package catalog

app shop {
  module "github.com/example/shop"
  blueprint platform
}

enum Status { OPEN CLOSED }

entity Product {
  name     strng
  owner    Customer
  status   Status
  category -> Categry (name)
  state    -> Status
  label    -> string
  tag      -> Tag (titel)
}

entity Category {
  name string
}

entity Tag {
  title string
}
