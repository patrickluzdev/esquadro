app shop {
  module "github.com/example/shop"
  blueprint base
  @base(x 1)
}

entity Product {
  name     string @postgress(column x)
  price    decimal @postgres(column product_price)
  status   string @base(x)
  sku      string @postgres(colum sku)
  code     string @postgres(column)
  category -> Category @postgres(column cat)

  @postgres(index [name, stauts])
}

entity Category {
  name string
}
