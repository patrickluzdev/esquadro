=== cmd/shop/main.go  [core: cmd/{{.App.Kebab}}/main.go.tmpl] slot:extra.hooks<-third slot:core.routes<-extra
package main

import "net/http"

func routes(mux *http.ServeMux) {
	mux.HandleFunc("GET /api/health", nil)
	mux.HandleFunc("GET /third", nil) // from third for shop
}

func main() {
	mux := http.NewServeMux()
	routes(mux)
	_ = http.ListenAndServe(":8080", mux)
}
