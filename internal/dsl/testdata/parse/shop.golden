app shop @2:1-9:2
  doc "The demo shop used across the docs."
  module "github.com/example/shop"
  blueprint base @5:3-5:17
  blueprint postgres @6:3-8:4
    option pool_max num:20
enum ProductStatus @11:1-11:48
  value ACTIVE
  value INACTIVE
  value SOLD_OUT
entity Category @13:1-15:2
  field name string required unique max(num:80) @14:3-14:38
entity Product @18:1-28:2
  doc "Something we sell."
  option plural "products"
  field name string required min(num:3) max(num:120) @19:3-19:47
  field description text @20:3-20:19
  field price decimal required min(num:0) @21:3-21:38
  field stock int default(num:0) @22:3-22:33
  field status ProductStatus default(ACTIVE) @23:3-23:44
  relation category -> Category (name) required @24:3-24:42
  relation tags <-> Tag (name) @25:3-25:29
  @postgres(index [name, status])
entity Tag @30:1-32:2
  field name string required unique @31:3-31:30
