app demo @2:1-13:2
  module "example.com/demo"
  blueprint "./blueprints/mine" @4:3-4:32
  blueprint "github.com/acme/esquadro-stripe@v1.2.0" @5:3-10:4
    option currency "BRL"
    option test_mode bool:true
    option retries num:3
    option ratio num:0.75
  blueprint admin-htmx @11:3-11:23
  @admin(title "Demo Admin")
enum Size @17:1-22:2
  value SMALL
    doc "Small one."
  value MEDIUM
    @label(text "Medium")
    @admin(hidden)
  value LARGE
entity Person @24:1-39:2
  option plural "people"
  option table "persons"
  field full_name string required pattern("^\\p{L}+( \\p{L}+)*$") @26:3-26:58
    doc "The display name."
  field email string required unique pattern("^[^@]+@[^@]+$") @admin(label "E-mail", searchable) @27:3-27:95
  field naïve bool default(bool:false) @28:3-28:34
  field balance decimal min(num:-100.50) @29:3-29:33
  field size Size default(MEDIUM) @30:3-30:33
  relation manager > Person @31:3-31:21
  relation passport - Passport @32:3-32:23
  field entity string @33:3-33:19
  @admin(icon "user", hidden)
  @postgres(index [email], table "persons")
entity Passport @41:1-43:2
  field number string required @42:3-42:25
comment "// A line comment at the top." @1:1-1:30
comment "/* A block comment\n   spanning lines. */" @15:1-16:22
comment "// a field may use a keyword as its name" @33:22-33:62
