// An example module: change it, delete it, or add files like it, one per
// module. Run esquadro gen after each change; esquadro check finds mistakes.
package catalog

enum Status {
  ACTIVE
  INACTIVE
}

/// A group of products.
entity Category {
  name     string required unique min(2) max(60)
  products < Product
  @security(read public, write user.admin)
}

/// Something the store sells.
entity Product {
  name        string  required min(2) max(120)
  description text
  price       decimal required min(0)
  status      Status  default(ACTIVE)
  category    > Category required
  @security(read public, write [user.admin, user.staff])
}
