/// {{.Label}}, generated by esquadro.
app {{.Name}} {
  module "{{.Module}}"

  // the program, its modules and the HTTP server
  blueprint app
  blueprint env
  blueprint domain
  blueprint http
  blueprint worker
  blueprint jobs

  // PostgreSQL: connection, migrations, use cases, tests and local services
  blueprint postgres
  blueprint migrations
  blueprint store
  blueprint testcontainers
  blueprint compose

  // the JSON API, who signs in to it, and what every request goes through
  blueprint rest
  blueprint api_docs
  blueprint security
  blueprint rate_limit
  blueprint compression
  blueprint i18n

  // running it in production: telemetry, the container image and the CI
  blueprint observability
  blueprint docker
  blueprint github_actions
{{- if .Git}}

  // the repository
  blueprint git {
    initial_commit true
  }
{{- end}}
}
