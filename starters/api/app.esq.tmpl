/// {{.Label}}, generated by esquadro.
app {{.Name}} {
  module "{{.Module}}"

  // the program, its modules and the HTTP server
  blueprint app
  blueprint domain
  blueprint http

  // PostgreSQL: connection, migrations, use cases, tests and local services
  blueprint postgres
  blueprint migrations
  blueprint store
  blueprint testcontainers
  blueprint compose

  // the JSON API and what every request goes through
  blueprint rest
  blueprint api_docs
  blueprint cors
  blueprint security_headers
  blueprint rate_limit
  blueprint compression
  blueprint i18n

  // running it in production: telemetry, the container image and the CI
  blueprint observability
  blueprint docker
  blueprint github_actions
{{- if .Git}}

  // the repository
  blueprint git {
    initial_commit true
  }
{{- end}}
}
