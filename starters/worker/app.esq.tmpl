/// {{.Label}}, generated by esquadro.
app {{.Name}} {
  module "{{.Module}}"

  // the program, its modules, and the jobs it works in the background
  blueprint app
  blueprint env
  blueprint domain
  blueprint worker
  blueprint jobs

  // PostgreSQL: connection, migrations, use cases, tests and local services
  blueprint postgres
  blueprint migrations
  blueprint store
  blueprint testcontainers
  blueprint compose

  // running it in production: telemetry, the container image and the CI
  blueprint observability
  blueprint docker
  blueprint github_actions
{{- if .Git}}

  // the repository
  blueprint git {
    initial_commit true
  }
{{- end}}
}
