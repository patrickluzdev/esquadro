/// {{.Label}}, generated by esquadro.
app {{.Name}} {
  module "{{.Module}}"

  // the program, its modules and the processes it runs
  blueprint app
  blueprint domain
  blueprint worker

  // PostgreSQL: connection, migrations, use cases, tests and local services
  blueprint postgres
  blueprint migrations
  blueprint store
  blueprint testcontainers
  blueprint compose

  // the container image and the CI
  blueprint docker
  blueprint github_actions
{{- if .Git}}

  // the repository
  blueprint git {
    initial_commit true
  }
{{- end}}
}
