// An example module: change it, delete it, or add files like it, one per
// module. Run esquadro gen after each change; esquadro check finds mistakes.
// Each job's work is in internal/billing/<job>_work.go, a file of yours.
package billing

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

/// What a customer owes.
entity Invoice {
  number string        required unique max(30)
  amount decimal       required min(0)
  due_on date          required
  status InvoiceStatus default(PENDING)
}

/// Sends an invoice to its customer: enqueued with EnqueueSendInvoice, from
/// a use case or the API.
job SendInvoice {
  invoice_id uuid required
}

/// Marks the invoices past their due date, every day at 3:00.
job MarkOverdueInvoices {
  @jobs(every "0 3 * * *")
}
