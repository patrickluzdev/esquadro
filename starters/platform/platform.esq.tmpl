/// {{.Label}}: the servers of your projects and the services they share.
platform {{.Name}} {
  // the servers, kept by Ansible
  blueprint server
  blueprint caddy
  blueprint postgres
  blueprint apps
  blueprint observability
  blueprint github_actions

  // the platform's email: its owner gets the alerts and password resets
  // blueprint mail {
  //   owner "you@acme.com"
  //   from  "Platform <no-reply@acme.com>"
  // }

  // with the domains on Cloudflare: their DNS and SSL, and the daily
  // backups of the databases in its R2
  // blueprint cloudflare {
  //   account_id "your account's id"
  // }
  // blueprint backup
{{- if .Git}}

  // the repository
  blueprint git {
    initial_commit true
  }
{{- end}}
}

/// The server: write its address, a Debian 13 you sign in to as root once.
server main {
  host "203.0.113.10"
}

