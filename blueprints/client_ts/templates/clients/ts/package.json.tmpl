{{- if .Entities -}}
{
  "name": {{tsString (packageName .App .Options)}},
  "version": "0.0.0",
  "description": {{tsString (printf "The TypeScript client of the %s API, generated by esquadro." .App.Label)}},
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit"
  },
{{- if eq .Options.registry "github"}}
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
{{- else}}
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
{{- end}}
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
{{end -}}
