// Generated by esquadro: the client against the API, which go test serves
// (TestTypeScriptClient) at API_URL. Run them with go test ./cmd/{{.App.Kebab}}.

import { test } from "node:test"
import assert from "node:assert/strict"
import { createClient, isApiError{{if $s}}, validate{{end}} } from "../src/index.ts"

const api = createClient({ baseUrl: process.env.API_URL! })
{{- range $e := .Entities}}{{if eq .Pascal $s}}{{$api := printf "api.%s" .Plural.Camel}}

const given = (i: number) => ({
{{- range inRequest $e}}{{if .Required}}
{{- if or (eq .Type "string") (eq .Type "text")}}
  {{.Snake}}: `{{.Pascal}} ${i}`.padEnd({{if .Min}}{{bound .Min}}{{else}}0{{end}}, "x"){{if .Max}}.slice(0, {{bound .Max}}){{end}},
{{- else}}
  {{.Snake}}: {{sample . 1}},
{{- end}}
{{- end}}{{end}}
})

test("{{.Plural.Snake}}: create once, read only some fields, change on the version read, delete", async () => {
  const key = crypto.randomUUID()
  const created = await {{$api}}.create(given(1), { idempotencyKey: key })
  const again = await {{$api}}.create(given(1), { idempotencyKey: key })
  assert.equal(again.id, created.id, "a retry with the same key creates once")

  const read = await {{$api}}.get(created.id, { fields: ["created_at"] })
  assert.deepEqual(Object.keys(read).sort(), ["can", "created_at", "id", "version"])

  const same = await {{$api}}.patch(created.id, {}, { ifMatch: created })
  assert.equal(same.version, created.version)
  await assert.rejects({{$api}}.patch(created.id, {}, { ifMatch: 99 }), (e) => isApiError(e, "precondition_failed"))

  const page = await {{$api}}.list()
  assert.ok(page.items.some((x) => x.id === created.id))
  assert.ok(Array.isArray(page.can))

  await {{$api}}.delete(created.id, { ifMatch: same })
  await assert.rejects({{$api}}.get(created.id), (e) => isApiError(e, "not_found"))
})

test("{{.Plural.Snake}}: a read cancelled rejects with an AbortError, sent once", async () => {
  let calls = 0
  // A server that never answers: only the signal ends the request.
  const hanging = createClient({
    baseUrl: process.env.API_URL!,
    fetch: (_input, init) => {
      calls++
      return new Promise((_resolve, reject) => init?.signal?.addEventListener("abort", () => reject(init.signal!.reason)))
    },
  })
  const controller = new AbortController()
  const read = hanging.{{.Plural.Camel}}.list({}, { signal: controller.signal })
  controller.abort()
  await assert.rejects(read, (e) => e instanceof Error && e.name === "AbortError" && !isApiError(e))
  assert.equal(calls, 1, "a cancelled read is not sent again")
})
{{- range inRequest $e}}{{if and (or (eq .Type "string") (eq .Type "text")) .Min (not .Pattern)}}{{if ge .Min.Value 2.0}}

test("{{$e.Plural.Snake}}: the client's rules and the API's refuse the same", async () => {
  const form = { ...given(2), {{.Snake}}: "x" }
  assert.deepEqual(validate.new{{$e.Pascal}}(form), [{ field: "{{.Snake}}", code: "too_short" }])
  await assert.rejects({{$api}}.create(form), (e) =>
    isApiError(e, "invalid_fields") && e.fields.length === 1 && e.fields[0]!.field === "{{.Snake}}" && e.fields[0]!.code === "too_short")
})
