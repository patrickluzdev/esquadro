// Generated by esquadro: do not edit. The identity routes of each realm:
// signing up and in, the session, the account.

import type { Transport } from "./runtime.ts"
import type { {{range $i, $r := realms .Entities}}{{if $i}}, {{end}}New{{$r.Entity.Pascal}}{{end}} } from "./records.ts"

/** A signed-in session. */
export interface Session {
  id: string
  realm: string
  roles: string[]
  permissions: string[]
  expires_at: string
  /** In cookie mode: sent back as X-CSRF-Token with each change. */
  csrf_token?: string
  /** Without a cookie: sent back as Authorization: Bearer. */
  session_token?: string
}

/** A device signed in to the account. */
export interface Device {
  id: string
  current: boolean
  created_at: string
  last_seen_at: string
  ip_address: string
  user_agent: string
}

/** An account of a realm, as those who administer it see it. */
export interface Account {
  id: string
  email: string
  /** What it is called: its record's name. */
  name: string
  /** Its record's fields. */
  fields: Record<string, unknown>
  roles: string[]
  status: "active" | "invited" | "unverified" | "disabled"
  last_seen_at: string | null
  created_at: string
}

/** A page of accounts. */
export interface AccountPage {
  items: Account[]
  page: number
  per_page: number
  total: number
  total_pages: number
}

/** A role of a realm, as the model declares it. */
export interface RoleInfo {
  name: string
  permissions: string[]
  /** How many accounts have it. */
  accounts: number
  /** Whether it administers the realm's accounts. */
  administers: boolean
}

/** What the accounts of a realm are asked for. */
export interface AccountQuery {
  q?: string
  role?: string
  status?: Account["status"]
  page?: number
  per_page?: number
}

// accounts are the routes that administer a realm's accounts.
function accounts(t: Transport, path: string) {
  const one = (id: string) => `${path}/accounts/${encodeURIComponent(id)}`
  return {
    list: (query: AccountQuery = {}) => t.request<AccountPage>("GET", `${path}/accounts`, { query: query as Record<string, string | number | undefined> }),
    /** Makes an account without a password and emails it a link to choose one. */
    invite: (invitation: { email: string; roles?: string[]; fields?: Record<string, unknown>; redirect?: string }) =>
      t.request<Account>("POST", `${path}/accounts`, { body: invitation }),
    reinvite: async (id: string, redirect?: string) => {
      await t.request("POST", `${one(id)}/invite`, { body: { redirect } })
    },
    setRoles: (id: string, roles: string[]) => t.request<Account>("PUT", `${one(id)}/roles`, { body: { roles } }),
    disable: (id: string) => t.request<Account>("POST", `${one(id)}/disable`),
    enable: (id: string) => t.request<Account>("POST", `${one(id)}/enable`),
    endSessions: async (id: string) => {
      await t.request("DELETE", `${one(id)}/sessions`)
    },
    remove: async (id: string) => {
      await t.request("DELETE", one(id))
    },
    /** The realm's roles, their permissions and how many accounts have each. */
    roles: () => t.request<RoleInfo[]>("GET", `${path}/roles`),
  }
}

/** An email and a password. */
export interface Credentials {
  email: string
  password: string
  /** The page of the app the verification link opens. */
  redirect?: string
}

// identity is one realm's routes on t; cookie is whether t signs in with
// the session cookie, which keeps the CSRF token of the session.
function realm(t: Transport, path: string, cookie: boolean) {
  const keep = (s: Session) => {
    if (cookie && s.csrf_token) t.csrf = s.csrf_token
    return s
  }
  if (cookie) {
    t.refreshCsrf ??= async () => {
      keep(await t.request<Session>("GET", `${path}/session`))
    }
  }
  return {
    /** Signs in, as a cookie or, with a token client, answering session_token. */
    signIn: async (c: Credentials) => keep(await t.request<Session>("POST", `${path}/sign-in`, { body: { ...c, cookie } })),
    /** The session signed in; in cookie mode, it keeps its CSRF token. */
    session: async () => keep(await t.request<Session>("GET", `${path}/session`)),
    signOut: async () => {
      await t.request("POST", `${path}/sign-out`)
      t.csrf = undefined
    },
    /** A short JWT for other services, checked with /.well-known/jwks.json. */
    token: () => t.request<{ token: string; expires_at: string }>("POST", `${path}/token`),
    /** The devices signed in. */
    sessions: () => t.request<Device[]>("GET", `${path}/sessions`),
    /** Ends every session but this one. */
    endOtherSessions: async () => {
      await t.request("DELETE", `${path}/sessions`)
    },
    endSession: async (id: string) => {
      await t.request("DELETE", `${path}/sessions/${encodeURIComponent(id)}`)
    },
    /** Changes the password, ending the other sessions. */
    changePassword: async (change: { current_password?: string; new_password: string }) => {
      await t.request("POST", `${path}/password`, { body: change })
    },
    /** Sends a link to the new email, which confirms it. */
    changeEmail: async (change: { email: string; redirect?: string }) => {
      await t.request("POST", `${path}/email`, { body: change })
    },
    confirmEmail: async (token: string) => {
      await t.request("POST", `${path}/email/confirm`, { body: { token } })
    },
    /** The ways the account signs in. */
    providers: () => t.request<{ provider: string; created_at: string }[]>("GET", `${path}/providers`),
    /** Deletes the account. */
    deleteAccount: async () => {
      await t.request("DELETE", path)
    },
  }
}
{{range $r := realms .Entities}}
/** The routes of the {{$r.Name}} realm. */
export function {{$r.Entity.Camel}}Identity(t: Transport, cookie: boolean) {
  const path = "{{$p}}/{{$r.Name}}"
  return {
    ...realm(t, path, cookie),
{{- if has $r.Providers "password"}}
    /** Signs up; answers whether or not the email had an account, so that it tells no one. */
    signUp: async (account: Credentials & New{{$r.Entity.Pascal}}) => {
      await t.request("POST", `${path}/sign-up`, { body: account })
    },
{{- end}}
{{- if ne $r.VerifyEmail "off"}}
    sendVerifyEmail: async (request: { email: string; redirect?: string }) => {
      await t.request("POST", `${path}/verify-email/send`, { body: request })
    },
    verifyEmail: async (token: string) => {
      await t.request("POST", `${path}/verify-email`, { body: { token } })
    },
{{- end}}
{{- if $r.PasswordReset}}
    forgotPassword: async (request: { email: string; redirect?: string }) => {
      await t.request("POST", `${path}/password/forgot`, { body: request })
    },
    /** Sets the password with a reset link's (or an invitation's) token. */
    resetPassword: async (reset: { token: string; new_password: string }) => {
      await t.request("POST", `${path}/password/reset`, { body: reset })
    },
{{- end}}
{{- if realmAdmins $.Entities $r.Entity}}
    /** Its accounts, for those who administer them. */
    accounts: accounts(t, path),
{{- end}}
{{- $social := false}}{{range $r.Providers}}{{if ne . "password"}}{{$social = true}}{{end}}{{end}}
{{- if $social}}
    /** The address to send the browser to, to sign in with a provider. */
    oauthUrl: (provider: {{$first := true}}{{range $r.Providers}}{{if ne . "password"}}{{if not $first}} | {{end}}{{$first = false}}"{{.}}"{{end}}{{end}}, redirect?: string) =>
      t.url(`${path}/oauth/${provider}` + (redirect ? `?redirect=${encodeURIComponent(redirect)}` : "")),
    /** Links a provider: answers the address to send the browser to. */
    linkProvider: (provider: string, redirect?: string) =>
      t.request<{ url: string }>("POST", `${path}/providers/${provider}`, { body: { redirect } }),
    unlinkProvider: async (provider: string) => {
      await t.request("DELETE", `${path}/providers/${provider}`)
    },
{{- end}}
  }
}
