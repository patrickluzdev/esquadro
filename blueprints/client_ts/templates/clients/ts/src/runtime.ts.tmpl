// Generated by esquadro: do not edit. The client's runtime: requests,
// sign-in, errors and the operations every record has.

/** How a client reaches the service, and who it signs in as. */
export interface ClientOptions {
  /** Where the service answers, e.g. "https://api.shop.com". */
  baseUrl: string
  /**
   * In a browser: send the session cookie of a realm ("customer"), and its
   * CSRF token with each change. Works when the page and the service share
   * a site (app.shop.com and api.shop.com); elsewhere, use token.
   */
  auth?: { cookie: string }
  /**
   * A session token or a JWT, sent as Authorization: Bearer. On a server
   * (Next, Astro), create a client per request, with the token of whoever
   * made it: never one for everyone.
   */
  token?: string
  /**
   * The CSRF token of the session whose cookie is sent: for a server that
   * forwards a browser's cookie in headers. A client that signs in with
   * auth keeps its own.
   */
  csrfToken?: string
  /** Headers sent with every request, e.g. { cookie } forwarded by a server. */
  headers?: Record<string, string>
  /** The fetch to use; the global one by default. */
  fetch?: typeof fetch
}

/** A field the API refused, and why: required, too_short, taken... */
export interface FieldProblem {
  field: string
  code: string
}

/** A response that is not a success: its status, and the API's code. */
export class ApiError extends Error {
  readonly status: number
  /** Stable, to act on: not_found, invalid_fields, precondition_failed... */
  readonly code: string
  /** For people, in the request's language. */
  readonly title: string
  /** The X-Request-Id the service logged the request with. */
  readonly requestId: string
  /** With invalid_fields, every field refused. */
  readonly fields: FieldProblem[]

  constructor(status: number, body: unknown) {
    const doc = (body ?? {}) as { code?: string; title?: string; request_id?: string; errors?: FieldProblem[] }
    super(doc.title ?? `HTTP ${status}`)
    this.name = "ApiError"
    this.status = status
    this.code = doc.code ?? "http_" + status
    this.title = doc.title ?? ""
    this.requestId = doc.request_id ?? ""
    this.fields = doc.errors ?? []
  }
}

/** Reports whether e is an ApiError, with the code when one is given. */
export function isApiError(e: unknown, code?: string): e is ApiError {
  return e instanceof ApiError && (code === undefined || e.code === code)
}

/** A version to send as If-Match: the number, or the record read. */
export type Version = number | { version: number }

/** A request's query; a list is sent as a,b,c. */
export type Query = Record<string, string | number | boolean | readonly (string | number)[] | undefined>

/** What a request sends besides its method and path. */
export interface RequestOptions {
  query?: Query
  body?: unknown
  ifMatch?: Version
  idempotencyKey?: string
}

/** Sends the client's requests, with its sign-in. */
export class Transport {
  readonly #options: ClientOptions
  /** The CSRF token sent with changes, in cookie mode. */
  csrf: string | undefined
  /**
   * Fetches the session's CSRF token, in cookie mode: a change refused for
   * the lack of it (a session open in this browser, never read by this
   * page) is sent once more after it.
   */
  refreshCsrf: (() => Promise<void>) | undefined

  constructor(options: ClientOptions) {
    this.#options = options
    this.csrf = options.csrfToken
  }

  /** The address of path on the service. */
  url(path: string): string {
    return new URL(path, this.#options.baseUrl).toString()
  }

  /** Sends a request and answers its JSON body, or throws an ApiError. */
  async request<T>(method: string, path: string, init: RequestOptions = {}): Promise<T> {
    try {
      return await this.#send<T>(method, path, init)
    } catch (e) {
      // Refused before anything was done: safe to send again.
      if (!(e instanceof ApiError && e.code === "csrf" && method !== "GET" && this.refreshCsrf)) throw e
      await this.refreshCsrf().catch(() => undefined)
      return this.#send<T>(method, path, init)
    }
  }

  async #send<T>(method: string, path: string, init: RequestOptions): Promise<T> {
    const o = this.#options
    const url = new URL(path, o.baseUrl)
    for (const [key, value] of Object.entries(init.query ?? {})) {
      if (value === undefined || (Array.isArray(value) && value.length === 0)) continue
      url.searchParams.set(key, Array.isArray(value) ? value.join(",") : String(value))
    }
    const headers: Record<string, string> = { Accept: "application/json", ...o.headers }
    if (init.body !== undefined) headers["Content-Type"] = "application/json"
    if (o.token) headers.Authorization = `Bearer ${o.token}`
    if (method !== "GET" && this.csrf) headers["X-CSRF-Token"] = this.csrf
    if (init.ifMatch !== undefined) {
      headers["If-Match"] = `"${typeof init.ifMatch === "number" ? init.ifMatch : init.ifMatch.version}"`
    }
    if (init.idempotencyKey) headers["Idempotency-Key"] = init.idempotencyKey
    const res = await (o.fetch ?? fetch)(url, {
      method,
      headers,
      body: init.body === undefined ? undefined : JSON.stringify(init.body),
      credentials: o.auth ? "include" : "same-origin",
    })
    const text = await res.text()
    let body: unknown
    try {
      body = text ? JSON.parse(text) : undefined
    } catch {
      body = undefined
    }
    if (!res.ok) throw new ApiError(res.status, body)
    return body as T
  }
}

/** A page of a list, with what the person may do with the list. */
export interface Page<T> {
  items: T[]
  can: "create"[]
  /** By cursor: the cursor of the next page; absent on the last one. */
  next?: string
  /** By page. */
  page?: number
  per_page?: number
  total?: number
  total_pages?: number
}

/** Options of a create: the Idempotency-Key, new by default. */
export interface CreateOptions {
  /** Send the same key when retrying the same operation. */
  idempotencyKey?: string
}

/** Options of a change: the version it is made on. */
export interface ChangeOptions {
  ifMatch?: Version
}

// The operations of an entity's records, untyped: each entity's interface
// types them.
export function records(t: Transport, path: string, pagination: readonly string[]): unknown {
  const one = (id: string) => `${path}/${encodeURIComponent(id)}`
  const list = (query: Query = {}) => t.request<Page<unknown>>("GET", path, { query })
  return {
    list,
    async *all(query: Query = {}) {
      if (pagination.includes("cursor")) {
        let after: string | undefined
        do {
          const page = await list({ ...query, after, page: undefined })
          yield* page.items
          after = page.next
        } while (after)
      } else if (pagination.includes("page")) {
        for (let n = 1; ; n++) {
          const page = await list({ ...query, page: n })
          yield* page.items
          if (n >= (page.total_pages ?? 0)) break
        }
      } else {
        yield* (await list(query)).items
      }
    },
    get: (id: string, query: Query = {}) => t.request("GET", one(id), { query }),
    create: (record: unknown, o: CreateOptions = {}) =>
      t.request("POST", path, { body: record, idempotencyKey: o.idempotencyKey ?? crypto.randomUUID() }),
    update: (id: string, record: unknown, o: ChangeOptions = {}) =>
      t.request("PUT", one(id), { body: record, ifMatch: o.ifMatch }),
    patch: (id: string, changes: unknown, o: ChangeOptions = {}) =>
      t.request("PATCH", one(id), { body: changes, ifMatch: o.ifMatch }),
    delete: async (id: string, o: ChangeOptions = {}) => {
      await t.request("DELETE", one(id), { ifMatch: o.ifMatch })
    },
  }
}

// The operations of a many-to-many relation, untyped.
export function links(t: Transport, path: string, relation: string): unknown {
  const of = (id: string) => `${path}/${encodeURIComponent(id)}/${relation}`
  return {
    list: (id: string, query: Query = {}) => t.request("GET", of(id), { query }),
    add: async (id: string, other: string, o: ChangeOptions = {}) => {
      await t.request("PUT", `${of(id)}/${encodeURIComponent(other)}`, { ifMatch: o.ifMatch })
    },
    remove: async (id: string, other: string, o: ChangeOptions = {}) => {
      await t.request("DELETE", `${of(id)}/${encodeURIComponent(other)}`, { ifMatch: o.ifMatch })
    },
  }
}
