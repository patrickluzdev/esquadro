// Generated by esquadro from the model: do not edit. Sending the files of
// the file and image fields: the API says where (POST /storage/uploads),
// the file goes there, and a record uses it by the id answered.

import type { Transport } from "./runtime.ts"

/** The file fields, by entity: what a file may be sent for. */
export type UploadTarget =
{{- range $e := .Entities}}{{$fs := ""}}{{range .Fields}}{{if or (eq .Type "file") (eq .Type "image")}}{{if $fs}}{{$fs = printf "%s | %q" $fs .Snake}}{{else}}{{$fs = printf "%q" .Snake}}{{end}}{{end}}{{end}}{{if $fs}}
  | { entity: {{tsString $e.Plural.Snake}}; field: {{$fs}} }
{{- end}}{{end}}

/** Where and how to send a file, as the API answers. */
export interface Upload {
  id: string
  url: string
  method: "PUT"
  headers: Record<string, string>
  expires_at: string
}

/** What to send, and how far it went (0 to 1). */
export type UploadInput = UploadTarget & {
  file: Blob & { name?: string }
  onProgress?: (done: number) => void
  signal?: AbortSignal
}

/** The file sending of the client: send answers the file's id. */
export function uploads(t: Transport) {
  return {
    /** Asks where to send a file, sends it, and answers its id for the record's field. */
    async send(input: UploadInput): Promise<string> {
      const up = await t.request<Upload>("POST", "/storage/uploads", {
        body: {
          entity: input.entity,
          field: input.field,
          name: input.file.name ?? "file",
          content_type: input.file.type || "application/octet-stream",
          size: input.file.size,
        },
      })
      await put(t.url(up.url), up.headers, input)
      return up.id
    },
  }
}

/** Sends the bytes: with progress where XMLHttpRequest is (a browser), else by fetch. */
function put(url: string, headers: Record<string, string>, input: UploadInput): Promise<void> {
  if (typeof XMLHttpRequest === "undefined") {
    return fetch(url, { method: "PUT", headers, body: input.file, signal: input.signal }).then((r) => {
      if (!r.ok) throw new Error(`the file was not sent: ${r.status}`)
      input.onProgress?.(1)
    })
  }
  return new Promise((resolve, reject) => {
    const xhr = new XMLHttpRequest()
    xhr.open("PUT", url)
    for (const [k, v] of Object.entries(headers)) xhr.setRequestHeader(k, v)
    xhr.upload.onprogress = (e) => e.lengthComputable && input.onProgress?.(e.loaded / e.total)
    xhr.onload = () => (xhr.status >= 200 && xhr.status < 300 ? (input.onProgress?.(1), resolve()) : reject(new Error(`the file was not sent: ${xhr.status}`)))
    xhr.onerror = () => reject(new Error("the file was not sent: no connection"))
    xhr.onabort = () => reject(new DOMException("aborted", "AbortError"))
    input.signal?.addEventListener("abort", () => xhr.abort())
    xhr.send(input.file)
  })
}
{{end -}}
