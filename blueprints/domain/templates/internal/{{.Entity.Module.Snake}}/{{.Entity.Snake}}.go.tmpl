{{- $e := .Entity -}}
{{- $utf8 := ""}}{{$re := "" -}}
{{- range $e.Fields}}{{if not .Implicit -}}
{{- if and (or (eq .Type "string") (eq .Type "text")) (or .Min .Max)}}{{$utf8 = "unicode/utf8"}}{{end -}}
{{- if .Pattern}}{{$re = "regexp"}}{{end -}}
{{- end}}{{end -}}
package {{$e.Module.Snake}}

{{importBlock (goImports $e) $re $utf8}}
{{goDoc $e.Pascal $e.Doc (printf "%s is %s %s of %s." $e.Pascal (or (and (eq (slice (lower $e.Label) 0 1) "a" "e" "i" "o") "an") "a") (lower $e.Label) $e.Module.Snake)}}
type {{$e.Pascal}} struct {
{{- range $e.Fields}}{{if eq .Snake "id"}}
	{{.Pascal}} {{goType .}}
{{- end}}{{end}}
{{- range $e.Fields}}{{if not .Implicit}}
{{- if .Doc}}
	{{goDoc .Pascal .Doc ""}}
{{- end}}
	{{.Pascal}} {{goType .}}
{{- end}}{{end}}
{{- range $e.Relations}}{{if .OwnsForeignKey}}
	{{.Pascal}}ID uuid.UUID
{{- end}}{{end}}
{{- range $e.Fields}}{{if and .Implicit (ne .Snake "id")}}
	{{.Pascal}} {{goType .}}
{{- end}}{{end}}
}

// New{{$e.Pascal}} is {{if eq (slice (lower $e.Label) 0 1) "a" "e" "i" "o"}}an{{else}}a{{end}} {{lower $e.Label}} as it is written, before it is stored.
type New{{$e.Pascal}} struct {
{{- range $e.Fields}}{{if not .Implicit}}
	{{.Pascal}} {{goType .}}
{{- end}}{{end}}
{{- range $e.Relations}}{{if .OwnsForeignKey}}
	{{.Pascal}}ID uuid.UUID
{{- end}}{{end}}
}

// {{$e.Pascal}}Changes are changes to {{if eq (slice (lower $e.Label) 0 1) "a" "e" "i" "o"}}an{{else}}a{{end}} {{lower $e.Label}}: each field not nil is
// set (to its zero value, to empty it); the rest stay as they are.
type {{$e.Pascal}}Changes struct {
{{- range $e.Fields}}{{if not .Implicit}}
	{{.Pascal}} *{{goType .}}
{{- end}}{{end}}
{{- range $e.Relations}}{{if .OwnsForeignKey}}
	{{.Pascal}}ID *uuid.UUID
{{- end}}{{end}}
}

// Apply is x with the changes c makes, as it would be written again.
func (c {{$e.Pascal}}Changes) Apply(x {{$e.Pascal}}) New{{$e.Pascal}} {
	n := New{{$e.Pascal}}{
{{- range $e.Fields}}{{if not .Implicit}}
		{{.Pascal}}: x.{{.Pascal}},
{{- end}}{{end}}
{{- range $e.Relations}}{{if .OwnsForeignKey}}
		{{.Pascal}}ID: x.{{.Pascal}}ID,
{{- end}}{{end}}
	}
{{- range $e.Fields}}{{if not .Implicit}}
	if c.{{.Pascal}} != nil {
		n.{{.Pascal}} = *c.{{.Pascal}}
	}
{{- end}}{{end}}
{{- range $e.Relations}}{{if .OwnsForeignKey}}
	if c.{{.Pascal}}ID != nil {
		n.{{.Pascal}}ID = *c.{{.Pascal}}ID
	}
{{- end}}{{end}}
	return n
}

// Empty reports whether c changes nothing.
func (c {{$e.Pascal}}Changes) Empty() bool {
	return {{$first := true}}{{range $e.Fields}}{{if not .Implicit}}{{if not $first}} && {{end}}{{$first = false}}c.{{.Pascal}} == nil{{end}}{{end}}{{range $e.Relations}}{{if .OwnsForeignKey}}{{if not $first}} && {{end}}{{$first = false}}c.{{.Pascal}}ID == nil{{end}}{{end}}{{if $first}}true{{end}}
}
{{- $defaults := false}}
{{- range $e.Fields}}{{if and .Default (not .Implicit) (or (eq .Type "string") (eq .Type "text") (eq .Type "enum") (eq .Type "uuid") (eq .Type "json") (eq .Type "time") (eq .Type "date") (eq .Type "money"))}}{{$defaults = true}}{{end}}{{end}}
{{- if $defaults}}

// WithDefaults fills the fields left empty with the defaults declared for
// {{$e.Plural.Snake}}.
func (n New{{$e.Pascal}}) WithDefaults() New{{$e.Pascal}} {
{{- range $e.Fields}}{{if and .Default (not .Implicit)}}{{$x := printf "n.%s" .Pascal}}
{{- if or (eq .Type "string") (eq .Type "text")}}
	if {{$x}} == "" {
		{{$x}} = {{quote .Default.Text}}
	}
{{- else if eq .Type "uuid"}}
	if {{$x}} == uuid.Nil() {
		{{$x}} = uuid.MustParse({{quote .Default.Text}})
	}
{{- else if eq .Type "enum"}}
	if {{$x}} == "" {
		{{$x}} = {{.Enum.Pascal}}{{.Default.EnumValue.Pascal}}
	}
{{- else if eq .Type "json"}}
	if len({{$x}}) == 0 {
		{{$x}} = json.RawMessage({{quote .Default.Text}})
	}
{{- else if and (or (eq .Type "time") (eq .Type "date")) (eq .Default.Text "now")}}
	if {{$x}}.IsZero() {
		{{$x}} = time.Now()
	}
{{- else if eq .Type "money"}}
	if {{$x}}.CurrencyCode() == "" {
		{{$x}} = mustMoney({{quote .Default.Text}}, {{quote $.App.Currency}})
	}
{{- end}}
{{- end}}{{end}}
	return n
}
{{- else}}

// WithDefaults returns n: no field of {{$e.Plural.Snake}} has a default that an
// empty value could stand for.
func (n New{{$e.Pascal}}) WithDefaults() New{{$e.Pascal}} { return n }
{{- end}}
{{range $e.Fields}}{{if .Pattern}}
// {{$e.Camel}}{{.Pascal}}Pattern is the pattern declared for {{$e.Pascal}}.{{.Raw}}.
var {{$e.Camel}}{{.Pascal}}Pattern = regexp.MustCompile({{rawQuote .Pattern}})
{{end}}{{end}}
// Validate checks a New{{$e.Pascal}} against the rules declared for {{$e.Plural.Snake}}.
func (n New{{$e.Pascal}}) Validate() error {
	var invalid []FieldError
	refuse := func(field, code string) { invalid = append(invalid, FieldError{Field: field, Code: code}) }
{{- range $e.Fields}}{{if not .Implicit}}{{$f := .}}{{$x := printf "n.%s" .Pascal}}
{{- if .Required}}
{{- if or (eq .Type "string") (eq .Type "text") (eq .Type "enum")}}
	if {{$x}} == "" {
		refuse({{quote .Snake}}, "required")
	}
{{- else if or (eq .Type "uuid") (eq .Type "file") (eq .Type "image")}}
	if {{$x}} == uuid.Nil() {
		refuse({{quote .Snake}}, "required")
	}
{{- else if or (eq .Type "time") (eq .Type "date")}}
	if {{$x}}.IsZero() {
		refuse({{quote .Snake}}, "required")
	}
{{- else if eq .Type "json"}}
	if len({{$x}}) == 0 {
		refuse({{quote .Snake}}, "required")
	}
{{- else if eq .Type "money"}}
	if {{$x}}.CurrencyCode() == "" {
		refuse({{quote .Snake}}, "required")
	}
{{- end}}
{{- end}}
{{- if or (eq .Type "string") (eq .Type "text")}}
{{- if .Min}}
	if {{$x}} != "" && utf8.RuneCountInString({{$x}}) < {{.Min.Text}} {
		refuse({{quote .Snake}}, "too_short")
	}
{{- end}}
{{- if .Max}}
	if utf8.RuneCountInString({{$x}}) > {{.Max.Text}} {
		refuse({{quote .Snake}}, "too_long")
	}
{{- end}}
{{- if .Pattern}}
	if {{$x}} != "" && !{{$e.Camel}}{{.Pascal}}Pattern.MatchString({{$x}}) {
		refuse({{quote .Snake}}, "pattern")
	}
{{- end}}
{{- else if or (eq .Type "int") (eq .Type "int64")}}
{{- if .Min}}
	if {{$x}} < {{.Min.Text}} {
		refuse({{quote .Snake}}, "too_small")
	}
{{- end}}
{{- if .Max}}
	if {{$x}} > {{.Max.Text}} {
		refuse({{quote .Snake}}, "too_large")
	}
{{- end}}
{{- else if eq .Type "decimal"}}
{{- if .Min}}
	if {{$x}}.LessThan(decimal.RequireFromString({{quote .Min.Text}})) {
		refuse({{quote .Snake}}, "too_small")
	}
{{- end}}
{{- if .Max}}
	if {{$x}}.GreaterThan(decimal.RequireFromString({{quote .Max.Text}})) {
		refuse({{quote .Snake}}, "too_large")
	}
{{- end}}
{{- else if eq .Type "money"}}
	if {{$x}}.CurrencyCode() != "" {
		if !moneyFits({{$x}}) {
			refuse({{quote .Snake}}, "too_precise")
		}
{{- if .Min}}
		if moneyCmp({{$x}}, {{quote .Min.Text}}) < 0 {
			refuse({{quote .Snake}}, "too_small")
		}
{{- end}}
{{- if .Max}}
		if moneyCmp({{$x}}, {{quote .Max.Text}}) > 0 {
			refuse({{quote .Snake}}, "too_large")
		}
{{- end}}
	}
{{- else if eq .Type "enum"}}
	if {{$x}} != "" && !{{$x}}.Valid() {
		refuse({{quote .Snake}}, "invalid_value")
	}
{{- end}}
{{- end}}{{end}}
{{- range $e.Relations}}{{if and .OwnsForeignKey .Required}}
	if n.{{.Pascal}}ID == uuid.Nil() {
		refuse({{quote .Snake}}, "required")
	}
{{- end}}{{end}}
	if len(invalid) > 0 {
		return &InvalidFields{Fields: invalid}
	}
	return nil
}
