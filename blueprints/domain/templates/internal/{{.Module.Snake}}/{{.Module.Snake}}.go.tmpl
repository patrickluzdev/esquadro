// {{.Module.Pascal}} is the {{.Module.Snake}} module: its use cases are its methods.
type {{.Module.Pascal}} struct{ Deps }

// New returns the module with its dependencies.
func New(deps Deps) *{{.Module.Pascal}} {
	if deps.NewID == nil {
		deps.NewID = uuid.NewV7
	}
	return &{{.Module.Pascal}}{Deps: deps}
}
