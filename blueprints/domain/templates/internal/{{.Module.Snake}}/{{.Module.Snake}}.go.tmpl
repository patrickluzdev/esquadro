// moneyFits reports whether an amount fits where it is stored: four places
// at most.
func moneyFits(a currency.Amount) bool {
	_, places, ok := strings.Cut(a.Number(), ".")
	return !ok || len(strings.TrimRight(places, "0")) <= 4
}

// mustMoney is an amount known to be valid: a default, a test's value.
func mustMoney(n, code string) currency.Amount {
	a, err := currency.NewAmount(n, code)
	if err != nil {
		panic(err)
	}
	return a
}

// moneyCmp compares an amount with a bound, taken in the amount's currency:
// -1, 0 or 1.
func moneyCmp(a currency.Amount, bound string) int {
	b, err := currency.NewAmount(bound, a.CurrencyCode())
	if err != nil {
		return 0
	}
	c, _ := a.Cmp(b)
	return c
}
