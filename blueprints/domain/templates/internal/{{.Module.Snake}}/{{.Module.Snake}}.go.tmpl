// FieldError is a field the module refuses, with a code that says why:
// required, too_short, too_long, too_small, too_large, too_precise (an
// amount with more than four places), pattern, invalid_value, not_found (a
// related record that does not exist) or taken (a unique value already used).
type FieldError struct{ Field, Code string }

// InvalidFields is a value the module refuses, field by field.
type InvalidFields struct{ Fields []FieldError }

func (e *InvalidFields) Error() string { return "{{.Module.Snake}}: invalid fields" }

// RuleError is a business rule of the app that refuses a change (in
// <entity>_rules.go): its own code, what it tells people, and the fields it
// is about. The API answers it as 422, with the code and the text.
type RuleError struct {
	Code, Text string
	Fields     []string
}

func (e *RuleError) Error() string { return "{{.Module.Snake}}: " + e.Code + ": " + e.Text }

// Broken is the refusal of a rule: Broken("daily_limit", "This group got 20
// offers today.", "destination_id").
func Broken(code, text string, fields ...string) error {
	return &RuleError{Code: code, Text: text, Fields: fields}
}

