# Generated by esquadro: {{ app.name }}, at the version in .env, which only
# the deploy changes.
name: {{ app.name }}
services:
  app:
    image: {{ app.image }}:${VERSION:?not deployed yet}
    container_name: {{ app.name }}-app
    restart: unless-stopped
    env_file: app.env
    networks: [platform]
{% if app.worker %}
  worker:
    image: {{ app.image }}:${VERSION:?not deployed yet}
    container_name: {{ app.name }}-worker
    restart: unless-stopped
    command: ["run"]
    # The image's health check asks the HTTP server, which a worker has not:
    # the deploy counts it healthy when it keeps running.
    healthcheck:
      disable: true
    env_file: app.env
    networks: [platform]
{% endif %}
networks:
  platform:
    name: {{ platform_network }}
    external: true
