#!/bin/bash
# Generated by esquadro: each app's version and health, and the services.
set -uo pipefail
for dir in /opt/platform/apps/*/; do
  app=$(basename "$dir")
  version=$(sed -n 's/^VERSION=//p' "$dir/.env")
  echo "$app ${version:-not deployed}"
  [ -n "$version" ] && (cd "$dir" && docker compose ps --format '{{.Service}}: {{.Status}}' | sed 's/^/  /')
  tail -n 1 "$dir/deploys.log" 2>/dev/null | sed 's/^/  last deploy: /'
done
echo
docker ps --filter network=platform --format '{{.Names}}: {{.Status}}' | grep -v -- '-app:\|-worker:' || true
