#!/bin/bash
# Generated by esquadro: deploys a version of an app, or goes back to one.
#   deploy <app> <version>   (version v1.2.3 or 1.2.3)
# Run by an app's deploy key, the version comes in SSH_ORIGINAL_COMMAND.
# A token for the registry may come on stdin; it is used for this pull only.
set -euo pipefail

die() { echo "deploy: $*" >&2; exit 1; }

app=${1:?deploy <app> <version>}
version=${2:-${SSH_ORIGINAL_COMMAND:-}}
[[ $app =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "$app is not an app's name"
[[ $version =~ ^v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || die "the version must look like v1.2.3, not \"$version\""
tag=${version#v}

dir=/opt/platform/apps/$app
[ -f "$dir/image" ] || die "the platform runs no app $app"
cd "$dir"
image=$(cat image)
previous=$(sed -n 's/^VERSION=//p' .env)
log() { echo "$(date -u +%FT%TZ) $app $tag $*" | tee -a deploys.log; }

# The registry's token, when one comes, signs in for this deploy only.
export DOCKER_CONFIG
DOCKER_CONFIG=$(mktemp -d)
trap 'rm -rf "$DOCKER_CONFIG"' EXIT
if [ ! -t 0 ]; then
  token=$(cat)
  if [ -n "$token" ]; then
    printf '%s' "$token" | docker login "${image%%/*}" -u token --password-stdin >/dev/null 2>&1 ||
      die "cannot sign in to ${image%%/*} with the token given"
  fi
fi

log "pulling $image:$tag"
docker pull -q "$image:$tag" >/dev/null || die "cannot pull $image:$tag"

# An image that migrates its database says so (esquadro's migrations).
if [ "$(docker image inspect -f '{{ index .Config.Labels "dev.esquadro.migrate" }}' "$image:$tag")" = true ]; then
  log "migrating"
  docker run --rm --network platform --env-file app.env "$image:$tag" migrate || { log "failed: the migration"; exit 1; }
fi

healthy() {
  docker compose up -d --wait --wait-timeout 120 >/dev/null 2>&1 || return 1
  # A worker, which has no health check, counts as healthy when it keeps
  # running for 30 seconds.
  if docker compose config --services | grep -qx worker; then
    sleep 30
    [ -z "$(docker compose ps --status restarting --status exited -q)" ] || return 1
  fi
}

echo "VERSION=$tag" > .env
if healthy; then
  log "running"
  exit 0
fi
log "failed: not healthy"
docker compose logs --tail 50 >&2 || true
if [ -n "$previous" ]; then
  echo "VERSION=$previous" > .env
  if healthy; then
    log "back to $previous"
  else
    log "failed: $previous is not healthy either"
  fi
else
  docker compose down >/dev/null 2>&1 || true
  echo "VERSION=" > .env
fi
exit 1
