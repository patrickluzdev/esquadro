# Generated by esquadro: Cloudflare as the platform describes it, from
# platform.auto.tfvars.json. Your own resources go in local.tf.

terraform {
  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.0"
    }
  }

  # The state is in git, so it is encrypted, with a passphrase from the
  # platform's secrets.
  encryption {
    key_provider "pbkdf2" "state" {
      passphrase = var.state_passphrase
    }
    method "aes_gcm" "state" {
      keys = key_provider.pbkdf2.state
    }
    state {
      method   = method.aes_gcm.state
      enforced = true
    }
    plan {
      method   = method.aes_gcm.state
      enforced = true
    }
  }
}

variable "state_passphrase" {
  type      = string
  sensitive = true
}

variable "account_id" {
  type = string
}

variable "server" {
  description = "The server's address the records point at."
  type        = string
}

variable "domains" {
  description = "Every domain of the platform."
  type        = list(string)
}

variable "proxied" {
  type = bool
}

variable "bucket" {
  description = "The R2 bucket of the backups; none when empty."
  type        = string
}

data "cloudflare_zones" "all" {
  account = {
    id = var.account_id
  }
}

locals {
  zones = { for z in data.cloudflare_zones.all.result : z.name => z.id }
  # The zones each domain is in, then its own: the longest of them.
  zones_of = {
    for d in var.domains : d => [for name in keys(local.zones) : name if d == name || endswith(d, ".${name}")]
  }
  zone_of = {
    for d, names in local.zones_of : d => length(names) == 0 ? null : local.zones[
      [for n in names : n if length(n) == max([for m in names : length(m)]...)][0]
    ]
  }
  used_zones = toset(values(local.zone_of))
}

check "every_domain_has_a_zone" {
  assert {
    condition     = alltrue([for d, z in local.zone_of : z != null])
    error_message = "Some domains are in no zone of the account: ${join(", ", [for d, z in local.zone_of : d if z == null])}."
  }
}

resource "cloudflare_dns_record" "domain" {
  for_each = { for d, z in local.zone_of : d => z if z != null }
  zone_id  = each.value
  name     = each.key
  type     = "A"
  content  = var.server
  proxied  = var.proxied
  ttl      = 1
  comment  = "Managed by the platform's OpenTofu."
}

resource "cloudflare_zone_setting" "ssl" {
  for_each   = var.proxied ? local.used_zones : toset([])
  zone_id    = each.value
  setting_id = "ssl"
  value      = "strict"
}

resource "cloudflare_r2_bucket" "backups" {
  count      = var.bucket == "" ? 0 : 1
  account_id = var.account_id
  name       = var.bucket
}
