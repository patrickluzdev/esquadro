# Generated by esquadro: the platform's model, for every role.
platform_name: {{.App.Kebab}}
platform_admin_user: {{.Options.admin_user}}
platform_ssh_key: {{quote .Options.ssh_key}}
platform_timezone: {{.Options.timezone}}
# Where the platform's services and apps live on the servers.
platform_root: /opt/platform
# The Docker network the services and the apps share; only the services
# that face the internet publish ports.
platform_network: platform
# Ports the firewall lets in besides SSH.
platform_ports:
{{- with slot "server.ports" .}}
{{.}}
{{- else}} []
{{- end}}
# The apps the platform runs.
platform_apps:
{{- range .Hosted}}
  - name: {{.Kebab}}
    image: {{.Image}}
    domains: [{{range $i, $d := .Domains}}{{if $i}}, {{end}}{{$d}}{{end}}]
    port: {{.Port}}
    worker: {{.Worker}}
    database: {{.Database}}
{{- else}} []
{{- end}}
{{- with slot "server.vars" .}}
{{.}}
{{- end}}
