# Generated by esquadro: add your own tasks to Taskfile.yml instead.
version: '3'

env:
  # How the tasks sign in to the servers.
  SSH: ssh -i {{.Options.ssh_key}} -o IdentitiesOnly=yes
  # Where your age key is: it decrypts secrets/, and it is never in git.
  SOPS_AGE_KEY_FILE: '{{"{{"}}.HOME{{"}}"}}/.config/sops/age/keys.txt'
  ANSIBLE_CONFIG: ansible/ansible.cfg

tasks:
  deps:
    desc: Install the Ansible collections the playbooks use
    cmds:
      - ansible-galaxy collection install -r ansible/requirements.yml

  secrets:init:
    desc: Make your age key (once), encrypt secrets/ with it, and add the secrets new blueprints need
    cmds:
      - sh scripts/secrets-init.sh

  secrets:edit:
    desc: Change the platform's secrets in your editor; they are encrypted again on save
    cmds:
      - sops secrets/platform.sops.yaml

  bootstrap:
    desc: Prepare a new server, signing in as root once (SERVER=<name>, all of them without it)
    cmds:
      - ansible-playbook ansible/bootstrap.yml {{"{{"}}if .SERVER{{"}}"}}--limit {{"{{"}}.SERVER{{"}}"}}{{"{{"}}end{{"}}"}}
      - task: apply

  plan:
    desc: Show what apply would change, changing nothing
    cmds:
{{- with slot "server.plan" .}}
{{.}}
{{- end}}
      - ansible-playbook ansible/site.yml --check --diff

  apply:
    desc: Bring the servers, and what else the platform describes, to it
    cmds:
{{- with slot "server.apply" .}}
{{.}}
{{- end}}
      - ansible-playbook ansible/site.yml

  ssh:
    desc: Sign in to a server (SERVER=<name>, the first one without it)
    vars:
      SERVER: '{{"{{"}}.SERVER | default "{{(index .Servers 0).Raw}}"{{"}}"}}'
    cmds:
      - |
        case "{{"{{"}}.SERVER{{"}}"}}" in
{{- range .Servers}}
        {{.Raw}}) host={{.Host}} ;;
{{- end}}
        *) echo "there is no server {{"{{"}}.SERVER{{"}}"}}" >&2; exit 1 ;;
        esac
        $SSH -t {{.Options.admin_user}}@"$host"
    interactive: true

  lint:
    desc: Check the playbooks
    cmds:
      - ansible-playbook ansible/site.yml --syntax-check
      - ansible-lint ansible/
{{- range slotParts "server.tasks" .}}

{{.}}
{{- end}}
