/// The foundation of every generated project: go.mod, configuration,
/// structured logging, the HTTP server and the Go models of the entities.
blueprint platform {
  version "0.1.0"

  /// Port the HTTP server listens on when PORT is not set.
  option port int default(8080)

  /// Fields of the Config struct.
  slot "platform.config.fields"
  /// Code that fills those fields from the environment.
  slot "platform.config.load"
  /// Code run at startup, before the server starts.
  slot "platform.main.init"
  /// Code run on shutdown, after the server stops.
  slot "platform.main.shutdown"
  /// HTTP routes, registered on the ServeMux.
  slot "platform.routes"
  /// Extra Makefile targets.
  slot "platform.makefile.targets"
  /// Extra methods on each entity's Go model.
  slot "platform.model.methods"
}
