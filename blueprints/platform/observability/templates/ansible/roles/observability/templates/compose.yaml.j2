# Generated by esquadro: Grafana with its databases (otel-lgtm), on the
# platform's network only, and the collector of the server's metrics.
name: observability
services:
  otel-lgtm:
    image: grafana/otel-lgtm:{{ observability_version }}
    container_name: otel-lgtm
    restart: unless-stopped
    env_file: .env
    environment:
      GF_AUTH_ANONYMOUS_ENABLED: "false"
{% if observability_grafana_domain %}
      GF_SERVER_ROOT_URL: https://{{ observability_grafana_domain }}
{% endif %}
{% if mail_owner is defined %}
      # Password resets and alerts, through the platform's email.
      GF_SMTP_ENABLED: "true"
      GF_SMTP_HOST: "{{ mail_smtp_host }}:{{ mail_smtp_port }}"
      GF_SMTP_USER: "{{ mail_smtp_user }}"
      GF_SMTP_FROM_ADDRESS: "{{ mail_from_address }}"
      GF_SMTP_FROM_NAME: "{{ mail_from_name or 'Grafana' }}"
      GF_SMTP_STARTTLS_POLICY: "{{ 'NoStartTLS' if (mail_smtp_port | int) == 465 else 'MandatoryStartTLS' }}"
      GF_SECURITY_ADMIN_EMAIL: "{{ mail_owner }}"
{% endif %}
      PROMETHEUS_EXTRA_ARGS: --storage.tsdb.retention.time={{ observability_retention_days }}d
      LOKI_EXTRA_ARGS: >-
        -compactor.retention-enabled=true -store.retention={{ observability_retention_days * 24 }}h
        -compactor.delete-request-store=filesystem
      TEMPO_EXTRA_ARGS: -backend-worker.compaction.block-retention={{ observability_retention_days * 24 }}h
    ports:
      # Grafana, for task grafana's SSH tunnel: on the server only.
      - "127.0.0.1:3000:3000"
      # OTLP, for what runs on the server outside the platform's network
      # (the backup's report): on the server only.
      - "127.0.0.1:4318:4318"
    volumes:
      - data:/data
      - ./alerting/platform.yaml:/otel-lgtm/grafana/conf/provisioning/alerting/platform.yaml:ro
      - ./dashboards.yaml:/otel-lgtm/grafana/conf/provisioning/dashboards/apps.yaml:ro
      - ./dashboards:/otel-lgtm/apps-dashboards:ro
    networks: [platform]
  hostmetrics:
    image: grafana/otel-lgtm:{{ observability_version }}
    container_name: hostmetrics
    restart: unless-stopped
    entrypoint: ["/otel-lgtm/otelcol-contrib/otelcol-contrib", "--config=/etc/hostmetrics.yaml"]
    # The image's health check is otel-lgtm's, which this one does not run.
    healthcheck:
      disable: true
    volumes:
      - ./hostmetrics.yaml:/etc/hostmetrics.yaml:ro
      - /:/hostfs:ro
    networks: [platform]
volumes:
  data:
networks:
  platform:
    name: {{ platform_network }}
    external: true
