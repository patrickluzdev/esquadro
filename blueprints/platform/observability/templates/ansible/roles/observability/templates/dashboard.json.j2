{#- Generated by esquadro: the dashboard of one app (app), at /d/app-<name>. -#}
{%- set pt = observability_alerts_language == 'pt-BR' -%}
{%- set j = '{job="' ~ app.name ~ '"' -%}
{%- set panels = [
  {'row': 'API'},
  {'title': 'Requisições por minuto' if pt else 'Requests per minute', 'unit': 'short',
   'expr': 'sum by (http_route) (rate(http_server_request_duration_seconds_count' ~ j ~ '}[5m])) * 60', 'legend': '{{http_route}}'},
  {'title': 'Respostas 5xx por minuto' if pt else '5xx answers per minute', 'unit': 'short',
   'expr': 'sum by (http_route) (rate(http_server_request_duration_seconds_count' ~ j ~ ', http_response_status_code=~"5.."}[5m])) * 60', 'legend': '{{http_route}}'},
  {'title': 'Latência p50 e p95' if pt else 'Latency p50 and p95', 'unit': 's',
   'expr': 'histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket' ~ j ~ '}[5m])))', 'legend': 'p95',
   'expr2': 'histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket' ~ j ~ '}[5m])))', 'legend2': 'p50'},
] -%}
{%- if app.worker -%}
{%- set panels = panels + [
  {'row': 'Jobs'},
  {'title': 'Execuções por tipo e resultado' if pt else 'Runs by kind and result', 'unit': 'short',
   'expr': 'sum by (kind, status) (increase(river_work_count_total' ~ j ~ '}[5m]))', 'legend': '{{kind}} {{status}}'},
  {'title': 'Fila por estado' if pt else 'Queue by state', 'unit': 'short',
   'expr': 'sum by (state) (jobs_queue' ~ j ~ '})', 'legend': '{{state}}'},
  {'title': 'Jobs agendados atrasados' if pt else 'Late scheduled jobs', 'unit': 'short',
   'expr': 'max by (kind) (jobs_periodic_overdue' ~ j ~ '})', 'legend': '{{kind}}'},
  {'title': 'Integrações (1 = respondeu)' if pt else 'Integrations (1 = answered)', 'unit': 'short',
   'expr': 'min by (integration) (integration_check' ~ j ~ '})', 'legend': '{{integration}}'},
] -%}
{%- endif -%}
{%- set panels = panels + [
  {'row': 'Banco e processo' if pt else 'Database and process'},
  {'title': 'Conexões do banco' if pt else 'Database connections', 'unit': 'short',
   'expr': 'sum(pgxpool_acquired_connections' ~ j ~ '})', 'legend': 'in use' if not pt else 'em uso',
   'expr2': 'sum(pgxpool_total_connections' ~ j ~ '})', 'legend2': 'open' if not pt else 'abertas'},
  {'title': 'Memória em uso' if pt else 'Memory in use', 'unit': 'bytes',
   'expr': 'sum by (instance) (go_memory_used_bytes' ~ j ~ '})', 'legend': '{{instance}}'},
  {'title': 'Goroutines', 'unit': 'short',
   'expr': 'sum by (instance) (go_goroutine_count' ~ j ~ '})', 'legend': '{{instance}}'},
  {'title': 'Processos no ar (cada subida é um novo)' if pt else 'Processes up (each start is a new one)', 'unit': 'short',
   'expr': 'count(target_info' ~ j ~ '})', 'legend': 'processes'},
  {'row': 'Logs'},
  {'title': 'Erros nos logs' if pt else 'Errors in the logs', 'logs': '{service_name="' ~ app.name ~ '"} |~ "(?i)level=error|\"level\":\"ERROR\"|severity_text=ERROR"'},
] -%}
{
  "uid": "app-{{ app.name }}",
  "title": "{{ app.name }}",
  "tags": ["esquadro", "app"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "panels": [
{%- set y = namespace(v=0, x=0, id=1) %}
{%- for p in panels %}
{%- if p.row is defined %}
{%- if y.x > 0 %}{% set y.v = y.v + 8 %}{% set y.x = 0 %}{% endif %}
    {"id": {{ y.id }}, "type": "row", "title": {{ p.row | tojson }}, "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ y.v }}}, "panels": []}
{%- set y.v = y.v + 1 %}
{%- elif p.logs is defined %}
{%- if y.x > 0 %}{% set y.v = y.v + 8 %}{% set y.x = 0 %}{% endif %}
    {"id": {{ y.id }}, "type": "logs", "title": {{ p.title | tojson }}, "datasource": {"type": "loki", "uid": "loki"},
     "gridPos": {"h": 10, "w": 24, "x": 0, "y": {{ y.v }}},
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
     "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": {{ p.logs | tojson }}}]}
{%- set y.v = y.v + 10 %}
{%- else %}
    {"id": {{ y.id }}, "type": "timeseries", "title": {{ p.title | tojson }}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": {{ y.x }}, "y": {{ y.v }}},
     "fieldConfig": {"defaults": {"unit": {{ p.unit | tojson }}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": {{ p.expr | tojson }}, "legendFormat": {{ p.legend | tojson }}}
{%- if p.expr2 is defined %},
       {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": {{ p.expr2 | tojson }}, "legendFormat": {{ p.legend2 | tojson }}}
{%- endif %}
     ]}
{%- if y.x == 0 %}{% set y.x = 12 %}{% else %}{% set y.x = 0 %}{% set y.v = y.v + 8 %}{% endif %}
{%- endif %}
{%- set y.id = y.id + 1 %}{{ "," if not loop.last }}
{%- endfor %}
  ]
}
