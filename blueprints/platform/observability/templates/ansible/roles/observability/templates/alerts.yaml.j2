# Generated by esquadro: the platform's alerts, by email to its owner.
apiVersion: 1
{% if mail_owner is defined %}
contactPoints:
  - orgId: 1
    name: platform-owner
    receivers:
      - uid: platform-owner-email
        type: email
        settings:
          addresses: {{ mail_owner }}
          singleEmail: true
policies:
  - orgId: 1
    receiver: platform-owner
    group_by: [alertname]
    repeat_interval: 12h
{% endif %}
groups:
  - orgId: 1
    name: platform
    folder: Platform
    interval: 1m
    rules:
      - uid: platform-disk
        title: The server's disk is almost full
        condition: C
        for: 5m
        noDataState: OK
        execErrState: Error
        annotations:
          summary: More than 85% of the server's disk is used.
        data:
          - refId: A
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              instant: true
              expr: >-
                100 * sum(system_filesystem_usage_bytes{mountpoint="/", state="used"})
                / sum(system_filesystem_usage_bytes{mountpoint="/"})
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [85]}
      - uid: platform-memory
        title: The server is out of memory
        condition: C
        for: 10m
        noDataState: OK
        execErrState: Error
        annotations:
          summary: More than 90% of the server's memory has been used for 10 minutes.
        data:
          - refId: A
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              instant: true
              expr: >-
                100 * sum(system_memory_usage_bytes{state="used"})
                / sum(system_memory_usage_bytes)
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [90]}
{% for app in platform_apps %}
      - uid: platform-app-{{ app.name }}
        title: {{ app.name }} is silent
        condition: C
        for: 0s
        noDataState: OK
        execErrState: Error
        annotations:
          summary: {{ app.name }} has sent no telemetry for 10 minutes; it is down, or not deployed yet.
        data:
          - refId: A
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              instant: true
              expr: absent_over_time(target_info{job="{{ app.name }}"}[10m])
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [0]}
{% endfor %}
