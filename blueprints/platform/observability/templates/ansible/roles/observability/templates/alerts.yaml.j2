# Generated by esquadro: the platform's alerts, to its owner by email and,
# with a bot, on Telegram. The bot's token comes from Grafana's environment.
{% set pt = observability_alerts_language == 'pt-BR' %}
{% set telegram = (alerts_telegram_token | default('')) != '' and (alerts_telegram_chat_id | default('')) != '' %}
{% set link = ('https://' ~ observability_grafana_domain) if observability_grafana_domain else 'http://localhost:3000' %}
{% set tunnel = '' if observability_grafana_domain else ' (task grafana)' %}
apiVersion: 1
{% if mail_owner is defined or telegram %}
contactPoints:
  - orgId: 1
    name: platform-owner
    receivers:
{% if mail_owner is defined %}
      - uid: platform-owner-email
        type: email
        settings:
          addresses: {{ mail_owner }}
          singleEmail: true
{% endif %}
{% if telegram %}
      - uid: platform-owner-telegram
        type: telegram
        settings:
          bottoken: ${ALERTS_TELEGRAM_TOKEN}
          chatid: "{{ alerts_telegram_chat_id }}"
          parse_mode: None
{% endif %}
policies:
  - orgId: 1
    receiver: platform-owner
    group_by: [alertname]
    repeat_interval: 12h
    routes:
      # The apps' alerts: one per app and alert, sooner again.
      - receiver: platform-owner
        object_matchers: [["scope", "=", "app"]]
        group_by: [alertname, app]
        group_wait: 30s
        repeat_interval: 4h
{% endif %}
groups:
  - orgId: 1
    name: platform
    folder: Platform
    interval: 1m
    rules:
      - uid: platform-disk
        title: The server's disk is almost full
        condition: C
        for: 5m
        noDataState: OK
        execErrState: Error
        annotations:
          summary: More than 85% of the server's disk is used.
        data:
          - refId: A
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              instant: true
              expr: >-
                100 * sum(system_filesystem_usage_bytes{mountpoint="/", state="used"})
                / sum(system_filesystem_usage_bytes{mountpoint="/"})
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [85]}
      - uid: platform-memory
        title: The server is out of memory
        condition: C
        for: 10m
        noDataState: OK
        execErrState: Error
        annotations:
          summary: More than 90% of the server's memory has been used for 10 minutes.
        data:
          - refId: A
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              instant: true
              expr: >-
                100 * sum(system_memory_usage_bytes{state="used"})
                / sum(system_memory_usage_bytes)
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [90]}
{% for app in platform_apps %}
      - uid: platform-app-{{ app.name }}
        title: {{ app.name }} is silent
        condition: C
        for: 0s
        noDataState: OK
        execErrState: Error
        annotations:
          summary: {{ app.name }} has sent no telemetry for 10 minutes; it is down, or not deployed yet.
        data:
          - refId: A
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              instant: true
              expr: absent_over_time(target_info{job="{{ app.name }}"}[10m])
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [0]}
{% endfor %}
{% for app in platform_apps %}
{% set where = ('Painel: ' if pt else 'Dashboard: ') ~ link ~ '/d/app-' ~ app.name ~ tunnel %}
{% set alerts = [] %}
{% if app.worker %}
{% set alerts = alerts + [
  {'id': 'job-failed', 'for': '0s', 'by': 'kind',
   'title': (app.name ~ ': um job falhou') if pt else (app.name ~ ': a job failed'),
   'summary': ('O job {{ $labels.kind }} falhou {{ $values.A.Value }} vez(es) nos últimos 15 minutos. O erro está nos logs e na tela de jobs do app.' if pt else 'The job {{ $labels.kind }} failed {{ $values.A.Value }} time(s) in the last 15 minutes. The error is in the logs and on the app\'s jobs screen.'),
   'expr': 'round(sum by (kind) (increase(river_work_count_total{job="' ~ app.name ~ '", status="error"}[15m])))', 'gt': 0},
  {'id': 'job-late', 'for': '10m', 'by': 'kind',
   'title': (app.name ~ ': um job agendado está atrasado') if pt else (app.name ~ ': a scheduled job is late'),
   'summary': ('O job {{ $labels.kind }} não roda com sucesso desde o horário previsto. Veja o último erro na tela de jobs do app.' if pt else 'The job {{ $labels.kind }} has not worked since it was due. See its last error on the app\'s jobs screen.'),
   'expr': 'max by (kind) (jobs_periodic_overdue{job="' ~ app.name ~ '"})', 'gt': 0},
  {'id': 'job-retrying', 'for': '1h', 'by': 'kind',
   'title': (app.name ~ ': jobs presos tentando de novo') if pt else (app.name ~ ': jobs stuck retrying'),
   'summary': ('{{ $values.A.Value }} job(s) {{ $labels.kind }} tentando de novo há mais de uma hora.' if pt else '{{ $values.A.Value }} job(s) {{ $labels.kind }} have been retrying for over an hour.'),
   'expr': 'sum by (kind) (jobs_queue{job="' ~ app.name ~ '", state="retryable"})', 'gt': 0},
  {'id': 'job-discarded', 'for': '0s', 'by': 'kind',
   'title': (app.name ~ ': um job foi descartado') if pt else (app.name ~ ': a job was given up'),
   'summary': ('O job {{ $labels.kind }} falhou em todas as tentativas e não será tentado de novo.' if pt else 'The job {{ $labels.kind }} failed every attempt and will not be tried again.'),
   'expr': 'round(sum by (kind) (increase(jobs_discarded_total{job="' ~ app.name ~ '"}[15m])))', 'gt': 0},
  {'id': 'integration', 'for': '5m', 'by': 'integration',
   'title': (app.name ~ ': uma integração não responde') if pt else (app.name ~ ': an integration fails its check'),
   'summary': ('A checagem da integração {{ $labels.integration }} falhou (chave errada, API fora do ar). O erro está nos logs do worker.' if pt else 'The check of {{ $labels.integration }} failed (a wrong key, the API down). The error is in the worker\'s logs.'),
   'expr': 'min by (integration) (integration_check{job="' ~ app.name ~ '"})', 'lt': 1},
] %}
{% endif %}
{% set alerts = alerts + [
  {'id': 'http-errors', 'for': '10m', 'by': '',
   'title': (app.name ~ ': a API está com erros') if pt else (app.name ~ ': the API is failing'),
   'summary': ('Mais de ' ~ ((observability_alerts_http_error_ratio * 100) | round | int) ~ '% das respostas foram 5xx nos últimos 10 minutos.' if pt else 'More than ' ~ ((observability_alerts_http_error_ratio * 100) | round | int) ~ '% of the answers were 5xx in the last 10 minutes.'),
   'expr': '(sum(increase(http_server_request_duration_seconds_count{job="' ~ app.name ~ '", http_response_status_code=~"5.."}[10m])) / sum(increase(http_server_request_duration_seconds_count{job="' ~ app.name ~ '"}[10m]))) and on() (sum(increase(http_server_request_duration_seconds_count{job="' ~ app.name ~ '"}[10m])) >= 20)', 'gt': observability_alerts_http_error_ratio},
  {'id': 'http-slow', 'for': '15m', 'by': '',
   'title': (app.name ~ ': a API está lenta') if pt else (app.name ~ ': the API is slow'),
   'summary': ('95% das respostas levaram até {{ printf "%.2f" $values.A.Value }} s nos últimos 15 minutos (limite: ' ~ observability_alerts_http_p95_seconds ~ ' s).' if pt else '95% of the answers took up to {{ printf "%.2f" $values.A.Value }} s in the last 15 minutes (limit: ' ~ observability_alerts_http_p95_seconds ~ ' s).'),
   'expr': 'histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job="' ~ app.name ~ '"}[15m])))', 'gt': observability_alerts_http_p95_seconds},
  {'id': 'restarts', 'for': '0s', 'by': '',
   'title': (app.name ~ ': o app está reiniciando') if pt else (app.name ~ ': the app keeps restarting'),
   'summary': ('O app subiu {{ $values.A.Value }} vezes nos últimos 30 minutos.' if pt else 'The app started {{ $values.A.Value }} times in the last 30 minutes.'),
   'expr': 'count(count by (instance) (count_over_time(target_info{job="' ~ app.name ~ '"}[30m])))', 'gt': (2 if app.worker else 1) * (1 + observability_alerts_restarts)},
] %}
{% if app.database %}
{% set alerts = alerts + [
  {'id': 'backup', 'for': '0s', 'by': '',
   'title': (app.name ~ ': o backup do banco não rodou') if pt else (app.name ~ ': the database was not backed up'),
   'summary': ('O último backup com sucesso tem mais de ' ~ observability_alerts_backup_hours ~ ' horas. Veja journalctl -u platform-backup no servidor.' if pt else 'The last successful backup is more than ' ~ observability_alerts_backup_hours ~ ' hours old. See journalctl -u platform-backup on the server.'),
   'expr': '(time() - max(last_over_time(platform_backup_last_success{app="' ~ app.name ~ '"}[' ~ (observability_alerts_backup_hours + 1) ~ 'h]))) / 3600', 'gt': observability_alerts_backup_hours},
] %}
{% endif %}
  - orgId: 1
    name: {{ app.name }}
    folder: Apps
    interval: 1m
    rules:
{% for a in alerts %}
      - uid: app-{{ app.name }}-{{ a.id }}
        title: "{{ a.title }}"
        condition: C
        for: {{ a.for }}
        noDataState: OK
        execErrState: Error
        labels:
          scope: app
          app: {{ app.name }}
        annotations:
          summary: "{{ a.summary | replace('"', '\\"') }} {{ where }}"

        data:
          - refId: A
            relativeTimeRange: {from: 1800, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              instant: true
              expr: >-
                {{ a.expr }}
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: {{ 'lt' if a.lt is defined else 'gt' }}, params: [{{ a.lt if a.lt is defined else a.gt }}]}
{% endfor %}
{% endfor %}
