#!/bin/bash
# Generated by esquadro: emails the platform's owner.
#   notify <subject> <body>
# TLS on port 465, STARTTLS on any other: never in the clear.
set -euo pipefail
. /opt/platform/mail/mail.env

subject=${1:?notify <subject> <body>}
body=${2:-}
if [ "$MAIL_PORT" = 465 ]; then
  url="smtps://$MAIL_HOST:$MAIL_PORT"
else
  url="smtp://$MAIL_HOST:$MAIL_PORT"
fi
message=$(mktemp)
trap 'rm -f "$message"' EXIT
{
  printf 'From: %s\r\n' "$MAIL_FROM"
  printf 'To: %s\r\n' "$MAIL_OWNER"
  printf 'Subject: [%s] %s\r\n' "$PLATFORM" "$subject"
  printf 'Date: %s\r\n' "$(date -R)"
  printf 'Content-Type: text/plain; charset=utf-8\r\n\r\n'
  printf '%s\r\n\r\n-- \r\n%s, on %s\r\n' "$body" "$PLATFORM" "$(hostname)"
} > "$message"
curl -sS --ssl-reqd --netrc-file /opt/platform/mail/netrc --url "$url" \
  --mail-from "$MAIL_FROM_ADDRESS" --mail-rcpt "$MAIL_OWNER" --upload-file "$message"
echo "sent to $MAIL_OWNER: $subject"
