# Generated by esquadro: PostgreSQL's settings, sized to the server's
# {{ ansible_facts['memtotal_mb'] }} MB. Yours are in conf.d/local.conf.
listen_addresses = '*'
max_connections = {{ postgres_max_connections }}
shared_buffers = {{ (ansible_facts['memtotal_mb'] * 0.15) | int }}MB
effective_cache_size = {{ (ansible_facts['memtotal_mb'] * 0.4) | int }}MB
maintenance_work_mem = {{ [ (ansible_facts['memtotal_mb'] * 0.03) | int, 64 ] | max }}MB
work_mem = 8MB
wal_buffers = 16MB
random_page_cost = 1.1
effective_io_concurrency = 200
password_encryption = scram-sha-256
log_timezone = 'UTC'
timezone = 'UTC'
include_dir = 'conf.d'
