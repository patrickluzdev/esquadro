# Generated by esquadro: Caddy, the only service that publishes ports.
name: caddy
services:
  caddy:
    image: {{ caddy_image }}
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./etc:/etc/caddy:ro
      - data:/data
      - config:/config
    networks: [platform]
volumes:
  data:
  config:
networks:
  platform:
    name: {{ platform_network }}
    external: true
