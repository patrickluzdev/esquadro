# Generated by esquadro from the platform: your own sites are in sites/.
{
{% if caddy_email %}
	email {{ caddy_email }}
{% endif %}
	servers {
		protocols h1 h2
{% if caddy_cloudflare %}
		trusted_proxies static {{ caddy_cloudflare_ranges | join(' ') }}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
{% endif %}
	}
}

(app) {
{% if caddy_certificates == 'internal' %}
	tls internal
{% endif %}
	encode zstd gzip
	reverse_proxy {args[0]} {
		# The visitor's address, as the app reads it: the last one.
		header_up X-Forwarded-For {client_ip}
		# While an app is replaced, wait for it instead of failing.
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
{% for app in platform_apps if app.domains %}

# {{ app.name }}
{{ app.domains | join(', ') }} {
	import app {{ app.name }}-app:{{ app.port }}
}
{% endfor %}
{% for site in caddy_sites %}

{{ site.domains | join(', ') }} {
	import app {{ site.upstream }}
}
{% endfor %}

import sites/*.caddy
