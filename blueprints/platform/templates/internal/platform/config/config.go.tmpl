// Package config reads the service's configuration from the environment.
package config

import (
	"fmt"
	"os"
	"strconv"
{{- with slot "platform.config.imports" .}}
{{.}}
{{- end}}
)

// Config is the service's configuration.
type Config struct {
	// Env is "production" in production; anything else is development.
	Env  string
	Port int
{{- with slot "platform.config.fields" .}}
{{.}}
{{- end}}
}

// Load reads the configuration from environment variables, with defaults
// that suit development.
func Load() (Config, error) {
	c := Config{Env: get("{{upper .App.Snake}}_ENV", "development")}
	port, err := strconv.Atoi(get("PORT", "{{.Options.port}}"))
	if err != nil {
		return Config{}, fmt.Errorf("config: PORT must be a number: %w", err)
	}
	c.Port = port
{{- with slot "platform.config.load" .}}
{{.}}
{{- end}}
	return c, nil
}

// Addr is the address the server listens on.
func (c Config) Addr() string { return ":" + strconv.Itoa(c.Port) }

// get returns the environment variable name, or fallback when it is unset or
// empty.
func get(name, fallback string) string {
	if v := os.Getenv(name); v != "" {
		return v
	}
	return fallback
}
