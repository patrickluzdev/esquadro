# Generated by esquadro: where the backups go, and no config file.
RCLONE_CONFIG=/dev/null
RCLONE_CONFIG_BUCKET_TYPE=s3
RCLONE_CONFIG_BUCKET_PROVIDER={{ 'Cloudflare' if 'r2.cloudflarestorage.com' in backup_endpoint else 'Other' }}
RCLONE_CONFIG_BUCKET_ENDPOINT={{ backup_endpoint }}
RCLONE_CONFIG_BUCKET_ACCESS_KEY_ID={{ backup_access_key_id }}
RCLONE_CONFIG_BUCKET_SECRET_ACCESS_KEY={{ backup_secret_access_key }}
RCLONE_CONFIG_BUCKET_NO_CHECK_BUCKET=true
# No HEAD after each upload: R2 answers 501 to one that asks for the
# version the upload made.
RCLONE_CONFIG_BUCKET_NO_HEAD=true
BACKUP_BUCKET={{ backup_bucket }}
BACKUP_KEEP_DAYS={{ backup_keep_days }}
