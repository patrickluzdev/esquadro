#!/bin/bash
# Generated by esquadro: backs up each app's database (or one: backup
# <app>) to the bucket, as <app>/<date>.dump, and deletes those older than
# BACKUP_KEEP_DAYS.
set -euo pipefail
set -a
. /opt/platform/backup/rclone.env
set +a

apps=${1:-$(cat /opt/platform/backup/apps)}
failed=0
for app in $apps; do
  name="$app/$(date -u +%Y-%m-%dT%H%M%SZ).dump"
  if docker exec postgres pg_dump -U postgres -Fc "${app//-/_}" | rclone rcat "bucket:$BACKUP_BUCKET/$name"; then
    echo "backed up $app: $name"
  else
    echo "failed to back up $app" >&2
    failed=1
  fi
done
rclone delete --min-age "${BACKUP_KEEP_DAYS}d" "bucket:$BACKUP_BUCKET"
exit $failed
