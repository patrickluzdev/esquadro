#!/bin/bash
# Generated by esquadro: lists an app's backups (restore <app>), or puts
# one back (restore <app> <name>), with the app stopped meanwhile.
set -euo pipefail
set -a
. /opt/platform/backup/rclone.env
set +a

app=${1:?restore <app> [<backup>]}
[[ $app =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "restore: $app is not an app's name" >&2; exit 1; }
if [ -z "${2:-}" ]; then
  rclone lsf "bucket:$BACKUP_BUCKET/$app/" | sort
  exit 0
fi
backup=${2##*/}
[[ $backup =~ ^[0-9TZ-]+\.dump$ ]] || { echo "restore: $backup is not a backup's name" >&2; exit 1; }

dir=/opt/platform/apps/$app
running=$(sed -n 's/^VERSION=//p' "$dir/.env")
[ -n "$running" ] && (cd "$dir" && docker compose stop)
trap '[ -n "$running" ] && (cd "$dir" && docker compose start)' EXIT
rclone cat "bucket:$BACKUP_BUCKET/$app/$backup" |
  docker exec -i postgres pg_restore -U postgres --clean --if-exists --no-owner --role="${app//-/_}" -d "${app//-/_}"
echo "restored $app from $backup"
