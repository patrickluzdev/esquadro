# Generated by esquadro: the CI of {{.App.Label}}. It checks the code and
# never touches the servers: task apply runs from your machine.
name: ci

on:
  push:
    branches: [main]
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]

concurrency:
  group: ci-{{"${{"}} github.event.pull_request.number || github.ref {{"}}"}}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  check:
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7.0.1
      - uses: actions/setup-go@v7.0.0
        with:
          go-version: "{{goVersion}}"
      - name: The generated files are what the model generates
        run: |
          version=$(jq -r .esquadro esquadro/lock.json)
          case "$version" in v*) ;; *) version=latest ;; esac
          go install github.com/patrickluzdev/esquadro/cmd/esquadro@"$version"
          esquadro gen -check
      - uses: actions/setup-python@v7.1.0
        with:
          python-version: "3.13"
      - name: The playbooks
        env:
          ANSIBLE_CONFIG: ansible/ansible.cfg
        run: |
          pip install --quiet ansible-core ansible-lint
          ansible-galaxy collection install -r ansible/requirements.yml
          ansible-playbook ansible/site.yml --syntax-check
          ansible-lint ansible/
{{- if uses "cloudflare"}}
      - uses: opentofu/setup-opentofu@v2.0.2
        with:
          tofu_wrapper: false
      - name: The OpenTofu code
        working-directory: tofu
        env:
          # Only to read the configuration: the state is not opened.
          TF_VAR_state_passphrase: ci-only-validation-passphrase
        run: |
          tofu fmt -check -recursive
          tofu init -input=false
          tofu validate
{{- end}}
