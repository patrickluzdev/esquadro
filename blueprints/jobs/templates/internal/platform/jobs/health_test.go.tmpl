package jobs

import (
	"testing"
	"time"

	"github.com/robfig/cron/v3"
)

func TestLate(t *testing.T) {
	daily, err := cron.ParseStandard("0 0 * * *")
	if err != nil {
		t.Fatal(err)
	}
	at := func(s string) time.Time {
		v, err := time.Parse(time.RFC3339, s)
		if err != nil {
			t.Fatal(err)
		}
		return v
	}
	started := at("2026-11-20T10:00:00Z")
	for _, c := range []struct {
		name        string
		lastSuccess string
		now         string
		want        bool
	}{
		{"worked last night", "2026-11-25T00:00:05Z", "2026-11-25T20:00:00Z", false},
		{"missed tonight, within half a day", "2026-11-25T00:00:05Z", "2026-11-26T11:00:00Z", false},
		{"missed tonight, half a day later", "2026-11-25T00:00:05Z", "2026-11-26T12:30:00Z", true},
		{"never worked, before its first run", "", "2026-11-20T23:00:00Z", false},
		{"never worked, its first run missed", "", "2026-11-21T13:00:00Z", true},
	} {
		var last time.Time
		if c.lastSuccess != "" {
			last = at(c.lastSuccess)
		}
		if got := Late(daily, last, started, at(c.now)); got != c.want {
			t.Errorf("%s: %v", c.name, got)
		}
	}
}
