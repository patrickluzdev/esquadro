{{- if .Module.Jobs -}}
package {{.Module.Snake}}

import (
	"context"

	"{{.App.Module}}/internal/platform/jobs"
)

// CancelJob cancels a job of the module enqueued with an Enqueue...At, if
// it has not run yet.
func (m *{{.Module.Pascal}}) CancelJob(ctx context.Context, id int64) error {
	return m.Jobs.Cancel(ctx, id)
}

// RegisterJobs registers the work of the module's jobs, and the schedules of
// the periodic ones.
func (m *{{.Module.Pascal}}) RegisterJobs(r *jobs.Registry) {
{{- range .Module.Jobs}}{{$j := .}}
	jobs.Add(r, m.work{{.Pascal}})
{{- with index (ann .) "every"}}
	jobs.Every(r, {{quote .}}, {{$j.Pascal}}Args{}.WithDefaults())
{{- end}}
{{- end}}
}
{{end -}}
