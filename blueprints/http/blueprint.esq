/// The HTTP server: the serve command, run without arguments too, the
/// routes with /healthz (the process lives) and /readyz (it can serve: its
/// database answers), graceful shutdown, and package edge, which every
/// request goes through: a request ID, an access log, panics answered as
/// 500, errors as Problem Details (RFC 9457), and not_found for unknown
/// addresses. Other blueprints add routes and middleware.
blueprint http {
  version "0.1.0"

  /// The port the HTTP server listens on.
  env PORT int default("{{.Options.port}}")
  /// Take the client's address from X-Forwarded-For.
  env TRUST_PROXY bool prefixed default("{{.Options.trust_proxy}}")
  requires app

  /// Port the server listens on; PORT overrides it.
  option port int default(8080)
  /// Take the client's address from X-Forwarded-For, for the log and the
  /// rate limit; only behind a proxy that sets it. <APP>_TRUST_PROXY
  /// overrides it.
  option trust_proxy bool default(false)

  /// Imports of cmd/<app>/routes.go.
  slot "http.routes.imports"
  /// Routes, registered on mux; d is the dependencies, and an error is
  /// returned as nil, err.
  slot "http.routes"
  /// Middleware that sets the request's context before anything answers,
  /// one per line ending with a comma, e.g. edge.Localize,.
  slot "http.middleware.context"
  /// Middleware every request goes through, inside the access log and the
  /// panic recovery, one per line ending with a comma.
  slot "http.middleware"
  /// Code in edge.DocumentOf that changes a problem's title for the
  /// request of ctx: title holds it, p is the problem.
  slot "http.problem.title"
  /// What /readyz checks, one per line: {"postgres", d.pool.Ping}, with a
  /// name and a func(context.Context) error; d is the dependencies.
  slot "http.ready"
}
