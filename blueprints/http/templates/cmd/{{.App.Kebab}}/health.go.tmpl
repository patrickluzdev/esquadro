package main

import (
	"context"
	"fmt"
	"net/http"
	"time"

	"{{.App.Module}}/internal/platform/config"
)

// health asks the running service whether it answers: a GET of /healthz on
// the configured port, for a container's health check. It fails when the
// service does not answer 204 within two seconds.
func health(ctx context.Context) error {
	cfg, err := config.Load()
	if err != nil {
		return err
	}
	ctx, cancel := context.WithTimeout(ctx, 2*time.Second)
	defer cancel()
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, fmt.Sprintf("http://localhost:%d/healthz", cfg.Port), nil)
	if err != nil {
		return err
	}
	res, err := http.DefaultClient.Do(req)
	if err != nil {
		return fmt.Errorf("health: %w", err)
	}
	defer res.Body.Close()
	if res.StatusCode != http.StatusNoContent {
		return fmt.Errorf("health: /healthz answered %s", res.Status)
	}
	return nil
}
