package edge

import (
	"net/http/httptest"
	"strings"
	"testing"
)

func TestCORSAnswersAllowedOriginsOnly(t *testing.T) {
	t.Parallel()
	h := CORS([]string{"https://app.example.com"})(noContent)
	for origin, allowed := range map[string]bool{"https://app.example.com": true, "https://evil.example.com": false} {
		req := httptest.NewRequest("OPTIONS", "/", nil)
		req.Header.Set("Origin", origin)
		req.Header.Set("Access-Control-Request-Method", "POST")
		rec := serve(h, req)
		if rec.Code != 204 || (rec.Header().Get("Access-Control-Allow-Origin") == origin) != allowed {
			t.Errorf("preflight from %s: %d %v", origin, rec.Code, rec.Header())
		}
		if allowed && rec.Header().Get("Access-Control-Allow-Credentials") != "true" {
			t.Errorf("an allowed origin sends its cookies: %v", rec.Header())
		}
		// What a client sends to change safely, and reads back.
		if allowed && (!strings.Contains(rec.Header().Get("Access-Control-Allow-Headers"), "If-Match") ||
			!strings.Contains(rec.Header().Get("Access-Control-Allow-Headers"), "Idempotency-Key") ||
			!strings.Contains(rec.Header().Get("Access-Control-Expose-Headers"), "ETag")) {
			t.Errorf("the headers of safe writes: %v", rec.Header())
		}
	}
	// Any origin, but without cookies.
	req := httptest.NewRequest("GET", "/", nil)
	req.Header.Set("Origin", "https://any.example.com")
	if rec := serve(CORS([]string{"*"})(noContent), req); rec.Header().Get("Access-Control-Allow-Origin") != "*" || rec.Header().Get("Access-Control-Allow-Credentials") != "" {
		t.Errorf("any origin: %v", rec.Header())
	}
}
