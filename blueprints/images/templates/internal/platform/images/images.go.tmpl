// The size of an Open Graph image, as the sites that show shared links
// ask for it.
const (
	OGWidth  = 1200
	OGHeight = 630
)

// Theme is what a canvas draws with: colors by role (page, surface, ink,
// muted, accent, on_accent, line, and any of a brand's own) and fonts by
// name (display, body).
type Theme struct {
	Colors map[string]string
	Fonts  Fonts
}

// Canvas is an image being drawn.
type Canvas struct {
	img   *image.RGBA
	theme Theme
	faces map[faceKey]font.Face
}

// New is a canvas of width by height pixels, transparent, that draws with
// theme; its fonts are the Go fonts where theme has none.
func New(width, height int, theme Theme) *Canvas {
	if theme.Fonts == nil {
		theme.Fonts = Fonts{}
	}
	for name, f := range GoFonts() {
		if theme.Fonts[name] == nil {
			theme.Fonts[name] = f
		}
	}
	return &Canvas{img: image.NewRGBA(image.Rect(0, 0, width, height)), theme: theme, faces: map[faceKey]font.Face{}}
}

// Bounds is the canvas's rectangle, from (0, 0).
func (c *Canvas) Bounds() image.Rectangle { return c.img.Bounds() }

// Image is what was drawn, to draw on it with image/draw too.
func (c *Canvas) Image() *image.RGBA { return c.img }

// Color is a color of the theme by role, black when it has none.
func (c *Canvas) Color(role string) color.RGBA {
	if s, ok := c.theme.Colors[role]; ok {
		if col, err := Hex(s); err == nil {
			return col
		}
	}
	return color.RGBA{A: 255}
}

// Hex reads a color written #rgb or #rrggbb, with an alpha (#rrggbbaa)
// too.
func Hex(s string) (color.RGBA, error) {
	h := strings.TrimPrefix(strings.TrimSpace(s), "#")
	if len(h) == 3 {
		h = string([]byte{h[0], h[0], h[1], h[1], h[2], h[2]})
	}
	if len(h) == 6 {
		h += "ff"
	}
	n, err := strconv.ParseUint(h, 16, 32)
	if len(h) != 8 || err != nil {
		return color.RGBA{}, fmt.Errorf("images: %q is not a color: #rgb or #rrggbb", s)
	}
	a := uint8(n)
	// color.RGBA holds colors premultiplied by their alpha.
	pre := func(v uint8) uint8 { return uint8(uint32(v) * uint32(a) / 255) }
	return color.RGBA{R: pre(uint8(n >> 24)), G: pre(uint8(n >> 16)), B: pre(uint8(n >> 8)), A: a}, nil
}

// Fill paints the whole canvas.
func (c *Canvas) Fill(col color.Color) {
	draw.Draw(c.img, c.img.Bounds(), image.NewUniform(col), image.Point{}, draw.Src)
}

// Rect paints a rectangle, its corners rounded by radius pixels (0, square;
// at most half its shorter side).
func (c *Canvas) Rect(r image.Rectangle, col color.Color, radius float64) {
	r = r.Intersect(c.img.Bounds())
	if r.Empty() {
		return
	}
	if radius <= 0 {
		draw.Draw(c.img, r, image.NewUniform(col), image.Point{}, draw.Over)
		return
	}
	draw.DrawMask(c.img, r, image.NewUniform(col), image.Point{}, roundedMask(r.Dx(), r.Dy(), radius), image.Point{}, draw.Over)
}

// roundedMask is the alpha of a w by h rectangle with round corners,
// smooth at its edges.
func roundedMask(w, h int, radius float64) *image.Alpha {
	rad := float32(math.Min(radius, math.Min(float64(w), float64(h))/2))
	W, H := float32(w), float32(h)
	// The control points of a quarter circle drawn as a cubic curve.
	k := rad * 0.5523
	z := vector.NewRasterizer(w, h)
	z.MoveTo(rad, 0)
	z.LineTo(W-rad, 0)
	z.CubeTo(W-rad+k, 0, W, rad-k, W, rad)
	z.LineTo(W, H-rad)
	z.CubeTo(W, H-rad+k, W-rad+k, H, W-rad, H)
	z.LineTo(rad, H)
	z.CubeTo(rad-k, H, 0, H-rad+k, 0, H-rad)
	z.LineTo(0, rad)
	z.CubeTo(0, rad-k, rad-k, 0, rad, 0)
	z.ClosePath()
	mask := image.NewAlpha(image.Rect(0, 0, w, h))
	z.Draw(mask, mask.Bounds(), image.Opaque, image.Point{})
	return mask
}

// Fit is how a picture takes a box.
type Fit int

const (
	// Contain shows all of the picture, as large as the box lets it,
	// centered in it.
	Contain Fit = iota
	// Cover fills the box, cutting what of the picture is left out,
	// centered.
	Cover
)

// Picture draws img in the box r, contained or covering it, with corners
// rounded by radius; it answers the rectangle it took.
func (c *Canvas) Picture(r image.Rectangle, img image.Image, fit Fit, radius float64) image.Rectangle {
	src := img.Bounds()
	if r.Empty() || src.Empty() {
		return image.Rectangle{}
	}
	sx, sy := float64(r.Dx())/float64(src.Dx()), float64(r.Dy())/float64(src.Dy())
	scale := math.Min(sx, sy)
	if fit == Cover {
		scale = math.Max(sx, sy)
	}
	w, h := int(math.Round(float64(src.Dx())*scale)), int(math.Round(float64(src.Dy())*scale))
	at := image.Rect(0, 0, w, h).Add(image.Pt(r.Min.X+(r.Dx()-w)/2, r.Min.Y+(r.Dy()-h)/2))
	took := at.Intersect(r).Intersect(c.img.Bounds())
	if took.Empty() {
		return image.Rectangle{}
	}
	// Scaled onto a layer of its own, then laid on the canvas through the
	// rounded mask.
	layer := image.NewRGBA(image.Rect(0, 0, took.Dx(), took.Dy()))
	xdraw.CatmullRom.Scale(layer, at.Sub(took.Min), img, src, xdraw.Over, nil)
	if radius <= 0 {
		draw.Draw(c.img, took, layer, image.Point{}, draw.Over)
	} else {
		draw.DrawMask(c.img, took, layer, image.Point{}, roundedMask(took.Dx(), took.Dy(), radius), image.Point{}, draw.Over)
	}
	return took
}

// Decode reads a picture: PNG, JPEG, GIF (its first frame) or WebP.
func Decode(data []byte) (image.Image, error) {
	img, _, err := image.Decode(bytes.NewReader(data))
	if err != nil {
		return nil, fmt.Errorf("images: %w", err)
	}
	return img, nil
}

// maxFetch is the largest picture Fetch reads.
const maxFetch = 10 << 20

// Fetch reads the picture at an address (http or https), waiting at most
// 10 seconds for it.
func Fetch(ctx context.Context, url string) (image.Image, error) {
	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
	defer cancel()
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
	if err != nil {
		return nil, fmt.Errorf("images: %w", err)
	}
	if req.URL.Scheme != "http" && req.URL.Scheme != "https" {
		return nil, errors.New("images: fetch only http and https addresses")
	}
	res, err := http.DefaultClient.Do(req)
	if err != nil {
		return nil, fmt.Errorf("images: %w", err)
	}
	defer res.Body.Close()
	if res.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("images: %s answered %d", req.URL.Redacted(), res.StatusCode)
	}
	data, err := io.ReadAll(io.LimitReader(res.Body, maxFetch+1))
	if err != nil {
		return nil, fmt.Errorf("images: %w", err)
	}
	if len(data) > maxFetch {
		return nil, fmt.Errorf("images: %s is larger than %d bytes", req.URL.Redacted(), maxFetch)
	}
	return Decode(data)
}

// PNG is the canvas as a PNG.
func (c *Canvas) PNG() ([]byte, error) {
	var b bytes.Buffer
	if err := (&png.Encoder{CompressionLevel: png.BestSpeed}).Encode(&b, c.img); err != nil {
		return nil, fmt.Errorf("images: %w", err)
	}
	return b.Bytes(), nil
}
