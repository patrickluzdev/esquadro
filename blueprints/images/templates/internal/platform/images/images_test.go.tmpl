func TestWrapBreaksAtSpacesAndInsideLongWords(t *testing.T) {
	c := New(400, 200, theme)
	face := c.face("body", 20)
	lines, cut := Wrap(face, "a few short words that do not fit in one line of this width", 200, 0)
	if cut || len(lines) < 3 {
		t.Fatalf("lines %q, cut %v", lines, cut)
	}
	for _, l := range lines {
		if w := widthOf(c, l, 20); w > 200 {
			t.Fatalf("line %q is %dpx, wider than 200", l, w)
		}
	}
	long, _ := Wrap(face, strings.Repeat("x", 80), 100, 0)
	if len(long) < 2 || strings.Join(long, "") != strings.Repeat("x", 80) {
		t.Fatalf("a long word: %q", long)
	}
	paras, _ := Wrap(face, "one\ntwo", 400, 0)
	if len(paras) != 2 {
		t.Fatalf("a line break: %q", paras)
	}
}

func TestWrapCutsWithAnEllipsis(t *testing.T) {
	c := New(400, 200, theme)
	face := c.face("body", 20)
	lines, cut := Wrap(face, strings.Repeat("word ", 60), 200, 2)
	if !cut || len(lines) != 2 || !strings.HasSuffix(lines[1], "…") {
		t.Fatalf("lines %q, cut %v", lines, cut)
	}
	if w := widthOf(c, lines[1], 20); w > 200 {
		t.Fatalf("the cut line is %dpx", w)
	}
}

func TestLayoutShrinksBeforeCutting(t *testing.T) {
	c := New(600, 300, theme)
	title := "A title long enough to need a smaller size"
	b := c.Layout(title, 600, 0, Text{Size: 64, MinSize: 24, MaxLines: 2})
	if b.Cut || b.Size >= 64 || len(b.Lines) > 2 {
		t.Fatalf("block %+v", b)
	}
	tight := c.Layout(title, 600, 50, Text{Size: 40, Line: 1.2})
	if len(tight.Lines) != 1 || !tight.Cut {
		t.Fatalf("a box of one line: %+v", tight)
	}
	none := c.Layout(title, 600, 10, Text{Size: 40})
	if len(none.Lines) != 0 {
		t.Fatalf("a box too short: %+v", none)
	}
}

func TestTextStaysInItsBox(t *testing.T) {
	c := New(500, 300, theme)
	c.Fill(c.Color("page"))
	box := image.Rect(50, 50, 450, 150)
	took := c.Text(box, strings.Repeat("Overflowing text ", 30), Text{Font: "display", Size: 36})
	if took.Empty() || !took.In(box) {
		t.Fatalf("took %v of %v", took, box)
	}
	white := color.RGBA{255, 255, 255, 255}
	img := c.Image()
	for y := 0; y < 300; y++ {
		for x := 0; x < 500; x++ {
			if !image.Pt(x, y).In(box) && img.RGBAAt(x, y) != white {
				t.Fatalf("ink at (%d, %d), out of %v", x, y, box)
			}
		}
	}
}

func TestPNGIsOfItsSize(t *testing.T) {
	c := New(OGWidth, OGHeight, theme)
	c.Fill(c.Color("page"))
	c.Rect(image.Rect(100, 100, 300, 200), c.Color("accent"), 24)
	data, err := c.PNG()
	if err != nil {
		t.Fatal(err)
	}
	img, err := png.Decode(bytes.NewReader(data))
	if err != nil {
		t.Fatal(err)
	}
	if b := img.Bounds(); b.Dx() != OGWidth || b.Dy() != OGHeight {
		t.Fatalf("size %v", b)
	}
	// A round corner leaves the page's color; the middle is the accent.
	if r, g, b, _ := img.At(101, 101).RGBA(); r>>8 != 255 || g>>8 != 255 || b>>8 != 255 {
		t.Fatalf("the corner is painted: %v", img.At(101, 101))
	}
	if got := color.RGBAModel.Convert(img.At(200, 150)); got != c.Color("accent") {
		t.Fatalf("the middle is %v", got)
	}
}

func TestPictureContainsAndCovers(t *testing.T) {
	src := image.NewRGBA(image.Rect(0, 0, 200, 100))
	c := New(400, 400, theme)
	if took := c.Picture(image.Rect(0, 0, 400, 400), src, Contain, 0); took != image.Rect(0, 100, 400, 300) {
		t.Fatalf("contained in %v", took)
	}
	if took := c.Picture(image.Rect(0, 0, 400, 400), src, Cover, 12); took != image.Rect(0, 0, 400, 400) {
		t.Fatalf("covering %v", took)
	}
}

func TestHex(t *testing.T) {
	for in, want := range map[string]color.RGBA{"#fff": {255, 255, 255, 255}, "#2a85ff": {0x2a, 0x85, 0xff, 255}, "#00000080": {0, 0, 0, 0x80}} {
		if got, err := Hex(in); err != nil || got != want {
			t.Errorf("Hex(%q) = %v, %v; want %v", in, got, err, want)
		}
	}
	if _, err := Hex("blue"); err == nil {
		t.Error("blue is a color")
	}
}

func TestLoadFonts(t *testing.T) {
	fsys := fstest.MapFS{"fonts/Body.ttf": {Data: goregular.TTF}, "fonts/Display.woff2": {Data: []byte("wOF2")}}
	fonts, err := LoadFonts(fsys, map[string]string{"body": "fonts/Body.ttf", "display": "fonts/Display.woff2"})
	if fonts["body"] == nil || fonts["display"] != nil || err == nil || !strings.Contains(err.Error(), "display") {
