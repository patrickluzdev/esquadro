func TestCacheKeepsAndReplaces(t *testing.T) {
	ctx := context.Background()
	store, err := storage.Open(ctx, storage.Config{URL: "mem://"}, nil)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { store.Close() })
	cache := Cache{Store: store}
	draws := 0
	draw := func(b byte) func() ([]byte, error) {
		return func() ([]byte, error) { draws++; return []byte{b}, nil }
	}
	if data, hit, err := cache.PNG(ctx, "images/x/1", "v1", draw(1)); err != nil || hit || data[0] != 1 {
		t.Fatalf("first: %v %v %v", data, hit, err)
	}
	if data, hit, err := cache.PNG(ctx, "images/x/1", "v1", draw(9)); err != nil || !hit || data[0] != 1 || draws != 1 {
		t.Fatalf("again: %v %v %v, %d draws", data, hit, err, draws)
	}
	if data, hit, _ := cache.PNG(ctx, "images/x/1", "v2", draw(2)); hit || data[0] != 2 {
		t.Fatalf("a new version: %v %v", data, hit)
	}
	if _, ok, _ := store.Object(ctx, "images/x/1/v1.png"); ok {
		t.Fatal("the older version is still kept")
	}
	if _, _, err := cache.PNG(ctx, "images/x/2", "v1", func() ([]byte, error) { return nil, errors.New("broken") }); err == nil {
		t.Fatal("a drawing that fails is served")
	}
}

// widthOf is how wide a line is, in pixels, in the body font at size.
func widthOf(c *Canvas, line string, size float64) int {
	return font.MeasureString(c.face("body", size), line).Ceil()
}
