// Cache keeps the images drawn in the store, to serve them again without
// drawing them: each under a folder of its own (a record's), by a name
// that changes with what it is drawn from (the record's updated_at, the
// drawing's version).
type Cache struct {
	Store *storage.Store
	// Logger says what the store could not read or keep: the image is
	// drawn and served all the same.
	Logger *slog.Logger
}

// PNG is the image kept in folder under name, or, when there is none, the
// one draw makes, kept there in place of the folder's others. hit says
// whether it was kept already.
func (c Cache) PNG(ctx context.Context, folder, name string, draw func() ([]byte, error)) (data []byte, hit bool, err error) {
	folder = strings.TrimSuffix(folder, "/") + "/"
	key := folder + name + ".png"
	if c.Store != nil {
		data, ok, err := c.Store.Object(ctx, key)
		if err == nil && ok {
			return data, true, nil
		}
		if err != nil {
			c.log(ctx, "images: reading the cache", key, err)
		}
	}
	data, err = draw()
	if err != nil {
		return nil, false, err
	}
	if c.Store != nil {
		if err := c.Store.PutObject(ctx, key, data, "image/png"); err != nil {
			c.log(ctx, "images: keeping in the cache", key, err)
		} else if err := c.Store.DeleteObjects(ctx, folder, key); err != nil {
			c.log(ctx, "images: deleting older versions", key, err)
		}
	}
	return data, false, nil
}

func (c Cache) log(ctx context.Context, msg, key string, err error) {
	if c.Logger != nil {
		c.Logger.WarnContext(ctx, msg, "key", key, "error", err)
	}
}
