// Wrap breaks s into lines of at most width pixels in face: at spaces, and
// inside a word longer than a line; a line break of s starts a new line.
// With more than most lines (0, any number), it keeps most, the last one
// ending in an ellipsis, and says it cut.
func Wrap(face font.Face, s string, width, most int) (lines []string, cut bool) {
	fits := func(line string) bool { return font.MeasureString(face, line).Ceil() <= width }
	for _, para := range strings.Split(strings.ReplaceAll(s, "\r\n", "\n"), "\n") {
		line := ""
		for _, word := range strings.Fields(para) {
			if line != "" && fits(line+" "+word) {
				line += " " + word
				continue
			}
			if line != "" {
				lines = append(lines, line)
			}
			line = word
			// A word longer than a line goes on in the next.
			for !fits(line) && utf8.RuneCountInString(line) > 1 {
				head := longestFit(line, fits)
				lines = append(lines, head)
				line = line[len(head):]
			}
		}
		if line != "" {
			lines = append(lines, line)
		}
	}
	if most <= 0 || len(lines) <= most {
		return lines, false
	}
	lines = lines[:most]
	if most > 0 {
		lines[most-1] = ellipsis(face, lines[most-1], fits)
	}
	return lines, true
}

// longestFit is the longest beginning of s that fits, a character at
// least.
func longestFit(s string, fits func(string) bool) string {
	_, first := utf8.DecodeRuneInString(s)
	end := first
	for i := range s {
		if i > 0 && fits(s[:i]) {
			end = i
		} else if i > 0 {
			break
		}
	}
	return s[:end]
}

// ellipsis ends a line in an ellipsis that fits: "…", or "..." in a font
// without it.
func ellipsis(face font.Face, line string, fits func(string) bool) string {
	mark := "…"
	if _, ok := face.GlyphAdvance('…'); !ok {
		mark = "..."
	}
	for line != "" && !fits(line+mark) {
		_, size := utf8.DecodeLastRuneInString(line)
		line = line[:len(line)-size]
	}
	return strings.TrimRight(line, " ,.;:-–—") + mark
}
