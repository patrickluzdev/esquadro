		lineH := size * t.Line
		most := t.MaxLines
		if height > 0 {
			fit := int(math.Floor(float64(height)/lineH + 1e-9))
			if fit < 1 {
				// Not a line fits: smaller, or nothing.
				if size <= t.MinSize {
					return Block{Size: size, Cut: strings.TrimSpace(s) != ""}
				}
				size = math.Max(t.MinSize, size-2)
