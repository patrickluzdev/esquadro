package edge

import (
	"context"
	"fmt"
	"mime"
	"net/http"
	"strconv"
	"strings"
{{- if uses "rate_limit"}}
	"time"
{{- end}}
)

var (
	// ErrInvalidRequest is a request that does not match the contract.
	ErrInvalidRequest = &Problem{Status: 400, Code: "invalid_request", Title: "The request does not match the API's contract."}
	// ErrMethodNotAllowed is a method the address does not take.
	ErrMethodNotAllowed = &Problem{Status: 405, Code: "method_not_allowed", Title: "This address does not take that method."}
	// ErrNotAcceptable is an Accept header that leaves out JSON.
	ErrNotAcceptable = &Problem{Status: 406, Code: "not_acceptable", Title: "The API answers only in JSON."}
	// ErrRequestTooLarge is a body over the limit.
	ErrRequestTooLarge = &Problem{Status: 413, Code: "request_too_large", Title: "The request body is too large."}
	// ErrUnsupportedMediaType is a body that is not JSON.
	ErrUnsupportedMediaType = &Problem{Status: 415, Code: "unsupported_media_type", Title: "Send the request body as application/json."}
	// ErrNotImplemented is an operation of the contract nobody implemented.
	ErrNotImplemented = &Problem{Status: 501, Code: "not_implemented", Title: "The operation is not implemented."}
)

// Conflict is a request the current state of the records refuses.
func Conflict(code, title string) *Problem { return &Problem{Status: 409, Code: code, Title: title} }

// Broken is a business rule of the app that refuses a request: its own
// code (daily_limit), what it tells people, and the fields it is about.
func Broken(code, title string, fields []FieldProblem) *Problem {
	return &Problem{Status: 422, Code: code, Title: title, Errors: fields}
}

// InvalidFields lists every field refused at once.
func InvalidFields(fields []FieldProblem) *Problem {
	return &Problem{Status: 422, Code: "invalid_fields", Title: "Some fields are not valid.", Errors: fields}
}

// ImportRefused lists every field refused in an import, each with its
// row: nothing was stored.
func ImportRefused(fields []FieldProblem) *Problem {
	return &Problem{Status: 422, Code: "import_refused", Title: "Some rows are not valid: nothing was imported.", Errors: fields}
}

// TooManyRows is an import of more than max rows.
func TooManyRows(max int) *Problem {
	return &Problem{Status: 422, Code: "too_many_rows", Title: fmt.Sprintf("An import takes %d rows at most.", max)}
}

// TooManyRecords is a list without pagination that has more than max
// records: it answers none, rather than some as if they were all.
func TooManyRecords(what string, max int) *Problem {
	return &Problem{Status: 422, Code: "too_many_records", Title: fmt.Sprintf("More than %d %s: turn pagination on for them.", max, what)}
}

// LimitBody refuses a body over max bytes with ErrRequestTooLarge; 0 turns
// it off. Operations see a body cut at the limit fail to decode, which the
// API answers with the same problem.
func LimitBody(max int64) Middleware {
	return func(next http.Handler) http.Handler {
		if max <= 0 {
			return next
		}
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if r.ContentLength > max {
				Write(w, r, ErrRequestTooLarge)
				return
			}
			r.Body = http.MaxBytesReader(w, r.Body, max)
			next.ServeHTTP(w, r)
		})
	}
}

// JSONOnly refuses, before the operation, an Accept header that leaves out
// JSON (ErrNotAcceptable) and a body that is not JSON
// (ErrUnsupportedMediaType).
func JSONOnly(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if accept := r.Header.Get("Accept"); accept != "" && !acceptsJSON(accept) {
			Write(w, r, ErrNotAcceptable)
			return
		}
		if r.ContentLength != 0 && r.Method != http.MethodGet && r.Method != http.MethodDelete {
			media, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
			if err != nil || media != "application/json" {
				Write(w, r, ErrUnsupportedMediaType)
				return
			}
		}
		next.ServeHTTP(w, r)
	})
}

// acceptsJSON reports whether an Accept header takes JSON or Problem
// Details.
func acceptsJSON(accept string) bool {
	for part := range strings.SplitSeq(accept, ",") {
		media, params, _ := strings.Cut(strings.TrimSpace(part), ";")
		if strings.ReplaceAll(strings.TrimSpace(params), " ", "") == "q=0" {
			continue
		}
		switch strings.ToLower(strings.TrimSpace(media)) {
		case "*/*", "application/*", "application/json", "application/problem+json":
			return true
		}
	}
	return false
}

// The problems of If-Match: a version that is no longer the record's, and
// a change without one where the API asks for it.
var (
	ErrPreconditionFailed   = &Problem{Status: 412, Code: "precondition_failed", Title: "The record changed since you read it: read it again."}
	ErrPreconditionRequired = &Problem{Status: 428, Code: "precondition_required", Title: "Send If-Match with the ETag of the record you read."}
)

// Emptied is a change to the zero value of what p's type holds: what a
// PATCH sends as null.
func Emptied[T any](*T) *T { return new(T) }

// MaxIncluded is the most related records of a many-to-many relation an
// include answers per record.
const MaxIncluded = 100

// Unset leaves out of an answer the field p points at.
func Unset[T any](p *T) {
	var zero T
	*p = zero
}

type headersKey struct{}

// ResponseHeaders lets an operation set headers of its response that the
// contract does not declare, such as ETag: ogen writes only the declared
// ones.
func ResponseHeaders(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		next.ServeHTTP(w, r.WithContext(context.WithValue(r.Context(), headersKey{}, w.Header())))
	})
}

// SetETag sets the ETag of the response to the request of ctx: the
// version of the record it answers.
func SetETag(ctx context.Context, version int) {
	if h, ok := ctx.Value(headersKey{}).(http.Header); ok {
		h.Set("ETag", `"`+strconv.Itoa(version)+`"`)
	}
}
{{- if uses "rate_limit"}}

// SetRetryAfter sets Retry-After of the response to the request of ctx:
// the seconds, rounded up, to wait before trying again.
func SetRetryAfter(ctx context.Context, wait time.Duration) {
	if h, ok := ctx.Value(headersKey{}).(http.Header); ok {
		h.Set("Retry-After", strconv.Itoa(int((wait+time.Second-1)/time.Second)))
	}
}
{{- end}}

// IfMatch is the version an If-Match header asks for: 0 for any (absent,
// or *), or ErrPreconditionRequired when required and absent. A weak or
// malformed tag matches no version.
func IfMatch(header string, set, required bool) (int, error) {
	switch {
	case !set || header == "":
		if required {
			return 0, ErrPreconditionRequired
		}
		return 0, nil
	case strings.TrimSpace(header) == "*":
		return 0, nil
	}
	tag := strings.TrimSpace(header)
	if !strings.HasPrefix(tag, `"`) || !strings.HasSuffix(tag, `"`) || len(tag) < 3 {
		return 0, ErrPreconditionFailed
	}
	v, err := strconv.Atoi(tag[1 : len(tag)-1])
	if err != nil || v < 1 {
		return 0, ErrPreconditionFailed
	}
	return v, nil
}
