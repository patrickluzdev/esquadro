package edge

import (
	"strings"
	"testing"
)

func TestHTMLKeepsWhatAnEditorMakes(t *testing.T) {
	kept := `<h2>Title</h2><p>Some <strong>bold</strong>, <em>italic</em> and <a href="https://example.com">a link</a>.</p><ul><li>one</li></ul><blockquote>quote</blockquote><pre><code>x := 1</code></pre>`
	got := HTML(kept)
	for _, want := range []string{"<h2>Title</h2>", "<strong>bold</strong>", "<em>italic</em>", `href="https://example.com"`, `rel="nofollow`, "<li>one</li>", "<blockquote>", "<code>"} {
		if !strings.Contains(got, want) {
			t.Errorf("lost %q: %s", want, got)
		}
	}
}

func TestHTMLDropsWhatCouldRunOrSpy(t *testing.T) {
	for _, bad := range []string{
		`<script>alert(1)</script>`,
		`<img src=x onerror=alert(1)>`,
		`<a href="javascript:alert(1)">x</a>`,
		`<p onclick="alert(1)">x</p>`,
		`<p style="background:url(https://spy.example)">x</p>`,
		`<iframe src="https://example.com"></iframe>`,
		`<svg onload=alert(1)>`,
	} {
		got := HTML(bad)
		for _, word := range []string{"script", "onerror", "javascript:", "onclick", "style", "iframe", "onload", "<img", "<svg"} {
			if strings.Contains(strings.ToLower(got), word) {
				t.Errorf("%s kept %q: %s", bad, word, got)
			}
		}
	}
}
