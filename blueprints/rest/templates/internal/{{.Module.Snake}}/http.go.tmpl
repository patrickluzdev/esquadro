{{- else}}
	if !scope.All() {
		return nil, security.Refusal(ctx)
	}
{{- end}}
{{- end}}
	page, err := h.{{$p}}.List{{.Plural.Pascal}}(ctx, q)
	if err != nil {
		return nil, problemOf(err)
	}
{{- if not $pag}}
	if page.Next != "" {
