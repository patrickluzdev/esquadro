// answerFiles keeps the files of the module's records, for the answers.
var answerFiles *storage.Store

// fileAnswer is a record's file as the contract writes it: its name, size
// and type, and a signed link to read it, which expires. A file it cannot
// read is left out.
func fileAnswer(ctx context.Context, id uuid.UUID) (apigen.StoredFile, bool) {
	if answerFiles == nil || id == uuid.Nil() {
		return apigen.StoredFile{}, false
	}
	found, err := answerFiles.Files(ctx, []uuid.UUID{id})
	f, ok := found[id]
	if err != nil || !ok {
		return apigen.StoredFile{}, false
	}
	link, err := answerFiles.URL(ctx, f)
	if err != nil {
		return apigen.StoredFile{}, false
	}
	return apigen.StoredFile{ID: ogenuuid.UUID(f.ID), Name: f.Name, Size: f.Size, ContentType: f.ContentType, URL: link}, true
}
{{- end}}
