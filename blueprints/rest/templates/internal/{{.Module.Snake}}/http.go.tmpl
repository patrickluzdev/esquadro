// Include{{.Plural.Pascal}} reads {{lower .Plural.Label}} by id for an include, from this module
// or another: only those the request may read, with only the fields
// asked for.
func Include{{.Plural.Pascal}}(m *{{$m.Pascal}}) func(context.Context, []uuid.UUID, []string) (map[uuid.UUID]apigen.{{$P}}, error) {
	return func(ctx context.Context, ids []uuid.UUID, fields []string) (map[uuid.UUID]apigen.{{$P}}, error) {
		found, err := m.Read{{.Plural.Pascal}}(ctx, ids)
		if err != nil {
			return nil, err
		}
		asked := make([]apigen.{{$P}}Field, len(fields))
		for i, f := range fields {
			asked[i] = apigen.{{$P}}Field(f)
		}
		out := make(map[uuid.UUID]apigen.{{$P}}, len(found))
		for id, x := range found {
{{- if $pol}}
			if !({{$P}}Policy{}).Read(ctx, x) {
				continue
			}
{{- end}}
			a := {{.Camel}}Answer(ctx, x)
			{{.Camel}}Only(&a, asked)
			out[id] = a
		}
		return out, nil
	}
}
{{- end}}
