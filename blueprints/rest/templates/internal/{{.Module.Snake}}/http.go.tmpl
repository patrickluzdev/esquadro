func (h HTTP) EmptyTrashOf{{.Plural.Pascal}}(ctx context.Context) (*apigen.Purged, error) {
{{- if $pol}}
	{{if $own}}owner{{else}}_{{end}}, err := h.trashOf{{.Plural.Pascal}}(ctx)
	if err != nil {
		return nil, err
	}
{{- end}}
	// A page at a time; one where nothing could go (others point at it, or
	// the request may not delete it) is passed by.
	purged := 0
	for page := 1; ; {
		trash, err := h.{{$p}}.ListDeleted{{.Plural.Pascal}}(ctx, page, Max{{$P}}Page{{if $own}}, owner{{end}})
		if err != nil {
			return nil, problemOf(err)
		}
		if len(trash.{{.Plural.Pascal}}) == 0 {
			return &apigen.Purged{Purged: purged}, nil
		}
		gone := 0
		for _, d := range trash.{{.Plural.Pascal}} {
{{- if $pol}}
			if !({{$P}}Policy{}).Delete(ctx, d.{{$P}}) {
				continue
			}
{{- end}}
			switch err := h.{{$p}}.Purge{{$P}}(ctx, d.ID); {
			case errors.Is(err, Err{{$P}}InUse), errors.Is(err, Err{{$P}}NotFound):
			case err != nil:
				return nil, problemOf(err)
			default:
				gone++
			}
		}
		purged += gone
		if gone == 0 {
			page++
		}
	}
}
