// {{.Camel}}Included adds to the answers of xs the related records include
// asks for, each with the fields asked of it ("{{(index (includable $e) 0).Snake}}.name").
func (h HTTP) {{.Camel}}Included(ctx context.Context, xs []{{$P}}, answers []apigen.{{$P}}, include []apigen.{{$P}}Include, fields []apigen.{{$P}}Field) error {
	asked := map[string]bool{}
	for _, inc := range include {
		asked[string(inc)] = true
	}
	of := map[string][]string{}
	for _, f := range fields {
		if rel, name, ok := strings.Cut(string(f), "."); ok {
			if !asked[rel] {
				return edge.ErrInvalidRequest
			}
			of[rel] = append(of[rel], name)
		}
	}
{{- $many := false}}{{range includable $e}}{{if eq .Kind.String "many-to-many"}}{{$many = true}}{{end}}{{end}}
{{- if $many}}
	ids := make([]uuid.UUID, len(xs))
	for i, x := range xs {
		ids[i] = x.ID
	}
{{- end}}
{{- range includable $e}}{{$T := .Target}}{{$g := ogenName .Snake}}
{{- $load := printf "h.include.%s" $T.Plural.Pascal}}{{if eq $T.Module.Snake $m.Snake}}{{$load = printf "Include%s(h.%s)" $T.Plural.Pascal $p}}{{end}}
	if asked[{{quote .Snake}}] {
{{- if eq .Kind.String "many-to-many"}}
		linked, more, err := h.{{$p}}.List{{$P}}{{.Pascal}}Of(ctx, ids, edge.MaxIncluded)
		if err != nil {
			return err
		}
		var all []uuid.UUID
		for _, l := range linked {
			all = append(all, l...)
		}
		found, err := {{$load}}(ctx, all, of[{{quote .Snake}}])
		if err != nil {
			return err
		}
		for i, x := range xs {
			answers[i].{{$g}} = []apigen.{{$T.Pascal}}{}
			for _, id := range linked[x.ID] {
				if v, ok := found[id]; ok {
					answers[i].{{$g}} = append(answers[i].{{$g}}, v)
				}
			}
			if more[x.ID] {
				answers[i].{{ogenName (printf "%s_more" .Snake)}} = apigen.NewOptBool(true)
			}
		}
{{- else}}
		related := make([]uuid.UUID, 0, len(xs))
		for _, x := range xs {
			if x.{{.Pascal}}ID != uuid.Nil() {
				related = append(related, x.{{.Pascal}}ID)
			}
		}
		found, err := {{$load}}(ctx, related, of[{{quote .Snake}}])
		if err != nil {
			return err
		}
		for i, x := range xs {
			if v, ok := found[x.{{.Pascal}}ID]; ok {
{{- if eq $T.Pascal $P}}
				answers[i].{{$g}} = &v
{{- else}}
				answers[i].{{$g}} = apigen.NewOpt{{$T.Pascal}}(v)
{{- end}}
			}
		}
{{- end}}
	}
{{- end}}
	return nil
}
