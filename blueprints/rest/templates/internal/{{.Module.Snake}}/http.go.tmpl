func (h HTTP) Create{{$P}}(ctx context.Context, req *apigen.New{{$P}}) (*apigen.{{$P}}, error) {
	n, unread := new{{$P}}Of(req)
	if unread != nil {
		return nil, problemOf(refuse{{$P}}(n, unread))
	}
	created, err := h.{{$p}}.Create{{$P}}(ctx, n)
	if err != nil {
		return nil, problemOf(err)
	}
	answer := {{.Camel}}Answer(created)
	return &answer, nil
}

func (h HTTP) Get{{$P}}(ctx context.Context, params apigen.Get{{$P}}Params) (*apigen.{{$P}}, error) {
	found, err := h.{{$p}}.Read{{$P}}(ctx, uuid.UUID(params.{{$id}}))
	if err != nil {
		return nil, problemOf(err)
	}
	answer := {{.Camel}}Answer(found)
	return &answer, nil
}

func (h HTTP) List{{.Plural.Pascal}}(ctx context.Context, params apigen.List{{.Plural.Pascal}}Params) (*apigen.{{$P}}Page, error) {
	after, err := cursorOf(params.After)
	if err != nil {
		return nil, err
	}
	page, err := h.{{$p}}.List{{.Plural.Pascal}}(ctx, after, params.Limit.Or(25))
	if err != nil {
		return nil, problemOf(err)
	}
	answer := apigen.{{$P}}Page{Items: make([]apigen.{{$P}}, 0, len(page.{{.Plural.Pascal}}))}
	for _, listed := range page.{{.Plural.Pascal}} {
		answer.Items = append(answer.Items, {{.Camel}}Answer(listed))
	}
	if page.Next != uuid.Nil() {
		answer.Next = apigen.NewOptString(page.Next.String())
	}
	return &answer, nil
}

