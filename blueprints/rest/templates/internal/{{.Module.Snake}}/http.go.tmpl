// auditAnswer is a page of changes as the contract writes it.
func auditAnswer(page audit.Page) *apigen.AuditPage {
	out := &apigen.AuditPage{Items: make([]apigen.AuditEntry, 0, len(page.Items)), Page: page.Page, PerPage: page.PerPage, Total: page.Total, TotalPages: page.TotalPages}
	for _, e := range page.Items {
		changes := apigen.AuditEntryChanges{}
		for field, c := range e.Changes {
			var answer apigen.AuditFieldChange
			if c.Secret {
				answer.Secret = apigen.NewOptBool(true)
			}
			if c.From != nil {
				data, _ := json.Marshal(c.From)
				answer.From = jx.Raw(data)
			}
			if c.To != nil {
				data, _ := json.Marshal(c.To)
				answer.To = jx.Raw(data)
			}
			changes[field] = answer
		}
		out.Items = append(out.Items, apigen.AuditEntry{
			ID: ogenuuid.UUID(e.ID), At: e.At, Entity: e.Entity, RecordID: ogenuuid.UUID(e.RecordID),
			Action: apigen.AuditEntryAction(e.Action), Changes: changes,
			Actor: apigen.AuditActor{Kind: apigen.AuditActorKind(e.Actor.Kind), Realm: optString(e.Actor.Realm), ID: optString(e.Actor.ID), Name: e.Actor.Name},
		})
	}
	return out
}

// optString is a text that may be absent: absent when empty.
func optString(s string) apigen.OptString {
	if s == "" {
		return apigen.OptString{}
	}
	return apigen.NewOptString(s)
}
