// problemOf turns the module's errors into the problems the API answers
// with; other errors pass through.
func problemOf(err error) error {
	switch {
	case err == nil:
		return nil
	case errors.Is(err, postgres.ErrBadCursor), errors.Is(err, postgres.ErrBadSort), errors.Is(err, postgres.ErrByNumber):
		return edge.ErrInvalidRequest
{{- range $m.Entities}}
	case errors.Is(err, Err{{.Pascal}}Changed):
		return edge.ErrPreconditionFailed
{{- end}}
{{- range $m.Entities}}
	case errors.Is(err, Err{{.Pascal}}NotFound):
		return edge.NotFound({{quote (printf "No such %s." (lower .Label))}})
	case errors.Is(err, Err{{.Pascal}}InUse):
		return edge.Conflict("in_use", {{quote (printf "Other records still point at the %s." (lower .Label))}})
{{- end}}
	}
{{- $imports := false}}{{range $m.Entities}}{{if importable .}}{{$imports = true}}{{end}}{{end}}
{{- if $imports}}
	if errors.Is(err, ErrImportTooLarge) {
		return edge.TooManyRows(ImportMax)
	}
	if refused, ok := errors.AsType[*ImportRefused](err); ok {
		var fields []edge.FieldProblem
		for _, row := range refused.Rows {
			for _, f := range row.Fields {
				name := f.Field
				if api, ok := apiFields[name]; ok {
					name = api
				}
				fields = append(fields, edge.FieldProblem{Field: name, Code: f.Code, Row: row.Row})
			}
		}
		return edge.ImportRefused(fields)
	}
{{- end}}
{{- if limitedModule .Entities $m}}
	if _, ok := errors.AsType[*CreateLimited](err); ok {
		return edge.ErrRateLimited
	}
{{- end}}
	if broken, ok := errors.AsType[*RuleError](err); ok {
		fields := make([]edge.FieldProblem, 0, len(broken.Fields))
		for _, name := range broken.Fields {
			if api, ok := apiFields[name]; ok {
				name = api
			}
			fields = append(fields, edge.FieldProblem{Field: name, Code: broken.Code})
		}
		return edge.Broken(broken.Code, broken.Text, fields)
	}
	if invalid, ok := errors.AsType[*InvalidFields](err); ok {
		fields := make([]edge.FieldProblem, 0, len(invalid.Fields))
		for _, f := range invalid.Fields {
			name := f.Field
			if api, ok := apiFields[name]; ok {
				name = api
			}
			fields = append(fields, edge.FieldProblem{Field: name, Code: f.Code})
		}
		return edge.InvalidFields(fields)
	}
	return err
}
{{- if limitedModule .Entities $m}}

// retryAfter tells, with Retry-After, when a create past its limit may be
