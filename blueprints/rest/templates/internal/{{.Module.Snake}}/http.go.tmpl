		} else {
{{- if eq .Kind "eq"}}
			q.Filter.{{.Field}}Min, q.Filter.{{.Field}}Max = &d, &d
{{- else if eq .Kind "min"}}
			q.Filter.{{.Field}}Min = &d
{{- else}}
			q.Filter.{{.Field}}Max = &d
