// new{{$P}}Of reads a New{{$P}} as the contract writes it, with the fields
// it could not read (a decimal that is no number), if any.
func new{{$P}}Of(req *apigen.New{{$P}}) (New{{$P}}, []FieldError) {
	var n New{{$P}}
	var invalid []FieldError
{{- range inRequest $e}}{{$g := ogenName (jsonName .)}}{{$x := printf "n.%s" .Pascal}}
{{- if .Required}}
{{- if eq .Type "decimal"}}
	if d, err := decimal.NewFromString(req.{{$g}}); err == nil {
		{{$x}} = d
	} else {
		invalid = append(invalid, FieldError{Field: {{quote .Snake}}, Code: "invalid_value"})
	}
{{- else if eq .Type "uuid"}}
	{{$x}} = uuid.UUID(req.{{$g}})
{{- else if eq .Type "json"}}
	{{$x}} = []byte(req.{{$g}})
{{- else if eq .Type "enum"}}
	{{$x}} = {{.Enum.Pascal}}(req.{{$g}})
{{- else}}
	{{$x}} = req.{{$g}}
{{- end}}
{{- else}}
{{- if eq .Type "json"}}
	{{$x}} = []byte(req.{{$g}})
{{- else}}
	if v, ok := req.{{$g}}.Get(); ok {
{{- if eq .Type "decimal"}}
		if d, err := decimal.NewFromString(v); err == nil {
			{{$x}} = d
		} else {
			invalid = append(invalid, FieldError{Field: {{quote .Snake}}, Code: "invalid_value"})
		}
{{- else if eq .Type "uuid"}}
		{{$x}} = uuid.UUID(v)
{{- else if eq .Type "enum"}}
		{{$x}} = {{.Enum.Pascal}}(v)
{{- else}}
		{{$x}} = v
{{- end}}
	}
{{- end}}
{{- end}}
{{- end}}
{{- range keys $e}}{{$g := ogenName (keyName .)}}
{{- if keyInRequest $.Entities $e .}}
	n.{{.Pascal}}ID = uuid.UUID(req.{{$g}})
{{- else}}
	if v, ok := req.{{$g}}.Get(); ok {
		n.{{.Pascal}}ID = uuid.UUID(v)
	}
{{- end}}
{{- end}}
	return n, invalid
}

// {{.Camel}}ChangesOf reads the changes a PATCH sends.
func {{.Camel}}ChangesOf(req *apigen.{{$P}}Changes) ({{$P}}Changes, []FieldError) {
	var c {{$P}}Changes
	var invalid []FieldError
{{- range inRequest $e}}{{$g := ogenName (jsonName .)}}{{$x := printf "c.%s" .Pascal}}
{{- if eq .Type "json"}}
	if len(req.{{$g}}) > 0 {
		{{$x}} = new(json.RawMessage(req.{{$g}}))
	}
{{- else}}
{{- if clearable .}}
	if req.{{$g}}.Set && req.{{$g}}.Null {
{{- if .Required}}
		invalid = append(invalid, FieldError{Field: {{quote .Snake}}, Code: "required"})
{{- else}}
		{{$x}} = edge.Emptied({{$x}})
{{- end}}
	} else if req.{{$g}}.Set {
		v := req.{{$g}}.Value
{{- else}}
	if v, ok := req.{{$g}}.Get(); ok {
{{- end}}
{{- if eq .Type "decimal"}}
		if d, err := decimal.NewFromString(v); err == nil {
			{{$x}} = &d
		} else {
			invalid = append(invalid, FieldError{Field: {{quote .Snake}}, Code: "invalid_value"})
		}
{{- else if eq .Type "uuid"}}
		{{$x}} = new(uuid.UUID(v))
{{- else if eq .Type "enum"}}
		{{$x}} = new({{.Enum.Pascal}}(v))
{{- else}}
		{{$x}} = &v
{{- end}}
	}
{{- end}}
{{- end}}
{{- range keys $e}}{{$g := ogenName (keyName .)}}
{{- if .Required}}
	if v, ok := req.{{$g}}.Get(); ok {
		c.{{.Pascal}}ID = new(uuid.UUID(v))
	}
{{- else}}
	if req.{{$g}}.Set && req.{{$g}}.Null {
		c.{{.Pascal}}ID = new(uuid.Nil())
	} else if req.{{$g}}.Set {
		c.{{.Pascal}}ID = new(uuid.UUID(req.{{$g}}.Value))
	}
{{- end}}
{{- end}}
	return c, invalid
}

// refuse{{$P}} joins the fields the contract could not read with those the
// domain refuses, so a client learns every problem at once.
func refuse{{$P}}(n New{{$P}}, unread []FieldError) error {
	all := unread
	if invalid, ok := errors.AsType[*InvalidFields](n.WithDefaults().Validate()); ok {
		for _, f := range invalid.Fields {
			if !slices.ContainsFunc(all, func(u FieldError) bool { return u.Field == f.Field }) {
				all = append(all, f)
			}
		}
	}
	return &InvalidFields{Fields: all}
}

// {{.Camel}}Answer writes a {{$P}} as the contract does.
func {{.Camel}}Answer(x {{$P}}) apigen.{{$P}} {
	a := apigen.{{$P}}{
		ID:        ogenuuid.UUID(x.ID),
		Version:   x.Version,
		CreatedAt: apigen.NewOptDateTime(x.CreatedAt),
		UpdatedAt: apigen.NewOptDateTime(x.UpdatedAt),
	}
{{- range inRequest $e}}{{$g := ogenName (jsonName .)}}{{$x := printf "x.%s" .Pascal}}{{$req := .Required}}
{{- if or (eq .Type "string") (eq .Type "text")}}
{{- if not $req}}
	if {{$x}} != "" {
{{- end}}
	a.{{$g}} = apigen.NewOptString({{$x}})
{{- if not $req}}
	}
{{- end}}
{{- else if eq .Type "int"}}
	a.{{$g}} = apigen.NewOptInt({{$x}})
{{- else if eq .Type "int64"}}
	a.{{$g}} = apigen.NewOptInt64({{$x}})
{{- else if eq .Type "bool"}}
	a.{{$g}} = apigen.NewOptBool({{$x}})
{{- else if eq .Type "decimal"}}
	a.{{$g}} = apigen.NewOptString({{$x}}.String())
{{- else if or (eq .Type "time") (eq .Type "date")}}
{{- if not $req}}
	if !{{$x}}.IsZero() {
{{- end}}
	a.{{$g}} = apigen.NewOpt{{if eq .Type "time"}}DateTime{{else}}Date{{end}}({{$x}})
{{- if not $req}}
	}
{{- end}}
{{- else if eq .Type "uuid"}}
{{- if not $req}}
	if {{$x}} != uuid.Nil() {
{{- end}}
	a.{{$g}} = apigen.NewOptUUID(ogenuuid.UUID({{$x}}))
{{- if not $req}}
	}
{{- end}}
{{- else if eq .Type "json"}}
	if len({{$x}}) > 0 {
		a.{{$g}} = jx.Raw({{$x}})
	}
{{- else if eq .Type "enum"}}
{{- if not $req}}
	if {{$x}} != "" {
{{- end}}
	a.{{$g}} = apigen.NewOpt{{enumName .Enum}}(apigen.{{enumName .Enum}}({{$x}}))
{{- if not $req}}
	}
{{- end}}
{{- end}}
{{- end}}
{{- range keys $e}}
{{- if not .Required}}
	if x.{{.Pascal}}ID != uuid.Nil() {
{{- end}}
	a.{{ogenName (keyName .)}} = apigen.NewOptUUID(ogenuuid.UUID(x.{{.Pascal}}ID))
{{- if not .Required}}
	}
{{- end}}
{{- end}}
	return a
}

// {{.Camel}}Only leaves in a only the fields asked for, with id and
// version; none asked for, every one.
func {{.Camel}}Only(a *apigen.{{$P}}, fields []apigen.{{$P}}Field) {
	if len(fields) == 0 {
		return
	}
	asked := map[apigen.{{$P}}Field]bool{}
	for _, f := range fields {
		asked[f] = true
	}
{{- range inRequest $e}}
	if !asked[{{quote (jsonName .)}}] {
		edge.Unset(&a.{{ogenName (jsonName .)}})
	}
{{- end}}
{{- range keys $e}}
	if !asked[{{quote (keyName .)}}] {
		edge.Unset(&a.{{ogenName (keyName .)}})
	}
{{- end}}
	if !asked["created_at"] {
		edge.Unset(&a.CreatedAt)
	}
	if !asked["updated_at"] {
		edge.Unset(&a.UpdatedAt)
	}
}
{{- end}}

