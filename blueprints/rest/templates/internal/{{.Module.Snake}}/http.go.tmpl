// new{{$P}}Of reads a New{{$P}} as the contract writes it, with the fields
// it could not read (a decimal that is no number), if any.
func new{{$P}}Of(req *apigen.New{{$P}}) (New{{$P}}, []FieldError) {
	var n New{{$P}}
	var invalid []FieldError
{{- range inRequest $e}}{{$g := ogenName (jsonName .)}}{{$x := printf "n.%s" .Pascal}}
{{- if .Required}}
{{- if eq .Type "decimal"}}
	if d, err := decimal.NewFromString(req.{{$g}}); err == nil {
		{{$x}} = d
	} else {
		invalid = append(invalid, FieldError{Field: {{quote .Snake}}, Code: "invalid_value"})
	}
{{- else if eq .Type "uuid"}}
	{{$x}} = uuid.UUID(req.{{$g}})
{{- else if eq .Type "json"}}
	{{$x}} = []byte(req.{{$g}})
{{- else if eq .Type "enum"}}
	{{$x}} = {{.Enum.Pascal}}(req.{{$g}})
{{- else}}
	{{$x}} = req.{{$g}}
{{- end}}
{{- else}}
{{- if eq .Type "json"}}
	{{$x}} = []byte(req.{{$g}})
{{- else}}
	if v, ok := req.{{$g}}.Get(); ok {
{{- if eq .Type "decimal"}}
		if d, err := decimal.NewFromString(v); err == nil {
			{{$x}} = d
		} else {
			invalid = append(invalid, FieldError{Field: {{quote .Snake}}, Code: "invalid_value"})
		}
{{- else if eq .Type "uuid"}}
		{{$x}} = uuid.UUID(v)
{{- else if eq .Type "enum"}}
		{{$x}} = {{.Enum.Pascal}}(v)
{{- else}}
		{{$x}} = v
{{- end}}
	}
{{- end}}
{{- end}}
{{- end}}
{{- range keys $e}}{{$g := ogenName (printf "%sId" .Camel)}}
{{- if .Required}}
	n.{{.Pascal}}ID = uuid.UUID(req.{{$g}})
{{- else}}
	if v, ok := req.{{$g}}.Get(); ok {
		n.{{.Pascal}}ID = uuid.UUID(v)
	}
{{- end}}
{{- end}}
	return n, invalid
}

// refuse{{$P}} joins the fields the contract could not read with those the
// domain refuses, so a client learns every problem at once.
func refuse{{$P}}(n New{{$P}}, unread []FieldError) error {
	all := unread
	if invalid, ok := errors.AsType[*InvalidFields](n.WithDefaults().Validate()); ok {
		for _, f := range invalid.Fields {
			if !slices.ContainsFunc(all, func(u FieldError) bool { return u.Field == f.Field }) {
				all = append(all, f)
			}
		}
	}
	return &InvalidFields{Fields: all}
}

// {{.Camel}}Answer writes a {{$P}} as the contract does.
func {{.Camel}}Answer(x {{$P}}) apigen.{{$P}} {
	a := apigen.{{$P}}{
		ID:        ogenuuid.UUID(x.ID),
		CreatedAt: x.CreatedAt,
		UpdatedAt: x.UpdatedAt,
{{- range inRequest $e}}{{if .Required}}{{$g := ogenName (jsonName .)}}
{{- if eq .Type "decimal"}}
		{{$g}}: x.{{.Pascal}}.String(),
{{- else if eq .Type "uuid"}}
		{{$g}}: ogenuuid.UUID(x.{{.Pascal}}),
{{- else if eq .Type "json"}}
		{{$g}}: jx.Raw(x.{{.Pascal}}),
{{- else if eq .Type "enum"}}
		{{$g}}: apigen.{{enumName .Enum}}(x.{{.Pascal}}),
{{- else}}
		{{$g}}: x.{{.Pascal}},
{{- end}}
{{- end}}{{end}}
{{- range keys $e}}{{if .Required}}
		{{ogenName (printf "%sId" .Camel)}}: ogenuuid.UUID(x.{{.Pascal}}ID),
{{- end}}{{end}}
	}
{{- range inRequest $e}}{{if not .Required}}{{$g := ogenName (jsonName .)}}{{$x := printf "x.%s" .Pascal}}
{{- if or (eq .Type "string") (eq .Type "text")}}
	if {{$x}} != "" {
		a.{{$g}} = apigen.NewOptString({{$x}})
	}
{{- else if eq .Type "int"}}
	a.{{$g}} = apigen.NewOptInt({{$x}})
{{- else if eq .Type "int64"}}
	a.{{$g}} = apigen.NewOptInt64({{$x}})
{{- else if eq .Type "bool"}}
	a.{{$g}} = apigen.NewOptBool({{$x}})
{{- else if eq .Type "decimal"}}
	a.{{$g}} = apigen.NewOptString({{$x}}.String())
{{- else if eq .Type "time"}}
	if !{{$x}}.IsZero() {
		a.{{$g}} = apigen.NewOptDateTime({{$x}})
	}
{{- else if eq .Type "date"}}
	if !{{$x}}.IsZero() {
		a.{{$g}} = apigen.NewOptDate({{$x}})
	}
{{- else if eq .Type "uuid"}}
	if {{$x}} != uuid.Nil() {
		a.{{$g}} = apigen.NewOptUUID(ogenuuid.UUID({{$x}}))
	}
{{- else if eq .Type "json"}}
	if len({{$x}}) > 0 {
		a.{{$g}} = jx.Raw({{$x}})
	}
{{- else if eq .Type "enum"}}
	if {{$x}} != "" {
		a.{{$g}} = apigen.NewOpt{{enumName .Enum}}(apigen.{{enumName .Enum}}({{$x}}))
	}
{{- end}}
{{- end}}{{end}}
{{- range keys $e}}{{if not .Required}}
	if x.{{.Pascal}}ID != uuid.Nil() {
		a.{{ogenName (printf "%sId" .Camel)}} = apigen.NewOptUUID(ogenuuid.UUID(x.{{.Pascal}}ID))
	}
{{- end}}{{end}}
	return a
}
{{- end}}

// apiFields names, as the contract does, the fields the module refuses.
var apiFields = map[string]string{
{{- range apiFieldNames $m}}
	{{quote .Domain}}: {{quote .API}},
{{- end}}
}

// problemOf turns the module's errors into the problems the API answers
// with; other errors pass through.
// cursorOf is the cursor of a list, the nil UUID for the first page.
func cursorOf(after apigen.OptString) (uuid.UUID, error) {
	cursor, ok := after.Get()
	if !ok {
		return uuid.Nil(), nil
	}
	id, err := uuid.Parse(cursor)
	if err != nil {
		return uuid.Nil(), edge.ErrInvalidRequest
	}
	return id, nil
}

func problemOf(err error) error {
	switch {
	case err == nil:
		return nil
{{- range $m.Entities}}
	case errors.Is(err, Err{{.Pascal}}NotFound):
		return edge.NotFound({{quote (printf "No such %s." (lower .Label))}})
	case errors.Is(err, Err{{.Pascal}}InUse):
		return edge.Conflict("in_use", {{quote (printf "Other records still point at the %s." (lower .Label))}})
{{- end}}
	}
	if invalid, ok := errors.AsType[*InvalidFields](err); ok {
		fields := make([]edge.FieldProblem, 0, len(invalid.Fields))
		for _, f := range invalid.Fields {
			name := f.Field
			if api, ok := apiFields[name]; ok {
				name = api
			}
			fields = append(fields, edge.FieldProblem{Field: name, Code: f.Code})
		}
		return edge.InvalidFields(fields)
	}
	return err
}
