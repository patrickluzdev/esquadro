{{- end}}
{{- if and (has $pag "cursor") (has $pag "page")}}
	if params.Page.IsSet() && params.After.IsSet() {
		return nil, edge.ErrInvalidRequest
	}
{{- end}}
	switch {
{{- if has $pag "page"}}
	case {{if has $pag "cursor"}}params.Page.IsSet() || params.PerPage.IsSet(){{else}}true{{end}}:
		q.Page, q.PerPage = params.Page.Or(1), params.PerPage.Or(25)
