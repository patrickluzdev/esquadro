// moneyOf reads an amount as the contract writes it: its currency{{with .App.Currency}}, {{.}}
// when not sent{{end}}. It is not ok when the amount is no number or the
// currency is no ISO 4217 code.
func moneyOf(amount string, code apigen.OptString) (currency.Amount, bool) {
	a, err := currency.NewAmount(amount, code.Or({{quote .App.Currency}}))
	return a, err == nil
}
