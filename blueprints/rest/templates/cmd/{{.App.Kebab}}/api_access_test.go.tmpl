// call answers the status of a request as who, the IDs of the list it
// answered, if any, and the actions it says who may take (can).
func call(t *testing.T, method, url, who string) (int, map[string]bool, string) {
	t.Helper()
	var body io.Reader
	if method == "PATCH" {
		body = strings.NewReader("{}")
	}
	req, err := http.NewRequest(method, url, body)
	if err != nil {
		t.Fatal(err)
	}
	if body != nil {
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("If-Match", "*")
	}
	res, err := asTestPrincipal(who).Do(req)
	if err != nil {
		t.Fatal(err)
	}
	defer res.Body.Close()
	var page struct {
		Items []struct{ ID string }
		Can   []string
	}
	_ = json.NewDecoder(res.Body).Decode(&page)
	ids := map[string]bool{}
	for _, item := range page.Items {
		ids[item.ID] = true
	}
	return res.StatusCode, ids, strings.Join(page.Can, ",")
}

// as is the context of a request that comes from who.
func as(who string) context.Context {
	if p, ok := principalOf(who); ok {
		return security.WithPrincipal(context.Background(), p)
	}
	return context.Background()
}

// refused is the status of a request a policy refuses.
func refused(who string) int {
	if who == "nobody" {
		return http.StatusUnauthorized
	}
	return http.StatusForbidden
}

// TestAPIAccess checks that the API answers as each entity's policy says:
// it asks the policy that runs, generated from the model or written in the
// project, as each kind of request, and compares the API's answer.
func TestAPIAccess(t *testing.T) {
	t.Parallel()
	ctx := context.Background()
	srv, d := newTestServerOf(t, newTestDependencies(t))
	c, err := apigen.NewClient(srv.URL+"/api/v1", apigen.WithClient(testClient))
	if err != nil {
		t.Fatal(err)
	}
{{- range $i, $e := .Entities}}{{if canSampleAPI $e}}{{$P := $e.Pascal}}{{$m := $e.Module}}{{$own := ownerField $.Entities $e}}
	t.Run("{{$P}}", func(t *testing.T) {
		// Records of its own (i), apart from the other entities'.
		created, err := c.Create{{$P}}(ctx, givenAPI{{$P}}(t, c, {{$i}}+100), apigen.Create{{$P}}Params{})
		if err != nil {
			t.Fatal(err)
		}
		stored, err := d.{{$m.Camel}}.Read{{$P}}(ctx, uuid.UUID(created.ID))
		if err != nil {
			t.Fatal(err)
		}
		policy := {{$m.Snake}}.{{$P}}Policy{}
		url := srv.URL + "/api/v1/{{$e.Plural.Kebab}}"
		for _, who := range []string{
{{- range whosOf $.Entities $e}}
{{- if .Owns}} "{{.Realm}}@" + stored.{{$own}}.String(),
{{- else if .Realm}} {{printf "%q" .Name}},
{{- else}} "nobody",
{{- end}}
{{- end}} } {
			read := policy.Read(as(who), stored)
			want := http.StatusOK
			if !read {
				want = http.StatusNotFound
{{- if not (publicRead $.Entities $e)}}
				if who == "nobody" {
					want = http.StatusUnauthorized
				}
{{- end}}
			}
			gotOne, _, canOne := call(t, "GET", url+"/"+stored.ID.String(), who)
			if gotOne != want {
				t.Errorf("get as %s: %d, want %d", who, gotOne, want)
			}
			var wantCan []string
			if policy.Update(as(who), stored) {
				wantCan = append(wantCan, "update")
			}
			if policy.Delete(as(who), stored) {
				wantCan = append(wantCan, "delete")
			}
			if read && canOne != strings.Join(wantCan, ",") {
				t.Errorf("can as %s: %q, want %q", who, canOne, strings.Join(wantCan, ","))
			}

			scope := policy.List(as(who))
			owner, owned := scope.Owner()
			got, ids, can := call(t, "GET", url, who)
			if wantCreate := policy.CanCreate(as(who)); got == http.StatusOK && (can == "create") != wantCreate {
				t.Errorf("the list's can as %s: %q, want create %v", who, can, wantCreate)
			}
			switch {
			case !scope.All() && !owned:
				if got != refused(who) {
					t.Errorf("list as %s: %d, want %d", who, got, refused(who))
				}
			case got != http.StatusOK:
				t.Errorf("list as %s: %d", who, got)
			case ids[stored.ID.String()] != (scope.All(){{with $own}} || owner == stored.{{.}}{{end}}):
				t.Errorf("list as %s: the {{$e.Snake}} listed %v", who, ids[stored.ID.String()])
			}
{{- if not $own}}
			_ = owner
{{- end}}

			// Refusals only: a change let through would change what the
			// next one sees.
			if read && !policy.Update(as(who), stored) {
				if got, _, _ := call(t, "PATCH", url+"/"+stored.ID.String(), who); got != refused(who) {
					t.Errorf("patch as %s: %d, want %d", who, got, refused(who))
				}
			}
			if read && !policy.Delete(as(who), stored) {
				if got, _, _ := call(t, "DELETE", url+"/"+stored.ID.String(), who); got != refused(who) {
					t.Errorf("delete as %s: %d, want %d", who, got, refused(who))
				}
			}
		}
	})
{{- end}}{{end}}
}
