	_, err = c.Patch{{$P}}(ctx, &apigen.{{$P}}Changes{}, apigen.Patch{{$P}}Params{ {{- $id}}: created.ID, IfMatch: apigen.NewOptString(`"99"`)})
	if p, ok := errors.AsType[*apigen.ProblemStatusCode](err); !ok || p.StatusCode != 412 {
