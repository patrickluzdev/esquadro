// givenAPI{{$P}} returns a valid request for a {{lower .Label}} with its required
// fields, creating the records it needs first; i tells records apart.
func givenAPI{{$P}}(t *testing.T, {{if apiParents $e}}c{{else}}_{{end}} *apigen.Client, i int) *apigen.New{{$P}} {
	t.Helper()
{{- range apiParents $e}}
	{{.Camel}}, err := c.Create{{.Target.Pascal}}(context.Background(), givenAPI{{.Target.Pascal}}(t, c, i))
	if err != nil {
		t.Fatal(err)
	}
{{- end}}
	return &apigen.New{{$P}}{
{{- range inRequest $e}}{{if .Required}}
		{{ogenName (jsonName .)}}: {{apiSample . "i"}},
{{- end}}{{end}}
{{- range keys $e}}{{if .Required}}
{{- if eq .Target.Module $e.Module}}
		{{ogenName (printf "%sId" .Camel)}}: {{.Camel}}.ID,
{{- else}}
		{{ogenName (printf "%sId" .Camel)}}: ogenuuid.UUID(uuid.NewV7()), // another module: no foreign key
{{- end}}
{{- end}}{{end}}
	}
}

func TestAPI{{.Plural.Pascal}}(t *testing.T) {
	t.Parallel()
	ctx := context.Background()
	c := newTestClient(t)

	created, err := c.Create{{$P}}(ctx, givenAPI{{$P}}(t, c, 1))
	if err != nil {
		t.Fatal(err)
	}
	read, err := c.Get{{$P}}(ctx, apigen.Get{{$P}}Params{ {{$id}}: created.ID })
	if err != nil || read.ID != created.ID {
		t.Fatalf("get: %+v, %v", read, err)
	}
	page, err := c.List{{.Plural.Pascal}}(ctx, apigen.List{{.Plural.Pascal}}Params{})
	if err != nil || len(page.Items) != 1 || page.Items[0].ID != created.ID {
		t.Fatalf("list: %+v, %v", page, err)
	}
	if _, err := c.Update{{$P}}(ctx, givenAPI{{$P}}(t, c, 2), apigen.Update{{$P}}Params{ {{$id}}: created.ID }); err != nil {
		t.Fatalf("update: %v", err)
	}
	if err := c.Delete{{$P}}(ctx, apigen.Delete{{$P}}Params{ {{$id}}: created.ID }); err != nil {
		t.Fatalf("delete: %v", err)
	}
	_, err = c.Get{{$P}}(ctx, apigen.Get{{$P}}Params{ {{$id}}: created.ID })
	if p, ok := errors.AsType[*apigen.ProblemStatusCode](err); !ok || p.StatusCode != 404 || p.Response.Code != "not_found" {
		t.Fatalf("get after delete: %v", err)
	}
}
