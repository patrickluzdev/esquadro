// testClient sends a new Idempotency-Key with each POST, as a client
// should: a retry of the same operation would send the same one again.
var testClient = &http.Client{Transport: idempotentTransport{}}

type idempotentTransport struct{}

func (idempotentTransport) RoundTrip(r *http.Request) (*http.Response, error) {
	if r.Method == http.MethodPost && r.Header.Get("Idempotency-Key") == "" {
		r = r.Clone(r.Context())
		r.Header.Set("Idempotency-Key", uuid.NewV7().String())
	}
	return http.DefaultTransport.RoundTrip(r)
}

// newTestClient returns ogen's client for a new test server, so tests go
// through the whole contract: JSON, decoding, the module, Postgres and back.
func newTestClient(t *testing.T) *apigen.Client {
	t.Helper()
	c, err := apigen.NewClient(newTestServer(t).URL+"/api/v1", apigen.WithClient(testClient))
	if err != nil {
		t.Fatal(err)
	}
	return c
}

// TestAPIEdge checks what every request gets from package edge: problems
// for what the contract does not have, and the headers of an API.
func TestAPIEdge(t *testing.T) {
	t.Parallel()
	srv := newTestServer(t)
	for _, tc := range []struct {
		method, path, contentType, body string
		status                          int
		code                            string
	}{
		{"GET", "/nowhere", "", "", 404, "not_found"},
		{"GET", "/api/v1/nowhere", "", "", 404, "not_found"},
		{"PATCH", "/api/v1/{{(index .Entities 0).Plural.Kebab}}", "", "", 405, "method_not_allowed"},
		{"POST", "/api/v1/{{(index .Entities 0).Plural.Kebab}}", "text/plain", "x", 415, "unsupported_media_type"},
		{"POST", "/api/v1/{{(index .Entities 0).Plural.Kebab}}", "application/json", "{", 400, "invalid_request"},
		{"POST", "/api/v1/{{(index .Entities 0).Plural.Kebab}}", "application/json", strings.Repeat(" ", 65*1024) + "{}", 413, "request_too_large"},
	} {
		req, err := http.NewRequest(tc.method, srv.URL+tc.path, strings.NewReader(tc.body))
		if err != nil {
			t.Fatal(err)
		}
		if tc.contentType != "" {
			req.Header.Set("Content-Type", tc.contentType)
		}
		res, err := http.DefaultClient.Do(req)
		if err != nil {
			t.Fatal(err)
		}
		var doc edge.Document
		err = json.NewDecoder(res.Body).Decode(&doc)
		_ = res.Body.Close()
		if err != nil || res.StatusCode != tc.status || doc.Code != tc.code || doc.RequestID == "" ||
			res.Header.Get("Content-Type") != "application/problem+json" {
			t.Errorf("%s %s: %d %+v (%v), want %d %s", tc.method, tc.path, res.StatusCode, doc, err, tc.status, tc.code)
		}
		if {{if uses "security"}}res.Header.Get("X-Content-Type-Options") != "nosniff" || {{end}}res.Header.Get("X-Request-Id") != doc.RequestID {
			t.Errorf("%s %s: headers %v", tc.method, tc.path, res.Header)
		}
	}
}
