// TestAPIFields reads a {{lower .Label}} with only the fields asked for, alone and
// in a list, and refuses a field it does not have.
func TestAPIFields(t *testing.T) {
	t.Parallel()
	ctx := context.Background()
	srv := newTestServer(t)
	c, err := apigen.NewClient(srv.URL+"/api/v1", apigen.WithClient(testClient))
	if err != nil {
		t.Fatal(err)
	}
	created, err := c.Create{{.Pascal}}(ctx, givenAPI{{.Pascal}}(t, c, 1), apigen.Create{{.Pascal}}Params{})
	if err != nil {
		t.Fatal(err)
	}
	get := func(path string) (int, map[string]any) {
		t.Helper()
		res, err := http.Get(srv.URL + "/api/v1/{{.Plural.Kebab}}" + path)
		if err != nil {
			t.Fatal(err)
		}
		defer res.Body.Close()
		var body map[string]any
		_ = json.NewDecoder(res.Body).Decode(&body)
		return res.StatusCode, body
	}
	keys := func(m map[string]any) string {
		var out []string
		for k := range m {
			out = append(out, k)
		}
		slices.Sort(out)
		return strings.Join(out, ",")
	}
	if status, body := get("/" + created.ID.String() + "?fields=created_at"); status != 200 || keys(body) != "can,created_at,id,version" {
		t.Fatalf("one with fields: %d %v", status, body)
	}
	status, body := get("?fields=created_at")
	items, _ := body["items"].([]any)
	if status != 200 || len(items) == 0 {
		t.Fatalf("a list with fields: %d %v", status, body)
	}
	if item, _ := items[0].(map[string]any); keys(item) != "can,created_at,id,version" {
		t.Fatalf("a list with fields: %v", item)
	}
	if status, _ := get("/" + created.ID.String() + "?fields=nope"); status != 400 {
		t.Fatalf("a field it does not have: %d, want 400", status)
	}
}

// TestAPIIdempotency sends a {{lower .Label}} with an Idempotency-Key again: the same
// answer, one record; another body with the key is refused; two at once
// make one.
func TestAPIIdempotency(t *testing.T) {
	t.Parallel()
	ctx := context.Background()
	srv := newTestServer(t)
	c, err := apigen.NewClient(srv.URL+"/api/v1", apigen.WithClient(testClient))
	if err != nil {
		t.Fatal(err)
	}
	body := func(i int) string {
		b, err := json.Marshal(givenAPI{{.Pascal}}(t, c, i))
		if err != nil {
			t.Fatal(err)
		}
		return string(b)
	}
	post := func(key, body string) (int, string, http.Header) {
		t.Helper()
		req, _ := http.NewRequest("POST", srv.URL+"/api/v1/{{.Plural.Kebab}}", strings.NewReader(body))
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("Idempotency-Key", key)
		res, err := http.DefaultClient.Do(req)
		if err != nil {
			t.Fatal(err)
		}
		defer res.Body.Close()
		var answer struct {
			ID   string `json:"id"`
			Code string `json:"code"`
		}
		_ = json.NewDecoder(res.Body).Decode(&answer)
		if answer.Code != "" {
			return res.StatusCode, answer.Code, res.Header
		}
		return res.StatusCode, answer.ID, res.Header
	}
	count := func() int {
		page, err := c.List{{.Plural.Pascal}}(ctx, apigen.List{{.Plural.Pascal}}Params{})
		if err != nil {
			t.Fatal(err)
		}
		return len(page.Items)
	}
	before := count()

	first := body(1)
	status, id, _ := post("key-1", first)
	again, idAgain, header := post("key-1", first)
	if status != 201 || again != 201 || id != idAgain || header.Get("Idempotent-Replayed") != "true" {
		t.Fatalf("sent again: %d %s, then %d %s %v", status, id, again, idAgain, header)
	}
	if n := count(); n != before+1 {
		t.Fatalf("%d records made, want 1", n-before)
	}
	if status, code, _ := post("key-1", body(2)); status != 422 || code != "idempotency_key_reused" {
		t.Fatalf("another body with the key: %d %s", status, code)
	}

	// Two at once with one key: one record, the same answer.
	before = count()
	same := body(3)
	var wg sync.WaitGroup
	ids := make([]string, 2)
	for i := range 2 {
		wg.Go(func() {
			if status, got, _ := post("key-2", same); status == 201 {
				ids[i] = got
			}
		})
	}
	wg.Wait()
	if n := count(); n != before+1 || ids[0] != ids[1] {
		t.Fatalf("two at once: %d records, ids %v", n-before, ids)
	}
}
