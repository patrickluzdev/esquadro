{{- if .Entities -}}
# Generated by esquadro from the .esq files: do not edit. To add operations of
# your own, contribute them to the rest.tags, rest.paths and rest.schemas slots
# from a local blueprint, and implement them in a file of yours in the module.
openapi: 3.0.3
info:
  title: {{quote (or .Options.title .App.Label)}}
  version: 1.0.0
  description: |
    The {{.App.Label}} API.

    Errors are Problem Details whose `code` is stable
{{- if uses "i18n"}}{{$langs := strs (index (optionsOf "i18n") "languages")}} and whose `title` is in
    the language Accept-Language asks for{{if gt (len $langs) 1}} ({{join ", " $langs}}){{end}}{{end}}:
    `invalid_request` (400) for a request that does not match this contract,
    `not_found` (404), `method_not_allowed` (405), `not_acceptable` (406),
    `in_use` (409) for deleting a record others point at,
    `request_too_large` (413), `unsupported_media_type` (415),
    `precondition_failed` (412) and `precondition_required` (428) for If-Match
    (a record's ETag is its `version`), `idempotency_in_progress` (409),
    `idempotency_key_reused` (422) and `idempotency_key_required` (428) for
    Idempotency-Key,{{if accessLine .Entities (index .Entities 0) "read"}}
    `unauthorized` (401) without a session or a token, `forbidden` (403) for
    one that may not, `csrf` (403) for a change with a session cookie but
    without its X-CSRF-Token,{{end}}
    `invalid_fields` (422) listing every field refused at once, with codes
    `required`, `too_short`, `too_long`, `too_small`, `too_large`, `pattern`,
    `invalid_value`, `not_found` (a related record that does not exist) and
    `taken` (a unique value already used),{{if uses "rate_limit"}} `rate_limited` (429, with
    Retry-After){{end}} and `internal` (500). Every response carries X-Request-Id,
    which errors repeat as `request_id`. Every JSON name is snake_case.
servers:
  - url: /
tags:
{{- range .Modules}}{{if .Entities}}
  - name: {{.Snake}}
    description: {{quote (printf "The %s module." .Snake)}}
{{- end}}{{end}}
{{- with slot "rest.tags" .}}
{{.}}
{{- end}}
paths:
{{- range .Entities}}{{$e := .}}{{$id := printf "%sId" .Camel}}{{$a := "a"}}{{if single $e}}{{$a = "the"}}{{end}}
{{- if not (single $e)}}
  /api/v1/{{.Plural.Kebab}}:
    get:
      operationId: list{{.Plural.Pascal}}
      summary: {{quote (printf "List %s" (lower .Plural.Label))}}
{{- $pag := paginationOf $e $.Options}}
      description: |
        The {{lower .Plural.Label}}, the newest first unless `sort` says otherwise{{if searchFieldsOf $e}}
        (with `q`, the most relevant first){{end}}.
{{- if has $pag "cursor"}}
        By cursor: `limit` per page (25 by default, at most 100); `next` is the
        cursor of the next page, absent on the last one: pass it as `after`.
{{- end}}
{{- if has $pag "page"}}
        By page{{if has $pag "cursor"}}, with `page`{{end}}: `page` from 1, `per_page` per page (25 by default,
        at most 100), with `total` and `total_pages`.
{{- end}}
{{- if not $pag}}
        Every one at once, up to {{unpagedMax $e $.Options}}; past it, `too_many_records` (422).
{{- end}}
        Filters ending in `_min` and `_max` are inclusive bounds.
{{- $none := ""}}{{range apiFilters $e}}{{if and .None (not $none)}}{{$none = .Param}}{{end}}{{end}}
{{- if $none}}
        A key that may be empty takes `null` too: `{{$none}}=null` keeps those without one.
{{- end}}
{{- with accessLine $.Entities $e "list"}}
        {{.}}
{{- end}}
      tags: [{{.Module.Snake}}]
      parameters:
        - name: fields
          in: query
          required: false
          style: form
          explode: false
          description: Only these fields, comma-separated; `id` and `version` always come.
          schema: {type: array, items: {$ref: "#/components/schemas/{{.Pascal}}Field"}}
{{- if includable $e}}
        - name: include
          in: query
          required: false
          style: form
          explode: false
          description: The related records to answer with, comma-separated.
          schema: {type: array, items: {$ref: "#/components/schemas/{{.Pascal}}Include"}}
{{- end}}
{{- if has $pag "cursor"}}
        - $ref: "#/components/parameters/After"
        - $ref: "#/components/parameters/Limit"
{{- end}}
{{- if has $pag "page"}}
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/PerPage"
{{- end}}
        - name: sort
          in: query
          required: false
          description: {{if orders $e}}{{quote (sortDoc $e)}}{{else}}The order; - is descending.{{end}}
          schema: {type: string, enum: [{{range $i, $s := sortsOf $e (optionsOf "postgres")}}{{if $i}}, {{end}}{{quote $s}}{{end}}]}
{{- if searchFieldsOf $e}}
        - name: q
          in: query
          required: false
          description: Text to search for; words in quotes are a phrase, and -word leaves out.
          schema: {type: string}
{{- end}}
{{- range apiFilters $e}}
        - name: {{.Param}}
          in: query
          required: false
{{- if .Array}}
          style: form
          explode: false
{{- end}}
          schema: {{.Schema}}
{{- end}}
      responses:
        "200":
          description: {{quote (printf "A page of %s." (lower .Plural.Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}Page"
        default:
          $ref: "#/components/responses/Problem"
    post:
      operationId: create{{.Pascal}}
      summary: {{quote (printf "Create a %s" (lower .Label))}}
      description: |
        Stores a new {{lower .Label}}, with its defaults, once it passes the rules
        declared for {{lower .Plural.Label}}.
        Codes: `invalid_fields` (422); `invalid_request` (400).
{{- with accessLine $.Entities $e "create"}}
        {{.}}
{{- end}}
{{- with createLimit $.Entities $e}}
        Each {{.Realm}} creates at most {{.Max}} {{.Per}}: past that, `rate_limited` (429)
        with Retry-After.
{{- end}}
      tags: [{{.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/New{{.Pascal}}"
      responses:
        "201":
          description: {{quote (printf "The new %s." (lower .Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}"
        default:
          $ref: "#/components/responses/Problem"
{{- if importable $e}}
  /api/v1/{{.Plural.Kebab}}/import:
    post:
      operationId: import{{.Plural.Pascal}}
      summary: {{quote (printf "Import %s" (lower .Plural.Label))}}
      description: |
        Stores rows, as `POST` would each{{with importBy $e}}; a row whose `{{.Snake}}` is that of a
        {{lower $e.Label}} replaces it instead, as `PUT` would{{end}}. All or none: in one
        transaction, every row checked, and nothing stored when one is refused.
        At most {{importMax}} rows.
        Codes: `import_refused` (422), whose `errors` give each refused field
        with its `row` (from 1); `too_many_rows` (422); `invalid_request` (400).
{{- with accessLine $.Entities $e "create"}}
        {{.}}
{{- end}}
{{- with createLimit $.Entities $e}}
        Each record it creates counts toward the limit of creates: each {{.Realm}}
        creates at most {{.Max}} {{.Per}}; past that, `rate_limited` (429) with Retry-After.
{{- end}}
      tags: [{{.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Pascal}}Import"
      responses:
        "200":
          description: How many it created and updated.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Imported"
        default:
          $ref: "#/components/responses/Problem"
{{- end}}
{{- end}}
{{- if single $e}}
  /api/v1/{{.Kebab}}:
{{- else}}
  /api/v1/{{.Plural.Kebab}}/{{"{"}}{{$id}}{{"}"}}:
    parameters:
      - name: {{$id}}
        in: path
        required: true
        schema: {type: string, format: uuid}
{{- end}}
    get:
      operationId: get{{.Pascal}}
      summary: {{quote (printf "Read %s %s" $a (lower .Label))}}
      description: |
        Codes: `not_found` (404).
{{- with accessLine $.Entities $e "read"}}
        {{.}}
{{- end}}
      tags: [{{.Module.Snake}}]
      parameters:
        - name: fields
          in: query
          required: false
          style: form
          explode: false
          description: Only these fields, comma-separated; `id` and `version` always come.
          schema: {type: array, items: {$ref: "#/components/schemas/{{.Pascal}}Field"}}
{{- if includable $e}}
        - name: include
          in: query
          required: false
          style: form
          explode: false
          description: The related records to answer with, comma-separated.
          schema: {type: array, items: {$ref: "#/components/schemas/{{.Pascal}}Include"}}
{{- end}}
      responses:
        "200":
          description: {{quote (printf "The %s." (lower .Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}"
        default:
          $ref: "#/components/responses/Problem"
    put:
      operationId: update{{.Pascal}}
      summary: {{quote (printf "Change %s %s" $a (lower .Label))}}
      description: |
        Replaces the {{lower .Label}} by the one sent, so a field left out is
        cleared or takes its default.
        Codes: `invalid_fields` (422); `not_found` (404); `invalid_request` (400).
{{- with accessLine $.Entities $e "update"}}
        {{.}}
{{- end}}
      tags: [{{.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/IfMatch"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/New{{.Pascal}}"
      responses:
        "200":
          description: {{quote (printf "The saved %s." (lower .Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}"
        default:
          $ref: "#/components/responses/Problem"
    patch:
      operationId: patch{{.Pascal}}
      summary: {{quote (printf "Change some fields of %s %s" $a (lower .Label))}}
      description: |
        Changes only the fields sent: one left out stays as it is, and null
        empties one that may be empty. Without If-Match, a change someone else
        made meanwhile is kept.
        Codes: `invalid_fields` (422); `not_found` (404); `invalid_request` (400).
{{- with accessLine $.Entities $e "update"}}
        {{.}}
{{- end}}
      tags: [{{.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/IfMatch"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Pascal}}Changes"
      responses:
        "200":
          description: {{quote (printf "The saved %s." (lower .Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}"
        default:
          $ref: "#/components/responses/Problem"
{{- if not (single $e)}}
    delete:
      operationId: delete{{.Pascal}}
      summary: {{quote (printf "Delete a %s" (lower .Label))}}
      description: |
        Codes: `not_found` (404); `in_use` (409) while other records point at it.
{{- with accessLine $.Entities $e "delete"}}
        {{.}}
{{- end}}
      tags: [{{.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/IfMatch"
      responses:
        "204":
          description: {{if softDeleted $e}}In the trash.{{else}}Deleted.{{end}}
        default:
          $ref: "#/components/responses/Problem"
{{- end}}
{{- if audited $e (optionsOf "audit")}}
{{- if single $e}}
  /api/v1/{{.Kebab}}/history:
{{- else}}
  /api/v1/{{.Plural.Kebab}}/{{"{"}}{{$id}}{{"}"}}/history:
    parameters:
      - name: {{$id}}
        in: path
        required: true
        schema: {type: string, format: uuid}
{{- end}}
    get:
      operationId: history{{.Pascal}}
      summary: {{quote (printf "The history of %s %s" $a (lower .Label))}}
      description: |
        Its changes, the newest first: who, when, and each field before and
        after (a secret one only that it changed). By page, `page` from 1 and
        `per_page` (25 by default, at most 100).
{{- $h := index (optionsOf "audit") "history"}}
        {{if eq $h "read"}}Who may read it sees it.{{else if eq $h "admins"}}Those who administer see it.{{else}}Who may change it sees it.{{end}}
      tags: [{{.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/PerPage"
      responses:
        "200":
          description: A page of changes.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AuditPage"
        default:
          $ref: "#/components/responses/Problem"
{{- end}}
{{- range histories $e}}{{$N := printf "%s%s" $e.Pascal .Pascal}}
  /api/v1/{{$e.Plural.Kebab}}/{{"{"}}{{$id}}{{"}"}}/{{.Kebab}}-history:
    parameters:
      - name: {{$id}}
        in: path
        required: true
        schema: {type: string, format: uuid}
    get:
      operationId: get{{$N}}History
      summary: {{quote (printf "The values the %s of a %s took" (lower .Label) (lower $e.Label))}}
      description: |
        Each value its {{.Snake}} took since `since` (90 days ago by default), with
        when, the oldest first: the newest {{historyMax}} when there are more. Codes:
        `not_found` (404).
{{- with accessLine $.Entities $e "read"}}
        {{.}}
{{- end}}
      tags: [{{$e.Module.Snake}}]
      parameters:
        - name: since
          in: query
          required: false
          description: Since when, as RFC 3339; 90 days ago when left out.
          schema: {type: string, format: date-time}
      responses:
        "200":
          description: Its values.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{$N}}History"
        default:
          $ref: "#/components/responses/Problem"
{{- end}}
{{- if softDeleted $e}}
  /api/v1/{{.Plural.Kebab}}/{{"{"}}{{$id}}{{"}"}}/restore:
    parameters:
      - name: {{$id}}
        in: path
        required: true
        schema: {type: string, format: uuid}
    post:
      operationId: restore{{.Pascal}}
      summary: {{quote (printf "Restore a %s from the trash" (lower .Label))}}
      description: |
        Takes it out of the trash, with the records that went in with it.
        Codes: `not_found` (404) when it is not in the trash; `invalid_fields`
        (422): `in_trash` when a record it points at is in the trash too,
        `taken` when a unique value of it was taken meanwhile.
        Who may delete it may restore it.
      tags: [{{.Module.Snake}}]
      responses:
        "200":
          description: {{quote (printf "The restored %s." (lower .Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}"
        default:
          $ref: "#/components/responses/Problem"
  /api/v1/{{.Plural.Kebab}}/trash:
    get:
      operationId: listDeleted{{.Plural.Pascal}}
      summary: {{quote (printf "List the trash of %s" (lower .Plural.Label))}}
      description: |
        The {{lower .Plural.Label}} in the trash, the last deleted first, each with
        `deleted_at`: by page, `page` from 1 and `per_page` (25 by default, at
        most 100).{{with index (optionsOf "store") "purge_days"}} After {{.}} days there, they are deleted for good.{{end}}
        Who may delete them sees them.
      tags: [{{.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/PerPage"
      responses:
        "200":
          description: {{quote (printf "A page of the trash of %s." (lower .Plural.Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}Page"
        default:
          $ref: "#/components/responses/Problem"
    delete:
      operationId: emptyTrashOf{{.Plural.Pascal}}
      summary: {{quote (printf "Empty the trash of %s" (lower .Plural.Label))}}
      description: |
        Deletes for good the {{lower .Plural.Label}} in the trash the request may
        delete, but those other records still point at.
      tags: [{{.Module.Snake}}]
      responses:
        "200":
          description: How many were deleted.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Purged"
        default:
          $ref: "#/components/responses/Problem"
  /api/v1/{{.Plural.Kebab}}/trash/{{"{"}}{{$id}}{{"}"}}:
    parameters:
      - name: {{$id}}
        in: path
        required: true
        schema: {type: string, format: uuid}
    delete:
      operationId: purge{{.Pascal}}
      summary: {{quote (printf "Delete a %s for good" (lower .Label))}}
      description: |
        Only one in the trash. Codes: `not_found` (404) when it is not in the
        trash; `in_use` (409) while other records point at it.
      tags: [{{.Module.Snake}}]
      responses:
        "204":
          description: Deleted for good.
        default:
          $ref: "#/components/responses/Problem"
{{- end}}
{{- range links $e}}{{$rel := .}}{{$other := linkParam .}}
  /api/v1/{{$e.Plural.Kebab}}/{{"{"}}{{$id}}{{"}"}}/{{.Kebab}}:
    parameters:
      - name: {{$id}}
        in: path
        required: true
        schema: {type: string, format: uuid}
    get:
      operationId: list{{$e.Pascal}}{{.Pascal}}
      summary: {{quote (printf "List the %s of a %s" (lower .Label) (lower $e.Label))}}
      description: |
        In pages, as the other lists{{if .CrossesModules}}; {{lower .Target.Plural.Label}} of
        the {{.Target.Module.Snake}} module, by ID{{end}}.
        Codes: `not_found` (404) when there is no such {{lower $e.Label}}.
{{- with accessLine $.Entities $e "read"}}
        {{.}}
{{- end}}
      tags: [{{$e.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/After"
        - $ref: "#/components/parameters/Limit"
      responses:
        "200":
          description: {{quote (printf "A page of the %s." (lower .Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{if .CrossesModules}}{{$e.Pascal}}{{.Pascal}}{{else}}{{.Target.Pascal}}{{end}}Page"
        default:
          $ref: "#/components/responses/Problem"
{{- if not .Inferred}}
  /api/v1/{{$e.Plural.Kebab}}/{{"{"}}{{$id}}{{"}"}}/{{.Kebab}}/{{"{"}}{{$other}}{{"}"}}:
    parameters:
      - name: {{$id}}
        in: path
        required: true
        schema: {type: string, format: uuid}
      - name: {{$other}}
        in: path
        required: true
        schema: {type: string, format: uuid}
    put:
      operationId: addTo{{$e.Pascal}}{{.Pascal}}
      summary: {{quote (printf "Add to the %s of a %s" (lower .Label) (lower $e.Label))}}
      description: |
        Adding one already there changes nothing.
        Codes: `not_found` (404) when there is no such record.
{{- with accessLine $.Entities $e "update"}}
        {{.}}
{{- end}}
      tags: [{{$e.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/IfMatch"
      responses:
        "204":
          description: Added.
        default:
          $ref: "#/components/responses/Problem"
    delete:
      operationId: removeFrom{{$e.Pascal}}{{.Pascal}}
      summary: {{quote (printf "Remove from the %s of a %s" (lower .Label) (lower $e.Label))}}
      description: |
        Removing one that is not there changes nothing.
{{- with accessLine $.Entities $e "update"}}
        {{.}}
{{- end}}
      tags: [{{$e.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/IfMatch"
      responses:
        "204":
          description: Removed.
        default:
          $ref: "#/components/responses/Problem"
{{- end}}
{{- end}}
{{- end}}
{{- range .Reports}}
  /api/v1/reports/{{.Kebab}}:
    get:
      operationId: report{{.Pascal}}
      summary: {{quote (printf "The %s report" .Label)}}
      description: |
{{- range .Doc}}
        {{.}}
{{- end}}
        Up to {{reportRows . (optionsOf "rest")}} rows; past them, `too_many_records` (422).
      tags: [{{.Module.Snake}}]
{{- if .Params}}
      parameters:
{{- range .Params}}
        - name: {{.Snake}}
          in: query
          required: {{.Required}}
          schema: {{reportSchema . false}}
{{- end}}
{{- end}}
      responses:
        "200":
          description: {{quote (printf "The %s report's rows." .Label)}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}Report"
        default:
          $ref: "#/components/responses/Problem"
{{- end}}
{{- with slot "rest.paths" .}}
{{.}}
{{- end}}
components:
  parameters:
    After:
      name: after
      in: query
      required: false
      description: The cursor of the page to read, from the previous page's `next`.
      schema: {type: string}
    Limit:
      name: limit
      in: query
      required: false
      description: How many to read, 25 by default.
      schema: {type: integer, minimum: 1, maximum: 100}
    IdempotencyKey:
      name: Idempotency-Key
      in: header
      required: false
      description: |
        A new random UUID for each operation: sending it again (a retry)
        answers what the first answered, without creating twice; another
        body with it answers idempotency_key_reused (422).
      schema: {type: string, maxLength: 255}
    IfMatch:
      name: If-Match
      in: header
      required: false
      description: |
        The ETag the record was read with ("3"): the change is made only if
        the record is still that version, else precondition_failed (412).
        `*` is any version.
      schema: {type: string}
    Page:
      name: page
      in: query
      required: false
      description: The page to read, from 1.
      schema: {type: integer, minimum: 1}
    PerPage:
      name: per_page
      in: query
      required: false
      description: How many a page holds, 25 by default.
      schema: {type: integer, minimum: 1, maximum: 100}
  responses:
    Problem:
      description: The operation failed; `code` says why.
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
{{- with slot "rest.security.schemes" .}}
  securitySchemes:
{{.}}
{{- end}}
  schemas:
{{- if auditedOf .Entities (optionsOf "audit")}}
    AuditPage:
      type: object
      required: [items, page, per_page, total, total_pages]
      properties:
        items: {type: array, items: {$ref: "#/components/schemas/AuditEntry"}}
        page: {type: integer}
        per_page: {type: integer}
        total: {type: integer, format: int64}
        total_pages: {type: integer}
    AuditEntry:
      type: object
      required: [id, at, entity, record_id, action, actor, changes]
      properties:
        id: {type: string, format: uuid}
        at: {type: string, format: date-time}
        entity: {type: string, description: "The entity's plural: products."}
        record_id: {type: string, format: uuid}
        action: {type: string, enum: [create, update, delete, restore, purge]}
        actor: {$ref: "#/components/schemas/AuditActor"}
        changes:
          type: object
          description: "Each field that changed: {from, to}, or {secret: true}."
          additionalProperties: {$ref: "#/components/schemas/AuditFieldChange"}
    AuditActor:
      type: object
      required: [kind, name]
      properties:
        kind: {type: string, enum: [person, service, system]}
        realm: {type: string}
        id: {type: string}
        name: {type: string}
    AuditFieldChange:
      type: object
      properties:
        from: {description: The value before.}
        to: {description: The value after.}
        secret: {type: boolean, description: It changed; its values are not kept.}
{{- end}}
{{- $imports := false}}{{range .Entities}}{{if importable .}}{{$imports = true}}{{end}}{{end}}
{{- if $imports}}
    Imported:
      type: object
      required: [created, updated]
      properties:
        created: {type: integer, description: How many records it created.}
        updated: {type: integer, description: How many records it replaced.}
{{- end}}
{{- $soft := false}}{{range .Entities}}{{if softDeleted .}}{{$soft = true}}{{end}}{{end}}
{{- if $soft}}
    Purged:
      type: object
      required: [purged]
      properties:
        purged: {type: integer, description: How many were deleted for good.}
{{- end}}
    Problem:
      type: object
      description: Problem Details (RFC 9457).
      required: [type, title, status, code]
      properties:
        type: {type: string}
        title: {type: string}
        status: {type: integer, format: int32}
        code: {type: string, description: Stable error code.}
        errors:
          type: array
          description: With `invalid_fields`, every field refused.
          items:
            $ref: "#/components/schemas/FieldProblem"
        request_id: {type: string, description: The request's X-Request-Id.}
    FieldProblem:
      type: object
      required: [field, code]
      properties:
        field: {type: string}
        code: {type: string}
        row: {type: integer, description: "With `import_refused`, the row (from 1) the field is in."}
        limit: {type: integer, description: "With `too_short` or `too_long`, the length the value must reach or not pass: a password's minimum or maximum."}
{{- $money := false}}{{range .Entities}}{{range .Fields}}{{if eq .Type "money"}}{{$money = true}}{{end}}{{end}}{{end}}
{{- range .Reports}}{{range .Columns}}{{if eq .Type "money"}}{{$money = true}}{{end}}{{end}}{{end}}
{{- $files := false}}{{range .Entities}}{{range .Fields}}{{if or (eq .Type "file") (eq .Type "image")}}{{$files = true}}{{end}}{{end}}{{end}}
{{- if $files}}
    StoredFile:
      type: object
      description: A file a record keeps, with a signed link to read it, which expires.
      required: [id, name, size, content_type, url]
      properties:
        id: {type: string, format: uuid}
        name: {type: string, description: The name it was sent with.}
        size: {type: integer, format: int64, description: In bytes.}
        content_type: {type: string}
        url: {type: string, description: A signed link to read it; it expires.}
{{- end}}
{{- if $money}}
    Money:
      type: object
      description: An exact amount of money and its currency.
      required: [amount]
      properties:
        amount: {type: string, format: decimal, description: 'The amount, a decimal number written as a string, e.g. "19.90"; up to four places.'}
        currency:
          type: string
          description: 'Its currency, an ISO 4217 code{{with .App.Currency}}; {{.}} when not sent{{end}}.'
{{- with .App.Currency}}
          default: {{.}} # model rule
{{- end}}
{{- end}}
{{- range .Enums}}{{if .Module.Entities}}
    {{enumName .}}:
      type: string
      enum: [{{range $i, $v := .Values}}{{if $i}}, {{end}}{{quote $v.Raw}}{{end}}]
{{- end}}{{end}}
{{- range .Entities}}{{$e := .}}
    {{.Pascal}}:
      type: object
      description: |
{{- range .Doc}}
        {{.}}
{{- end}}
        Every field comes unless `fields` asks for some: then only those, with
        `id` and `version`.
{{- range readLimits $e (optionsOf "postgres")}}

        `{{.Field.Snake}}` comes only to {{join ", " .Rules}}; the others get the
        record without it, and cannot filter, sort or see its history by it
        (403).
{{- end}}
{{- range flows $e}}

        `{{.Field.Snake}}` changes only as its flow says, from its first state,
        {{.Field.Default.Text}}: {{.Text}}. Another change is refused
        (`not_allowed`); one the person may not make, with 403.
{{- end}}
      required: [id, version, can]
      properties:
        id: {type: string, format: uuid}
        can:
          type: array
          description: What the request's person may do with it, as the API decides{{if flows $e}}; `<field>:<STATE>`, the states they may take a field with a flow to{{end}}.
          items: {type: string, enum: ["update", "delete"{{range canNames $e}}, {{quote .}}{{end}}]}
{{- range inAnswer $e}}
        {{jsonName .}}: {{schema .}}
{{- end}}
{{- range keys $e}}
        {{keyName .}}: {type: string, format: uuid}
{{- end}}
        created_at: {type: string, format: date-time}
        updated_at: {type: string, format: date-time}
        version: {type: integer, description: "Goes up with each change: the ETag, and what If-Match sends back."}
{{- if softDeleted $e}}
        deleted_at: {type: string, format: date-time, description: In the trash, since when.}
{{- end}}
{{- range includable $e}}
{{- if eq .Kind.String "many-to-many"}}
        {{.Snake}}:
          type: array
          description: With `include={{.Snake}}`, up to 100; past them, `{{.Snake}}_more`.
          items: {$ref: "#/components/schemas/{{.Target.Pascal}}"}
        {{.Snake}}_more: {type: boolean, description: "With `include={{.Snake}}`: there are more than the 100 listed."}
{{- else}}
        {{.Snake}}: {$ref: "#/components/schemas/{{.Target.Pascal}}"}
{{- end}}
{{- end}}
    {{.Pascal}}Field:
      type: string
      description: A field of a {{lower .Label}} that `fields` may ask for.
      enum: [{{range $i, $f := answerFields $e}}{{if $i}}, {{end}}{{quote $f}}{{end}}{{range includable $e}}{{$r := .}}{{range answerFields .Target}}, {{quote (printf "%s.%s" $r.Snake .)}}{{end}}{{end}}]
{{- if includable $e}}
    {{.Pascal}}Include:
      type: string
      description: A relation of a {{lower .Label}} that `include` may ask for.
      enum: [{{range $i, $r := includable $e}}{{if $i}}, {{end}}{{quote $r.Snake}}{{end}}]
{{- end}}
    New{{.Pascal}}:
      type: object
{{- $req := false}}{{range inRequest $e}}{{if .Required}}{{$req = true}}{{end}}{{end}}{{range keys $e}}{{if keyInRequest $.Entities $e .}}{{$req = true}}{{end}}{{end}}
{{- if $req}}
      required: [{{$first := true}}{{range inRequest $e}}{{if .Required}}{{if not $first}}, {{end}}{{$first = false}}{{jsonName .}}{{end}}{{end}}{{range keys $e}}{{if keyInRequest $.Entities $e .}}{{if not $first}}, {{end}}{{$first = false}}{{keyName .}}{{end}}{{end}}]
{{- end}}
      properties:
{{- range inRequest $e}}
        {{jsonName .}}: {{writeSchema . false}}
{{- end}}
{{- range keys $e}}
        {{keyName .}}: {type: string, format: uuid}
{{- end}}
{{- range idLinks $e}}
        {{(.IDs).Snake}}:
          type: array
          description: "The {{.Snake}} it is linked to, written with it; left out, they stay as they are, and [] unlinks them all."
          items: {type: string, format: uuid}
{{- end}}
{{- if and (not (inRequest $e)) (not (keys $e)) (not (idLinks $e))}} {}
{{- end}}
{{- if importable $e}}
    {{.Pascal}}Import:
      type: object
      required: [rows]
      properties:
        rows:
          type: array
          description: At most {{importMax}}; past them, `too_many_rows` (422).
          items: {$ref: "#/components/schemas/New{{.Pascal}}"}
{{- end}}
    {{.Pascal}}Changes:
      type: object
      description: Changes to a {{lower .Label}}; only the fields sent change.
      properties:
{{- range inRequest $e}}
        {{jsonName .}}: {{writeSchema . true}}
{{- end}}
{{- range keys $e}}
        {{keyName .}}: {type: string, format: uuid{{if not .Required}}, nullable: true{{end}}}
{{- end}}
{{- range idLinks $e}}
        {{(.IDs).Snake}}:
          type: array
          description: "The {{.Snake}} it is linked to, written with it; left out, they stay as they are, and [] unlinks them all."
          items: {type: string, format: uuid}
{{- end}}
{{- if and (not (inRequest $e)) (not (keys $e)) (not (idLinks $e))}} {}
{{- end}}
    {{.Pascal}}Page:
      type: object
      required: [items, can]
      properties:
        can:
          type: array
          description: What the request's person may do with the list, as the API decides.
          items: {type: string, enum: ["create"]}
        items:
          type: array
          items:
            $ref: "#/components/schemas/{{.Pascal}}"
        next: {type: string, description: The cursor of the next page; absent on the last one.}
        page: {type: integer, description: By page, the page.}
        per_page: {type: integer, description: By page, how many a page holds.}
        total: {type: integer, format: int64, description: By page, how many in all.}
        total_pages: {type: integer, description: By page, how many pages.}
{{- range links $e}}{{if .CrossesModules}}
    {{$e.Pascal}}{{.Pascal}}Page:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items: {type: string, format: uuid}
        next: {type: string, description: The cursor of the next page; absent on the last one.}
{{- end}}{{end}}
{{- end}}
{{- range $e := .Entities}}{{range histories $e}}{{$N := printf "%s%s" $e.Pascal .Pascal}}
    {{$N}}History:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/{{$N}}Point"
    {{$N}}Point:
      type: object
      description: {{quote (printf "A value the %s of a %s took, and when." (lower .Label) (lower $e.Label))}}
      required: [value, at]
      properties:
        value: {{schema .}}
        at: {type: string, format: date-time}
{{- end}}{{end}}
{{- range .Reports}}
    {{.Pascal}}Report:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/{{.Pascal}}Row"
    {{.Pascal}}Row:
      type: object
{{- $req := false}}{{range .Columns}}{{if .Required}}{{$req = true}}{{end}}{{end}}
{{- if $req}}
      required: [{{$first := true}}{{range .Columns}}{{if .Required}}{{if not $first}}, {{end}}{{$first = false}}{{.Snake}}{{end}}{{end}}]
{{- end}}
      properties:
{{- range .Columns}}
        {{.Snake}}: {{reportSchema . (not .Required)}}
{{- end}}
{{- end}}
{{- with slot "rest.schemas" .}}
{{.}}
{{- end}}
{{end -}}
