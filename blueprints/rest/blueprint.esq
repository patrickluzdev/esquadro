/// A JSON API with the contract first: api/openapi.yaml
/// written from the model, the server generated by ogen and mounted at
/// /api/v1, and each module's HTTP part, which translates between the
/// contract and its use cases. Errors are Problem Details: a request that
/// does not match the contract, an Accept without JSON, a body that is not
/// JSON or is too large, and the module's refusals. With testcontainers,
/// the operations get tests through the whole contract.
blueprint rest {
  version "0.1.0"

  /// The largest request body the API reads, in KB; 0 is no limit.
  env MAX_BODY_KB int prefixed field(MaxBodyKB) default("{{.Options.max_body_kb}}")
  requires http, store, migrations
  optional i18n, rate_limit, testcontainers

  /// Title of the API in the contract; the app's name when empty.
  option title string default("")
  /// Largest request body, in KB; 0 turns the limit off.
  /// <APP>_MAX_BODY_KB overrides it.
  option max_body_kb int default(1024)
  /// How lists page, unless an entity says otherwise: cursor (after,
  /// limit, next), page (page, per_page, total) or both; [] lists every
  /// record, up to unpaged_max.
  option pagination list default(["cursor", "page"])
  /// The most records a list without pagination answers; above it, the
  /// list answers too_many_records.
  option unpaged_max int default(1000)
  /// Whether changing or deleting a record needs If-Match with the ETag it
  /// was read with: optional (it is checked when sent) or required (428
  /// without it).
  option if_match name default(optional)
  /// Whether a POST needs an Idempotency-Key: optional (a retry with it
  /// answers the same) or required (428 without it).
  option idempotency name default(optional)
  /// How many hours an Idempotency-Key answers retries.
  option idempotency_hours int default(24)

  annotation entity {
    /// How the entity's list pages: cursor, page, both, or [] (none).
    pagination list
    /// The most records its list answers without pagination.
    unpaged_max int
    /// optional or required, for the entity: see the if_match option.
    if_match name
    /// optional or required, for creating the entity: see the idempotency
    /// option.
    idempotency name
  }

  /// Tags of your own operations in api/openapi.yaml, indented by two.
  slot "rest.tags"
  /// Code in the API tests' newTestServer that sets more of d, the
  /// dependencies, given t and pool.
  slot "rest.test.dependencies"
  /// Code in newTestServer that wraps h, the service's handler, before the
  /// test server serves it.
  slot "rest.test.handler"
  /// Paths of your own operations, indented by two, in full: /api/v1/....
  slot "rest.paths"
  /// Schemas of your own operations, indented by four.
  slot "rest.schemas"
  /// Security schemes, indented by four, under components.securitySchemes.
  slot "rest.security.schemes"
  /// Middleware of the API in newAPI, before ogen's server, one per line
  /// ending with a comma; d is the dependencies, operations ogen's server.
  slot "rest.middleware"

  go_require "github.com/ogen-go/ogen" "v1.24.0"

  hook post-gen "ogen" writes "internal/apigen/**"
}
