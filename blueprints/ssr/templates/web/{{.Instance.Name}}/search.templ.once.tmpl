{{- $n := .Instance.Name -}}
{{- $pages := sitePages .Entities $n -}}
{{- if siteSearch $pages -}}
// The {{$n}} site's search: what it finds of each. Yours.

package {{$n}}

templ SearchPage(v Search) {
	@Layout(v.Page) {
		<h1 class="mb-8 text-2xl font-semibold tracking-tight">{ v.Title }</h1>
{{- range $pages}}{{if .Search}}{{$e := .Entity}}
		if len(v.{{$e.Plural.Pascal}}) > 0 {
			<section class="mb-12">
				<div class="mb-4 flex items-baseline justify-between">
					<h2 class="text-xl font-semibold tracking-tight">{ {{$e.Plural.Pascal}}Label }</h2>
					<a href={ templ.URL({{$e.Plural.Pascal}}URL() + "?q=" + queryEscape(v.Query)) } class="text-sm text-muted-foreground hover:text-foreground">{ T("seeAll") }</a>
				</div>
				<div class="grid grid-cols-2 gap-4 md:grid-cols-4">
					for _, x := range v.{{$e.Plural.Pascal}} {
						@{{$e.Camel}}Card(x)
					}
				</div>
			</section>
		}
{{- end}}{{end}}
		if v.Query != "" {{range $pages}}{{if .Search}}&& len(v.{{.Entity.Plural.Pascal}}) == 0 {{end}}{{end}}{
			@Empty(T("noResults"))
		}
	}
}
{{- end}}
