{{- $n := .Instance.Name -}}
// Generated by esquadro: do not edit. The pieces every page of the site is
// made of: what search engines and shared links read, the list's controls
// and pages, sharing, and the pages of the visitor's account. Your pages
// (layout.templ, home.templ, <entity>.templ) use them.

package {{$n}}

// Head is what search engines and shared links read of a page: its title,
// description, canonical address, Open Graph and structured data; then the
// site's styles and scripts.
templ Head(p Page) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ p.FullTitle() }</title>
	if p.Description != "" {
		<meta name="description" content={ p.Description }/>
	}
	if p.Refresh != "" {
		<meta http-equiv="refresh" content={ p.Refresh }/>
	}
	if p.NoIndex {
		<meta name="robots" content="noindex"/>
	} else {
		<link rel="canonical" href={ templ.URL(p.Canonical) }/>
	}
	<meta property="og:site_name" content={ Name }/>
	<meta property="og:title" content={ p.Title }/>
	<meta property="og:url" content={ p.Canonical }/>
	<meta property="og:type" content="website"/>
	<meta property="og:locale" content={ ogLocale() }/>
	if p.Description != "" {
		<meta property="og:description" content={ p.Description }/>
	}
	if p.Image != "" {
		<meta property="og:image" content={ p.Image }/>
		<meta name="twitter:card" content="summary_large_image"/>
	} else {
		<meta name="twitter:card" content="summary"/>
	}
	if p.Schema != "" {
		@templ.Raw(`<script type="application/ld+json">` + p.Schema + `</script>`)
	}
{{- with siteBrand .App .Options}}{{$b := .}}
{{- if .HasIcon "favicon.ico"}}
	<link rel="icon" href={ URL("/favicon.ico") } sizes="48x48"/>
{{- end}}
{{- if .HasIcon "favicon.svg"}}
	<link rel="icon" href={ URL("/favicon.svg") } type="image/svg+xml"/>
{{- end}}
{{- if .HasIcon "apple-touch-icon.png"}}
	<link rel="apple-touch-icon" href={ URL("/apple-touch-icon.png") }/>
{{- end}}
{{- if .HasIcon "site.webmanifest"}}
	<link rel="manifest" href={ URL("/site.webmanifest") }/>
{{- end}}
	<meta name="theme-color" content="{{.ThemeColor}}"/>
{{- range $name, $font := .Theme.Fonts}}{{range $weight, $file := $font.Files}}
	<link rel="preload" href={ URL("/brand/{{$file}}") } as="font" crossorigin/>
{{- end}}{{end}}
{{- end}}
	<link rel="stylesheet" href={ templ.URL(Asset("site.css")) }/>
	<script src={ Asset("htmx.min.js") } defer></script>
	<script src={ Asset("kit.js") } defer></script>
}

// ProblemPage is the page of something that went wrong: not found, an
// error.
templ ProblemPage(p Page, title, text string) {
	@Layout(p) {
		<section class="mx-auto max-w-xl py-24 text-center">
			@StatePicture(stateOf(p.Status))
			<h1 class="t-section text-3xl font-semibold tracking-tight">{ title }</h1>
			<p class="t-text mt-3 text-muted-foreground">{ text }</p>
			<a href={ templ.URL(URL("/")) } class="btn btn-primary mt-8 inline-flex rounded-lg bg-primary px-4 py-2 font-medium text-primary-foreground">{ T("home") }</a>
		</section>
	}
}

// Controls are a list's search, filters and order: a form that asks for
// the list again, and, with htmx, changes only the list.
templ Controls(action string, filters []Filter, sorts []Option, search bool, q string) {
	<form
		method="get"
		action={ templ.URL(action) }
		class="flex flex-wrap items-end gap-3"
		hx-get={ action }
		hx-target="#results"
		hx-select="#results"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-trigger="change, submit, search"
	>
		if search {
			<label class="grid min-w-56 flex-1 gap-1 text-sm">
				<span class="sr-only">{ T("search") }</span>
				<span class="field flex h-10 items-center gap-2 rounded-lg border border-border bg-background px-3 text-muted-foreground">
					@Icon("search")
					<input type="search" name="q" value={ q } placeholder={ T("searchPlaceholder") } class="h-full min-w-0 flex-1 bg-transparent text-foreground outline-none"/>
				</span>
			</label>
		}
		for _, f := range filters {
			<label class="grid gap-1 text-sm">
				<span class="text-muted-foreground">{ f.Label }</span>
				<select name={ f.Param } class="field h-10 rounded-lg border border-border bg-background px-3">
					for _, o := range f.Options {
						<option value={ o.Value } selected?={ o.Chosen }>{ o.Label }</option>
					}
				</select>
			</label>
		}
		if len(sorts) > 1 {
			<label class="grid gap-1 text-sm">
				<span class="text-muted-foreground">{ T("order") }</span>
				<select name="sort" class="field h-10 rounded-lg border border-border bg-background px-3">
					for _, o := range sorts {
						<option value={ o.Value } selected?={ o.Chosen }>{ o.Label }</option>
					}
				</select>
			</label>
		}
		<noscript><button type="submit" class="h-10 rounded-lg border border-border px-4">{ T("filter") }</button></noscript>
	</form>
}

// Pagination is the links to a list's pages: previous, the page of all,
// next.
templ Pagination(pg Pager) {
	if pg.Pages > 1 {
		<nav class="mt-8 flex items-center justify-between gap-4 text-sm">
			if pg.Number > 1 {
				<a href={ templ.URL(pg.Link(pg.Number - 1)) } rel="prev" class="btn btn-secondary inline-flex items-center gap-1 rounded-lg border border-border px-4 py-2">
					@Icon("chevron-left")
					{ T("previous") }
				</a>
			} else {
				<span></span>
			}
			<span class="text-muted-foreground">{ T("pageOf", "page", Number(int64(pg.Number)), "pages", Number(int64(pg.Pages))) }</span>
			if pg.Number < pg.Pages {
				<a href={ templ.URL(pg.Link(pg.Number + 1)) } rel="next" class="btn btn-secondary inline-flex items-center gap-1 rounded-lg border border-border px-4 py-2">
					{ T("next") }
					@Icon("chevron-right")
				</a>
			} else {
				<span></span>
			}
		</nav>
	}
}

// Share is the button that shares a page: the device's sharing, or
// WhatsApp where there is none.
templ Share(url, title string) {
	<a
		href={ templ.URL("https://wa.me/?text=" + queryEscape(title+" "+url)) }
		data-share={ url }
		data-share-title={ title }
		target="_blank"
		rel="noopener"
		class="btn btn-secondary inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-medium"
	>
		@Icon("share-2")
		{ T("share") }
	</a>
}

// Empty is what a list with nothing shows.
templ Empty(text string) {
	<div class="rounded-xl border border-dashed border-border p-10 text-center text-muted-foreground">
		@StatePicture("empty")
		<p class="t-text">{ text }</p>
	</div>
}

// StatePicture is the brand's picture of a state (empty, not_found, gone,
// error, forbidden, loading, success); nothing without one.
templ StatePicture(state string) {
	if src := statePictures[state]; src != "" {
		<img src={ URL("/brand/" + src) } alt="" class="state-picture" width="140" height="140"/>
	}
}

// Logo is the site's logo, from its brand; its name without one.
templ Logo() {
{{- with siteBrand .App .Options}}{{with .Theme.Identity.Logo}}
	<img src={ URL("/brand/{{.}}") } alt={ Name } class="h-8 w-auto"/>
{{- else}}
	<span class="text-lg font-semibold tracking-tight">{ Name }</span>
{{- end}}{{else}}
	<span class="text-lg font-semibold tracking-tight">{ Name }</span>
{{- end}}
}

// Icon is an icon by name, of the text's size and color: the kit's are
// Lucide's (icons_gen.go), unless icons.go, which is yours, gives its own;
// a name of yours draws yours. Nothing for a name neither has.
templ Icon(name string) {
	@templ.Raw(iconSVG(name))
}

// The visitor's account.

// AuthFrame is the frame of the pages of signing in: a narrow card.
templ AuthFrame(p Page, title, hint string) {
	@Layout(p) {
		@templ.Raw(`<script id="site-words" type="application/json">` + authWords() + `</script>`)
		<section class="mx-auto w-full max-w-sm py-16">
			<h1 class="t-section text-2xl font-semibold tracking-tight">{ title }</h1>
			if hint != "" {
				<p class="mt-2 text-sm text-muted-foreground">{ hint }</p>
			}
			<div class="mt-8">
				{ children... }
			</div>
		</section>
	}
}

// field is a labeled input of an account's form.
templ field(name, label, kind, autocomplete string) {
	<label class="grid gap-1 text-sm">
		<span>{ label }</span>
		<input name={ name } type={ kind } autocomplete={ autocomplete } required class="field h-10 rounded-lg border border-border bg-background px-3"/>
	</label>
}

// formMessage is where an account's form tells how it went.
templ formMessage() {
	<p data-message role="status" class="notice notice-info hidden rounded-lg bg-muted p-3 text-sm"></p>
}

templ submit(label string) {
	<button type="submit" class="btn btn-primary btn-wide h-10 w-full rounded-lg bg-primary font-medium text-primary-foreground disabled:opacity-60">{ label }</button>
}

// SignInPage signs the visitor in: email and password, and the realm's
// providers.
templ SignInPage(p Page, a Account) {
	@AuthFrame(p, T("welcomeBack"), T("signInHint")) {
		<form data-identity={ a.Identity + "/sign-in" } data-next={ a.Next } class="grid gap-4">
			@field("email", T("email"), "email", "email")
			@field("password", T("password"), "password", "current-password")
			@formMessage()
			@submit(T("signIn"))
		</form>
		<a href={ templ.URL(URL(paths.forgot)) } class="mt-4 block text-sm text-muted-foreground underline">{ T("forgotPassword") }</a>
		if len(a.Providers) > 0 {
			<p class="mt-8 text-center text-xs uppercase text-muted-foreground">{ T("orContinueWith") }</p>
			<div class="mt-3 grid gap-2">
				for _, pr := range a.Providers {
					<a href={ templ.URL(pr.URL) } class="flex h-10 items-center justify-center rounded-lg border border-border text-sm font-medium">{ T("continueWith", "provider", pr.Name) }</a>
				}
			</div>
		}
		if a.SignUp {
			<p class="mt-8 text-sm">{ T("noAccountYet") } <a href={ templ.URL(URL(paths.signup)) } class="font-medium underline">{ T("signUp") }</a></p>
		}
	}
}

// SignUpPage creates an account: the realm's own fields, email and
// password.
templ SignUpPage(p Page, a Account) {
	@AuthFrame(p, T("signUp"), T("signUpHint")) {
		<form data-identity={ a.Identity + "/sign-up" } data-done={ T("signedUp") } class="grid gap-4">
			for _, f := range a.Fields {
				@field(f.Name, f.Label, "text", f.Autocomplete)
			}
			@field("email", T("email"), "email", "email")
			@field("password", T("password"), "password", "new-password")
			@formMessage()
			@submit(T("signUp"))
		</form>
		if len(a.Providers) > 0 {
			<div class="mt-6 grid gap-2">
				for _, pr := range a.Providers {
					<a href={ templ.URL(pr.URL) } class="flex h-10 items-center justify-center rounded-lg border border-border text-sm font-medium">{ T("continueWith", "provider", pr.Name) }</a>
				}
			</div>
		}
		<p class="mt-8 text-sm">{ T("haveAccount") } <a href={ templ.URL(URL(paths.signin)) } class="font-medium underline">{ T("signIn") }</a></p>
	}
}

// ForgotPage sends the link to set a new password.
templ ForgotPage(p Page, a Account) {
	@AuthFrame(p, T("forgotPassword"), T("forgotHint")) {
		<form data-identity={ a.Identity + "/password/forgot" } data-redirect={ a.Reset } data-done={ T("linkSent") } class="grid gap-4">
			@field("email", T("email"), "email", "email")
			@formMessage()
			@submit(T("sendLink"))
		</form>
		<a href={ templ.URL(URL(paths.signin)) } class="mt-4 block text-sm text-muted-foreground underline">{ T("backToSignIn") }</a>
	}
}

// ResetPage sets a new password, with the link's token.
templ ResetPage(p Page, a Account) {
	@AuthFrame(p, T("newPassword"), T("resetHint")) {
		<form data-identity={ a.Identity + "/password/reset" } data-token={ a.Token } data-done={ T("passwordSet") } class="grid gap-4">
			@field("new_password", T("newPassword"), "password", "new-password")
			@formMessage()
			@submit(T("setPassword"))
		</form>
		<a href={ templ.URL(URL(paths.signin)) } class="mt-4 block text-sm text-muted-foreground underline">{ T("backToSignIn") }</a>
	}
}

// ConfirmPage confirms the visitor's email, with the link's token.
templ ConfirmPage(p Page, a Account) {
	@AuthFrame(p, T("emailConfirmed"), "") {
		<form data-identity={ a.Identity + "/verify-email" } data-token={ a.Token } data-auto data-done={ T("emailConfirmedHint") } class="grid gap-4">
			@formMessage()
		</form>
		<a href={ templ.URL(URL(paths.signin)) } class="mt-4 block text-sm underline">{ T("signIn") }</a>
	}
}

// AccountPage is the visitor's account: signing out, and deleting it.
templ AccountPage(p Page, a Account) {
	@AuthFrame(p, T("myAccount"), "") {
		<form data-identity={ a.Identity + "/sign-out" } data-csrf data-next={ URL("/") } class="grid gap-4">
			@formMessage()
			@submit(T("signOut"))
		</form>
		<form data-identity={ a.Identity } data-method="DELETE" data-csrf data-confirm={ T("deleteAccountHint") } data-next={ URL("/") } class="mt-12 grid gap-3 border-t border-border pt-8">
			<h2 class="font-medium">{ T("deleteAccount") }</h2>
			<p class="text-sm text-muted-foreground">{ T("deleteAccountHint") }</p>
			<button type="submit" class="h-10 rounded-lg border border-destructive font-medium text-destructive">{ T("deleteAccountConfirm") }</button>
		</form>
	}
}
