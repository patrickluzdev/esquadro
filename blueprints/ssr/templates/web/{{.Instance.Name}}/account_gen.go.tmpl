{{- $n := .Instance.Name -}}
{{- $o := .Options -}}
{{- $sys := sitePaths $o.locale -}}
{{- $realm := realmOf .Entities $o -}}
{{- $sec := optionsOf "security" -}}
// Generated by esquadro: do not edit. The visitor's account on the {{$n}}
// site: signing in and up, the forgotten password, the email confirmed and
// the account, as pages; their forms call the app's identity routes
// (kit.js).
package {{$n}}

import (
	_ "embed"
	"encoding/json"
	"net/http"
	"net/url"
	"regexp"
	"strings"

	"github.com/a-h/templ"
)

// paths are the addresses of the site's own pages, in its language.
var paths = struct {
	search, signin, signup, forgot, reset, account, confirm string
}{
	search: "/{{$sys.search}}", signin: "/{{$sys.signin}}", signup: "/{{$sys.signup}}", forgot: "/{{$sys.forgot}}",
	reset: "/{{$sys.reset}}", account: "/{{$sys.account}}", confirm: "/{{$sys.confirm}}",
}

// SignInURL, SignUpURL and AccountURL are the addresses of the account's
// pages, as links write them.
func SignInURL() string  { return URL(paths.signin) }
func SignUpURL() string  { return URL(paths.signup) }
func AccountURL() string { return URL(paths.account) }

// identity is where the realm's identity routes are.
const identity = {{quote (printf "%s/%s" (or $sec.path "/identity") $realm.Name)}}

// signUpOpen is whether anyone may create an account.
const signUpOpen = {{eq $realm.Signup "open"}}

// SignUpOpen reports whether the site offers to create an account.
func SignUpOpen() bool { return signUpOpen }

// Account is what the account's pages know: where the identity routes are,
// the providers, the fields of a new account, and a link's token.
type Account struct {
	Identity  string
	Providers []Provider
	Fields    []AccountField
	SignUp    bool
	// Next is where signing in goes back to; Reset and Confirm, the
	// addresses of the pages a forgotten password's link and an email's
	// confirmation open; Token, a link's token.
	Next, Reset, Confirm, Token string
}

// Provider is a way to sign in with an account elsewhere: Google.
type Provider struct {
	Name, URL string
}

// AccountField is a field of a new account besides its email and
// password: the name.
type AccountField struct {
	Name, Label, Autocomplete string
}

//go:embed kit.js
var kitJS []byte

func (s *Site) accountRoutes(m *http.ServeMux) {
	m.HandleFunc("GET /{{$sys.assets}}/kit.js", func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "text/javascript; charset=utf-8")
		assetCache(w, r, "kit.js")
		_, _ = w.Write(kitJS)
	})
	m.HandleFunc("GET "+paths.signin, func(w http.ResponseWriter, r *http.Request) {
		s.authPage(w, r, T("signIn"), SignInPage)
	})
	if signUpOpen {
		m.HandleFunc("GET "+paths.signup, func(w http.ResponseWriter, r *http.Request) {
			s.authPage(w, r, T("signUp"), SignUpPage)
		})
	}
	m.HandleFunc("GET "+paths.forgot, func(w http.ResponseWriter, r *http.Request) {
		s.authPage(w, r, T("forgotPassword"), ForgotPage)
	})
	m.HandleFunc("GET "+paths.reset, func(w http.ResponseWriter, r *http.Request) {
		s.authPage(w, r, T("newPassword"), ResetPage)
	})
	m.HandleFunc("GET "+paths.confirm, func(w http.ResponseWriter, r *http.Request) {
		s.authPage(w, r, T("emailConfirmed"), ConfirmPage)
	})
	m.HandleFunc("GET "+paths.account, func(w http.ResponseWriter, r *http.Request) {
		p := s.page(r, T("myAccount"), "")
		if !p.SignedIn {
			http.Redirect(w, r, URL(paths.signin)+"?next="+url.QueryEscape(URL(paths.account)), http.StatusFound)
			return
		}
		s.authPage(w, r, T("myAccount"), AccountPage)
	})
}

// authPage answers a page of the account, never kept by search engines or
// caches.
func (s *Site) authPage(w http.ResponseWriter, r *http.Request, title string, page func(Page, Account) templ.Component) {
	p := s.page(r, title, "")
	p.NoIndex = true
	a := Account{Identity: identity, SignUp: signUpOpen, Token: r.URL.Query().Get("token"), Next: next(r),
		Reset: back(URL(paths.reset)), Confirm: back(URL(paths.confirm))}
{{- range $realm.Providers}}{{if ne . "password"}}
	a.Providers = append(a.Providers, Provider{Name: {{quote (printf "%s" . | humanize)}}, URL: identity + "/oauth/{{.}}?redirect=" + url.QueryEscape(back(a.Next))})
{{- end}}{{end}}
{{- range $realm.Entity.Fields}}{{if and .Required (not .Implicit) (or (eq (printf "%v" .Type) "string") (eq (printf "%v" .Type) "text"))}}
	a.Fields = append(a.Fields, AccountField{Name: {{quote .Snake}}, Label: {{quote (siteLabel .Ann $n .Label)}}, Autocomplete: {{if eq .Snake "name"}}"name"{{else}}"off"{{end}}})
{{- end}}{{end}}
	w.Header().Set("Cache-Control", "no-store")
	s.render(w, r, http.StatusOK, page(p, a))
}

// next is where signing in goes back to: ?next=, when it is a path of the
// site, or its first page.
func next(r *http.Request) string {
	n := r.URL.Query().Get("next")
	if strings.HasPrefix(n, URL("/")) && !strings.HasPrefix(n, "//") {
		return n
	}
	return URL("/")
}

// back is where a provider or an email's link sends the visitor back to: a
// path on the app's domain, or the address of the site's domain on one of
// its own (which the security blueprint allows, and in development opens
// on the site's alias).
func back(path string) string {
	if Domain == "" {
		return path
	}
	return "https://" + Domain + strings.TrimPrefix(path, Path)
}

// ogLocale is the site's language as Open Graph writes it: pt_BR.
func ogLocale() string { return strings.ReplaceAll(Locale, "-", "_") }

func queryEscape(s string) string { return url.QueryEscape(s) }

var tags = regexp.MustCompile(`<[^>]*>`)

// summary is a text as a page's description: no markup, one line, up to
// 160 characters.
func summary(text string) string {
	s := strings.Join(strings.Fields(tags.ReplaceAllString(text, " ")), " ")
	if r := []rune(s); len(r) > 160 {
		s = strings.TrimSpace(string(r[:157])) + "…"
	}
	return s
}

// authWords are the words kit.js says: a problem by its code, offline.
func authWords() string {
	b, _ := json.Marshal(map[string]string{
		"error_invalid_credentials": T("badCredentials"),
		"error_email_taken":         T("emailTaken"),
		"error_invalid_token":       T("invalidLink"),
		"error_too_many_requests":   T("tooMany"),
		"error_session_ended":       T("sessionEnded"),
		"error_email_not_verified":  T("emailNotConfirmed"),
		"somethingWrong":            T("somethingWrong"),
		"offline":                   T("offline"),
	})
	return string(b)
}
