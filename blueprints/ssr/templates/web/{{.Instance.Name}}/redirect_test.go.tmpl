// noFollow is a client that answers a redirect instead of following it.
var noFollow = &http.Client{CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}

// get asks for url as userAgent, without following a redirect: the
// answer, and its body.
func get(t *testing.T, url, userAgent string) (*http.Response, string) {
	t.Helper()
	req, err := http.NewRequestWithContext(context.Background(), http.MethodGet, url, nil)
	if err != nil {
		t.Fatal(err)
	}
	req.Header.Set("User-Agent", userAgent)
	res, err := noFollow.Do(req)
	if err != nil {
		t.Fatal(err)
	}
	defer res.Body.Close()
	body, err := io.ReadAll(res.Body)
	if err != nil {
		t.Fatal(err)
	}
	return res, string(body)
}

{{- range $redirects}}{{$e := .Entity}}{{$p := $e.Module.Snake}}

// TestRedirect{{$e.Pascal}} visits a {{lower $e.Label}}'s address: {{if .Wait}}a person sees the
// page of where it goes, a link's preview is sent on{{else}}it sends on, as a
// person or as a link's preview{{end}}, and an address of none is not found.
func TestRedirect{{$e.Pascal}}(t *testing.T) {
{{- if canRedirectSample .}}
	t.Parallel()
	ctx := context.Background()
	m := {{$p}}.New({{$p}}.Deps{Pool: postgrestest.Fresh(t)})
	i := 1
	n := {{$p}}.New{{$e.Pascal}}{
{{- range $e.Fields}}{{if written .}}{{$f := .}}{{with siteSample $f $p "i"}}
		{{$f.Pascal}}: {{.}},
{{- end}}{{end}}{{end}}
	}
	n.{{.To.Pascal}} = "https://example.com/to"
	x, err := m.Create{{$e.Pascal}}(ctx, n)
	if err != nil {
		t.Fatal(err)
	}
	srv := httptest.NewServer(New(Deps{ {{- $e.Module.Pascal}}: m, VisitorSecret: []byte("test"), Logger: slog.New(slog.DiscardHandler)}))
	t.Cleanup(srv.Close)
	at := srv.URL + "/{{with .Path}}{{.}}/{{end}}"
{{- if .Wait}}
	res, body := get(t, at+x.{{.By.Pascal}}, "Mozilla/5.0 (a person)")
	if res.StatusCode != http.StatusOK || res.Header.Get("Cache-Control") != "no-store" ||
		!strings.Contains(body, `http-equiv="refresh"`) || !strings.Contains(body, "https://example.com/to") {
		t.Fatalf("a person: %d (%s), want the page of where it goes:\n%s", res.StatusCode, res.Header.Get("Cache-Control"), body)
	}
	agents := []string{"WhatsApp/2.24"}
{{- else}}
	agents := []string{"Mozilla/5.0 (a person)", "WhatsApp/2.24"}
{{- end}}
	for _, agent := range agents {
		res, _ := get(t, at+x.{{.By.Pascal}}, agent)
		if res.StatusCode != http.StatusFound || res.Header.Get("Location") != "https://example.com/to" || res.Header.Get("Cache-Control") != "no-store" {
			t.Fatalf("%s: %d to %q (%s)", agent, res.StatusCode, res.Header.Get("Location"), res.Header.Get("Cache-Control"))
		}
	}
	if res, _ := get(t, at+"no-such-{{$e.Snake}}", "Mozilla/5.0"); res.StatusCode != http.StatusNotFound {
		t.Fatalf("an address of no {{lower $e.Label}}: %d, want 404", res.StatusCode)
	}
{{- else}}
	t.Skip("esquadro cannot write a {{$e.Pascal}} by itself (a required relation or a field with a pattern): test its redirect by hand")
{{- end}}
}
