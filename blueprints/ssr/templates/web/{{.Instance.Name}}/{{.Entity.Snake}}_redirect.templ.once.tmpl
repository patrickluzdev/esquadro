{{- if siteRedirect .Entities .Instance.Name .Entity -}}
// The page a person sees on the way from a {{.Entity.Pascal}}'s address to another
// site, when its redirect has a wait: where they are going, the seconds
// counted down, and a link to go at once. Yours: esquadro wrote it once,
// and merges its changes into yours.

package {{.Instance.Name}}

import "strconv"

// {{.Entity.Pascal}}RedirectPage goes on by itself after v.Wait seconds: the page's
// refresh, and kit.js, which counts them down and fills the bar.
templ {{.Entity.Pascal}}RedirectPage(v {{.Entity.Pascal}}Redirect) {
	@Layout(v.Page) {
		<section class="mx-auto max-w-md py-24 text-center" data-countdown={ strconv.Itoa(v.Wait) } data-to={ v.To }>
			<h1 class="t-section text-2xl font-semibold tracking-tight">{ T("redirectTitle", "host", v.Host) }</h1>
			<p class="t-text mt-3 text-muted-foreground" aria-live="polite" data-countdown-text={ T("redirectWait") }>{ T("redirectWait", "n", strconv.Itoa(v.Wait)) }</p>
			<div class="progress mt-8 h-1.5 overflow-hidden rounded-full bg-muted">
				<i class="block h-full w-0 bg-primary transition-[width] duration-1000 ease-linear" data-countdown-bar></i>
			</div>
			<a href={ templ.URL(v.To) } class="btn btn-primary mt-8 inline-flex rounded-lg bg-primary px-4 py-2 font-medium text-primary-foreground">{ T("redirectGo") }</a>
		</section>
	}
}
{{- end}}
