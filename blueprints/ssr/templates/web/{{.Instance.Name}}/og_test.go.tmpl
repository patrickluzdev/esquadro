{{- if and (siteOG $pages) (uses "images") (uses "testcontainers") -}}
{{- $tested := ogTested $pages -}}
// Generated by esquadro: do not edit.

package {{$n}}
{{- if not $tested}}

import "testing"
{{- else}}

{{importBlock "bytes" "context" "image/png" "io" "log/slog" "net/http" "net/http/httptest" "strings" "testing" "uuid" (ogSampleImports $pages) (ogPackages .App.Module $tested) (printf "%s/internal/platform/postgres/postgrestest" .App.Module) (printf "%s/internal/platform/storage" .App.Module)}}
// fetchOG asks for an Open Graph image, with an ETag it has (or ""): the
// answer and its body.
func fetchOG(t *testing.T, url, etag string) (*http.Response, []byte) {
	t.Helper()
	req, err := http.NewRequestWithContext(context.Background(), http.MethodGet, url, nil)
	if err != nil {
		t.Fatal(err)
	}
	if etag != "" {
		req.Header.Set("If-None-Match", etag)
	}
	res, err := http.DefaultClient.Do(req)
	if err != nil {
		t.Fatal(err)
	}
	defer res.Body.Close()
	body, err := io.ReadAll(res.Body)
	if err != nil {
		t.Fatal(err)
	}
	return res, body
}
{{- end}}
{{- range $pages}}{{if .OG}}{{$e := .Entity}}{{$pg := .}}{{$p := $e.Module.Snake}}

// TestOG{{$e.Pascal}} draws a {{lower $e.Label}}'s Open Graph image: a PNG of 1200x630,
// kept in the store and served from it again, not sent to who has it, and
// drawn again when the {{lower $e.Label}} changes.
func TestOG{{$e.Pascal}}(t *testing.T) {
{{- if and (ogSample $e) (ogPublic $e)}}
	t.Parallel()
	ctx := context.Background()
	pool := postgrestest.Fresh(t)
	store, err := storage.Open(ctx, storage.Config{URL: "mem://"}, pool)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { store.Close() })
	m := {{$p}}.New({{$p}}.Deps{Pool: pool, Files: store})
{{- range ogParents $e}}{{$t := .Target}}
	{{.Camel}}, err := m.Create{{$t.Pascal}}(ctx, {{$p}}.New{{$t.Pascal}}{
{{- range $t.Fields}}{{if written .}}{{$f := .}}{{with siteSample $f $p "1"}}
		{{$f.Pascal}}: {{.}},
{{- end}}{{end}}{{end}}
	})
	if err != nil {
		t.Fatal(err)
	}
{{- end}}
	given := func(i int) {{$p}}.New{{$e.Pascal}} {
		return {{$p}}.New{{$e.Pascal}}{
{{- range $e.Fields}}{{if written .}}{{$f := .}}{{with siteSample $f $p "i"}}
			{{$f.Pascal}}: {{.}},
{{- end}}{{end}}{{end}}
{{- range $e.Relations}}{{if and .OwnsForeignKey .Required}}
{{- if eq .Target.Module $e.Module}}
			{{.Pascal}}ID: {{.Camel}}.ID,
{{- else}}
			{{.Pascal}}ID: uuid.NewV7(), // in another module: no foreign key
{{- end}}
{{- end}}{{end}}
		}
	}
	x, err := m.Create{{$e.Pascal}}(ctx, given(1))
	if err != nil {
		t.Fatal(err)
	}
	srv := httptest.NewServer(New(Deps{ {{- $e.Module.Pascal}}: m, Storage: store, Logger: slog.New(slog.DiscardHandler)}))
	t.Cleanup(srv.Close)
	at := srv.URL + "/{{$pg.Path}}/" + x.ID.String() + "/og.png"
	if !shown{{$e.Pascal}}(x) {
		// shown.go hides it: its picture is not found, as its page.
		if res, _ := fetchOG(t, at, ""); res.StatusCode != http.StatusNotFound {
			t.Fatalf("the picture of a {{lower $e.Label}} shown.go hides: %d, want 404", res.StatusCode)
		}
		t.Skip("shown.go hides the {{lower $e.Label}} this test makes: its drawing is left to your tests")
	}

	res, first := fetchOG(t, at, "")
	if res.StatusCode != http.StatusOK || res.Header.Get("Content-Type") != "image/png" {
		t.Fatalf("%d %s, want a PNG", res.StatusCode, res.Header.Get("Content-Type"))
	}
	img, err := png.Decode(bytes.NewReader(first))
	if err != nil {
		t.Fatal(err)
	}
	if b := img.Bounds(); b.Dx() != 1200 || b.Dy() != 630 {
		t.Fatalf("an image of %dx%d, want 1200x630", b.Dx(), b.Dy())
	}
	etag := res.Header.Get("ETag")
	if etag == "" || !strings.Contains(res.Header.Get("Cache-Control"), "max-age") {
		t.Fatalf("ETag %q, Cache-Control %q", etag, res.Header.Get("Cache-Control"))
	}

	// Kept in the store, and served from it.
	key := "images/{{$n}}/{{$e.Plural.Snake}}/" + x.ID.String() + "/" + {{$e.Camel}}OGName(x) + ".png"
	if kept, ok, err := store.Object(ctx, key); err != nil || !ok || !bytes.Equal(kept, first) {
		t.Fatalf("kept under %s: %v, %v", key, ok, err)
	}
	marked := append(bytes.Clone(first), []byte("kept")...)
	if err := store.PutObject(ctx, key, marked, "image/png"); err != nil {
		t.Fatal(err)
	}
	if res, again := fetchOG(t, at, ""); res.StatusCode != http.StatusOK || !bytes.Equal(again, marked) {
		t.Fatalf("again: %d, %d bytes, want what the store keeps", res.StatusCode, len(again))
	}
	if res, _ := fetchOG(t, at, etag); res.StatusCode != http.StatusNotModified {
		t.Fatalf("with its ETag: %d, want 304", res.StatusCode)
	}
{{- if eq (len (sitePageModules $.Entities $.Modules $n $e)) 1}}

	// The page's og:image is it.
	page, body := fetchOG(t, srv.URL+{{$e.Pascal}}Path(x), "")
	// The site's own address: its domain's, or the test server's.
	base := srv.URL
	if Domain != "" {
		base = "https://" + Domain
	}
	if page.StatusCode != http.StatusOK || !strings.Contains(string(body), `property="og:image" content="`+base+URL({{$e.Pascal}}OGPath(x))) {
		t.Fatalf("the page (%d) has no og:image of %s:\n%s", page.StatusCode, {{$e.Pascal}}OGPath(x), body)
	}
{{- end}}

	// A change draws it again.
	changed, err := m.Update{{$e.Pascal}}(ctx, x.ID, x.Version, given(2))
	if err != nil {
		t.Fatal(err)
	}
	res, drawn := fetchOG(t, at, etag)
	if res.StatusCode != http.StatusOK || res.Header.Get("ETag") == etag || bytes.Equal(drawn, marked) {
		t.Fatalf("after a change: %d, ETag %s", res.StatusCode, res.Header.Get("ETag"))
	}
	if _, ok, _ := store.Object(ctx, key); ok {
		t.Fatal("the image before the change is still kept")
	}
	if _, ok, _ := store.Object(ctx, "images/{{$n}}/{{$e.Plural.Snake}}/"+x.ID.String()+"/"+{{$e.Camel}}OGName(changed)+".png"); !ok {
		t.Fatal("the image after the change is not kept")
	}

	if res, _ := fetchOG(t, srv.URL+"/{{$pg.Path}}/"+uuid.NewV7().String()+"/og.png", ""); res.StatusCode != http.StatusNotFound {
		t.Fatalf("of no {{lower $e.Label}}: %d, want 404", res.StatusCode)
	}
{{- else}}
	t.Skip("esquadro cannot write a {{$e.Pascal}} by itself, or it is not public: test its image by hand")
{{- end}}
}
{{- end}}{{end}}
{{- end}}
