{{- end}}
)

var (
	_ = strings.TrimSpace
	_ uuid.UUID
)

// {{$e.Pascal}}List is the page of the list of {{lower $e.Plural.Label}}.
type {{$e.Pascal}}List struct {
	Page
	Items []{{$m}}.{{$e.Pascal}}
	Pager Pager
	// Filters are the list's filters, with what is chosen; Sorts, its
	// orders.
	Filters []Filter
	Sorts   []Option
{{- range $pg.Keys}}
	// {{.Pascal}} are the {{lower .Label}} of the records listed, by id.
	{{.Pascal}} map[uuid.UUID]{{.Target.Module.Snake}}.{{.Target.Pascal}}
{{- end}}
}

// {{$e.Pascal}}View is the page of a {{lower $e.Label}}.
type {{$e.Pascal}}View struct {
	Page
	Item {{$m}}.{{$e.Pascal}}
{{- range $pg.Keys}}
	// {{.Pascal}} is its {{lower .Label}}, when the reader may see it.
	{{.Pascal}} *{{.Target.Module.Snake}}.{{.Target.Pascal}}
{{- end}}
{{- range $pg.Lists}}
	// {{.Relation.Pascal}} are its {{lower .Relation.Label}}: the latest, up to a page.
	{{.Relation.Pascal}} []{{.Target.Module.Snake}}.{{.Target.Pascal}}
{{- end}}
}

// {{$e.Pascal}}Path is the path of a {{lower $e.Label}}'s page{{if $pg.Key}}: the slug of its title, then
// its {{lower $pg.Key.Label}} (/{{$pg.Path}}/<slug>-<{{$pg.Key.Snake}}>); by id without one it can end it
// with (/{{$pg.Path}}/<id>/<slug>){{end}}.
func {{$e.Pascal}}Path(x {{$m}}.{{$e.Pascal}}) string {
{{- if $pg.Key}}
	if keyed(x.{{$pg.Key.Pascal}}) {
		return "/{{$pg.Path}}/" + keyPath({{$e.Pascal}}Title(x), x.{{$pg.Key.Pascal}})
	}
{{- end}}
	return "/{{$pg.Path}}/" + x.ID.String() + "/" + Slug({{$e.Pascal}}Title(x))
}

// {{$e.Pascal}}URL is the address of a {{lower $e.Label}}'s page, as links write it.
func {{$e.Pascal}}URL(x {{$m}}.{{$e.Pascal}}) string { return URL({{$e.Pascal}}Path(x)) }

// {{$e.Pascal}}Title is what a {{lower $e.Label}} is called.
func {{$e.Pascal}}Title(x {{$m}}.{{$e.Pascal}}) string { return x.{{$pg.Title.Pascal}} }

// {{$e.Plural.Pascal}}URL is the address of the list of {{lower $e.Plural.Label}}.
func {{$e.Plural.Pascal}}URL() string { return URL("/{{$pg.Path}}") }

// {{$e.Pascal}}Description is what a {{lower $e.Label}}'s page is described as{{if $pg.Description}}: its
// {{lower $pg.Description.Label}}, or without one{{end}}, what it is called{{if and (eq $pg.Schema "product") $pg.Price}} and its price{{end}}, on the site.
func {{$e.Pascal}}Description(x {{$m}}.{{$e.Pascal}}) string {
{{- if $pg.Description}}
	if d := summary(x.{{$pg.Description.Pascal}}); d != "" {
		return d
	}
{{- end}}
{{- if and (eq $pg.Schema "product") $pg.Price}}
	if price := Money(x.{{$pg.Price.Pascal}}); price != "" {
		return T("recordPriceDescription", "title", {{$e.Pascal}}Title(x), "price", price, "site", Name)
	}
{{- end}}
	return T("recordDescription", "title", {{$e.Pascal}}Title(x), "site", Name)
}
{{- range $b := $pg.Browses}}
{{- if $b.Relation}}{{$t := $b.Relation.Target}}{{$tm := $t.Module.Snake}}

// {{$e.Plural.Pascal}}By{{$b.Pascal}}Path is the path of the list of the {{lower $e.Plural.Label}} of a
// {{lower $t.Label}}: /{{$pg.Path}}/{{with $b.Segment}}{{.}}/{{end}}<slug of its {{lower $b.Title.Label}}>.
func {{$e.Plural.Pascal}}By{{$b.Pascal}}Path(x {{$tm}}.{{$t.Pascal}}) string {
	return "/{{$pg.Path}}/{{with $b.Segment}}{{.}}/{{end}}" + Slug(x.{{$b.Title.Pascal}})
