{{- $n := .Instance.Name -}}
{{- $pg := sitePage .Entities $n .Entity -}}
{{- if $pg -}}
{{- $e := .Entity -}}
{{- $m := $e.Module.Snake -}}
{{- $M := $e.Module.Pascal -}}
{{- $images := and $pg.Image (uses "storage") -}}
// Generated by esquadro from the model: do not edit. The {{lower $e.Plural.Label}} of
// the {{$n}} site: their list, at /{{$pg.Path}}, and a page for each, at
// /{{$pg.Path}}/<id>/<slug>. {{$e.Snake}}.templ, yours, shows them.
package {{$n}}

import (
	"errors"
	"net/http"
	"slices"
	"strings"
	"uuid"
{{range $mod := sitePageModules .Entities .Modules $n $e}}
	"{{$.App.Module}}/internal/{{$mod.Snake}}"
{{- end}}
)

var (
	_ = strings.TrimSpace
	_ uuid.UUID
)

// {{$e.Pascal}}List is the page of the list of {{lower $e.Plural.Label}}.
type {{$e.Pascal}}List struct {
	Page
	Items []{{$m}}.{{$e.Pascal}}
	Pager Pager
	// Filters are the list's filters, with what is chosen; Sorts, its
	// orders.
	Filters []Filter
	Sorts   []Option
{{- range $pg.Keys}}
	// {{.Pascal}} are the {{lower .Label}} of the records listed, by id.
	{{.Pascal}} map[uuid.UUID]{{.Target.Module.Snake}}.{{.Target.Pascal}}
{{- end}}
}

// {{$e.Pascal}}View is the page of a {{lower $e.Label}}.
type {{$e.Pascal}}View struct {
	Page
	Item {{$m}}.{{$e.Pascal}}
{{- range $pg.Keys}}
	// {{.Pascal}} is its {{lower .Label}}, when the reader may see it.
	{{.Pascal}} *{{.Target.Module.Snake}}.{{.Target.Pascal}}
{{- end}}
{{- range $pg.Lists}}
	// {{.Relation.Pascal}} are its {{lower .Relation.Label}}: the latest, up to a page.
	{{.Relation.Pascal}} []{{.Target.Module.Snake}}.{{.Target.Pascal}}
{{- end}}
}

// {{$e.Pascal}}Path is the path of a {{lower $e.Label}}'s page.
func {{$e.Pascal}}Path(x {{$m}}.{{$e.Pascal}}) string {
	return "/{{$pg.Path}}/" + x.ID.String() + "/" + Slug({{$e.Pascal}}Title(x))
}

// {{$e.Pascal}}URL is the address of a {{lower $e.Label}}'s page, as links write it.
func {{$e.Pascal}}URL(x {{$m}}.{{$e.Pascal}}) string { return URL({{$e.Pascal}}Path(x)) }

// {{$e.Pascal}}Title is what a {{lower $e.Label}} is called.
func {{$e.Pascal}}Title(x {{$m}}.{{$e.Pascal}}) string { return x.{{$pg.Title.Pascal}} }

// {{$e.Plural.Pascal}}URL is the address of the list of {{lower $e.Plural.Label}}.
func {{$e.Plural.Pascal}}URL() string { return URL("/{{$pg.Path}}") }
{{- if $images}}

// {{$e.Pascal}}Image is the address of a {{lower $e.Label}}'s picture, "" for none.
func {{$e.Pascal}}Image(x {{$m}}.{{$e.Pascal}}) string {
	if x.{{$pg.Image.Pascal}} == uuid.Nil() {
		return ""
	}
	return URL("/{{$pg.Path}}/" + x.ID.String() + "/img")
}
{{- end}}

// {{$e.Plural.Pascal}}Label is what the site calls {{lower $e.Plural.Label}}; {{$e.Pascal}}Label, one of them.
const (
	{{$e.Plural.Pascal}}Label = {{quote (siteLabel $e.Ann $n $e.Plural.Label)}}
	{{$e.Pascal}}Label  = {{quote (or (index (ann $e) "singular") $e.Label)}}
)

// {{$e.Plural.Camel}}Sorts are the orders the list offers.
var {{$e.Plural.Camel}}Sorts = []string{ {{- range $i, $s := $pg.Sorts}}{{if $i}}, {{end}}{{quote $s}}{{end}}{{if $pg.Search}}, "relevance"{{end -}} }

// {{$e.Plural.Camel}}SortLabels are what each order is called.
var {{$e.Plural.Camel}}SortLabels = map[string]string{
	"-created_at": T("orderNewest"),
	"created_at":  T("orderOldest"),
{{- range $pg.Entity.Fields}}{{if index .Ann "store"}}{{if index (index .Ann "store") "sort"}}
	{{quote .Snake}}:  T("orderAsc", "name", {{quote (siteLabel .Ann $n .Label)}}),
	{{quote (printf "-%s" .Snake)}}: T("orderDesc", "name", {{quote (siteLabel .Ann $n .Label)}}),
{{- end}}{{end}}{{end}}
	"relevance": T("orderRelevance"),
}

func (s *Site) list{{$e.Plural.Pascal}}(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	if !({{$m}}.{{$e.Pascal}}Policy{}).List(ctx).All() {
		s.NotFound(w, r)
		return
	}
	v := r.URL.Query()
	q := {{$m}}.{{$e.Pascal}}Query{Page: pageNumber(r), PerPage: pageSize, Sort: {{quote $pg.Sort}}}
{{- if $pg.Search}}
	q.Search = strings.TrimSpace(v.Get("q"))
{{- end}}
	searched := {{if $pg.Search}}q.Search != ""{{else}}false{{end}}
	if sort := v.Get("sort"); slices.Contains({{$e.Plural.Camel}}Sorts, sort) && (sort != "relevance" || searched) {
		q.Sort = sort
	}
{{- range $pg.Filters}}
{{- if eq .Kind "in"}}
	for _, x := range v["{{.Param}}"] {
		if value := {{.Enum.Module.Snake}}.{{.Enum.Pascal}}(x); value.Valid() {
			q.Filter.{{.Field}} = append(q.Filter.{{.Field}}, value)
		}
	}
{{- else if eq .Kind "bool"}}
	switch v.Get("{{.Param}}") {
	case "true":
		yes := true
		q.Filter.{{.Field}} = &yes
	case "false":
		no := false
		q.Filter.{{.Field}} = &no
	}
{{- else if eq .Kind "id"}}
	if id, err := uuid.Parse(v.Get("{{.Param}}")); err == nil {
		q.Filter.{{.Field}} = id
	}
{{- end}}
{{- end}}
	page, err := s.deps.{{$M}}.List{{$e.Plural.Pascal}}(ctx, q)
	if err != nil {
		s.fail(w, r, err)
		return
	}
	if q.Page > 1 && len(page.{{$e.Plural.Pascal}}) == 0 {
		s.NotFound(w, r)
		return
	}
	view := {{$e.Pascal}}List{Page: s.page(r, {{$e.Plural.Pascal}}Label, ""), Items: page.{{$e.Plural.Pascal}}, Pager: pagerOf(r, page.Total, q.Page)}
	// A search or a filtered list is no page of its own for search engines.
	for k := range v {
		if k != "page" {
			view.NoIndex = true
		}
	}
	chosen := q.Sort
	if chosen == "" {
		chosen = {{quote (or $pg.Sort "-created_at")}}
	}
	for _, key := range {{$e.Plural.Camel}}Sorts {
		if key != "relevance" || searched {
			view.Sorts = append(view.Sorts, Option{Value: key, Label: {{$e.Plural.Camel}}SortLabels[key], Chosen: key == chosen})
		}
	}
{{- range $f := $pg.Filters}}
	{
		f := Filter{Param: "{{$f.Param}}", Label: {{quote (siteLabel $f.Ann $n $f.Name)}}}
		f.Options = append(f.Options, Option{Value: "", Label: T("all"), Chosen: v.Get("{{$f.Param}}") == ""})
{{- if eq $f.Kind "in"}}
{{- range $val := $f.Enum.Values}}
		f.Options = append(f.Options, Option{Value: {{quote $val.Raw}}, Label: {{quote (siteLabel $val.Ann $n $val.Raw)}}, Chosen: slices.Contains(v["{{$f.Param}}"], {{quote $val.Raw}})})
{{- end}}
{{- else if eq $f.Kind "bool"}}
		f.Options = append(f.Options, Option{Value: "true", Label: T("yesValue"), Chosen: v.Get("{{$f.Param}}") == "true"},
			Option{Value: "false", Label: T("noValue"), Chosen: v.Get("{{$f.Param}}") == "false"})
{{- else if eq $f.Kind "id"}}
{{- $t := $f.Relation.Target}}{{$tp := sitePage $.Entities $n $t}}
		if ({{$t.Module.Snake}}.{{$t.Pascal}}Policy{}).List(ctx).All() {
			options, err := s.deps.{{$t.Module.Pascal}}.List{{$t.Plural.Pascal}}(ctx, {{$t.Module.Snake}}.{{$t.Pascal}}Query{Limit: 100})
			if err != nil {
				s.fail(w, r, err)
				return
			}
			for _, x := range options.{{$t.Plural.Pascal}} {
				f.Options = append(f.Options, Option{Value: x.ID.String(), Label: {{if $tp}}{{$t.Pascal}}Title(x){{else}}x.ID.String(){{end}}, Chosen: v.Get("{{$f.Param}}") == x.ID.String()})
			}
		}
{{- end}}
		view.Filters = append(view.Filters, f)
	}
{{- end}}
{{- range $r := $pg.Keys}}
	view.{{$r.Pascal}} = map[uuid.UUID]{{$r.Target.Module.Snake}}.{{$r.Target.Pascal}}{}
	{
		var ids []uuid.UUID
		for _, x := range view.Items {
			if x.{{$r.Pascal}}ID != uuid.Nil() && !slices.Contains(ids, x.{{$r.Pascal}}ID) {
				ids = append(ids, x.{{$r.Pascal}}ID)
			}
		}
		if len(ids) > 0 {
			found, err := s.deps.{{$r.Target.Module.Pascal}}.Read{{$r.Target.Plural.Pascal}}(ctx, ids)
			if err != nil {
				s.fail(w, r, err)
				return
			}
			for id, x := range found {
				if ({{$r.Target.Module.Snake}}.{{$r.Target.Pascal}}Policy{}).Read(ctx, x) {
					view.{{$r.Pascal}}[id] = x
				}
			}
		}
	}
{{- end}}
	s.render(w, r, http.StatusOK, {{$e.Pascal}}ListPage(view))
}
func (s *Site) read{{$e.Pascal}}(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	id, ok := readID(r)
	if !ok {
		s.NotFound(w, r)
		return
	}
	x, err := s.deps.{{$M}}.Read{{$e.Pascal}}(ctx, id)
	if errors.Is(err, {{$m}}.Err{{$e.Pascal}}NotFound) || (err == nil && !({{$m}}.{{$e.Pascal}}Policy{}).Read(ctx, x)) {
		s.NotFound(w, r)
		return
	}
	if err != nil {
		s.fail(w, r, err)
		return
	}
	// One address for each record: another slug, or none, moves to it.
	if r.PathValue("slug") != Slug({{$e.Pascal}}Title(x)) {
		target := {{$e.Pascal}}URL(x)
		if r.URL.RawQuery != "" {
			target += "?" + r.URL.RawQuery
		}
		http.Redirect(w, r, target, http.StatusMovedPermanently)
		return
	}
	view := {{$e.Pascal}}View{Page: s.page(r, {{$e.Pascal}}Title(x), {{if $pg.Description}}summary(x.{{$pg.Description.Pascal}}){{else}}""{{end}}), Item: x}
{{- if $images}}
	if img := {{$e.Pascal}}Image(x); img != "" {
		view.Image = s.Abs(r, strings.TrimPrefix(img, Path))
	}
{{- end}}
{{- range $r := $pg.Keys}}
	if x.{{$r.Pascal}}ID != uuid.Nil() {
		related, err := s.deps.{{$r.Target.Module.Pascal}}.Read{{$r.Target.Pascal}}(ctx, x.{{$r.Pascal}}ID)
		if err == nil && ({{$r.Target.Module.Snake}}.{{$r.Target.Pascal}}Policy{}).Read(ctx, related) {
			view.{{$r.Pascal}} = &related
		}
	}
{{- end}}
{{- range $l := $pg.Lists}}{{$t := $l.Target}}
	if ({{$t.Module.Snake}}.{{$t.Pascal}}Policy{}).List(ctx).All() {
		q := {{$t.Module.Snake}}.{{$t.Pascal}}Query{Page: 1, PerPage: pageSize}
		q.Filter.{{$l.Key}} = x.ID
		listed, err := s.deps.{{$t.Module.Pascal}}.List{{$t.Plural.Pascal}}(ctx, q)
		if err != nil {
			s.fail(w, r, err)
			return
		}
		view.{{$l.Relation.Pascal}} = listed.{{$t.Plural.Pascal}}
	}
{{- end}}
{{- if $pg.Schema}}
	data := map[string]any{
		"@type": {{if eq $pg.Schema "product"}}"Product"{{else if eq $pg.Schema "article"}}"Article"{{else}}"Organization"{{end}},
		"{{if eq $pg.Schema "article"}}headline{{else}}name{{end}}": {{$e.Pascal}}Title(x),
		"url": view.Canonical,
	}
	if view.Description != "" {
		data["description"] = view.Description
	}
	if view.Image != "" {
		data["image"] = view.Image
	}
{{- if eq $pg.Schema "product"}}{{$price := ""}}{{range $pg.Fields}}{{if and (not $price) (eq (printf "%v" .Type) "money")}}{{$price = .Pascal}}{{end}}{{end}}{{if $price}}
	if x.{{$price}}.CurrencyCode() != "" {
		data["offers"] = map[string]any{"@type": "Offer", "price": x.{{$price}}.Number(), "priceCurrency": x.{{$price}}.CurrencyCode(), "url": view.Canonical}
	}
{{- end}}{{end}}
	view.Schema = schema(data)
{{- end}}
	s.render(w, r, http.StatusOK, {{$e.Pascal}}Page(view))
}
{{- if $images}}

// image{{$e.Pascal}} sends to a {{lower $e.Label}}'s picture, by a link of the store's that
// works for a while: the page's address for it stays the same.
func (s *Site) image{{$e.Pascal}}(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	id, ok := readID(r)
	if !ok {
		s.NotFound(w, r)
		return
	}
	x, err := s.deps.{{$M}}.Read{{$e.Pascal}}(ctx, id)
	if err != nil || !({{$m}}.{{$e.Pascal}}Policy{}).Read(ctx, x) || x.{{$pg.Image.Pascal}} == uuid.Nil() {
		s.NotFound(w, r)
		return
	}
	found, err := s.deps.Storage.Files(ctx, []uuid.UUID{x.{{$pg.Image.Pascal}}})
	f, ok := found[x.{{$pg.Image.Pascal}}]
	if err != nil || !ok {
		s.NotFound(w, r)
		return
	}
	link, err := s.deps.Storage.URL(ctx, f)
	if err != nil {
		s.fail(w, r, err)
		return
	}
	w.Header().Set("Cache-Control", "public, max-age=300")
	http.Redirect(w, r, link, http.StatusFound)
}
{{- end}}
{{- end}}
