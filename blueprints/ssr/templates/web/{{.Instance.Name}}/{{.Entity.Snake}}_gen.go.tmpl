// {{$e.Plural.Pascal}}Label is what the site calls {{lower $e.Plural.Label}}; {{$e.Pascal}}Label, one of them.
const (
	{{$e.Plural.Pascal}}Label = {{quote (siteLabel $e.Ann $n $e.Plural.Label)}}
	{{$e.Pascal}}Label  = {{quote (or (index (ann $e) "singular") $e.Label)}}
)

// {{$e.Plural.Camel}}Sorts are the orders the list offers.
var {{$e.Plural.Camel}}Sorts = []string{ {{- range $i, $s := $pg.Sorts}}{{if $i}}, {{end}}{{quote $s}}{{end}}{{if $pg.Search}}, "relevance"{{end -}} }

// {{$e.Plural.Camel}}SortLabels are what each order is called.
var {{$e.Plural.Camel}}SortLabels = map[string]string{
	"-created_at": T("orderNewest"),
	"created_at":  T("orderOldest"),
{{- range $pg.Entity.Fields}}{{if index .Ann "store"}}{{if index (index .Ann "store") "sort"}}
	{{quote .Snake}}:  T("orderAsc", "name", {{quote (siteLabel .Ann $n .Label)}}),
	{{quote (printf "-%s" .Snake)}}: T("orderDesc", "name", {{quote (siteLabel .Ann $n .Label)}}),
{{- end}}{{end}}{{end}}
{{- range orders $pg.Entity}}
	{{quote .Snake}}: {{quote (humanize .Snake)}},
{{- end}}
	"relevance": T("orderRelevance"),
}

func (s *Site) list{{$e.Plural.Pascal}}(w http.ResponseWriter, r *http.Request) {
	s.show{{$e.Plural.Pascal}}(w, r, nil)
}

// show{{$e.Plural.Pascal}} answers the list of {{lower $e.Plural.Label}}: all of them, or{{if $pg.Browses}} those of b, the
// page of a filter's value at an address of its own{{else}} (b is always nil:
// no filter of the list has pages of its values){{end}}.
func (s *Site) show{{$e.Plural.Pascal}}(w http.ResponseWriter, r *http.Request, b *browse) {
	ctx := r.Context()
	if !({{$m}}.{{$e.Pascal}}Policy{}).List(ctx).All() {
		s.NotFound(w, r)
		return
	}
	asked := r.URL.Query()
	v := r.URL.Query()
	if b != nil {
		v.Set(b.Param, b.Value)
	}
	q := {{$m}}.{{$e.Pascal}}Query{Page: pageNumber(r), PerPage: pageSize, Sort: {{quote $pg.Sort}}}
{{- if $pg.Search}}
	q.Search = strings.TrimSpace(v.Get("q"))
{{- end}}
	searched := {{if $pg.Search}}q.Search != ""{{else}}false{{end}}
	if sort := v.Get("sort"); slices.Contains({{$e.Plural.Camel}}Sorts, sort) && (sort != "relevance" || searched) {
		q.Sort = sort
	}
{{- range $pg.Filters}}
{{- if eq .Kind "in"}}
	for _, x := range v["{{.Param}}"] {
		if value := {{.Enum.Module.Snake}}.{{.Enum.Pascal}}(x); value.Valid() {
			q.Filter.{{.Field}} = append(q.Filter.{{.Field}}, value)
		}
	}
{{- else if eq .Kind "bool"}}
	switch v.Get("{{.Param}}") {
	case "true":
		yes := true
		q.Filter.{{.Field}} = &yes
	case "false":
		no := false
		q.Filter.{{.Field}} = &no
	}
{{- else if eq .Kind "id"}}
	if id, err := uuid.Parse(v.Get("{{.Param}}")); err == nil {
		q.Filter.{{.Field}} = id
	}
{{- end}}
{{- end}}
	listed{{$e.Plural.Pascal}}(&q)
	page, err := s.deps.{{$M}}.List{{$e.Plural.Pascal}}(ctx, q)
	if err != nil {
		s.fail(w, r, err)
		return
	}
	if q.Page > 1 && len(page.{{$e.Plural.Pascal}}) == 0 {
		s.NotFound(w, r)
		return
	}
	title, description := {{$e.Plural.Pascal}}Label, ""
	if b != nil {
		title = T("browseTitle", "list", {{$e.Plural.Pascal}}Label, "name", b.Name)
		description = T("browseDescription", "list", {{$e.Plural.Pascal}}Label, "name", b.Name, "site", Name)
	}
	view := {{$e.Pascal}}List{Page: s.page(r, title, description), Items: page.{{$e.Plural.Pascal}}, Pager: pagerOf(r, page.Total, q.Page)}
	// A search or a filtered list is no page of its own for search engines;
	// nor is the page of a value with none.
	for k := range asked {
		if k != "page" {
			view.NoIndex = true
		}
	}
	if b != nil {
		view.Crumbs = []Crumb{s.crumb(r, T("home"), "/"), s.crumb(r, {{$e.Plural.Pascal}}Label, "/{{$pg.Path}}"), s.crumb(r, b.Name, b.Path)}
		view.NoIndex = view.NoIndex || page.Total == 0
	}
{{- if $pg.Browses}}
	// The list by the value of one filter with pages of its values is that
	// page, at its address.
	if b == nil && view.NoIndex {
		var params []string
		for k := range asked {
			if k != "page" {
				params = append(params, k)
			}
		}
		if len(params) == 1 && len(asked[params[0]]) == 1 {
			found, err := s.{{$e.Plural.Camel}}BrowseOf(ctx, params[0], asked.Get(params[0]))
			if err != nil {
				s.fail(w, r, err)
				return
			}
			if found != nil {
				view.NoIndex = page.Total == 0
				view.Canonical = s.canonical(r, found.Path)
			}
		}
	}
{{- end}}
	chosen := q.Sort
	if chosen == "" {
		chosen = {{quote (or $pg.Sort "-created_at")}}
	}
	for _, key := range {{$e.Plural.Camel}}Sorts {
		if key != "relevance" || searched {
			view.Sorts = append(view.Sorts, Option{Value: key, Label: {{$e.Plural.Camel}}SortLabels[key], Chosen: key == chosen})
		}
	}
{{- range $f := $pg.Filters}}
	{
		f := Filter{Param: "{{$f.Param}}", Label: {{quote (siteLabel $f.Ann $n $f.Name)}}}
		f.Options = append(f.Options, Option{Value: "", Label: T("all"), Chosen: v.Get("{{$f.Param}}") == ""})
{{- if eq $f.Kind "in"}}
{{- range $val := $f.Enum.Values}}
		f.Options = append(f.Options, Option{Value: {{quote $val.Raw}}, Label: {{quote (siteLabel $val.Ann $n $val.Raw)}}, Chosen: slices.Contains(v["{{$f.Param}}"], {{quote $val.Raw}})})
{{- end}}
{{- else if eq $f.Kind "bool"}}
		f.Options = append(f.Options, Option{Value: "true", Label: T("yesValue"), Chosen: v.Get("{{$f.Param}}") == "true"},
			Option{Value: "false", Label: T("noValue"), Chosen: v.Get("{{$f.Param}}") == "false"})
{{- else if eq $f.Kind "id"}}
{{- $t := $f.Relation.Target}}{{$tp := sitePage $.Entities $n $t}}
		if ({{$t.Module.Snake}}.{{$t.Pascal}}Policy{}).List(ctx).All() {
			options, err := s.deps.{{$t.Module.Pascal}}.List{{$t.Plural.Pascal}}(ctx, {{$t.Module.Snake}}.{{$t.Pascal}}Query{Limit: 100})
			if err != nil {
				s.fail(w, r, err)
				return
			}
			for _, x := range options.{{$t.Plural.Pascal}} {
				f.Options = append(f.Options, Option{Value: x.ID.String(), Label: {{if $tp}}{{$t.Pascal}}Title(x){{else}}x.ID.String(){{end}}, Chosen: v.Get("{{$f.Param}}") == x.ID.String()})
			}
		}
{{- end}}
		view.Filters = append(view.Filters, f)
	}
{{- end}}
{{- range $r := $pg.Keys}}
	view.{{$r.Pascal}} = map[uuid.UUID]{{$r.Target.Module.Snake}}.{{$r.Target.Pascal}}{}
	{
		var ids []uuid.UUID
		for _, x := range view.Items {
			if x.{{$r.Pascal}}ID != uuid.Nil() && !slices.Contains(ids, x.{{$r.Pascal}}ID) {
				ids = append(ids, x.{{$r.Pascal}}ID)
			}
		}
		if len(ids) > 0 {
			found, err := s.deps.{{$r.Target.Module.Pascal}}.Read{{$r.Target.Plural.Pascal}}(ctx, ids)
			if err != nil {
				s.fail(w, r, err)
				return
			}
			for id, x := range found {
				if ({{$r.Target.Module.Snake}}.{{$r.Target.Pascal}}Policy{}).Read(ctx, x) {
					view.{{$r.Pascal}}[id] = x
				}
			}
		}
	}
{{- end}}
	s.render(w, r, http.StatusOK, {{$e.Pascal}}ListPage(view))
}

// read{{$e.Pascal}} answers what is at /{{$pg.Path}}/<id>[/<slug>]{{if $pg.Key}} and /{{$pg.Path}}/<slug>-<{{$pg.Key.Snake}}>{{end}}: a {{lower $e.Label}}'s
// page{{if $pg.Browses}}, or first the list of a filter's value at that address{{end}}.
func (s *Site) read{{$e.Pascal}}(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	first, second := r.PathValue("id"), r.PathValue("slug")
{{- if $pg.Browses}}
	b, err := s.{{$e.Plural.Camel}}BrowseAt(ctx, first, second)
	if err != nil {
		s.fail(w, r, err)
		return
	}
	if b != nil {
		s.show{{$e.Plural.Pascal}}(w, r, b)
		return
	}
{{- end}}
	var x {{$m}}.{{$e.Pascal}}
{{- if not $pg.Browses}}
	var err error
{{- end}}
	if id, ok := readID(r); ok {
		x, err = s.deps.{{$M}}.Read{{$e.Pascal}}(ctx, id)
{{- if $pg.Key}}
	} else if key := keyOf(first); second == "" && keyed(key) {
		x, err = s.deps.{{$M}}.Read{{$e.Pascal}}By{{$pg.Key.Pascal}}(ctx, key)
{{- end}}
	} else {
		s.NotFound(w, r)
		return
	}
	if errors.Is(err, {{$m}}.Err{{$e.Pascal}}NotFound) || (err == nil && (!({{$m}}.{{$e.Pascal}}Policy{}).Read(ctx, x) || !shown{{$e.Pascal}}(x))) {
		s.NotFound(w, r)
		return
	}
	if err != nil {
		s.fail(w, r, err)
		return
	}
	// One address for each record: another slug, or none{{if $pg.Key}}, or its id's{{end}}, moves to it.
	at := "/{{$pg.Path}}/" + first
	if second != "" {
		at += "/" + second
	}
	if at != {{$e.Pascal}}Path(x) {
		target := {{$e.Pascal}}URL(x)
		if r.URL.RawQuery != "" {
			target += "?" + r.URL.RawQuery
		}
		http.Redirect(w, r, target, http.StatusMovedPermanently)
		return
	}
	view := {{$e.Pascal}}View{Page: s.page(r, {{$e.Pascal}}Title(x), {{$e.Pascal}}Description(x)), Item: x}
{{- if eq $pg.Schema "product"}}
	view.Type = "product"
{{- else if eq $pg.Schema "article"}}
	view.Type = "article"
{{- end}}
{{- if or $images $og}}
	// picture is its own picture's absolute address, or the one the site
	// draws of it.
	picture := ""
{{- end}}
{{- if $images}}
	if img := {{$e.Pascal}}Image(x); img != "" {
		view.Image = s.Abs(r, strings.TrimPrefix(img, Path))
		picture = view.Image
	}
{{- end}}
{{- if $og}}
	// Shared links show the image the site draws of it.
	view.Image = s.Abs(r, {{$e.Pascal}}OGPath(x))
	view.ImageWidth, view.ImageHeight = images.OGWidth, images.OGHeight
	if picture == "" {
		picture = view.Image
	}
{{- end}}
{{- range $r := $pg.Keys}}
	if x.{{$r.Pascal}}ID != uuid.Nil() {
		related, err := s.deps.{{$r.Target.Module.Pascal}}.Read{{$r.Target.Pascal}}(ctx, x.{{$r.Pascal}}ID)
		if err == nil && ({{$r.Target.Module.Snake}}.{{$r.Target.Pascal}}Policy{}).Read(ctx, related) {
			view.{{$r.Pascal}} = &related
		}
	}
{{- end}}
	// The steps to it: the first page, the list{{with $pg.CrumbBrowse}}, the list of its {{lower .Name}}{{end}}.
	view.Crumbs = []Crumb{s.crumb(r, T("home"), "/"), s.crumb(r, {{$e.Plural.Pascal}}Label, "/{{$pg.Path}}")}
{{- with $pg.CrumbBrowse}}
{{- if .Relation}}
	if view.{{.Relation.Pascal}} != nil {
		b := {{$e.Plural.Camel}}By{{.Pascal}}Of(*view.{{.Relation.Pascal}})
		view.Crumbs = append(view.Crumbs, s.crumb(r, b.Name, b.Path))
	}
{{- else}}
	if x.{{.Field}} != "" {
		b := {{$e.Plural.Camel}}By{{.Pascal}}Of(x.{{.Field}})
		view.Crumbs = append(view.Crumbs, s.crumb(r, b.Name, b.Path))
	}
{{- end}}
{{- end}}
	view.Crumbs = append(view.Crumbs, s.crumb(r, {{$e.Pascal}}Title(x), {{$e.Pascal}}Path(x)))
{{- range $l := $pg.Lists}}{{$t := $l.Target}}
	if ({{$t.Module.Snake}}.{{$t.Pascal}}Policy{}).List(ctx).All() {
		q := {{$t.Module.Snake}}.{{$t.Pascal}}Query{Page: 1, PerPage: pageSize}
		q.Filter.{{$l.Key}} = x.ID
		listed, err := s.deps.{{$t.Module.Pascal}}.List{{$t.Plural.Pascal}}(ctx, q)
		if err != nil {
			s.fail(w, r, err)
			return
		}
		view.{{$l.Relation.Pascal}} = listed.{{$t.Plural.Pascal}}
	}
{{- end}}
{{- if $pg.Schema}}
	data := map[string]any{
		"@type": {{if eq $pg.Schema "product"}}"Product"{{else if eq $pg.Schema "article"}}"Article"{{else}}"Organization"{{end}},
		"{{if eq $pg.Schema "article"}}headline{{else}}name{{end}}": {{$e.Pascal}}Title(x),
		"url": view.Canonical,
	}
	if view.Description != "" {
		data["description"] = view.Description
	}
{{- if or $images $og}}
	if picture != "" {
		data["image"] = picture
	}
{{- end}}
{{- if and (eq $pg.Schema "product") $pg.Price}}{{$price := $pg.Price.Pascal}}
	if x.{{$price}}.CurrencyCode() != "" {
		offer := map[string]any{"@type": "Offer", "price": x.{{$price}}.Number(), "priceCurrency": x.{{$price}}.CurrencyCode(), "url": view.Canonical}
{{- with $pg.Available}}
		// In stock with {{range $i, $v := $pg.AvailableValues}}{{if $i}}, {{end}}{{$v.Raw}}{{end}}; out of stock with any other {{lower .Label}}.
		offer["availability"] = "https://schema.org/OutOfStock"
		switch x.{{.Pascal}} {
		case {{range $i, $v := $pg.AvailableValues}}{{if $i}}, {{end}}{{quote $v.Raw}}{{end}}:
			offer["availability"] = "https://schema.org/InStock"
		}
{{- end}}
{{- with $pg.Seller}}
		if seller := {{if .Enum}}{{.Enum.Pascal}}Label(x.{{.Pascal}}){{else}}strings.TrimSpace(x.{{.Pascal}}){{end}}; seller != "" {
			offer["seller"] = map[string]any{"@type": "Organization", "name": seller}
		}
{{- end}}
		data["offers"] = offer
	}
{{- end}}
	view.Schema = schema(data)
{{- end}}
	s.render(w, r, http.StatusOK, {{$e.Pascal}}Page(view))
}
{{- if $images}}

// image{{$e.Pascal}} sends to a {{lower $e.Label}}'s picture, by a link of the store's that
// works for a while: the page's address for it stays the same.
func (s *Site) image{{$e.Pascal}}(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	id, ok := readID(r)
	if !ok {
{{- if $pg.Browses}}
		// The list of a value whose slug is img: /{{$pg.Path}}/<segment>/img.
		r.SetPathValue("slug", "img")
		s.read{{$e.Pascal}}(w, r)
{{- else}}
		s.NotFound(w, r)
{{- end}}
		return
	}
	x, err := s.deps.{{$M}}.Read{{$e.Pascal}}(ctx, id)
	if err != nil || !({{$m}}.{{$e.Pascal}}Policy{}).Read(ctx, x) || !shown{{$e.Pascal}}(x) || x.{{$pg.Image.Pascal}} == uuid.Nil() {
		s.NotFound(w, r)
		return
	}
	found, err := s.deps.Storage.Files(ctx, []uuid.UUID{x.{{$pg.Image.Pascal}}})
	f, ok := found[x.{{$pg.Image.Pascal}}]
	if err != nil || !ok {
		s.NotFound(w, r)
		return
	}
	link, err := s.deps.Storage.URL(ctx, f)
	if err != nil {
		s.fail(w, r, err)
		return
	}
	w.Header().Set("Cache-Control", "public, max-age=300")
	http.Redirect(w, r, link, http.StatusFound)
}
{{- end}}
{{- if $og}}

// {{$e.Pascal}}OG is what a {{lower $e.Label}}'s Open Graph image is drawn from.
type {{$e.Pascal}}OG struct {
	Item {{$m}}.{{$e.Pascal}}
	// Title and Description are its page's.
	Title, Description string
{{- if $pg.Image}}
	// Picture is its {{lower $pg.Image.Label}}, nil without one (or one that cannot be read).
	Picture image.Image
{{- end}}
	// Site is the site's name; Logo, its brand's logo, nil without one it
	// can draw (an SVG is not drawn).
	Site string
	Logo image.Image
}

// {{$e.Pascal}}OGPath is the path of a {{lower $e.Label}}'s Open Graph image, which changes
// with it: /{{$pg.Path}}/<id>/og.png?v=<version>.
func {{$e.Pascal}}OGPath(x {{$m}}.{{$e.Pascal}}) string {
	return "/{{$pg.Path}}/" + x.ID.String() + "/og.png?v=" + {{$e.Camel}}OGName(x)
}

// {{$e.Camel}}OGName is the name a {{lower $e.Label}}'s image is kept under: the
// drawing's version, the theme's, and when the {{lower $e.Label}} last changed.
func {{$e.Camel}}OGName(x {{$m}}.{{$e.Pascal}}) string {
	return {{$e.Camel}}OGVersion + "-" + ogThemeHash + "-" + strconv.FormatInt(x.UpdatedAt.UnixNano(), 36)
}

// og{{$e.Pascal}} answers a {{lower $e.Label}}'s Open Graph image, 1200x630: drawn by
// Draw{{$e.Pascal}}OG ({{$e.Snake}}_og.go, yours) and kept in the store, drawn again
// when the {{lower $e.Label}} changes or {{$e.Camel}}OGVersion does.
func (s *Site) og{{$e.Pascal}}(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	id, ok := readID(r)
	if !ok {
		http.NotFound(w, r)
		return
	}
	x, err := s.deps.{{$M}}.Read{{$e.Pascal}}(ctx, id)
	if errors.Is(err, {{$m}}.Err{{$e.Pascal}}NotFound) || (err == nil && (!({{$m}}.{{$e.Pascal}}Policy{}).Read(ctx, x) || !shown{{$e.Pascal}}(x))) {
		http.NotFound(w, r)
		return
	}
	if err != nil {
		s.ogFailed(w, r, err)
		return
	}
	name := {{$e.Camel}}OGName(x)
	err = servePNG(w, r, `"`+name+`"`, {{ogPublic $e}}, func() ([]byte, error) {
		data, _, err := s.ogCache().PNG(ctx, "images/{{$n}}/{{$e.Plural.Snake}}/"+x.ID.String(), name, func() ([]byte, error) {
			o := {{$e.Pascal}}OG{Item: x, Title: {{$e.Pascal}}Title(x), Site: Name, Logo: s.ogLogo}
{{- if $pg.Description}}
			o.Description = summary(x.{{$pg.Description.Pascal}})
{{- end}}
{{- if $pg.Image}}
			o.Picture = s.picture(ctx, x.{{$pg.Image.Pascal}})
{{- end}}
			c := images.New(images.OGWidth, images.OGHeight, s.og)
			if err := Draw{{$e.Pascal}}OG(c, o); err != nil {
				return nil, err
			}
			return c.PNG()
		})
		return data, err
	})
	if err != nil {
		s.ogFailed(w, r, err)
	}
}
{{- end}}
{{- end}}
