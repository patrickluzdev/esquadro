}

// {{$e.Plural.Camel}}By{{$b.Pascal}} are the lists of the {{lower $e.Plural.Label}} of each {{lower $t.Label}} the reader
// may see, up to browseMax, the oldest first.
func (s *Site) {{$e.Plural.Camel}}By{{$b.Pascal}}(ctx context.Context) ([]*browse, error) {
	if !({{$tm}}.{{$t.Pascal}}Policy{}).List(ctx).All() {
		return nil, nil
	}
	found, err := s.deps.{{$t.Module.Pascal}}.List{{$t.Plural.Pascal}}(ctx, {{$tm}}.{{$t.Pascal}}Query{Sort: "created_at", Limit: browseMax, Unpaged: true})
	if err != nil {
		return nil, err
	}
	var out []*browse
	for _, x := range found.{{$t.Plural.Pascal}} {
		if ({{$tm}}.{{$t.Pascal}}Policy{}).Read(ctx, x) {
			out = append(out, {{$e.Plural.Camel}}By{{$b.Pascal}}Of(x))
		}
	}
	return out, nil
}
{{- else}}{{$en := $b.Enum}}

// {{$e.Plural.Pascal}}By{{$b.Pascal}}Path is the path of the list of the {{lower $e.Plural.Label}} of a value
// of {{lower $b.Name}}: /{{$pg.Path}}/{{$b.Segment}}/<slug of its label>.
func {{$e.Plural.Pascal}}By{{$b.Pascal}}Path(v {{$en.Module.Snake}}.{{$en.Pascal}}) string {
	return "/{{$pg.Path}}/{{$b.Segment}}/" + Slug({{$en.Pascal}}Label(v))
}

// {{$e.Plural.Pascal}}By{{$b.Pascal}}URL is its address, as links write it.
func {{$e.Plural.Pascal}}By{{$b.Pascal}}URL(v {{$en.Module.Snake}}.{{$en.Pascal}}) string {
