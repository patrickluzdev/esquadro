}

// {{$e.Plural.Camel}}By{{$b.Pascal}}Of is the list of the {{lower $e.Plural.Label}} of a value of {{lower $b.Name}}.
func {{$e.Plural.Camel}}By{{$b.Pascal}}Of(v {{$en.Module.Snake}}.{{$en.Pascal}}) *browse {
	return &browse{Param: {{quote $b.Param}}, Value: string(v), Name: {{$en.Pascal}}Label(v), Path: {{$e.Plural.Pascal}}By{{$b.Pascal}}Path(v)}
}

// {{$e.Plural.Camel}}By{{$b.Pascal}} are the lists of the {{lower $e.Plural.Label}} of each value of {{lower $b.Name}}.
func (s *Site) {{$e.Plural.Camel}}By{{$b.Pascal}}(context.Context) ([]*browse, error) {
	var out []*browse
	for _, v := range []{{$en.Module.Snake}}.{{$en.Pascal}}{ {{- range $i, $v := $en.Values}}{{if $i}}, {{end}}{{quote $v.Raw}}{{end -}} } {
		out = append(out, {{$e.Plural.Camel}}By{{$b.Pascal}}Of(v))
	}
	return out, nil
}
{{- end}}
{{- end}}
{{- if $pg.Browses}}

// {{$e.Plural.Camel}}Browses are the lists of {{lower $e.Plural.Label}} by each filter with pages of
// its values, in the order of the filters.
func (s *Site) {{$e.Plural.Camel}}Browses(ctx context.Context) ([][]*browse, error) {
	var out [][]*browse
	for _, by := range []func(context.Context) ([]*browse, error){ {{- range $i, $b := $pg.Browses}}{{if $i}}, {{end}}s.{{$e.Plural.Camel}}By{{$b.Pascal}}{{end -}} } {
		found, err := by(ctx)
		if err != nil {
			return nil, err
		}
		out = append(out, found)
	}
	return out, nil
}

// {{$e.Plural.Camel}}BrowseAt is the list of {{lower $e.Plural.Label}} by a filter's value at
// /{{$pg.Path}}/<first>[/<second>], nil for none: {{range $i, $b := $pg.Browses}}{{if $i}}, {{end}}{{if $b.Segment}}/{{$pg.Path}}/{{$b.Segment}}/<slug>{{else}}/{{$pg.Path}}/<slug>, before a {{lower $e.Label}}'s{{end}}{{end}}.
func (s *Site) {{$e.Plural.Camel}}BrowseAt(ctx context.Context, first, second string) (*browse, error) {
	var found []*browse
	var err error
	switch {
{{- range $b := $pg.Browses}}
	case {{if $b.Segment}}second != "" && first == {{quote $b.Segment}}{{else}}second == ""{{end}}:
		found, err = s.{{$e.Plural.Camel}}By{{$b.Pascal}}(ctx)
{{- end}}
	}
	at := "/{{$pg.Path}}/" + first
	if second != "" {
		at += "/" + second
	}
	for _, b := range found {
		if b.Path == at {
			return b, nil
		}
	}
	return nil, err
}

// {{$e.Plural.Camel}}BrowseOf is the list of {{lower $e.Plural.Label}} by a filter's value, by its
// parameter (?{{(index $pg.Browses 0).Param}}=...), nil for a parameter or a value with none.
func (s *Site) {{$e.Plural.Camel}}BrowseOf(ctx context.Context, param, value string) (*browse, error) {
	switch param {
{{- range $b := $pg.Browses}}
	case {{quote $b.Param}}:
{{- if $b.Relation}}{{$t := $b.Relation.Target}}{{$tm := $t.Module.Snake}}
		id, err := uuid.Parse(value)
		if err != nil {
			return nil, nil
		}
		x, err := s.deps.{{$t.Module.Pascal}}.Read{{$t.Pascal}}(ctx, id)
		if errors.Is(err, {{$tm}}.Err{{$t.Pascal}}NotFound) || (err == nil && !({{$tm}}.{{$t.Pascal}}Policy{}).Read(ctx, x)) {
			return nil, nil
		}
		if err != nil {
			return nil, err
		}
		return {{$e.Plural.Camel}}By{{$b.Pascal}}Of(x), nil
{{- else}}
		if v := {{$b.Enum.Module.Snake}}.{{$b.Enum.Pascal}}(value); v.Valid() {
			return {{$e.Plural.Camel}}By{{$b.Pascal}}Of(v), nil
		}
{{- end}}
{{- end}}
	}
	return nil, nil
}
{{- end}}
{{- if $images}}

// {{$e.Pascal}}Image is the address of a {{lower $e.Label}}'s picture, "" for none.
func {{$e.Pascal}}Image(x {{$m}}.{{$e.Pascal}}) string {
