{
  "name": "{{.Instance.Name}}",
  "private": true,
  "description": "The {{.Instance.Name}} site's styles and scripts, which the app's binary serves.",
  "scripts": {
    "build": "tailwindcss -i ./site.css -o ./dist/assets/site.css --minify && node -e \"require('fs').copyFileSync(require.resolve('htmx.org/dist/htmx.min.js'), 'dist/assets/htmx.min.js')\"",
    "dev": "node -e \"require('fs').mkdirSync('dist/assets', {recursive: true}); require('fs').copyFileSync(require.resolve('htmx.org/dist/htmx.min.js'), 'dist/assets/htmx.min.js')\" && tailwindcss -i ./site.css -o ./dist/assets/site.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "htmx.org": "4.0.2",
    "tailwindcss": "4.3.5"
  }
}
