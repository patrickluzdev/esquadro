// Domain is the domain the site answers on, "" for the app's; Path, where
// it is on the app's domain ("" on a domain of its own).
const (
	Domain = {{quote $o.domain}}
	Path   = {{if $o.domain}}""{{else}}{{quote (or $o.path (printf "/%s" $n))}}{{end}}
)

// Name is the site's name, in every title; Locale, its language.
const (
	Name   = {{quote (or $o.name .App.Label)}}
	Locale = {{quote (or (and (eq $o.locale "pt_br") "pt-BR") "en")}}
)

// realm is the realm whose people sign in to the site.
const realm = {{quote (or (and $realm $realm.Name) "")}}

// pageSize is how many records a list shows at a time.
const pageSize = {{$o.page_size}}

// files are the built styles and scripts: dist/assets, when built (npm run
// build), and dist/README.md.
//
//go:embed all:dist
var files embed.FS

// Deps are what the site reads: the modules of its pages{{if or $images $og}}, and the
// store of their pictures{{end}}{{if $og}} and of the images it draws{{end}}.
type Deps struct {
{{- range $mods}}
	{{.Pascal}} *{{.Snake}}.{{.Pascal}}
{{- end}}
{{- if or $images $og}}
	Storage *storage.Store
{{- end}}
{{- if $redirects}}
	// VisitorSecret tells a visit apart a day at a time (edge.Visitor);
	// TrustProxy, whether the client's address comes from the proxy's
	// header.
	VisitorSecret []byte
	TrustProxy    bool
{{- end}}
	Logger *slog.Logger
}

// Site is the {{$n}} site: an http.Handler of its pages, served at / (the
// app strips Path).
type Site struct {
	deps Deps
	mux  *http.ServeMux
	// base is the site's address, for canonical links: the url option, or
	// the request's.
	base string
{{- if $og}}
	// og is what the site's Open Graph images are drawn with: the brand's
	// colors and fonts, and its logo (nil without one it can draw).
	og     images.Theme
	ogLogo image.Image
{{- end}}
}

// New is the site, with what it reads.
func New(d Deps) *Site {
	if d.Logger == nil {
		d.Logger = slog.Default()
	}
	s := &Site{deps: d, mux: http.NewServeMux(), base: {{quote (or $o.url (and $o.domain (printf "https://%s" $o.domain)) "")}}}
{{- if $og}}
	s.og, s.ogLogo = ogTheme(d.Logger)
{{- end}}
	s.routes()
	return s
}
{{- if $og}}

// ogThemeHash tells apart what the images are drawn with (the colors, and
// the brand's font and logo files): part of the name each is kept under,
// so that a change to them draws the images again.
const ogThemeHash = {{quote (ogThemeHash $brand $o)}}

// ogTheme is what the site's Open Graph images are drawn with: the colors
// {{if $brand}}and fonts of its brand, and its logo{{else}}of its theme, in the Go fonts{{end}}.
func ogTheme(log *slog.Logger) (images.Theme, image.Image) {
	t := images.Theme{Colors: map[string]string{
{{- range $role, $c := ogColors $brand $o}}
		{{quote $role}}: {{quote $c}},
{{- end}}
	}}
	var logo image.Image
{{- if $brand}}
{{- $display := ogFont $brand "display"}}{{$body := ogFont $brand "body"}}
{{- if or $display $body}}
	fonts, err := images.LoadFonts(brand.Files, map[string]string{ {{- if $display}}"display": {{quote $display}}{{end}}{{if and $display $body}}, {{end}}{{if $body}}"body": {{quote $body}}{{end -}} })
	if err != nil {
		log.Warn("site: the brand's fonts, for its images: the Go fonts in their place", "error", err)
	}
	t.Fonts = fonts
{{- end}}
{{- with ogLogo $brand}}
	if data, err := fs.ReadFile(brand.Files, {{quote .}}); err == nil {
		logo, err = images.Decode(data)
		if err != nil {
			log.Warn("site: the brand's logo, for its images", "error", err)
		}
	}
{{- end}}
{{- end}}
	_ = log
	return t, logo
}

// ogCache keeps the site's Open Graph images in the store, until what they
// are drawn from changes.
func (s *Site) ogCache() images.Cache {
	return images.Cache{Store: s.deps.Storage, Logger: s.deps.Logger}
}
{{- if siteOGPictures $pages}}

// picture is the picture of an image field's file, to draw: nil without
// one, or when it cannot be read (logged).
func (s *Site) picture(ctx context.Context, id uuid.UUID) image.Image {
	if id == uuid.Nil() || s.deps.Storage == nil {
		return nil
	}
	found, err := s.deps.Storage.Files(ctx, []uuid.UUID{id})
	f, ok := found[id]
	if err != nil || !ok {
		return nil
	}
	data, err := s.deps.Storage.Read(ctx, f)
	if err == nil {
		var img image.Image
		if img, err = images.Decode(data); err == nil {
			return img
		}
	}
	s.deps.Logger.WarnContext(ctx, "site: a picture, for an image", "file", id, "error", err)
	return nil
}
{{- end}}

// servePNG answers an image the site drew: kept by browsers and proxies
// for an hour (public: everyone may read it), told apart by etag; one
// asked for again unchanged is not sent.
func servePNG(w http.ResponseWriter, r *http.Request, etag string, public bool, draw func() ([]byte, error)) error {
	h := w.Header()
	h.Set("ETag", etag)
	h.Set("Cache-Control", map[bool]string{true: "public, max-age=3600", false: "private, max-age=3600"}[public])
	if r.Header.Get("If-None-Match") == etag {
		w.WriteHeader(http.StatusNotModified)
		return nil
	}
	data, err := draw()
	if err != nil {
		h.Del("ETag")
		h.Set("Cache-Control", "no-store")
		return err
	}
	h.Set("Content-Type", "image/png")
	h.Set("Content-Length", strconv.Itoa(len(data)))
	h.Set("X-Content-Type-Options", "nosniff")
	w.WriteHeader(http.StatusOK)
	_, _ = w.Write(data)
	return nil
}

// ogFailed answers an Open Graph image that could not be drawn: {{with $brand}}{{with .Theme.Identity.OGImage}}the
// brand's picture, where it is{{else}}an error{{end}}{{else}}an error{{end}}. The error is logged.
func (s *Site) ogFailed(w http.ResponseWriter, r *http.Request, err error) {
	if errors.Is(err, context.Canceled) {
		return
	}
	s.deps.Logger.ErrorContext(r.Context(), "site: an Open Graph image", "path", r.URL.Path, "error", err)
	w.Header().Set("Cache-Control", "no-store")
{{- with $brand}}{{with .Theme.Identity.OGImage}}
	http.Redirect(w, r, URL("/brand/{{.}}"), http.StatusFound)
{{- else}}
	http.Error(w, "the image could not be drawn", http.StatusInternalServerError)
{{- end}}{{else}}
	http.Error(w, "the image could not be drawn", http.StatusInternalServerError)
{{- end}}
}
{{- end}}

func (s *Site) ServeHTTP(w http.ResponseWriter, r *http.Request) { s.mux.ServeHTTP(w, r) }

func (s *Site) routes() {
	m := s.mux
	m.HandleFunc("GET /{$}", s.home)
	assets, _ := fs.Sub(files, "dist")
	static := http.FileServerFS(assets)
	m.Handle("GET /{{$sys.assets}}/", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		assetCache(w, r, strings.TrimPrefix(r.URL.Path, "/{{$sys.assets}}/"))
		static.ServeHTTP(w, r)
	}))
	m.HandleFunc("GET /{{$sys.sitemap}}", s.sitemap)
	m.HandleFunc("GET /robots.txt", s.robots)
{{- if siteSearch $pages}}
	m.HandleFunc("GET /{{$sys.search}}", s.search)
{{- end}}
{{- range $pages}}
	m.HandleFunc("GET /{{.Path}}", s.list{{.Entity.Plural.Pascal}})
	m.HandleFunc("GET /{{.Path}}/{id}", s.read{{.Entity.Pascal}})
	m.HandleFunc("GET /{{.Path}}/{id}/{slug}", s.read{{.Entity.Pascal}})
{{- if and .Image $images}}
	m.HandleFunc("GET /{{.Path}}/{id}/img", s.image{{.Entity.Pascal}})
{{- end}}
{{- if and .OG (uses "images")}}
	m.HandleFunc("GET /{{.Path}}/{id}/og.png", s.og{{.Entity.Pascal}})
{{- end}}
{{- end}}
{{- if $brand}}
	// The brand's files, and its icons at the root too, where browsers and
	// the manifest look for them.
	m.Handle("GET /brand/", http.StripPrefix("/brand/", brandFiles(http.FileServerFS(brand.Files))))
{{- range $brand.IconFiles}}
	m.Handle("GET /{{.}}", brandFiles(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
{{- if hasSuffix . ".webmanifest"}}
		w.Header().Set("Content-Type", "application/manifest+json")
{{- end}}
		http.ServeFileFS(w, r, brand.Files, {{quote (printf "%s/%s" $brand.Theme.Identity.Icons .)}})
	})))
{{- end}}
{{- end}}
{{- range $redirects}}
	m.HandleFunc("GET {{.Route}}", s.redirect{{.Entity.Pascal}})
{{- end}}
	s.accountRoutes(m)
	// Your own pages, in routes.go.
	if own, ok := any(s).(interface{ ownRoutes(*http.ServeMux) }); ok {
		own.ownRoutes(m)
	}
	m.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) { s.NotFound(w, r) })
}

// Page is what every page knows: what it is called and described as, for
// people and search engines, and who is reading it.
type Page struct {
	Site *Site
	// Title is the page's own title (the site's name is added); Description,
	// a sentence about it; Image, the absolute address of its picture.
	Title, Description, Image string
	// ImageWidth and ImageHeight are its picture's size, in pixels, when
	// known: an Open Graph image the site draws.
	ImageWidth, ImageHeight int
	// Canonical is the page's absolute address; Path, its path on the site.
	Canonical, Path string
	// Schema is its structured data (JSON-LD), "" for none.
	Schema string
	// NoIndex keeps it out of search engines: an empty search, an error.
	NoIndex bool
	// SignedIn is whether the reader signed in to the site's realm.
	SignedIn bool
	// Query is what was searched, for the search box.
	Query string
	// Status is the HTTP status the page is answered with.
	Status int
	// Refresh is where the page goes on by itself, and after how many
	// seconds ("3;url=https://..."), "" for nowhere: a redirect's page.
	Refresh string
}

// page is a page of a request, with the title and description given.
func (s *Site) page(r *http.Request, title, description string) Page {
	p := Page{Site: s, Title: title, Description: description, Path: r.URL.Path, Status: http.StatusOK,
		SignedIn: realm != "" && security.SignedIn(r.Context(), realm), Query: r.URL.Query().Get("q")}
	canonical := r.URL.Path
	if page := r.URL.Query().Get("page"); page != "" && page != "1" {
		canonical += "?page=" + url.QueryEscape(page)
	}
	p.Canonical = s.Abs(r, canonical)
{{- with $brand}}{{with .Theme.Identity.OGImage}}
	// The brand's picture, for a page whose own does not set one.
	p.Image = s.Abs(r, URL("/brand/{{.}}"))
{{- end}}{{end}}
	return p
}

// FullTitle is the title of the page's tab: its own, then the site's name.
func (p Page) FullTitle() string {
	if p.Title == "" || p.Title == Name {
		return Name
	}
	return T("pageTitle", "title", p.Title, "site", Name)
}

// assetVersions are the assets' versions by name (site.css, kit.js): a
// hash of their content, which their addresses carry, so that a new build
// is a new address and browsers keep each one for good.
var assetVersions = func() map[string]string {
	v := map[string]string{"kit.js": version(kitJS)}
	entries, _ := fs.ReadDir(files, "dist/{{$sys.assets}}")
	for _, e := range entries {
		if b, err := fs.ReadFile(files, "dist/{{$sys.assets}}/"+e.Name()); err == nil && !e.IsDir() {
			v[e.Name()] = version(b)
		}
	}
	return v
}()

func version(b []byte) string {
	sum := sha256.Sum256(b)
	return hex.EncodeToString(sum[:5])
}

// Asset is the address of an asset of the site (site.css, kit.js), with
// its version.
func Asset(name string) string {
	if v := assetVersions[name]; v != "" {
		return URL("/{{$sys.assets}}/" + name + "?v=" + v)
	}
	return URL("/{{$sys.assets}}/" + name)
}

// assetCache says how long a browser keeps an asset: for good at the
// address of its version, a few minutes at any other.
func assetCache(w http.ResponseWriter, r *http.Request, name string) {
	if v := r.URL.Query().Get("v"); v != "" && v == assetVersions[name] {
		w.Header().Set("Cache-Control", "public, max-age=31536000, immutable")
		return
	}
	w.Header().Set("Cache-Control", "public, max-age=300")
}

// URL is a path of the site as links write it: under Path, on the app's
// domain.
func URL(path string) string { return Path + path }

// Abs is a path of the site as an absolute address: for canonical links,
// Open Graph and the sitemap. On this machine (localhost, or the site's
// alias in development, site.localhost:8080), it is on the request's
// address, so that the links lead back to it.
func (s *Site) Abs(r *http.Request, path string) string {
	base := s.base
	if base == "" || local(r.Host) {
		scheme := "http"
		if r.TLS != nil || r.Header.Get("X-Forwarded-Proto") == "https" {
			scheme = "https"
		}
		base = scheme + "://" + r.Host
	}
	return strings.TrimSuffix(base, "/") + URL(path)
}

// local reports whether host is this machine's: localhost, or a name under
// it, with a port or none.
func local(host string) bool {
	if h, _, err := net.SplitHostPort(host); err == nil {
		host = h
	}
	return host == "localhost" || strings.HasSuffix(host, ".localhost")
}

// render answers a page: the HTML of c, with the status of p.
func (s *Site) render(w http.ResponseWriter, r *http.Request, status int, c templ.Component) {
	h := w.Header()
	h.Set("Content-Type", "text/html; charset=utf-8")
	h.Set("Content-Security-Policy", csp)
	// A page shows who reads it (the header's account): a browser asks
	// again each time, and no shared cache keeps it. A page that said how
	// it is kept (no-store) keeps it.
	switch {
	case h.Get("Cache-Control") != "":
	case status == http.StatusOK && r.Method == http.MethodGet:
		h.Set("Cache-Control", "private, no-cache")
	default:
		h.Set("Cache-Control", "no-store")
	}
	w.WriteHeader(status)
	if err := c.Render(r.Context(), w); err != nil {
		s.deps.Logger.ErrorContext(r.Context(), "render", "path", r.URL.Path, "error", err)
	}
}

// csp lets the site's pages run their own scripts and styles, show pictures
// from anywhere over HTTPS, and send forms to themselves.
const csp = "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; " +
	"connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'"

// NotFound answers the page of something the site does not have.
func (s *Site) NotFound(w http.ResponseWriter, r *http.Request) {
	p := s.page(r, T("notFoundTitle"), "")
	p.NoIndex, p.Status = true, http.StatusNotFound
	s.render(w, r, http.StatusNotFound, ProblemPage(p, T("notFoundTitle"), T("notFoundText")))
}

// Gone answers the page of what is no longer there (410): a link to an
// offer that ended, which its rules said (ErrGone).
func (s *Site) Gone(w http.ResponseWriter, r *http.Request) {
	p := s.page(r, T("goneTitle"), "")
	p.NoIndex, p.Status = true, http.StatusGone
	s.render(w, r, http.StatusGone, ProblemPage(p, T("goneTitle"), T("goneText")))
}
{{- range $redirects}}{{$e := .Entity}}{{$p := $e.Module.Snake}}

// {{$e.Pascal}}Redirect is the page a person sees on the way from a {{lower $e.Label}}'s
// address to another site's, with a wait ({{$e.Snake}}_redirect.templ, yours).
type {{$e.Pascal}}Redirect struct {
	Page Page
	// Record is the {{lower $e.Label}} visited.
	Record {{$p}}.{{$e.Pascal}}
	// To is where it goes; Host, the host of To, without www
	// (shopee.com.br).
	To, Host string
	// Wait is the seconds before it goes on by itself.
	Wait int
}

// redirect{{$e.Pascal}} sends a visit of a {{lower $e.Label}}'s address on: where its
// rules say (BeforeRedirect, in {{$e.Snake}}_rules.go; its {{.To.Snake}} by default),
// or to the page of what is no longer there. Bots go on too (a link's
// preview shows what it leads to), told apart in the Visit.
{{- if .Wait}} A person going
// to another site sees where first, for {{.Wait}} seconds ({{$e.Pascal}}RedirectPage).
{{- end}}
func (s *Site) redirect{{$e.Pascal}}(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	m := s.deps.{{$e.Module.Pascal}}
	x, err := m.Read{{$e.Pascal}}By{{.By.Pascal}}(ctx, r.PathValue("key"))
	if errors.Is(err, {{$p}}.Err{{$e.Pascal}}NotFound) {
		s.NotFound(w, r)
		return
	}
	if err != nil {
		s.fail(w, r, err)
		return
	}
	visit := {{$p}}.Visit{
		Bot:       edge.IsBot(r),
		Visitor:   edge.Visitor(r, s.deps.VisitorSecret, s.deps.TrustProxy),
		Referrer:  r.Referer(),
		UserAgent: r.UserAgent(),
		At:        time.Now(),
	}
	rules := {{$p}}.{{$e.Pascal}}Rules{}
	to, err := rules.BeforeRedirect(ctx, m, x, visit)
	if errors.Is(err, {{$p}}.ErrGone) || (err == nil && to == "") {
		s.Gone(w, r)
		return
	}
	if err != nil {
		s.fail(w, r, err)
		return
	}
	// An address of the site is where the site is on the app's domain.
	if strings.HasPrefix(to, "/") && !strings.HasPrefix(to, "//") {
		to = Path + to
	}
	// Never kept by a browser or a proxy: every visit comes here.
	w.Header().Set("Cache-Control", "no-store")
{{- if .Wait}}
	if dest, err := url.Parse(to); err == nil && !visit.Bot && (dest.Scheme == "http" || dest.Scheme == "https") && dest.Host != "" {
		const wait = {{.Wait}}
		host := strings.TrimPrefix(dest.Hostname(), "www.")
		p := s.page(r, T("redirectTitle", "host", host), "")
		p.NoIndex, p.Refresh = true, fmt.Sprintf("%d;url=%s", wait, to)
		s.render(w, r, http.StatusOK, {{$e.Pascal}}RedirectPage({{$e.Pascal}}Redirect{Page: p, Record: x, To: to, Host: host, Wait: wait}))
	} else {
		http.Redirect(w, r, to, http.StatusFound)
	}
{{- else}}
	http.Redirect(w, r, to, http.StatusFound)
{{- end}}
	// After the answer, whatever the client does with the connection.
	if err := rules.Visited(context.WithoutCancel(ctx), m, x, visit); err != nil {
		s.deps.Logger.ErrorContext(ctx, "site: keeping a visit", "path", r.URL.Path, "error", err)
	}
}
{{- end}}

{{- if $brand}}
// brandFiles serves the brand's files, which change only with a new
// version of the app: kept by browsers for a day.
func brandFiles(h http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Cache-Control", "public, max-age=86400")
		h.ServeHTTP(w, r)
	})
}

{{end -}}
// statePictures are the brand's pictures of the states, files of its
// folder by state.
var statePictures = map[string]string{
{{- with $brand}}{{range $state, $file := .Theme.States}}
	{{quote $state}}: {{quote $file}},
{{- end}}{{end}}
}

// stateOf is the state a page of a status shows: not_found, gone,
// forbidden or error.
func stateOf(status int) string {
	switch status {
	case http.StatusNotFound:
		return "not_found"
	case http.StatusGone:
		return "gone"
	case http.StatusUnauthorized, http.StatusForbidden:
		return "forbidden"
	}
	return "error"
}

// fail answers the page of an error, logged; one that is no record's
// refusal or absence is the site's.
func (s *Site) fail(w http.ResponseWriter, r *http.Request, err error) {
	if errors.Is(err, context.Canceled) {
		return
	}
	s.deps.Logger.ErrorContext(r.Context(), "site", "path", r.URL.Path, "error", err)
	p := s.page(r, T("errorTitle"), "")
	p.NoIndex, p.Status = true, http.StatusInternalServerError
	s.render(w, r, http.StatusInternalServerError, ProblemPage(p, T("errorTitle"), T("errorText")))
}

// Pager is a list's pages: the one shown, how many, and their addresses.
type Pager struct {
	Number, Pages int
	Total         int64
	query         url.Values
	path          string
}

// pagerOf is the pager of a list of total records at path, the query's.
func pagerOf(r *http.Request, total int64, number int) Pager {
	pages := int((total + pageSize - 1) / pageSize)
	return Pager{Number: number, Pages: max(pages, 1), Total: total, query: r.URL.Query(), path: r.URL.Path}
}

// Link is the address of page n of the list, with the same filters.
func (p Pager) Link(n int) string {
	q := url.Values{}
	for k, v := range p.query {
		q[k] = v
	}
	q.Del("page")
	if n > 1 {
		q.Set("page", strconv.Itoa(n))
	}
	if len(q) == 0 {
		return URL(p.path)
	}
	return URL(p.path) + "?" + q.Encode()
}

// pageNumber is the page a request asks for, from 1.
func pageNumber(r *http.Request) int {
	n, err := strconv.Atoi(r.URL.Query().Get("page"))
	if err != nil || n < 1 {
		return 1
	}
	return n
}

// Option is a choice of a list's filter or order.
type Option struct {
	Value, Label string
	Chosen       bool
}

// Filter is a filter of a list: its parameter, what it is called, and its
// options.
type Filter struct {
	Param, Label string
	Options      []Option
}

// Chosen is the label of the option chosen, "" for none.
func (f Filter) Chosen() string {
	for _, o := range f.Options {
		if o.Chosen && o.Value != "" {
			return o.Label
		}
	}
	return ""
}

// Slug is a title as an address: lowercase words joined by hyphens, with
// no accents.
func Slug(title string) string {
	var b strings.Builder
	dash := false
	for _, r := range unaccent.Replace(strings.ToLower(title)) {
		switch {
		case r < unicode.MaxASCII && (unicode.IsLetter(r) || unicode.IsDigit(r)):
			if dash && b.Len() > 0 {
				b.WriteByte('-')
			}
			dash = false
			b.WriteRune(r)
		default:
			dash = true
		}
		if b.Len() >= 80 {
			break
		}
	}
	if b.Len() == 0 {
		return "-"
	}
	return b.String()
}

var unaccent = strings.NewReplacer(
	"á", "a", "à", "a", "â", "a", "ã", "a", "ä", "a",
	"é", "e", "è", "e", "ê", "e", "ë", "e",
	"í", "i", "ì", "i", "î", "i", "ï", "i",
	"ó", "o", "ò", "o", "ô", "o", "õ", "o", "ö", "o",
	"ú", "u", "ù", "u", "û", "u", "ü", "u",
	"ç", "c", "ñ", "n",
)

// readID is the record id of a request's path, false when it is no id.
func readID(r *http.Request) (uuid.UUID, bool) {
	id, err := uuid.Parse(r.PathValue("id"))
	return id, err == nil
}

// schema is structured data as a page writes it, "" when it cannot be.
func schema(v map[string]any) string {
	v["@context"] = "https://schema.org"
	b, err := json.Marshal(v)
	if err != nil {
		return ""
	}
	return string(b)
}

// Words.

// T is the site's word for key in its language, with each {name} of the
// text replaced: T("count", "count", "3"). Yours (messages.go) win over
// esquadro's; a key neither has is answered as it is. With a count of 1,
// the word's form for one, key_one ("{count} found"), when it has one: of
// yours, or of esquadro's when you did not change the word.
func T(key string, args ...string) string {
	text, ok := ownWords[key]
	if !ok {
		text, ok = words[key]
	}
	if countIsOne(args) {
		if one, found := ownWords[key+"_one"]; found {
			text, ok = one, true
		} else if _, changed := ownWords[key]; !changed {
			if one, found := words[key+"_one"]; found {
				text, ok = one, true
			}
		}
	}
	if !ok {
		return key
	}
	for i := 0; i+1 < len(args); i += 2 {
		text = strings.ReplaceAll(text, "{"+args[i]+"}", args[i+1])
	}
	return text
}

// countIsOne reports whether the {count} of T's args is 1.
func countIsOne(args []string) bool {
	for i := 0; i+1 < len(args); i += 2 {
		if args[i] == "count" {
			return args[i+1] == "1"
		}
	}
	return false
}

// words are esquadro's: those every frontend shares, then the site's own.
var words = map[string]string{
{{- range siteWords $o.locale}}
	{{quote .Key}}: {{quote .Text}},
{{- end}}
}

