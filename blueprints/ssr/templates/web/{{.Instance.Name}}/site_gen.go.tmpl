// Date is a day: 18 de novembro de 2026, November 18, 2026.
func Date(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	if Locale == "pt-BR" {
		return fmt.Sprintf("%d de %s de %d", t.Day(), monthsPT[t.Month()-1], t.Year())
	}
	return t.Format("January 2, 2006")
}

var monthsPT = [...]string{"janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"}

// DateTime is a moment, in the server's time zone: 18/11/2026 14:05.
func DateTime(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	if Locale == "pt-BR" {
		return t.Local().Format("02/01/2006 15:04")
	}
	return t.Local().Format("Jan 2, 2006 3:04 PM")
}

// Number is an integer with the thousands grouped: 1.234, 1,234.
func Number(n int64) string {
	s := strconv.FormatInt(n, 10)
	sep := ","
	if Locale == "pt-BR" {
		sep = "."
	}
	var b strings.Builder
	for i, c := range s {
		if i > 0 && (len(s)-i)%3 == 0 && s[i-1] != '-' {
			b.WriteString(sep)
		}
		b.WriteRune(c)
	}
	return b.String()
}

// YesNo is a yes or no in words.
func YesNo(v bool) string {
	if v {
		return T("yesValue")
	}
	return T("noValue")
}
