{{- $o := .Options}}{{$brand := siteBrand .App .Options -}}
{{- $base := ""}}{{if not $o.domain}}{{$base = or $o.path (printf "/%s" .Instance.Name)}}{{end -}}
{{- if $brand -}}
/* Generated by esquadro: do not edit. The site's look from its brand
   ({{$brand.Dir}}/theme.json): the colors by role and its own, the fonts, the
   text roles (.t-<role>), radii, motion, and the kit's pieces (.btn, .field,
   .chip, .card, .notice, .progress, .price, .photo). site.css, yours,
   imports this first: a token set there wins. */
{{$brand.CSS (printf "%s/brand/" $base)}}
{{- else -}}
/* Generated by esquadro: do not edit. The site's tokens from its options
   (primary, primary_dark, radius in the .esq), the same every frontend of
   the app writes. site.css, yours, imports this first: a token set there
   wins. */
{{- $t := uiTheme .Options }}
:root {
  --radius: {{$t.Radius}};
  --background: #ffffff;
  --foreground: #0a0a0a;
  --muted: #f4f4f5;
  --muted-foreground: #71717a;
  --border: #e4e4e7;
  --destructive: #dc2626;
  --primary: {{$t.Primary}};
  --primary-foreground: {{$t.OnPrimary}};
  --ring: {{$t.Primary}};
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #fafafa;
    --muted: #27272a;
    --muted-foreground: #a1a1aa;
    --border: #27272a;
    --destructive: #f87171;
    --primary: {{$t.Dark}};
    --primary-foreground: {{$t.OnDark}};
    --ring: {{$t.Dark}};
  }
}
{{- end}}
