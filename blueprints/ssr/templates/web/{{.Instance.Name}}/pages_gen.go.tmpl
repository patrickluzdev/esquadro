// Home is the site's first page: the latest records of each entity with
// pages.
type Home struct {
	Page
{{- range $pages}}
	{{.Entity.Plural.Pascal}} []{{.Entity.Module.Snake}}.{{.Entity.Pascal}}
{{- end}}
}

// homeSize is how many of each the first page shows.
const homeSize = 8

func (s *Site) home(w http.ResponseWriter, r *http.Request) {
{{- if $pages}}
	ctx := r.Context()
{{- end}}
	view := Home{Page: s.page(r, Name, Description)}
{{- range $pages}}{{$e := .Entity}}
	if ({{$e.Module.Snake}}.{{$e.Pascal}}Policy{}).List(ctx).All() {
		page, err := s.deps.{{$e.Module.Pascal}}.List{{$e.Plural.Pascal}}(ctx, {{$e.Module.Snake}}.{{$e.Pascal}}Query{Page: 1, PerPage: homeSize, Sort: {{quote .Sort}}})
		if err != nil {
			s.fail(w, r, err)
			return
		}
		view.{{$e.Plural.Pascal}} = page.{{$e.Plural.Pascal}}
	}
{{- end}}
	s.render(w, r, http.StatusOK, HomePage(view))
}
{{- if siteSearch $pages}}

