func (s *Site) search(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	q := strings.TrimSpace(r.URL.Query().Get("q"))
	view := Search{Page: s.page(r, T("search"), "")}
	view.NoIndex = true
	if q != "" {
		view.Title = T("resultsFor", "q", q)
{{- range $pages}}{{if .Search}}{{$e := .Entity}}
		if ({{$e.Module.Snake}}.{{$e.Pascal}}Policy{}).List(ctx).All() {
			page, err := s.deps.{{$e.Module.Pascal}}.List{{$e.Plural.Pascal}}(ctx, {{$e.Module.Snake}}.{{$e.Pascal}}Query{Search: q, Page: 1, PerPage: homeSize})
			if err != nil {
				s.fail(w, r, err)
				return
			}
			view.{{$e.Plural.Pascal}} = page.{{$e.Plural.Pascal}}
		}
{{- end}}{{end}}
	}
	s.render(w, r, http.StatusOK, SearchPage(view))
}

// SearchURL is the address of the site's search.
func SearchURL() string { return URL(paths.search) }
