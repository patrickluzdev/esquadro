// sitemapMax is the most addresses the sitemap holds, as search engines
// read them.
const sitemapMax = 50000

type sitemapURL struct {
	Loc     string `xml:"loc"`
	LastMod string `xml:"lastmod,omitempty"`
}

func (s *Site) sitemap(w http.ResponseWriter, r *http.Request) {
{{- if $pages}}
	ctx := r.Context()
{{- end}}
	urls := []sitemapURL{ {Loc: s.Abs(r, "/")} }
{{- range $pages}}{{$e := .Entity}}
	if ({{$e.Module.Snake}}.{{$e.Pascal}}Policy{}).List(ctx).All() {
		urls = append(urls, sitemapURL{Loc: s.Abs(r, "/{{.Path}}")})
{{- if .Browses}}
		browses, err := s.{{$e.Plural.Camel}}Browses(ctx)
		if err != nil {
			s.fail(w, r, err)
			return
		}
		for _, found := range browses {
			for _, b := range found {
				urls = append(urls, sitemapURL{Loc: s.Abs(r, b.Path)})
			}
		}
{{- end}}
		for number := 1; len(urls) < sitemapMax; number++ {
			page, err := s.deps.{{$e.Module.Pascal}}.List{{$e.Plural.Pascal}}(ctx, {{$e.Module.Snake}}.{{$e.Pascal}}Query{Page: number, PerPage: 100})
			if err != nil {
				s.fail(w, r, err)
				return
			}
			for _, x := range page.{{$e.Plural.Pascal}} {
				if ({{$e.Module.Snake}}.{{$e.Pascal}}Policy{}).Read(ctx, x) {
					urls = append(urls, sitemapURL{Loc: s.Abs(r, {{$e.Pascal}}Path(x)), LastMod: x.UpdatedAt.UTC().Format("2006-01-02")})
				}
			}
			if len(page.{{$e.Plural.Pascal}}) < 100 {
				break
			}
		}
	}
{{- end}}
	w.Header().Set("Content-Type", "application/xml; charset=utf-8")
	w.Header().Set("Cache-Control", "public, max-age=3600")
	_, _ = w.Write([]byte(xml.Header))
	_ = xml.NewEncoder(w).Encode(struct {
		XMLName xml.Name     `xml:"urlset"`
		NS      string       `xml:"xmlns,attr"`
		URLs    []sitemapURL `xml:"url"`
	}{NS: "http://www.sitemaps.org/schemas/sitemap/0.9", URLs: urls})
}

func (s *Site) robots(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "text/plain; charset=utf-8")
	w.Header().Set("Cache-Control", "public, max-age=3600")
	var b strings.Builder
	b.WriteString("User-agent: *\n")
	for _, p := range []string{paths.signin, paths.signup, paths.forgot, paths.reset, paths.account, paths.confirm, paths.search} {
		b.WriteString("Disallow: " + URL(p) + "\n")
	}
	b.WriteString("Sitemap: " + s.Abs(r, "/{{(sitePaths $o.locale).sitemap}}") + "\n")
	_, _ = w.Write([]byte(b.String()))
}

// llmsMax is how many of each list's latest records llms.txt links.
const llmsMax = 50

// llms answers /llms.txt (https://llmstxt.org): the site's name and what
// it is, then, for each list a reader who did not sign in may read, its
// address, those of its filters' values and of its latest records.
func (s *Site) llms(w http.ResponseWriter, r *http.Request) {
{{- if $pages}}
	ctx := r.Context()
{{- end}}
	var b strings.Builder
	b.WriteString("# " + llmsText(Name) + "\n")
	if Description != "" {
		b.WriteString("\n> " + llmsText(Description) + "\n")
	}
	link := func(name, path, note string) {
		b.WriteString("- [" + llmsText(name) + "](" + s.Abs(r, path) + ")")
		if note = llmsText(note); note != "" {
			b.WriteString(": " + note)
		}
		b.WriteString("\n")
	}
	_ = link
{{- range $pages}}{{$e := .Entity}}{{$pg := .}}
	if ({{$e.Module.Snake}}.{{$e.Pascal}}Policy{}).List(ctx).All() {
		b.WriteString("\n## " + llmsText({{$e.Plural.Pascal}}Label) + "\n\n")
		link({{$e.Plural.Pascal}}Label, "/{{.Path}}", "")
{{- if .Browses}}
		browses, err := s.{{$e.Plural.Camel}}Browses(ctx)
		if err != nil {
			s.fail(w, r, err)
			return
		}
		for _, found := range browses {
			for _, x := range found {
				link(T("browseTitle", "list", {{$e.Plural.Pascal}}Label, "name", x.Name), x.Path, "")
			}
		}
{{- end}}
		page, err := s.deps.{{$e.Module.Pascal}}.List{{$e.Plural.Pascal}}(ctx, {{$e.Module.Snake}}.{{$e.Pascal}}Query{Page: 1, PerPage: llmsMax})
		if err != nil {
			s.fail(w, r, err)
			return
		}
		for _, x := range page.{{$e.Plural.Pascal}} {
			if ({{$e.Module.Snake}}.{{$e.Pascal}}Policy{}).Read(ctx, x) {
				link({{$e.Pascal}}Title(x), {{$e.Pascal}}Path(x), {{if $pg.Description}}summary(x.{{$pg.Description.Pascal}}){{else}}""{{end}})
			}
		}
	}
{{- end}}
	w.Header().Set("Content-Type", "text/markdown; charset=utf-8")
	w.Header().Set("Cache-Control", "public, max-age=3600")
	_, _ = w.Write([]byte(b.String()))
}

// llmsText is a text on one line of llms.txt's Markdown: its spaces and
// lines one space, its brackets escaped.
func llmsText(s string) string {
	s = strings.Join(strings.Fields(s), " ")
	return strings.NewReplacer(`\`, `\\`, "[", `\[`, "]", `\]`).Replace(s)
}
