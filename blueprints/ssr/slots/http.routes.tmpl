{{- range $i := instances "ssr"}}
	// The {{$i.Name}} site, rendered by the binary.
	web.Handle(mux, {{$i.Name}}.New({{$i.Name}}.Deps{
{{- range siteModules $.Entities $.Modules $i.Name}}
		{{.Pascal}}: d.{{.Camel}},
{{- end}}
{{- if or (and (siteImages (sitePages $.Entities $i.Name)) (uses "storage")) (and (siteOG (sitePages $.Entities $i.Name)) (uses "images"))}}
		Storage: d.storage,
{{- end}}
{{- if siteRedirects $.Entities $i.Name}}
		VisitorSecret: []byte(d.config.{{siteField $i.Name "VISITOR_SECRET"}}),
		TrustProxy:    d.config.TrustProxy,
{{- end}}
		Logger: d.logger,
	}), {{printf "%q" $i.Name}}, {{$i.Name}}.Domain, {{$i.Name}}.Path)
{{- end}}
