{{- $model := .Options.model -}}
{{- $protected := quote .Options.main -}}
{{- if eq $model "gitflow"}}{{$protected = printf "%s %s" (quote .Options.main) (quote .Options.develop)}}{{end -}}
{{- if eq $model "gitlab_flow"}}{{$protected = printf "%s %s" (quote .Options.main) (join " " (strs .Options.environments))}}{{end -}}
#!/bin/sh
# Generated by esquadro: the {{$model}} tasks of {{.App.Label}} (see
# CONTRIBUTING.md). Run them with task: task --list shows them. They never
# push: each one says what to send.
set -eu

main={{quote .Options.main}}
{{- if eq $model "gitflow"}}
develop={{quote .Options.develop}}
{{- end}}
{{- if eq $model "gitlab_flow"}}
environments={{quote (join " " (strs .Options.environments))}}
{{- end}}

die() {
	echo "branching: $*" >&2
	exit 1
}

# clean refuses to go on with uncommitted changes.
clean() {
	[ -z "$(git status --porcelain)" ] || die "commit or stash your changes first"
}

current() {
	git rev-parse --abbrev-ref HEAD
}

# fresh brings a branch up to date with origin, when there is one and it has
# the branch.
fresh() {
	if git remote get-url origin >/dev/null 2>&1 && git ls-remote --exit-code --heads origin "$1" >/dev/null 2>&1; then
		git fetch -q origin "$1:$1" 2>/dev/null || die "$1 differs from origin/$1: update it first"
	fi
}

# named checks the name of a new branch.
named() {
	[ -n "${1:-}" ] || die "give it a name: task $2 -- <name>"
	echo "$1" | grep -Eq '^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$' || die "\"$1\" is not a branch name: use letters, digits, ., _, - and /"
}

# version checks a version: X.Y.Z, or X.Y when only two are asked.
version() {
	[ -n "${1:-}" ] || die "give the version: task $2 -- $3"
	echo "$1" | grep -Eq "$4" || die "\"$1\" is not a version: use $3"
}

# start creates a branch from another one and switches to it.
start() {
	clean
	fresh "$2"
	git rev-parse -q --verify "refs/heads/$1" >/dev/null && die "$1 already exists"
	git switch -q -c "$1" "$2"
	echo "on $1, from $2"
}

# merge merges a branch into another one, keeping the merge commit.
merge() {
	git switch -q "$2"
	git merge -q --no-ff "$1" -m "Merge branch '$1' into $2"
}

command=${1:-}
[ $# -gt 0 ] && shift
case "$command" in
{{- if eq $model "gitflow"}}
feature-start | bugfix-start)
	kind=${command%-start}
	named "${1:-}" "$kind:start"
	start "$kind/$1" "$develop"
	;;
feature-finish | bugfix-finish)
	kind=${command%-finish}
	branch=$(current)
	case "$branch" in "$kind"/*) ;; *) die "you are on $branch, not on a $kind/ branch" ;; esac
	clean
	fresh "$develop"
	merge "$branch" "$develop"
	git branch -q -d "$branch"
	echo "merged $branch into $develop; to send it: git push origin $develop"
	;;
release-start | hotfix-start)
	kind=${command%-start}
	version "${1:-}" "$kind:start" "X.Y.Z, e.g. 1.2.0" '^[0-9]+\.[0-9]+\.[0-9]+$'
	from=$develop
	[ "$kind" = hotfix ] && from=$main
	start "$kind/$1" "$from"
	;;
release-finish | hotfix-finish)
	kind=${command%-finish}
	branch=$(current)
	case "$branch" in "$kind"/*) ;; *) die "you are on $branch, not on a $kind/ branch" ;; esac
	v=${branch#"$kind"/}
	version "$v" "$kind:start" "X.Y.Z, e.g. 1.2.0" '^[0-9]+\.[0-9]+\.[0-9]+$'
	clean
	git rev-parse -q --verify "refs/tags/v$v" >/dev/null && die "the tag v$v already exists"
	fresh "$main"
	fresh "$develop"
	merge "$branch" "$main"
	git tag -a "v$v" -m "v$v"
	merge "$branch" "$develop"
	git branch -q -d "$branch"
	echo "released v$v on $main and merged it into $develop; to send it: git push origin $main $develop v$v"
	;;
{{- else if eq $model "github_flow"}}
feature-start)
	named "${1:-}" "feature:start"
	start "feature/$1" "$main"
	echo "push it and open a pull request to $main: git push -u origin feature/$1"
	;;
{{- else if eq $model "gitlab_flow"}}
feature-start)
	named "${1:-}" "feature:start"
	start "feature/$1" "$main"
	echo "push it and open a pull request to $main: git push -u origin feature/$1"
	;;
promote)
	[ -n "${1:-}" ] || die "give the environment: task promote -- <one of: $environments>"
	from=$main
	found=
	for env in $environments; do
		if [ "$env" = "$1" ]; then
			found=yes
			break
		fi
		from=$env
	done
	[ -n "$found" ] || die "$1 is not an environment: $environments"
	clean
	back=$(current)
	fresh "$from"
	fresh "$1"
	merge "$from" "$1"
	git switch -q "$back"
	echo "promoted $from to $1; to send it: git push origin $1"
	;;
{{- else if eq $model "trunk"}}
sync)
	clean
	git switch -q "$main"
	if git remote get-url origin >/dev/null 2>&1; then
		git pull -q --rebase origin "$main"
	fi
	echo "$main is up to date; to send your commits: git push origin $main"
	;;
{{- else if eq $model "release_flow"}}
feature-start)
	named "${1:-}" "feature:start"
	start "feature/$1" "$main"
	echo "push it and open a pull request to $main: git push -u origin feature/$1"
	;;
release-cut)
	version "${1:-}" "release:cut" "X.Y, e.g. 1.2" '^[0-9]+\.[0-9]+$'
	clean
	back=$(current)
	fresh "$main"
	git rev-parse -q --verify "refs/heads/releases/$1" >/dev/null && die "releases/$1 already exists"
	git branch "releases/$1" "$main"
	echo "cut releases/$1 from $main; to send it: git push origin releases/$1"
	;;
release-pick)
	[ $# -eq 2 ] || die "give the commit and the release: task release:pick -- <commit> <X.Y>"
	clean
	back=$(current)
	git switch -q "releases/$2"
	git cherry-pick -x "$1"
	git switch -q "$back"
	echo "picked $1 into releases/$2; to send it: git push origin releases/$2"
	;;
{{- end}}
protect)
	command -v gh >/dev/null || die "protect needs the GitHub CLI, gh: https://cli.github.com"
	repo=$(gh repo view --json nameWithOwner -q .nameWithOwner) || die "gh does not know this repository on GitHub"
	for branch in {{$protected}}; do
		gh api -X PUT "repos/$repo/branches/$branch/protection" --input - >/dev/null <<JSON
{
  "required_status_checks": {{if uses "github_actions"}}{"strict": true, "contexts": ["test"]}{{else}}null{{end}},
  "enforce_admins": false,
  "required_pull_request_reviews": {"required_approving_review_count": 0},
  "restrictions": null
}
JSON
		echo "$repo: $branch now takes changes by pull request{{if uses "github_actions"}}, with a green CI{{end}}"
	done
	;;
*)
	die "unknown command \"$command\"; see task --list"
	;;
esac
