{
  "name": "{{.App.Kebab}}",
  "private": true,
  "description": "Generated by esquadro: the npm workspace of {{.App.Label}}'s frontends and its TypeScript client.",
  "workspaces": [
{{- $first := true}}
{{- if uses "client_ts"}}
    "clients/ts"{{$first = false}}
{{- end}}
{{- range frontends}}{{if not $first}},{{end}}{{$first = false}}
    "web/{{.Name}}"
{{- end}}
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  }
}
