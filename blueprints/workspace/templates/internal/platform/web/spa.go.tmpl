// Package web serves the app's single-page frontends from its binary.
// Generated by esquadro: do not edit.
package web

import (
	"io/fs"
	"net/http"
	"path"
	"strings"
)

// CSP is the Content-Security-Policy of a frontend: its own files, images
// from anywhere over HTTPS, the API on its own origin, and nothing else.
const CSP = "default-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; " +
	"font-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'"

// own are the app's paths, which a frontend on a domain of its own leaves
// to the app: its API and identity, its health, its keys.
var own = []string{"/api/", "/identity/", "/.well-known/", "/healthz", "/readyz", "/docs"}

// Mount serves a frontend's build (dist/app of files) on mux: on domain,
// when it has one (the app's own paths still reach the app there), or under
// prefix. Paths of no file answer index.html, for the frontend's routes.
func Mount(mux *http.ServeMux, files fs.FS, domain, prefix string) error {
	app, err := fs.Sub(files, "dist/app")
	if err != nil {
		return err
	}
	serve := handler(app)
	if domain != "" {
		mux.Handle(domain+"/", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			for _, p := range own {
				if strings.HasPrefix(r.URL.Path, p) {
					// The app's routes have no domain: without it, the mux
					// finds them.
					r = r.Clone(r.Context())
					r.Host = ""
					mux.ServeHTTP(w, r)
					return
				}
			}
			serve.ServeHTTP(w, r)
		}))
		return nil
	}
	prefix = "/" + strings.Trim(prefix, "/")
	mux.Handle(prefix+"/", http.StripPrefix(prefix, serve))
	mux.Handle(prefix, http.RedirectHandler(prefix+"/", http.StatusMovedPermanently))
	return nil
}

func handler(app fs.FS) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		h := w.Header()
		h.Set("Content-Security-Policy", CSP)
		name := strings.TrimPrefix(path.Clean("/"+r.URL.Path), "/")
		if name != "" && name != "index.html" {
			if info, err := fs.Stat(app, name); err == nil && !info.IsDir() {
				if strings.HasPrefix(name, "assets/") {
					// Built with their content's hash in the name.
					h.Set("Cache-Control", "public, max-age=31536000, immutable")
				} else {
					h.Set("Cache-Control", "no-cache")
				}
				http.ServeFileFS(w, r, app, name)
				return
			}
		}
		index, err := fs.ReadFile(app, "index.html")
		if err != nil {
			h.Set("Content-Type", "text/plain; charset=utf-8")
			h.Set("Cache-Control", "no-store")
			w.WriteHeader(http.StatusServiceUnavailable)
			_, _ = w.Write([]byte("This frontend is not built: run task web:build, then build the app.\n"))
			return
		}
		h.Set("Content-Type", "text/html; charset=utf-8")
		h.Set("Cache-Control", "no-cache")
		_, _ = w.Write(index)
	})
}
