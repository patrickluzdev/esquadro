{{- with instances "spa"}}
      # Node for the frontends: their packages, so that go test checks
      # them (types, tests, build).
      - uses: actions/setup-node@v7.1.0
        with:
          node-version: 24
      - name: The frontends' packages
        run: if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
{{- end}}
