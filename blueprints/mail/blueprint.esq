/// Email: by SMTP (any provider, the local Mailpit included) or Resend's
/// API, chosen by MAIL_URL in each environment. Modules send emails from
/// templates of the project; with jobs, each is a job, sealed and retried
/// until it goes. The security blueprint's emails go out here too. With
/// compose, Mailpit catches every email in development, at
/// http://localhost:8025.
blueprint mail {
  version "0.1.0"

  /// How emails go: smtp://user:password@host:port (TLS on 465, STARTTLS
  /// otherwise; without TLS only in development), resend://API_KEY, or
  /// log:// (into the log). In development, the local Mailpit of
  /// compose.yaml, or the log.
  env MAIL_URL string secret required development("{{if uses \"compose\"}}smtp://localhost:{{composePort \"mailpit\" \"1025\"}}{{else}}log://{{end}}")
  /// With jobs, seals the emails in the queue, links and addresses
  /// included; esquadro generates one for development.
  env MAIL_SECRET string secret required generate(32) when("{{if uses \"jobs\"}}true{{end}}")
  /// Who emails come from: Shop <no-reply@shop.com>.
  env MAIL_FROM string required development("{{.App.Label}} <no-reply@localhost>")
  requires app, env
  optional jobs, compose, domain, testcontainers, docker

  /// The project's folder of its brand (brand, the same an ssr site may
  /// name), with its theme.json: the emails' layout takes its colors, the
  /// names of its fonts, and its logo (identity.logo_email, or a logo that
  /// is a PNG, JPEG or GIF), sent with each email. Without one, the emails
  /// keep their neutral look.
  option brand string default("")
  /// The language of the emails esquadro writes (security's, welcome,
  /// the footer, mail test) and of their dates: en, pt_br, or frontend,
  /// the first frontend's (en without one).
  option locale name default(frontend)
  /// A line the emails' footer ends with, as the postal address some laws
  /// ask of them: Shop Ltd, 1 Main Street, Springfield.
  option address string default("")
}
