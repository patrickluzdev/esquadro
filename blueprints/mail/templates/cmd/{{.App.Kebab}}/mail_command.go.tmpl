package main

import (
	"context"
	"errors"
	"fmt"
	"html"
	"strings"

	"{{.App.Module}}/internal/platform/mail"
)

// mailCommand runs {{.App.Kebab}} mail test <address>: an email sent now,
// past the queue, with the configuration of the environment, to see that
// it works.
func mailCommand(ctx context.Context, args []string) error {
	if len(args) != 2 || args[0] != "test" {
		return errors.New("usage: {{.App.Kebab}} mail test <address>: sends an email with this environment's MAIL_URL")
	}
	d, release, err := open(ctx)
	if err != nil {
		return err
	}
	defer release()
	// In the layouts, as every email: what the readers will see.
	text := strings.ReplaceAll(mail.Word("testText"), "{env}", d.config.Env)
	msg, err := mail.Wrap(mail.Word("testSubject"), text, "<p>"+html.EscapeString(text)+"</p>")
	if err != nil {
		return err
	}
	msg.To = []string{args[1]}
	if err := d.mail.Deliver(ctx, msg); err != nil {
		return err
	}
	fmt.Printf("sent to %s\n", args[1])
	return nil
}
