{{- $b := mailBrand .App .Options -}}
{{- $loc := .Options.locale}}{{if eq $loc "frontend"}}{{$loc = ""}}{{end}}{{range frontends}}{{if not $loc}}{{$loc = .Options.locale}}{{end}}{{end}}{{if not $loc}}{{$loc = "en"}}{{end -}}
{{- $logo := ""}}{{if $b}}{{$logo = mailLogo $b}}{{end -}}
// Generated by esquadro from the mail blueprint's options: do not edit.
// The look of the emails, for templates/_layout.html and _layout.txt
// (yours): the app's name, the colors and fonts of {{if $b}}the brand in {{$b.Dir}}/{{else}}no brand (the neutral look){{end}},
// its logo, and the words of the footer.

package mail

import (
	htmltemplate "html/template"
	"net/url"
	"strings"
{{- if $logo}}
	"sync"

	brand "{{.App.Module}}/{{$b.Dir}}"
{{- end}}
)

// App is the app's name, as the emails write it.
const App = {{quote .App.Label}}

// branded reports whether the emails wear a brand: without one, the
// layout keeps its neutral look, with no header nor footer.
const branded = {{if $b}}true{{else}}false{{end}}

// address is the line the footer ends with: mail's address option.
const address = {{quote (or .Options.address "")}}

// lang is the language of the layout's words.
const lang = {{if eq $loc "pt_br"}}"pt-BR"{{else}}"en"{{end}}

// colors are the emails' colors, by the brand's roles.
var colors = map[string]string{
{{- if $b}}
{{- range $role := mailColors}}
	{{quote $role}}: {{quote ($b.Color $role)}},
{{- end}}
{{- else}}
	"page": "#f5f5f4", "surface": "#ffffff", "ink": "#1c1917", "muted": "#78716c", "line": "#e7e5e4",
	"accent": "#1c1917", "on_accent": "#ffffff",
{{- end}}
}

// fonts are the emails' font families: the brand's by name, which a
// reader's device may have, then the system's. Emails load no fonts.
var fonts = map[string]string{
{{- if $b}}
	"display": {{quote ($b.FontStack "display")}},
	"body":    {{quote ($b.FontStack "body")}},
{{- else}}
	"display": "-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
	"body":    "-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
{{- end}}
}

// words are the layout's words, with {app} for the app's name.
var words = map[string]string{
{{- range mailWords $loc}}
	{{quote .Key}}: {{quote .Text}},
{{- end}}
}

// logoCID names the logo in the HTML (cid:...), sent along with each email
// that shows it.
const logoCID = "brand-logo"
{{if $logo}}
// logo is the brand's logo for emails, {{$logo}}: the brand's files are
// embedded in the app.
var logo = sync.OnceValue(func() *Inline {
	data, err := brand.Files.ReadFile({{quote $logo}})
	if err != nil {
		return nil
	}
	return &Inline{CID: logoCID, Name: {{quote (mailBase $logo)}}, Type: {{quote (mailLogoType $b)}}, Data: data}
})
{{else}}
// logo is nil: {{if $b}}the brand has no logo email clients show (a PNG,
// JPEG or GIF: identity.logo_email){{else}}there is no brand{{end}}, and the header writes the
// app's name.
func logo() *Inline { return nil }
{{end}}
// withLogo adds the logo to a message whose HTML shows it.
func withLogo(m Message) Message {
	l := logo()
	if l == nil || !strings.Contains(m.HTML, "cid:"+l.CID) {
		return m
	}
	for _, in := range m.Inline {
		if in.CID == l.CID {
			return m
		}
	}
	m.Inline = append(append([]Inline(nil), m.Inline...), *l)
	return m
}

// word is a word of the layout, with the app's name in it.
func word(key string) string {
	return strings.ReplaceAll(words[key], "{app}", App)
}

// layoutFuncs are what the templates write the look with:
//
//	branded      whether there is a brand
//	color "ink"  a color by role: page, surface, ink, muted, line, accent, on_accent
//	font "body"  a font family: display or body
//	logo         the logo's address (cid:...), "" without one
//	app          the app's name
//	word "why"   a word of the layout
//	address      the footer's last line, "" without one
//	lang         the language of the words
//	button       a link as a button, a paragraph of its own: {{"{{"}}button .Link "Choose your password"{{"}}"}}
//
// In a text, button writes the label and the link.
func layoutFuncs(html bool) map[string]any {
	buttonOf := any(button)
	if !html {
		buttonOf = func(link, label string) string { return label + ":\n" + link }
	}
	return map[string]any{
		"branded": func() bool { return branded },
		"color":   func(role string) htmltemplate.CSS { return htmltemplate.CSS(colors[role]) },
		"font":    func(name string) htmltemplate.CSS { return htmltemplate.CSS(fonts[name]) },
		"logo": func() htmltemplate.URL {
			if logo() == nil {
				return ""
			}
			return htmltemplate.URL("cid:" + logoCID)
		},
		"app":     func() string { return App },
		"word":    word,
		"address": func() string { return address },
		"lang":    func() string { return lang },
		"button":  buttonOf,
	}
}

// button is a link as a button in the brand's accent, or, without a brand,
// a paragraph with the link. A link that is not http(s) or mailto is left
// out.
func button(link, label string) htmltemplate.HTML {
	u, err := url.Parse(link)
	if err != nil || (u.Scheme != "https" && u.Scheme != "http" && u.Scheme != "mailto") {
		return htmltemplate.HTML(htmltemplate.HTMLEscapeString(label))
	}
	href, text := htmltemplate.HTMLEscapeString(link), htmltemplate.HTMLEscapeString(label)
	if !branded {
		return htmltemplate.HTML(`<p><a href="` + href + `">` + text + `</a></p>`)
	}
	return htmltemplate.HTML(`<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0"><tr>` +
		`<td style="border-radius:8px;background:` + colors["accent"] + `">` +
		`<a href="` + href + `" style="display:inline-block;padding:12px 22px;border-radius:8px;font-family:` + htmltemplate.HTMLEscapeString(fonts["body"]) +
		`;font-size:15px;font-weight:700;line-height:1;color:` + colors["on_accent"] + `;text-decoration:none">` + text + `</a></td></tr></table>`)
}
