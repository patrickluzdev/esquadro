package mail

import (
	"bytes"
	"context"
	"encoding/base64"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"time"
)

// resend sends by Resend's API. The message's ID is its idempotency key:
// a retry of the same message is not sent twice.
type resend struct {
	key, endpoint string
	client        *http.Client
}

func (r *resend) Deliver(ctx context.Context, m Message) error {
	payload := map[string]any{
		"from": m.From, "to": m.To, "subject": m.Subject, "text": m.Text,
		"html": m.HTML, "reply_to": m.ReplyTo,
	}
	// The files the HTML shows (the logo) go as attachments named by their
	// content_id, as cid: names them.
	var attachments []map[string]string
	for _, in := range m.Inline {
		attachments = append(attachments, map[string]string{"filename": in.Name, "content": base64.StdEncoding.EncodeToString(in.Data),
			"content_type": in.Type, "content_id": in.CID})
	}
	if attachments != nil {
		payload["attachments"] = attachments
	}
	body, err := json.Marshal(payload)
	if err != nil {
		return err
	}
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, r.endpoint, bytes.NewReader(body))
	if err != nil {
		return err
	}
	req.Header.Set("Authorization", "Bearer "+r.key)
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Idempotency-Key", m.ID)
	client := r.client
	if client == nil {
		client = &http.Client{Timeout: 30 * time.Second}
	}
	res, err := client.Do(req)
	if err != nil {
		return err
	}
	defer res.Body.Close()
	if res.StatusCode >= 300 {
		answer, _ := io.ReadAll(io.LimitReader(res.Body, 4<<10))
		return fmt.Errorf("resend answered %s: %s", res.Status, answer)
	}
	return nil
}
