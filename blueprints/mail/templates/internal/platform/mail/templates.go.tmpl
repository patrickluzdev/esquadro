package mail

import (
	"bytes"
	"embed"
	"errors"
	"fmt"
	htmltemplate "html/template"
	"io/fs"
	"strings"
	"sync"
	"text/template"
)

// templates are the emails of the app, one per name: <name>.txt, whose
// first line is "Subject: ...", and, for an HTML version, <name>.html
// defining "content", which _layout.html wraps; _layout.txt, when it is
// there, wraps the text (its footer). <name>.json, data to try the
// template with, is for the tests. The layouts are yours: they write the
// look of layout.go (the brand's colors, fonts and logo) with its
// functions, which every template may use (button).
//
//go:embed all:templates
var templates embed.FS

// written is a template, parsed once.
type written struct {
	subject, text *template.Template
	html          *htmltemplate.Template
}

var parsed sync.Map // name -> *written

// Write is the message the template name writes with data: its subject and
// text, and its HTML when it has one.
func Write(name string, data any) (Message, error) {
	w, err := parse(name)
	if err != nil {
		return Message{}, err
	}
	var subject, text, html bytes.Buffer
	if err := w.subject.Execute(&subject, data); err != nil {
		return Message{}, fmt.Errorf("mail: %s: %w", name, err)
	}
	if err := w.text.Execute(&text, data); err != nil {
		return Message{}, fmt.Errorf("mail: %s: %w", name, err)
	}
	if w.html != nil {
		if err := w.html.ExecuteTemplate(&html, "_layout.html", data); err != nil {
			return Message{}, fmt.Errorf("mail: %s: %w", name, err)
		}
	}
	return Message{Subject: strings.TrimSpace(subject.String()), Text: strings.TrimSpace(text.String()) + "\n", HTML: html.String()}, nil
}

// Templates are the names of the app's emails.
func Templates() []string {
	entries, _ := fs.Glob(templates, "templates/*.txt")
	names := make([]string, 0, len(entries))
	for _, e := range entries {
		if name := strings.TrimSuffix(strings.TrimPrefix(e, "templates/"), ".txt"); !strings.HasPrefix(name, "_") {
			names = append(names, name)
		}
	}
	return names
}

func parse(name string) (*written, error) {
	if w, ok := parsed.Load(name); ok {
		return w.(*written), nil
	}
	if strings.ContainsAny(name, "/\\.") || strings.HasPrefix(name, "_") {
		return nil, fmt.Errorf("mail: %q is not a template name", name)
	}
	raw, err := fs.ReadFile(templates, "templates/"+name+".txt")
	if err != nil {
		return nil, fmt.Errorf("mail: no template %s: write internal/platform/mail/templates/%s.txt", name, name)
	}
	first, body, _ := strings.Cut(string(raw), "\n")
	subject, ok := strings.CutPrefix(first, "Subject:")
	if !ok {
		return nil, fmt.Errorf("mail: %s.txt: the first line is the subject, Subject: ...", name)
	}
	w := &written{}
	if w.subject, err = template.New(name + ".subject").Option("missingkey=error").Parse(strings.TrimSpace(subject)); err != nil {
		return nil, fmt.Errorf("mail: %s.txt: %w", name, err)
	}
	if w.text, err = textOf(name, body); err != nil {
		return nil, fmt.Errorf("mail: %s.txt: %w", name, err)
	}
	if _, err := fs.Stat(templates, "templates/"+name+".html"); err == nil {
		w.html, err = htmltemplate.New(name).Funcs(layoutFuncs(true)).Option("missingkey=error").ParseFS(templates, "templates/_layout.html", "templates/"+name+".html")
		if err != nil {
			return nil, fmt.Errorf("mail: %s.html: %w", name, err)
		}
	} else if !errors.Is(err, fs.ErrNotExist) {
		return nil, err
	}
	parsed.Store(name, w)
	return w, nil
}

// textOf is the text of an email, body, wrapped by _layout.txt when it is
// there: its "content".
func textOf(name, body string) (*template.Template, error) {
	layout, err := fs.ReadFile(templates, "templates/_layout.txt")
	if errors.Is(err, fs.ErrNotExist) {
		return template.New(name + ".txt").Funcs(layoutFuncs(false)).Option("missingkey=error").Parse(body)
	}
	if err != nil {
		return nil, err
	}
	t, err := template.New(name + ".txt").Funcs(layoutFuncs(false)).Option("missingkey=error").Parse(string(layout))
	if err != nil {
		return nil, fmt.Errorf("_layout.txt: %w", err)
	}
	if _, err := t.New("content").Parse(strings.TrimRight(body, " \r\n")); err != nil {
		return nil, err
	}
	return t, nil
}

// Wrap writes a message of your own in the layouts, as the templates'
// emails are: its subject, its text and, when html is not empty, its HTML,
// which is trusted (escape what it takes from others).
func Wrap(subject, text, html string) (Message, error) {
	data := map[string]any{"Text": text, "HTML": htmltemplate.HTML(html)}
	t, err := textOf("wrap", `{{"{{"}}.Text{{"}}"}}`)
	if err != nil {
		return Message{}, fmt.Errorf("mail: %w", err)
	}
	var tb, hb bytes.Buffer
	if err := t.Execute(&tb, data); err != nil {
		return Message{}, fmt.Errorf("mail: %w", err)
	}
	msg := Message{Subject: subject, Text: strings.TrimSpace(tb.String()) + "\n"}
	if html == "" {
		return msg, nil
	}
	h, err := htmltemplate.New("wrap").Funcs(layoutFuncs(true)).Option("missingkey=error").ParseFS(templates, "templates/_layout.html")
	if err == nil {
		_, err = h.New("content").Parse(`{{"{{"}}.HTML{{"}}"}}`)
	}
	if err == nil {
		err = h.ExecuteTemplate(&hb, "_layout.html", data)
	}
	if err != nil {
		return Message{}, fmt.Errorf("mail: _layout.html: %w", err)
	}
	msg.HTML = hb.String()
	return msg, nil
}
