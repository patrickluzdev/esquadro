package mail

import (
	"context"
	"fmt"
	"log/slog"
	"net/url"
	"strings"
)

// transportOf is the transport MAIL_URL names.
func transportOf(raw string, development bool, logger *slog.Logger) (Transport, error) {
	u, err := url.Parse(raw)
	if err != nil || raw == "" {
		return nil, fmt.Errorf("mail: MAIL_URL is not smtp://user:password@host:port, resend://API_KEY or log://")
	}
	switch u.Scheme {
	case "smtp":
		return smtpTransportOf(u, development)
	case "resend":
		key := u.Host + u.Opaque
		if key == "" {
			return nil, fmt.Errorf("mail: MAIL_URL resend:// needs the API key: resend://re_...")
		}
		return &resend{key: key, endpoint: "https://api.resend.com/emails"}, nil
	case "log":
		if logger == nil {
			logger = slog.Default()
		}
		return logTransport{logger}, nil
	}
	return nil, fmt.Errorf("mail: MAIL_URL scheme %q is not smtp, resend or log", u.Scheme)
}

// logTransport writes messages into the log: development without Mailpit.
type logTransport struct{ logger *slog.Logger }

func (t logTransport) Deliver(ctx context.Context, m Message) error {
	t.logger.InfoContext(ctx, "email", "to", strings.Join(m.To, ", "), "subject", m.Subject, "text", m.Text)
	return nil
}
