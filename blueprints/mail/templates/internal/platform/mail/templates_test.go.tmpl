package mail

import (
	"encoding/json"
	"io/fs"
	"strings"
	"testing"
)

// TestTemplates writes every email of the app with its <name>.json, so
// that a template that names a field its data does not have fails here,
// not when it is sent. A template without one is only parsed.
func TestTemplates(t *testing.T) {
	names := Templates()
	if len(names) == 0 {
		t.Fatal("no templates")
	}
	for _, name := range names {
		raw, err := fs.ReadFile(templates, "templates/"+name+".json")
		if err != nil {
			if _, err := parse(name); err != nil {
				t.Error(err)
			}
			continue
		}
		var data any
		if err := json.Unmarshal(raw, &data); err != nil {
			t.Errorf("%s.json: %v", name, err)
			continue
		}
		msg, err := Write(name, data)
		if err != nil {
			t.Error(err)
			continue
		}
		if msg.Subject == "" || strings.TrimSpace(msg.Text) == "" {
			t.Errorf("%s: an empty subject or text", name)
		}
	}
}

// The layouts wrap the emails and are none: a name with _ is not one.
func TestLayoutsAreNoEmails(t *testing.T) {
	for _, name := range Templates() {
		if strings.HasPrefix(name, "_") {
			t.Errorf("%s is a layout, listed as an email", name)
		}
	}
	if _, err := Write("_layout", map[string]any{}); err == nil {
		t.Error("a layout was written as an email")
	}
}

// button writes a link as a button, escaped, and leaves out a link that
// is not one a reader may follow; a text writes the label and the link.
func TestButton(t *testing.T) {
	got := string(button("https://shop.example/a?b=1&c=2", "Go <now>"))
	if !strings.Contains(got, `href="https://shop.example/a?b=1&amp;c=2"`) || !strings.Contains(got, "Go &lt;now&gt;") {
		t.Errorf("button: %s", got)
	}
	if branded && !strings.Contains(got, colors["accent"]) {
		t.Errorf("a brand's button is in its accent: %s", got)
	}
	if got := string(button("javascript:alert(1)", "Go")); strings.Contains(got, "href") || strings.Contains(got, "javascript") {
		t.Errorf("a script as a link: %s", got)
	}
	text := layoutFuncs(false)["button"].(func(string, string) string)
	if got := text("https://shop.example/a", "Go"); got != "Go:\nhttps://shop.example/a" {
		t.Errorf("a text's button: %q", got)
	}
}

// The logo goes along with an email that shows it, once; never with one
// that does not.
func TestLogo(t *testing.T) {
	if strings.Contains(word("why"), "{app}") || !strings.Contains(word("why"), App) {
		t.Errorf("the footer's word without the app's name: %s", word("why"))
	}
	shows := Message{HTML: `<img src="cid:` + logoCID + `">`}
	if logo() == nil {
		if len(withLogo(shows).Inline) != 0 {
			t.Error("no logo, yet one went along")
		}
		return
	}
	once := withLogo(withLogo(shows))
	if len(once.Inline) != 1 || once.Inline[0].CID != logoCID || len(once.Inline[0].Data) == 0 {
		t.Fatalf("the logo: %+v", once.Inline)
	}
	if len(withLogo(Message{HTML: "<p>no logo</p>"}).Inline) != 0 {
		t.Error("the logo went with an email that does not show it")
	}
}

func TestWriteAndSend(t *testing.T) {
	msg, err := Write("welcome", map[string]any{"Name": "<Ana>"})
	if err != nil || msg.Subject != "Welcome, <Ana>" || !strings.Contains(msg.HTML, "Hi &lt;Ana&gt;") || !strings.Contains(msg.Text, "Hi <Ana>,") {
		t.Fatalf("%+v %v", msg, err)
	}
	if _, err := Write("welcome", map[string]any{}); err == nil {
		t.Fatal("a missing field passed")
	}
	if _, err := Write("../secret", nil); err == nil {
		t.Fatal("a path passed as a name")
	}
	var got []Message
	m := NewWith(transportFunc(func(m Message) { got = append(got, m) }), "Shop <no-reply@shop.example>")
	if err := m.Send(t.Context(), Email{To: []string{"ana@example.com"}, Template: "welcome", Data: map[string]any{"Name": "Ana"}}); err != nil {
		t.Fatal(err)
	}
	if len(got) != 1 || got[0].From != "\"Shop\" <no-reply@shop.example>" && got[0].From != "Shop <no-reply@shop.example>" {
		t.Fatalf("%+v", got)
	}
	if err := m.Send(t.Context(), Email{To: []string{"ana@example.com"}, Template: "nope"}); err == nil {
		t.Fatal("a template that does not exist passed")
	}
}
