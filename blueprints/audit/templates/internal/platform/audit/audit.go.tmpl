// Entry is a change as it is listed.
type Entry struct {
	ID       uuid.UUID              `json:"id"`
	At       time.Time              `json:"at"`
	Entity   string                 `json:"entity"`
	RecordID uuid.UUID              `json:"record_id"`
	Action   string                 `json:"action"`
	Actor    Actor                  `json:"actor"`
	Changes  map[string]FieldChange `json:"changes"`
}

// Page is a page of changes, the newest first.
type Page struct {
	Items      []Entry `json:"items"`
	Page       int     `json:"page"`
	PerPage    int     `json:"per_page"`
	Total      int64   `json:"total"`
	TotalPages int     `json:"total_pages"`
}

// Filter narrows the changes listed; zero values do not.
type Filter struct {
	Entity   string
	RecordID uuid.UUID
	ActorID  string
	Action   string
	Since    time.Time
	Until    time.Time
}

// List reads a page (from 1) of the changes f lets through, the newest
// first.
func List(ctx context.Context, db postgres.DB, f Filter, page, perPage int) (Page, error) {
	if perPage <= 0 || perPage > 100 {
		perPage = 25
	}
	page = max(page, 1)
	where := `WHERE ($1 = '' OR entity = $1) AND ($2::uuid IS NULL OR record_id = $2) AND ($3 = '' OR actor_id = $3)
		AND ($4 = '' OR action = $4) AND ($5::timestamptz IS NULL OR at >= $5) AND ($6::timestamptz IS NULL OR at < $6)`
	args := []any{f.Entity, nullUUID(f.RecordID), f.ActorID, f.Action, nullTime(f.Since), nullTime(f.Until)}
	out := Page{Items: []Entry{}, Page: page, PerPage: perPage}
	if err := db.QueryRow(ctx, `SELECT count(*) FROM audit_changes `+where, args...).Scan(&out.Total); err != nil {
		return Page{}, fmt.Errorf("audit: list: %w", err)
	}
	rows, err := db.Query(ctx, `SELECT id, at, entity, record_id, action, actor_kind, actor_realm, actor_id, actor_name, changes
		FROM audit_changes `+where+` ORDER BY at DESC, id DESC LIMIT `+strconv.Itoa(perPage)+` OFFSET `+strconv.Itoa((page-1)*perPage), args...)
	if err != nil {
		return Page{}, fmt.Errorf("audit: list: %w", err)
	}
	defer rows.Close()
	for rows.Next() {
		var e Entry
		var changes []byte
		if err := rows.Scan(&e.ID, &e.At, &e.Entity, &e.RecordID, &e.Action, &e.Actor.Kind, &e.Actor.Realm, &e.Actor.ID, &e.Actor.Name, &changes); err != nil {
			return Page{}, fmt.Errorf("audit: list: %w", err)
		}
		if err := json.Unmarshal(changes, &e.Changes); err != nil {
			return Page{}, fmt.Errorf("audit: list: %w", err)
		}
		out.Items = append(out.Items, e)
	}
	out.TotalPages = int((out.Total + int64(perPage) - 1) / int64(perPage))
	return out, rows.Err()
}

func nullUUID(id uuid.UUID) any {
	if id == uuid.Nil() {
		return nil
	}
	return id
}

func nullTime(t time.Time) any {
	if t.IsZero() {
		return nil
	}
	return t
}

// Purge deletes the changes older than before, how many.
func Purge(ctx context.Context, db postgres.DB, before time.Time) (int64, error) {
	tag, err := db.Exec(ctx, `DELETE FROM audit_changes WHERE at < $1`, before)
	if err != nil {
		return 0, fmt.Errorf("audit: purge: %w", err)
	}
	return tag.RowsAffected(), nil
}

// Allowed tells whether the request of ctx may see every change, or why
// not (unauthorized, forbidden); the app sets it when it starts.
var Allowed func(ctx context.Context) error

// Routes serves GET /audit, every change, to those Allowed lets in.
func Routes(mux *http.ServeMux, db postgres.DB) {
	mux.HandleFunc("GET /audit", func(w http.ResponseWriter, r *http.Request) {
		ctx := r.Context()
		if Allowed == nil {
			fail(w, r, edge.ErrNotFound)
			return
		}
		if err := Allowed(ctx); err != nil {
			fail(w, r, err)
			return
		}
		q := r.URL.Query()
		f := Filter{Entity: q.Get("entity"), ActorID: q.Get("actor_id"), Action: q.Get("action")}
		bad := func(field string) {
			edge.Write(w, r, &edge.Problem{Status: http.StatusBadRequest, Code: "invalid_request", Title: "A parameter is not valid.",
				Errors: []edge.FieldProblem{ {Field: field, Code: "invalid_value"} }})
		}
		if v := q.Get("record_id"); v != "" {
			id, err := uuid.Parse(v)
			if err != nil {
				bad("record_id")
				return
			}
			f.RecordID = id
		}
		for _, p := range []struct {
			name string
			to   *time.Time
		}{ {"since", &f.Since}, {"until", &f.Until} } {
			if v := q.Get(p.name); v != "" {
				t, err := parseTime(v)
				if err != nil {
					bad(p.name)
					return
				}
				*p.to = t
			}
		}
		page, _ := strconv.Atoi(q.Get("page"))
		perPage, _ := strconv.Atoi(q.Get("per_page"))
		out, err := List(ctx, db, f, page, perPage)
		if err != nil {
			fail(w, r, err)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		w.Header().Set("Cache-Control", "no-store")
		_ = json.NewEncoder(w).Encode(out)
	})
}

// fail answers err: a problem as it is, anything else as an internal error,
// logged.
func fail(w http.ResponseWriter, r *http.Request, err error) {
	if p, ok := errors.AsType[*edge.Problem](err); ok {
		edge.Write(w, r, p)
		return
	}
	slog.ErrorContext(r.Context(), "audit", "error", err.Error())
	edge.Write(w, r, edge.ErrInternal)
}

// parseTime reads a moment, or a day (from its start).
func parseTime(v string) (time.Time, error) {
	if t, err := time.Parse(time.RFC3339, v); err == nil {
		return t, nil
	}
	if t, err := time.Parse(time.DateOnly, v); err == nil {
		return t, nil
	}
	return time.Time{}, errors.New("not a time")
}
