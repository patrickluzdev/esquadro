// Money is an amount as the API writes it, {amount, currency}; none for
// an empty one.
func Money(a currency.Amount) any {
	if a.CurrencyCode() == "" {
		return nil
	}
	return map[string]string{"amount": a.Number(), "currency": a.CurrencyCode()}
}
