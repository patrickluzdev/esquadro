// RetentionDays is how long a change is kept; 0 keeps it.
const RetentionDays = {{.Options.retention_days}}

// Actor is who made a change: a person (of a realm), a service key, or the
// system (a command, a job).
type Actor struct {
	Kind  string `json:"kind"`
	Realm string `json:"realm,omitempty"`
	ID    string `json:"id,omitempty"`
	Name  string `json:"name"`
}

// Who finds who the request of ctx comes from; the app sets it when it
// starts. Without it, or without anyone, the change is the system's.
var Who func(ctx context.Context) (Actor, bool)

type systemKey struct{}

// AsSystem makes the changes made with ctx the system's, under name: the
// command or job that makes them.
func AsSystem(ctx context.Context, name string) context.Context {
	return context.WithValue(ctx, systemKey{}, Actor{Kind: "system", Name: name})
}

// ActorOf is who makes the changes of ctx.
func ActorOf(ctx context.Context) Actor {
	if a, ok := ctx.Value(systemKey{}).(Actor); ok {
		return a
	}
	if Who != nil {
		if a, ok := Who(ctx); ok {
			return a
		}
	}
	name := "{{.App.Kebab}}"
	if len(os.Args) > 1 {
		name += " " + os.Args[1]
	}
	return Actor{Kind: "system", Name: name}
}

// Change is a change of a record: its entity (the plural: products), its
// id, what was done (create, update, delete, restore, purge) and its
// fields before and after.
type Change struct {
	Entity   string
	RecordID uuid.UUID
	Action   string
	Before   map[string]any
	After    map[string]any
	// Secret are the fields kept without their values.
	Secret []string
}

// FieldChange is what happened to a field: from and to, or only that it
// changed (a secret one).
type FieldChange struct {
	From   any  `json:"from,omitempty"`
	To     any  `json:"to,omitempty"`
	Secret bool `json:"secret,omitempty"`
}

// Execer runs SQL: the transaction of the change.
type Execer interface {
	Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error)
}

// Record keeps a change, in the transaction of ctx (db, as the store's use
// cases have it). An update that changed no field is not kept.
func Record(ctx context.Context, db Execer, c Change) error {
	secret := map[string]bool{}
	for _, f := range c.Secret {
		secret[f] = true
	}
	changes := map[string]FieldChange{}
	switch c.Action {
	case "create":
		for f, v := range c.After {
			if secret[f] {
				changes[f] = FieldChange{Secret: true}
			} else if !empty(v) {
				changes[f] = FieldChange{To: v}
			}
		}
	case "update":
		for f, after := range c.After {
			if same(c.Before[f], after) {
				continue
			}
			if secret[f] {
				changes[f] = FieldChange{Secret: true}
			} else {
				changes[f] = FieldChange{From: c.Before[f], To: after}
			}
		}
		if len(changes) == 0 {
			return nil
		}
	case "delete", "purge":
		for f, v := range c.Before {
			if !secret[f] && !empty(v) {
				changes[f] = FieldChange{From: v}
			}
		}
	}
	data, err := json.Marshal(changes)
	if err != nil {
		return fmt.Errorf("audit: %w", err)
	}
	a := ActorOf(ctx)
	_, err = db.Exec(ctx, `INSERT INTO audit_changes (id, entity, record_id, action, actor_kind, actor_realm, actor_id, actor_name, changes)
		VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)`,
		uuid.NewV7(), c.Entity, c.RecordID, c.Action, a.Kind, a.Realm, a.ID, a.Name, data)
	if err != nil {
		return fmt.Errorf("audit: record: %w", err)
	}
	return nil
}

// ID is a record's or a file's id, none for the nil one.
func ID(id uuid.UUID) any {
	if id == uuid.Nil() {
		return nil
	}
	return id
}

// same reports whether two values of a field are the same, as JSON.
func same(a, b any) bool {
	x, _ := json.Marshal(a)
	y, _ := json.Marshal(b)
	return string(x) == string(y)
}

// empty reports whether a field has no value worth keeping on create.
func empty(v any) bool {
	data, _ := json.Marshal(v)
	switch string(data) {
	case "null", `""`, "[]", "{}":
		return true
	}
	return false
}
