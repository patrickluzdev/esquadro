package postgres

import (
	"context"
	"errors"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
)

// DB runs queries: the pool, or a transaction.
type DB interface {
	Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error)
	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
	QueryRow(ctx context.Context, sql string, args ...any) pgx.Row
	Begin(ctx context.Context) (pgx.Tx, error)
}

type txKey struct{}

// WithTx is ctx with tx: the use cases that run with it write in tx, which
// commits or rolls back what they all did, together.
func WithTx(ctx context.Context, tx pgx.Tx) context.Context {
	return context.WithValue(ctx, txKey{}, tx)
}

// TxOf is the transaction of ctx, if it has one.
func TxOf(ctx context.Context) (pgx.Tx, bool) {
	tx, ok := ctx.Value(txKey{}).(pgx.Tx)
	return tx, ok
}

// InTx runs fn in the transaction of ctx, when it has one; else in a new
// transaction of db, committed when fn succeeds and rolled back when not.
func InTx(ctx context.Context, db DB, fn func(context.Context) error) error {
	if _, ok := TxOf(ctx); ok {
		return fn(ctx)
	}
	tx, err := db.Begin(ctx)
	if err != nil {
		return err
	}
	defer func() { _ = tx.Rollback(ctx) }()
	if err := fn(WithTx(ctx, tx)); err != nil {
		return err
	}
	return tx.Commit(ctx)
}

// ErrNoTx is a lock asked for outside a transaction, where it would hold
// nothing.
var ErrNoTx = errors.New("postgres: a lock needs a transaction")

// Lock takes the lock of key until the transaction of ctx ends: another
// transaction that asks for the same key waits for this one. A rule that
// counts before it writes ("20 a day at most") locks first, so that two
// writes at once both count right.
func Lock(ctx context.Context, key string) error {
	tx, ok := TxOf(ctx)
	if !ok {
		return ErrNoTx
	}
	_, err := tx.Exec(ctx, "SELECT pg_advisory_xact_lock(hashtextextended($1, 0))", key)
	return err
}

// Querier is what a use case runs its queries on: the transaction of ctx,
// or db.
func Querier(ctx context.Context, db DB) DB {
	if tx, ok := TxOf(ctx); ok {
		return tx
	}
	return db
}
