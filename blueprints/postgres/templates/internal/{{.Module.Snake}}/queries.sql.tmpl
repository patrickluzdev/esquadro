{{- if .Module.Entities -}}
-- Generated by esquadro: the queries of the {{.Module.Snake}} module, for sqlc.
{{- range .Module.Entities}}{{$e := .}}{{$t := pgTable $e $.Options}}{{$ws := writable $e}}

-- name: Create{{$e.Pascal}} :one
INSERT INTO {{$t}} (id{{range $ws}}, {{.Column}}{{end}})
VALUES (@id{{range $ws}}, @{{.Param}}{{end}})
RETURNING *;

-- name: Get{{$e.Pascal}} :one
SELECT * FROM {{$t}} WHERE id = @id;

-- name: List{{$e.Plural.Pascal}} :many
SELECT * FROM {{$t}}
WHERE sqlc.narg(after)::uuid IS NULL OR id > sqlc.narg(after)::uuid
ORDER BY id
LIMIT sqlc.arg(page_size);

-- name: Update{{$e.Pascal}} :one
UPDATE {{$t}}
SET {{range $ws}}{{.Column}} = @{{.Param}}, {{end}}updated_at = now()
WHERE id = @id
RETURNING *;

-- name: Delete{{$e.Pascal}} :execrows
DELETE FROM {{$t}} WHERE id = @id;
{{- end}}
{{end -}}
