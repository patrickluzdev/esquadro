{{- if .Entities -}}
# Generated by esquadro: one entry per module with entities.
version: "2"
sql:
{{- range .Modules}}{{if .Entities}}
  - engine: postgresql
    schema: migrations
    queries: internal/{{.Snake}}/queries.sql
    gen:
      go:
        package: sqlgen
        out: internal/{{.Snake}}/sqlgen
        sql_package: pgx/v5
        emit_exact_table_names: true
        omit_unused_structs: true
        initialisms: [{{join ", " initialisms}}]
{{- end}}{{end}}
{{end -}}
