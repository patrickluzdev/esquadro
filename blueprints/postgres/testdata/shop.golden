======== v1: init
-- Generated by esquadro from a change in the .esq files. Review it before
-- applying it; esquadro never changes it again.

-- +goose Up
CREATE SCHEMA catalog;

CREATE SCHEMA orders;

CREATE TYPE catalog.status AS ENUM ('ACTIVE', 'INACTIVE');

CREATE TABLE catalog.categories (
    id uuid NOT NULL DEFAULT gen_random_uuid(),
    name text NOT NULL,
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    PRIMARY KEY (id),
    CONSTRAINT categories_name_key UNIQUE (name)
);

CREATE TABLE catalog.products (
    id uuid NOT NULL DEFAULT gen_random_uuid(),
    name text NOT NULL,
    description text,
    price numeric NOT NULL DEFAULT 0,
    stock integer DEFAULT 0,
    status catalog.status DEFAULT 'ACTIVE',
    launched_on date DEFAULT CURRENT_DATE,
    details jsonb DEFAULT '{}'::jsonb,
    note text DEFAULT 'it''s new',
    category_id uuid NOT NULL,
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    PRIMARY KEY (id)
);

CREATE TABLE catalog.product_tags (
    product_id uuid NOT NULL,
    tag_id uuid NOT NULL,
    PRIMARY KEY (product_id, tag_id)
);

CREATE TABLE catalog.tags (
    id uuid NOT NULL DEFAULT gen_random_uuid(),
    label text NOT NULL,
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    PRIMARY KEY (id)
);

CREATE TABLE orders.orders (
    id uuid NOT NULL DEFAULT gen_random_uuid(),
    number text NOT NULL,
    placed_at timestamptz NOT NULL DEFAULT now(),
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    PRIMARY KEY (id),
    CONSTRAINT orders_number_key UNIQUE (number)
);

CREATE TABLE orders.order_items (
    id uuid NOT NULL DEFAULT gen_random_uuid(),
    quantity integer NOT NULL,
    order_id uuid NOT NULL,
    product_id uuid NOT NULL,
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    PRIMARY KEY (id)
);

ALTER TABLE catalog.products ADD CONSTRAINT products_category_id_fkey FOREIGN KEY (category_id) REFERENCES catalog.categories (id) ON DELETE RESTRICT;

ALTER TABLE catalog.product_tags ADD CONSTRAINT product_tags_product_id_fkey FOREIGN KEY (product_id) REFERENCES catalog.products (id) ON DELETE CASCADE;

ALTER TABLE catalog.product_tags ADD CONSTRAINT product_tags_tag_id_fkey FOREIGN KEY (tag_id) REFERENCES catalog.tags (id) ON DELETE CASCADE;

ALTER TABLE orders.order_items ADD CONSTRAINT order_items_order_id_fkey FOREIGN KEY (order_id) REFERENCES orders.orders (id) ON DELETE RESTRICT;

CREATE INDEX products_category_id_idx ON catalog.products (category_id);

CREATE INDEX products_name_status_idx ON catalog.products (name, status);

CREATE INDEX product_tags_tag_id_idx ON catalog.product_tags (tag_id);

CREATE INDEX order_items_order_id_idx ON orders.order_items (order_id);

CREATE INDEX order_items_product_id_idx ON orders.order_items (product_id);

