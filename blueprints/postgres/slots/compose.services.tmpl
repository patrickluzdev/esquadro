{{- $name := or (index (optionsOf "compose") "name") .App.Kebab}}{{$port := "5432"}}{{range strs (index (optionsOf "compose") "ports")}}{{if hasPrefix . "postgres:"}}{{$port = trimPrefix . "postgres:"}}{{end}}{{end}}
  postgres:
    container_name: {{$name}}-postgres
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{.App.Snake}}
    ports:
      - "{{$port}}:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{.App.Snake}}"]
      interval: 2s
      timeout: 5s
      retries: 15
