/// The connection to PostgreSQL: a pgx pool opened with the service, from
/// DATABASE_URL, and where each module's tables live. With compose, a
/// Postgres for development in compose.yaml, which the default DATABASE_URL
/// points at. The annotations describe the tables to the blueprints that
/// write their SQL (migrations, store).
blueprint postgres {
  version "0.2.0"

  /// Where the PostgreSQL database is; in development, the one compose.yaml
  /// starts.
  env DATABASE_URL string secret required development("postgres://postgres:postgres@localhost:{{composePort \"postgres\" \"5432\"}}/{{.App.Snake}}?sslmode=disable")
  /// The most connections the pool opens.
  env POOL_MAX int prefixed default("{{.Options.pool_max}}")
  requires app
  optional compose, docker

  /// Maximum number of connections in the pool; <APP>_POOL_MAX overrides
  /// it.
  option pool_max int default(10)
  /// Modules whose tables live in a Postgres schema of their own, named
  /// after the module; the others use public.
  option schemas list default([])

  /// Imports of internal/platform/postgres/postgres.go.
  slot "postgres.imports"
  /// Code in postgres.Open that changes the pool's config before it opens,
  /// e.g. config.ConnConfig.Tracer = ....
  slot "postgres.config"

  annotation entity {
    /// Table name, when it should differ from the plural snake case name.
    table        name
    /// Columns of an index, e.g. index [name, status].
    index        fields
    /// Columns of a unique index.
    unique_index fields
  }
  annotation field {
    /// Column name, when it should differ from the snake case name.
    column name
  }

  go_require "github.com/jackc/pgx/v5" "v5.7.1"
}
