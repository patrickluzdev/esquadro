/// PostgreSQL storage: migrations written from the change in the model,
/// queries with sqlc, and each entity's use cases (create, read, list,
/// update, delete) as methods of its module.
blueprint postgres {
  version "0.1.0"
  requires platform

  /// Maximum number of connections in the pool.
  option pool_max int default(10)
  /// Modules whose tables live in a Postgres schema of their own, named
  /// after the module; the others use public.
  option schemas list default([])

  annotation entity {
    /// Table name, when it should differ from the plural snake case name.
    table        name
    /// Columns of an index, e.g. index [name, status].
    index        fields
    /// Columns of a unique index.
    unique_index fields
  }
  annotation field {
    /// Column name, when it should differ from the snake case name.
    column name
  }

  go_require "github.com/jackc/pgx/v5" "v5.7.1"
  go_require "github.com/pressly/goose/v3" "v3.24.1"
  go_require "github.com/testcontainers/testcontainers-go" "v0.40.0"
  go_require "github.com/testcontainers/testcontainers-go/modules/postgres" "v0.40.0"

  hook pre-gen "migrations"
  hook post-gen "sqlc" writes "internal/*/sqlgen/**"
}
