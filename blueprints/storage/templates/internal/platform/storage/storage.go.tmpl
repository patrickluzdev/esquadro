// Field is what a file field takes: its largest size, its MIME types (any
// when none), how long a link to read it works, and whether a browser
// opens it (else it is downloaded under its name).
type Field struct {
	Image      bool
	Max        int64
	Types      []string
	URLMinutes int
	Inline     bool
}

// Fields are the model's file fields, by entity and field: products.photo.
var Fields = map[string]Field{
{{- range $files}}
	{{quote .Key}}: {Image: {{.Image}}, Max: {{.Rules.Max}}, Types: []string{ {{- range $i, $t := .Rules.Types}}{{if $i}}, {{end}}{{quote $t}}{{end -}} }, URLMinutes: {{.Rules.URLMinutes}}, Inline: {{.Rules.Inline}}},
{{- end}}
}

const (
	// uploadExpiry is how long a link to send a file works.
	uploadExpiry = {{.Options.upload_minutes}} * time.Minute
	// pendingFor is how long a file sent and never used is kept.
	pendingFor = {{.Options.pending_hours}} * time.Hour
	// checkContent says whether a file's first bytes are read, to check
	// its real format, before a record uses it.
	checkContent = {{.Options.check_content}}
	// diskPath is where the app serves a folder store's signed links.
	diskPath = "/storage/blob"
)

// The problems of a file, as a field's code.
const (
	TooLarge     = "too_large"
	InvalidType  = "invalid_type"
	InvalidValue = "invalid_value"
	NotFound     = "not_found"
)

// Refusal is a request the store turns down: Field is the request's field
// (size, content_type, field) and Code why.
type Refusal struct{ Field, Code string }

func (r *Refusal) Error() string { return "storage: " + r.Field + ": " + r.Code }

// Config is how the store opens: STORAGE_URL, STORAGE_SECRET (it signs a
// folder's links) and STORAGE_PREFIX (of every key).
type Config struct {
	URL, Secret, Prefix string
}

// Store keeps the files.
type Store struct {
	pool   *pgxpool.Pool
	bucket *blob.Bucket
	// disk signs and checks the links of a folder store; nil otherwise.
	disk   *fileblob.URLSignerHMAC
	prefix string
	// Principal is who makes a request, from its context: empty when no
	// one signed in. A file is used only by records of whoever asked for
	// it.
	Principal func(context.Context) string
}

// Open opens the store STORAGE_URL names: file://./storage (a folder,
// made when missing), mem:// (in memory, for tests){{if has .Options.drivers "s3"}}, s3://bucket{{end}}{{if has .Options.drivers "gcs"}}, gs://bucket{{end}}{{if has .Options.drivers "azure"}}, azblob://container{{end}}.
func Open(ctx context.Context, cfg Config, pool *pgxpool.Pool) (*Store, error) {
	u, err := url.Parse(cfg.URL)
	if err != nil || u.Scheme == "" {
		return nil, fmt.Errorf("storage: STORAGE_URL %q is no URL like file://./storage", cfg.URL)
	}
	s := &Store{pool: pool, prefix: cfg.Prefix}
{{- if uses "security"}}
	s.Principal = func(ctx context.Context) string {
		if p, ok := security.PrincipalOf(ctx); ok {
			return p.Realm + ":" + p.ID.String()
		}
		return ""
	}
{{- end}}
	if u.Scheme == "file" {
		if cfg.Secret == "" {
			return nil, errors.New("storage: a folder store signs its links with STORAGE_SECRET, which is empty")
		}
		dir := u.Host + u.Path // file://./storage is ./storage; file:///srv/files, /srv/files.
		s.disk = fileblob.NewURLSignerHMAC(&url.URL{Path: diskPath}, []byte(cfg.Secret))
		s.bucket, err = fileblob.OpenBucket(dir, &fileblob.Options{URLSigner: s.disk, CreateDir: true})
	} else {
		s.bucket, err = blob.OpenBucket(ctx, cfg.URL)
	}
	if err != nil {
		return nil, fmt.Errorf("storage: open %s: %w", u.Redacted(), err)
	}
	return s, nil
}

// Close closes the store.
func (s *Store) Close() error { return s.bucket.Close() }

// UploadRequest is a file a browser wants to send, for a field of an
// entity (products, photo).
type UploadRequest struct {
	Entity, Field     string
	Name, ContentType string
	Size              int64
}

// Upload is where and how to send the file: a PUT of its bytes to URL with
// Headers, before ExpiresAt. The record uses it by ID.
type Upload struct {
	ID        uuid.UUID
	URL       string
	Method    string
	Headers   map[string]string
	ExpiresAt time.Time
}

// Request checks a file against its field's rules and answers where to
// send it. The file waits, pending, until a record uses it.
func (s *Store) Request(ctx context.Context, r UploadRequest) (Upload, error) {
	f, ok := Fields[r.Entity+"."+r.Field]
	if !ok {
		return Upload{}, &Refusal{"field", InvalidValue}
	}
	if r.Size <= 0 || r.Size > f.Max {
		return Upload{}, &Refusal{"size", TooLarge}
	}
	ct, _, err := mime.ParseMediaType(r.ContentType)
	if err != nil || !allowed(f, ct) {
		return Upload{}, &Refusal{"content_type", InvalidType}
	}
	id := uuid.NewV7()
	key := s.prefix + keyOf(r.Entity, r.Field, id, r.Name)
	var by *string
	if s.Principal != nil {
		if p := s.Principal(ctx); p != "" {
			by = &p
		}
	}
	if _, err := postgres.Querier(ctx, s.pool).Exec(ctx,
		`INSERT INTO storage_files (id, key, name, content_type, size, entity, field, created_by) VALUES ($1, $2, $3, $4, $5, $6, $7, $8)`,
		postgres.UUID(id), key, nameOf(r.Name), ct, r.Size, r.Entity, r.Field, by); err != nil {
		return Upload{}, fmt.Errorf("storage: request: %w", err)
	}
	link, err := s.bucket.SignedURL(ctx, key, &blob.SignedURLOptions{
		Method: http.MethodPut, ContentType: ct, Expiry: uploadExpiry,
		BeforeSign: func(as func(any) bool) error {
{{- if has .Options.drivers "s3"}}
			// S3 takes only a body of the size asked for.
			var put *s3.PutObjectInput
			if as(&put) {
				put.ContentLength = &r.Size
			}
{{- end}}
			return nil
		},
	})
	if err != nil {
		return Upload{}, fmt.Errorf("storage: sign the upload: %w", err)
	}
	return Upload{ID: id, URL: link, Method: http.MethodPut, Headers: map[string]string{"Content-Type": ct}, ExpiresAt: time.Now().Add(uploadExpiry)}, nil
}

// allowed reports whether a field takes a MIME type: one of its types, any
// for a file without them; an image only an image.
func allowed(f Field, ct string) bool {
	if len(f.Types) > 0 {
		return slices.Contains(f.Types, ct)
	}
	return !f.Image || strings.HasPrefix(ct, "image/")
}

// keyOf is the key of a new file{{if eq .Options.key_layout "entity"}}: products/photo/<id>.png{{else}}: <id>.png, under two folders of
// its id's last characters, so that no folder gets too many{{end}}.
func keyOf(entity, field string, id uuid.UUID, name string) string {
	ext := strings.ToLower(path.Ext(nameOf(name)))
	if len(ext) > 10 || strings.ContainsAny(ext, "/\\ ") {
		ext = ""
	}
{{- if eq .Options.key_layout "entity"}}
	return entity + "/" + field + "/" + id.String() + ext
{{- else}}
	s := id.String()
	return s[len(s)-2:] + "/" + s[len(s)-4:len(s)-2] + "/" + s + ext
{{- end}}
}

// nameOf is a file's name as kept: its base name, at most 255 bytes.
func nameOf(name string) string {
	name = path.Base(strings.ReplaceAll(strings.TrimSpace(name), "\\", "/"))
	if name == "." || name == "/" || name == "" {
		name = "file"
	}
	for len(name) > 255 {
		name = name[:len(name)-1]
	}
	return name
}

// File is a file a record uses.
type File struct {
	ID          uuid.UUID
	Name        string
	ContentType string
	Size        int64
	Entity      string
	Field       string
	key         string
}

// Sync keeps the files of a record in step with it, in the transaction of
// ctx: those it gains (after, by field) are checked and attached to it,
// those it loses (before) released, to leave the store. It answers the
// fields refused, with why.
func (s *Store) Sync(ctx context.Context, entity string, record uuid.UUID, before, after map[string]uuid.UUID) (map[string]string, error) {
	refused := map[string]string{}
	for field, id := range after {
		if id == uuid.Nil() || id == before[field] {
			continue
		}
		code, err := s.attach(ctx, entity, field, record, id)
		if err != nil {
			return nil, err
		}
		if code != "" {
			refused[field] = code
		}
	}
	if len(refused) > 0 {
		return refused, nil
	}
	for field, id := range before {
		if id == uuid.Nil() || id == after[field] {
			continue
		}
		if _, err := postgres.Querier(ctx, s.pool).Exec(ctx, `UPDATE storage_files SET status = 'deleting' WHERE id = $1 AND record_id = $2`, postgres.UUID(id), postgres.UUID(record)); err != nil {
			return nil, fmt.Errorf("storage: release %s: %w", field, err)
		}
	}
	return refused, nil
}

// attach checks a file a record is to use, and attaches it: it must be
// waiting, asked for this field by whoever asks now, in the store at its
// size, and of the format it claims.
func (s *Store) attach(ctx context.Context, entity, field string, record, id uuid.UUID) (string, error) {
	db := postgres.Querier(ctx, s.pool)
	var (
		key, ct, status, fEntity, fField string
		size                             int64
		by                               *string
		owner                            pgtype.UUID
	)
	err := db.QueryRow(ctx, `SELECT key, content_type, size, status, entity, field, created_by, record_id FROM storage_files WHERE id = $1 FOR UPDATE`, postgres.UUID(id)).
		Scan(&key, &ct, &size, &status, &fEntity, &fField, &by, &owner)
	if errors.Is(err, pgx.ErrNoRows) {
		return NotFound, nil
	}
	if err != nil {
		return "", fmt.Errorf("storage: read the file: %w", err)
	}
	switch {
	case fEntity != entity || fField != field:
		return InvalidValue, nil
	case status == "attached" && owner.Valid && postgres.ID(owner) == record:
		return "", nil // already this record's
	case status != "pending":
		return InvalidValue, nil
	}
	if s.Principal != nil && by != nil && *by != s.Principal(ctx) {
		return InvalidValue, nil
	}
	attrs, err := s.bucket.Attributes(ctx, key)
	if gcerrors.Code(err) == gcerrors.NotFound {
		return NotFound, nil // asked for, never sent
	}
	if err != nil {
		return "", fmt.Errorf("storage: read the file's attributes: %w", err)
	}
	if attrs.Size != size {
		return InvalidValue, nil
	}
	if checkContent {
		ok, err := s.formatIs(ctx, key, ct)
		if err != nil {
			return "", err
		}
		if !ok {
			return InvalidType, nil
		}
	}
	if _, err := db.Exec(ctx, `UPDATE storage_files SET status = 'attached', record_id = $2, attached_at = now() WHERE id = $1`, postgres.UUID(id), postgres.UUID(record)); err != nil {
		return "", fmt.Errorf("storage: attach: %w", err)
	}
	return "", nil
}

// formatIs reads a file's first bytes and reports whether it is of the
// format it claims: an image must be one of that format, and nothing may
// be a web page (HTML, or SVG and XML where they were not asked for).
func (s *Store) formatIs(ctx context.Context, key, claimed string) (bool, error) {
	r, err := s.bucket.NewRangeReader(ctx, key, 0, 512, nil)
	if err != nil {
		return false, fmt.Errorf("storage: read the file: %w", err)
	}
	defer r.Close()
	head, err := io.ReadAll(r)
	if err != nil {
		return false, fmt.Errorf("storage: read the file: %w", err)
	}
	sniffed, _, _ := mime.ParseMediaType(http.DetectContentType(head))
	trimmed := bytes.ToLower(bytes.TrimSpace(head))
	page := sniffed == "text/html" || bytes.HasPrefix(trimmed, []byte("<svg")) || bytes.Contains(trimmed[:min(len(trimmed), 256)], []byte("<svg"))
	switch {
	case claimed == "image/avif":
		// DetectContentType knows no AVIF: its ISO box says so.
		return len(head) >= 12 && string(head[4:8]) == "ftyp" && (string(head[8:12]) == "avif" || string(head[8:12]) == "avis"), nil
	case claimed == "image/svg+xml":
		return page && sniffed != "text/html", nil
	case strings.HasPrefix(claimed, "image/"):
		return sniffed == claimed, nil
	case claimed == "text/html":
		return true, nil
	}
	return !page, nil
}

// Files are the files of ids, by id; ids of no file are left out.
func (s *Store) Files(ctx context.Context, ids []uuid.UUID) (map[uuid.UUID]File, error) {
	out := map[uuid.UUID]File{}
	if len(ids) == 0 {
		return out, nil
	}
	keys := make([]pgtype.UUID, len(ids))
	for i, id := range ids {
		keys[i] = postgres.UUID(id)
	}
	rows, err := postgres.Querier(ctx, s.pool).Query(ctx, `SELECT id, name, content_type, size, entity, field, key FROM storage_files WHERE id = ANY($1) AND status = 'attached'`, keys)
	if err != nil {
		return nil, fmt.Errorf("storage: read files: %w", err)
	}
	defer rows.Close()
	for rows.Next() {
		var (
			f  File
			id pgtype.UUID
		)
		if err := rows.Scan(&id, &f.Name, &f.ContentType, &f.Size, &f.Entity, &f.Field, &f.key); err != nil {
			return nil, err
		}
		f.ID = postgres.ID(id)
		out[f.ID] = f
	}
	return out, rows.Err()
}

// URL is a signed link to read a file, which works for its field's
// url_minutes: opened in the browser or downloaded under its name.
func (s *Store) URL(ctx context.Context, f File) (string, error) {
	field := Fields[f.Entity+"."+f.Field]
	minutes := field.URLMinutes
	if minutes <= 0 {
		minutes = 60
	}
	disposition := dispositionOf(field, f.Name)
	return s.bucket.SignedURL(ctx, f.key, &blob.SignedURLOptions{
		Method: http.MethodGet, Expiry: time.Duration(minutes) * time.Minute,
		BeforeSign: func(as func(any) bool) error {
{{- if has .Options.drivers "s3"}}
			var get *s3.GetObjectInput
			if as(&get) {
				get.ResponseContentDisposition = &disposition
				get.ResponseContentType = &f.ContentType
			}
{{- end}}
			return nil
		},
	})
}

// dispositionOf is how a file is served: inline, or as an attachment under
// its name.
func dispositionOf(f Field, name string) string {
	if f.Inline {
		return "inline"
	}
	return mime.FormatMediaType("attachment", map[string]string{"filename": name})
}

// Clean deletes the files sent and never used (older than {{.Options.pending_hours}}h), and those
// released, from the store and then from the table; one it could not
// delete is tried again next time.
func (s *Store) Clean(ctx context.Context) (int, error) {
	rows, err := s.pool.Query(ctx, `SELECT id, key FROM storage_files WHERE status = 'deleting' OR (status = 'pending' AND created_at < $1) ORDER BY created_at LIMIT 1000`, time.Now().Add(-pendingFor))
	if err != nil {
		return 0, fmt.Errorf("storage: clean: %w", err)
	}
	type gone struct {
		id  pgtype.UUID
		key string
	}
	var list []gone
	for rows.Next() {
		var g gone
		if err := rows.Scan(&g.id, &g.key); err != nil {
			rows.Close()
			return 0, err
		}
		list = append(list, g)
	}
	rows.Close()
	if err := rows.Err(); err != nil {
		return 0, err
	}
	n := 0
	for _, g := range list {
		if err := s.bucket.Delete(ctx, g.key); err != nil && gcerrors.Code(err) != gcerrors.NotFound {
			continue
		}
		if _, err := s.pool.Exec(ctx, `DELETE FROM storage_files WHERE id = $1`, g.id); err != nil {
			return n, fmt.Errorf("storage: clean: %w", err)
		}
		n++
	}
	return n, nil
}

// Routes serves the requests for uploads, at POST /storage/uploads, and a
// folder store's signed links, at /storage/blob: a PUT sends a file asked
// for, a GET reads one (other stores serve their own).
func (s *Store) Routes(mux *http.ServeMux) {
	mux.HandleFunc("POST /storage/uploads", s.upload)
	if s.disk == nil {
		return
	}
	mux.HandleFunc("PUT "+diskPath, s.diskPut)
	mux.HandleFunc("GET "+diskPath, s.diskGet)
}

// upload answers where to send a file: {entity, field, name, content_type,
// size} in, {id, url, method, headers, expires_at} out.
func (s *Store) upload(w http.ResponseWriter, r *http.Request) {
{{- if uses "security"}}
	// Only who signed in sends files; whether a record may use one is the
	// record's rules', when it is saved.
	if s.Principal != nil && s.Principal(r.Context()) == "" {
		edge.Write(w, r, security.ErrUnauthorized)
		return
	}
{{- end}}
	var in struct {
		Entity      string `json:"entity"`
		Field       string `json:"field"`
		Name        string `json:"name"`
		ContentType string `json:"content_type"`
		Size        int64  `json:"size"`
	}
	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 16<<10)).Decode(&in); err != nil {
		edge.Write(w, r, &edge.Problem{Status: http.StatusBadRequest, Code: "invalid_request", Title: "Send the file's entity, field, name, content_type and size, as JSON."})
		return
	}
	up, err := s.Request(r.Context(), UploadRequest{Entity: in.Entity, Field: in.Field, Name: in.Name, ContentType: in.ContentType, Size: in.Size})
	var refusal *Refusal
	if errors.As(err, &refusal) {
		edge.Write(w, r, edge.InvalidFields([]edge.FieldProblem{ {Field: refusal.Field, Code: refusal.Code} }))
		return
	}
	if err != nil {
		edge.Write(w, r, edge.ErrInternal)
		return
	}
	w.Header().Set("Content-Type", "application/json")
	w.Header().Set("Cache-Control", "no-store")
	w.WriteHeader(http.StatusCreated)
	_ = json.NewEncoder(w).Encode(map[string]any{
		"id": up.ID.String(), "url": up.URL, "method": up.Method, "headers": up.Headers, "expires_at": up.ExpiresAt.UTC().Format(time.RFC3339),
	})
}

// diskKey is the key of a signed link of the folder store, for its method.
func (s *Store) diskKey(r *http.Request) (string, bool) {
	key, err := s.disk.KeyFromURL(r.Context(), r.URL)
	return key, err == nil && r.URL.Query().Get("method") == r.Method
}

func (s *Store) diskPut(w http.ResponseWriter, r *http.Request) {
	key, ok := s.diskKey(r)
	if !ok {
		http.Error(w, "the link is not valid, or no longer", http.StatusForbidden)
		return
	}
	var (
		ct   string
		size int64
	)
	err := s.pool.QueryRow(r.Context(), `SELECT content_type, size FROM storage_files WHERE key = $1 AND status = 'pending'`, key).Scan(&ct, &size)
	if err != nil {
		http.Error(w, "no file waits for this link", http.StatusNotFound)
		return
	}
	if got, _, _ := mime.ParseMediaType(r.Header.Get("Content-Type")); got != ct || r.URL.Query().Get("contentType") != ct {
		http.Error(w, "the Content-Type is not the one asked for", http.StatusForbidden)
		return
	}
	if r.ContentLength >= 0 && r.ContentLength != size {
		http.Error(w, "the body is not of the size asked for", http.StatusRequestEntityTooLarge)
		return
	}
	body := http.MaxBytesReader(w, r.Body, size)
	wr, err := s.bucket.NewWriter(r.Context(), key, &blob.WriterOptions{ContentType: ct})
	if err != nil {
		http.Error(w, "the file could not be kept", http.StatusInternalServerError)
		return
	}
	n, err := io.Copy(wr, body)
	if err != nil || n != size {
		_ = wr.Close()
		_ = s.bucket.Delete(r.Context(), key)
		http.Error(w, "the body is not of the size asked for", http.StatusRequestEntityTooLarge)
		return
	}
	if err := wr.Close(); err != nil {
		http.Error(w, "the file could not be kept", http.StatusInternalServerError)
		return
	}
	w.WriteHeader(http.StatusOK)
}

func (s *Store) diskGet(w http.ResponseWriter, r *http.Request) {
	key, ok := s.diskKey(r)
	if !ok {
		http.Error(w, "the link is not valid, or no longer", http.StatusForbidden)
		return
	}
	var f File
	err := s.pool.QueryRow(r.Context(), `SELECT name, content_type, size, entity, field FROM storage_files WHERE key = $1 AND status = 'attached'`, key).
		Scan(&f.Name, &f.ContentType, &f.Size, &f.Entity, &f.Field)
	if err != nil {
		http.NotFound(w, r)
		return
	}
	rd, err := s.bucket.NewReader(r.Context(), key, nil)
	if err != nil {
		http.NotFound(w, r)
		return
	}
	defer rd.Close()
	w.Header().Set("Content-Type", f.ContentType)
	w.Header().Set("Content-Disposition", dispositionOf(Fields[f.Entity+"."+f.Field], f.Name))
	w.Header().Set("X-Content-Type-Options", "nosniff")
	w.Header().Set("Content-Security-Policy", "default-src 'none'; sandbox")
	w.Header().Set("Cache-Control", "private, max-age=300")
	http.ServeContent(w, r, "", rd.ModTime(), rd)
}
