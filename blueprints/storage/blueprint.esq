/// Files and images in the model: file and image fields, kept in a store
/// chosen by STORAGE_URL in each environment (a folder of the disk, S3 and
/// what speaks it, Google Cloud Storage, Azure Blob Storage). A browser
/// asks the API for an upload, sends the file straight to the store and
/// saves the record with the file's id; the app checks the file (its size,
/// its real format) before it is used. Files are read by signed links that
/// expire; a file replaced, cleared or of a deleted record leaves the
/// store, and an upload never used is cleaned up. In development the store
/// is a folder of the project, served by the app itself.
blueprint storage {
  version "0.1.0"
  requires app, env, http, domain, postgres, migrations, store, rest
  optional jobs, worker, security, compose, client_ts, spa, testcontainers, docker

  /// Where files are kept: file://./storage (a folder), s3://bucket?region=
  /// (S3, and R2, MinIO and others with &endpoint= and
  /// &s3ForcePathStyle=true), gs://bucket or azblob://container. In
  /// development, a folder of the project (local_dir), or the local MinIO
  /// of compose.yaml with local minio.
  env STORAGE_URL string secret required development("{{if eq .Options.local \"minio\"}}s3://{{.App.Kebab}}?endpoint=http://localhost:{{composePort \"minio\" \"9000\"}}&s3ForcePathStyle=true&region=us-east-1{{else}}file://./{{.Options.local_dir}}{{end}}")
  /// Signs the links of a folder store (the app serves them); esquadro
  /// generates one for development.
  env STORAGE_SECRET string secret required generate(32)
  /// A prefix of every file's key, to share a bucket between apps or
  /// environments: shop/production/.
  env STORAGE_PREFIX string default("")
  go_require "gocloud.dev" "v0.48.2"

  /// disk (a folder of the project) or minio (a MinIO in compose.yaml):
  /// the store in development.
  option local name default(disk)
  /// The folder of a disk store in development, out of git.
  option local_dir string default("storage")
  /// The formats an image field takes, and its largest size; a field's
  /// @storage(types, max) overrides them.
  option image_types list default(["png", "jpeg", "webp", "gif", "avif"])
  option image_max string default("10MB")
  /// The formats a file field takes (any when empty), and its largest size.
  option file_types list default([])
  option file_max string default("25MB")
  /// Minutes a link to read a file works, and one to send it.
  option url_minutes int default(60)
  option upload_minutes int default(15)
  /// Hours after which an upload never used is deleted.
  option pending_hours int default(24)
  /// How often the cleanup runs, with jobs: 1h, 30m.
  option clean_every string default("1h")
  /// How keys are made: entity (products/photo/<id>) or random (<id>).
  option key_layout name default(entity)
  /// Read a file's first bytes to check its real format before it is used.
  option check_content bool default(true)

  annotation field {
    /// The largest file of the field: 5MB, 500KB.
    max string
    /// The formats of the field: [pdf, docx], or MIME types.
    types list
    /// Minutes a link to read the field's file works.
    url_minutes int
    /// Opened in the browser; images of a safe format are, by default.
    inline bool
    /// Always downloaded, under its name; the default but for images.
    attachment bool
  }
}
