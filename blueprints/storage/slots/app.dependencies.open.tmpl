{{- if fileFields .Entities (optionsOf "storage")}}
	d.storage, err = storage.Open(ctx, storage.Config{URL: d.config.StorageURL, Secret: d.config.StorageSecret, Prefix: d.config.StoragePrefix, AccessKey: d.config.StorageAccessKey, SecretKey: d.config.StorageSecretKey}, d.pool)
	if err != nil {
		release()
		return d, nil, err
	}
{{- end}}
