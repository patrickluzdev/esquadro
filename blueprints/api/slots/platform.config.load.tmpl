{{- if .Entities}}{{$p := upper .App.Snake}}
	for origin := range strings.SplitSeq(get("{{$p}}_CORS_ORIGINS", {{quote (join "," (strs .Options.cors_origins))}}), ",") {
		if origin = strings.TrimSpace(origin); origin != "" {
			c.API.CORSOrigins = append(c.API.CORSOrigins, origin)
		}
	}
	if c.API.RateLimit, err = strconv.Atoi(get("{{$p}}_RATE_LIMIT", "{{.Options.rate_limit}}")); err != nil {
		return Config{}, fmt.Errorf("config: {{$p}}_RATE_LIMIT must be a number: %w", err)
	}
	if c.API.MaxBodyKB, err = strconv.Atoi(get("{{$p}}_MAX_BODY_KB", "{{.Options.max_body_kb}}")); err != nil {
		return Config{}, fmt.Errorf("config: {{$p}}_MAX_BODY_KB must be a number: %w", err)
	}
	if c.API.HSTS, err = strconv.ParseBool(get("{{$p}}_HSTS", "{{.Options.hsts}}")); err != nil {
		return Config{}, fmt.Errorf("config: {{$p}}_HSTS must be true or false: %w", err)
	}
	if c.API.TrustProxy, err = strconv.ParseBool(get("{{$p}}_TRUST_PROXY", "{{.Options.trust_proxy}}")); err != nil {
		return Config{}, fmt.Errorf("config: {{$p}}_TRUST_PROXY must be true or false: %w", err)
	}
{{- if .Options.docs}}
	docs := "true"
	if c.Env == "production" {
		docs = "false"
	}
	if c.API.Docs, err = strconv.ParseBool(get("{{$p}}_DOCS", docs)); err != nil {
		return Config{}, fmt.Errorf("config: {{$p}}_DOCS must be true or false: %w", err)
	}
{{- end}}
{{- end}}
