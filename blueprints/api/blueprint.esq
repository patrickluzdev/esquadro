/// A JSON API with the contract first, as in studyloop: api/openapi.yaml
/// written from the model, the server generated by ogen, and each module's
/// HTTP part, which translates between the contract and its use cases.
blueprint api {
  version "0.1.0"
  requires platform, postgres

  /// Title of the API in the contract; the app's name when empty.
  option title string default("")

  /// Tags of your own operations in api/openapi.yaml, indented by two.
  slot "api.tags"
  /// Paths of your own operations, indented by two.
  slot "api.paths"
  /// Schemas of your own operations, indented by four.
  slot "api.schemas"

  go_require "github.com/ogen-go/ogen" "v1.24.0"

  hook post-gen "ogen" writes "internal/apigen/**"
}
