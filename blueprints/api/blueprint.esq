/// A JSON API with the contract first, as in studyloop: api/openapi.yaml
/// written from the model, the server generated by ogen, and each module's
/// HTTP part, which translates between the contract and its use cases.
///
/// Every request goes through internal/platform/edge: a request ID, an
/// access log, panics answered as 500, security headers, CORS, a rate limit
/// per client, a body limit, content negotiation, gzip and errors as
/// Problem Details in the client's language. The options below are the
/// defaults; environment variables override most of them in production.
blueprint api {
  version "0.2.0"
  requires platform, postgres

  /// Title of the API in the contract; the app's name when empty.
  option title string default("")
  /// Origins browsers may call the API from, or ["*"] for any; none turns
  /// CORS off. <APP>_CORS_ORIGINS, comma separated, overrides it.
  option cors_origins list default([])
  /// Requests a minute each client may make; 0 turns the limit off.
  /// <APP>_RATE_LIMIT overrides it. Kept in memory: one instance only.
  option rate_limit int default(120)
  /// Largest request body, in KB; 0 turns the limit off.
  /// <APP>_MAX_BODY_KB overrides it.
  option max_body_kb int default(1024)
  /// Compress responses with gzip when the client accepts it.
  option compression bool default(true)
  /// Languages of the problems' titles, from Accept-Language; the first is
  /// the default. Translations live in internal/platform/edge/translations.go.
  option languages list default(["en"])
  /// Serve the contract at /api/openapi.yaml and its documentation at
  /// /docs, outside production unless <APP>_DOCS=true.
  option docs bool default(true)
  /// Send Strict-Transport-Security; only behind HTTPS. <APP>_HSTS
  /// overrides it.
  option hsts bool default(false)
  /// Take the client's address from X-Forwarded-For, for the rate limit and
  /// the log; only behind a proxy that sets it. <APP>_TRUST_PROXY overrides
  /// it.
  option trust_proxy bool default(false)

  /// Tags of your own operations in api/openapi.yaml, indented by two.
  slot "api.tags"
  /// Paths of your own operations, indented by two.
  slot "api.paths"
  /// Schemas of your own operations, indented by four.
  slot "api.schemas"

  go_require "github.com/ogen-go/ogen" "v1.24.0"

  hook post-gen "ogen" writes "internal/apigen/**"
}
