{{- if .Entities -}}
# Generated by esquadro from the .esq files: do not edit. To add operations of
# your own, contribute them to the api.tags, api.paths and api.schemas slots
# from a local blueprint, and implement them in a file of yours in the module.
openapi: 3.0.3
info:
  title: {{quote (or .Options.title .App.Label)}}
  version: 1.0.0
  description: |
    The {{.App.Label}} API.

    Errors are Problem Details whose `code` is stable and whose `title` is in
    the language Accept-Language asks for{{if gt (len (strs .Options.languages)) 1}} ({{join ", " (strs .Options.languages)}}){{end}}:
    `invalid_request` (400) for a request that does not match this contract,
    `not_found` (404), `method_not_allowed` (405), `not_acceptable` (406),
    `in_use` (409) for deleting a record others point at,
    `request_too_large` (413), `unsupported_media_type` (415),
    `invalid_fields` (422) listing every field refused at once, with codes
    `required`, `too_short`, `too_long`, `too_small`, `too_large`, `pattern`,
    `invalid_value`, `not_found` (a related record that does not exist) and
    `taken` (a unique value already used), `rate_limited` (429, with
    Retry-After) and `internal` (500). Every response carries X-Request-Id,
    which errors repeat as `requestId`.
servers:
  - url: /api/v1
tags:
{{- range .Modules}}{{if .Entities}}
  - name: {{.Snake}}
    description: {{quote (printf "The %s module." .Snake)}}
{{- end}}{{end}}
{{- with slot "api.tags" .}}
{{.}}
{{- end}}
paths:
{{- range .Entities}}{{$e := .}}{{$id := printf "%sId" .Camel}}
  /{{.Plural.Kebab}}:
    get:
      operationId: list{{.Plural.Pascal}}
      summary: {{quote (printf "List %s" (lower .Plural.Label))}}
      description: |
        The {{lower .Plural.Label}} in the order they were created, in pages of
        `limit` (25 by default, at most 100). `next` is the cursor of the next
        page, absent on the last one: pass it as `after`.
      tags: [{{.Module.Snake}}]
      parameters:
        - $ref: "#/components/parameters/After"
        - $ref: "#/components/parameters/Limit"
      responses:
        "200":
          description: {{quote (printf "A page of %s." (lower .Plural.Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}Page"
        default:
          $ref: "#/components/responses/Problem"
    post:
      operationId: create{{.Pascal}}
      summary: {{quote (printf "Create a %s" (lower .Label))}}
      description: |
        Stores a new {{lower .Label}}, with its defaults, once it passes the rules
        declared for {{lower .Plural.Label}}.
        Codes: `invalid_fields` (422); `invalid_request` (400).
      tags: [{{.Module.Snake}}]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/New{{.Pascal}}"
      responses:
        "201":
          description: {{quote (printf "The new %s." (lower .Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}"
        default:
          $ref: "#/components/responses/Problem"
  /{{.Plural.Kebab}}/{{"{"}}{{$id}}{{"}"}}:
    parameters:
      - name: {{$id}}
        in: path
        required: true
        schema: {type: string, format: uuid}
    get:
      operationId: get{{.Pascal}}
      summary: {{quote (printf "Read a %s" (lower .Label))}}
      description: |
        Codes: `not_found` (404).
      tags: [{{.Module.Snake}}]
      responses:
        "200":
          description: {{quote (printf "The %s." (lower .Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}"
        default:
          $ref: "#/components/responses/Problem"
    put:
      operationId: update{{.Pascal}}
      summary: {{quote (printf "Change a %s" (lower .Label))}}
      description: |
        Replaces the {{lower .Label}} by the one sent, so a field left out is
        cleared or takes its default.
        Codes: `invalid_fields` (422); `not_found` (404); `invalid_request` (400).
      tags: [{{.Module.Snake}}]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/New{{.Pascal}}"
      responses:
        "200":
          description: {{quote (printf "The saved %s." (lower .Label))}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Pascal}}"
        default:
          $ref: "#/components/responses/Problem"
    delete:
      operationId: delete{{.Pascal}}
      summary: {{quote (printf "Delete a %s" (lower .Label))}}
      description: |
        Codes: `not_found` (404); `in_use` (409) while other records point at it.
      tags: [{{.Module.Snake}}]
      responses:
        "204":
          description: Deleted.
        default:
          $ref: "#/components/responses/Problem"
{{- end}}
{{- with slot "api.paths" .}}
{{.}}
{{- end}}
components:
  parameters:
    After:
      name: after
      in: query
      required: false
      description: The cursor of the page to read, from the previous page's `next`.
      schema: {type: string}
    Limit:
      name: limit
      in: query
      required: false
      description: How many to read, 25 by default.
      schema: {type: integer, minimum: 1, maximum: 100}
  responses:
    Problem:
      description: The operation failed; `code` says why.
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
  schemas:
    Problem:
      type: object
      description: Problem Details (RFC 9457).
      required: [type, title, status, code]
      properties:
        type: {type: string}
        title: {type: string}
        status: {type: integer, format: int32}
        code: {type: string, description: Stable error code.}
        errors:
          type: array
          description: With `invalid_fields`, every field refused.
          items:
            $ref: "#/components/schemas/FieldProblem"
        requestId: {type: string, description: The request's X-Request-Id.}
    FieldProblem:
      type: object
      required: [field, code]
      properties:
        field: {type: string}
        code: {type: string}
{{- range .Enums}}{{if .Module.Entities}}
    {{enumName .}}:
      type: string
      enum: [{{range $i, $v := .Values}}{{if $i}}, {{end}}{{quote $v.Raw}}{{end}}]
{{- end}}{{end}}
{{- range .Entities}}{{$e := .}}
    {{.Pascal}}:
      type: object
{{- with .Doc}}
      description: {{quote (join " " .)}}
{{- end}}
      required: [id{{range inRequest $e}}{{if .Required}}, {{jsonName .}}{{end}}{{end}}{{range keys $e}}{{if .Required}}, {{.Camel}}Id{{end}}{{end}}, createdAt, updatedAt]
      properties:
        id: {type: string, format: uuid}
{{- range inRequest $e}}
        {{jsonName .}}: {{schema .}}
{{- end}}
{{- range keys $e}}
        {{.Camel}}Id: {type: string, format: uuid}
{{- end}}
        createdAt: {type: string, format: date-time}
        updatedAt: {type: string, format: date-time}
    New{{.Pascal}}:
      type: object
{{- $req := false}}{{range inRequest $e}}{{if .Required}}{{$req = true}}{{end}}{{end}}{{range keys $e}}{{if .Required}}{{$req = true}}{{end}}{{end}}
{{- if $req}}
      required: [{{$first := true}}{{range inRequest $e}}{{if .Required}}{{if not $first}}, {{end}}{{$first = false}}{{jsonName .}}{{end}}{{end}}{{range keys $e}}{{if .Required}}{{if not $first}}, {{end}}{{$first = false}}{{.Camel}}Id{{end}}{{end}}]
{{- end}}
      properties:
{{- range inRequest $e}}
        {{jsonName .}}: {{schema .}}
{{- end}}
{{- range keys $e}}
        {{.Camel}}Id: {type: string, format: uuid}
{{- end}}
{{- if and (not (inRequest $e)) (not (keys $e))}} {}
{{- end}}
    {{.Pascal}}Page:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/{{.Pascal}}"
        next: {type: string, description: The cursor of the next page; absent on the last one.}
{{- end}}
{{- with slot "api.schemas" .}}
{{.}}
{{- end}}
{{end -}}
