func TestWriteTitlesProblemsInTheRequestLanguage(t *testing.T) {
	t.Parallel()
	for _, lang := range Languages {
		req := httptest.NewRequest("GET", "/", nil)
		req.Header.Set("Accept-Language", lang)
		rec := serve(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { Write(w, r, ErrNotFound) }), req)
		if rec.Header().Get("Content-Language") != lang || !strings.Contains(rec.Body.String(), TitleIn(lang, ErrNotFound)) {
			t.Errorf("%s: %v %s", lang, rec.Header(), rec.Body)
		}
	}
}
