// Settings are what the middleware may be tuned with, from the configuration.
type Settings struct {
	// CORSOrigins are the origins browsers may call the API from; "*" is
	// any, and none turns CORS off.
	CORSOrigins []string
	// RateLimit is how many requests a minute each client may make; 0
	// turns the limit off.
	RateLimit int
	// MaxBody is the largest request body, in bytes; 0 turns the limit off.
	MaxBody int64
	// HSTS sends Strict-Transport-Security, for a service behind HTTPS.
	HSTS bool
	// TrustProxy takes the client's address from X-Forwarded-For.
	TrustProxy bool
}

// Middleware wraps a handler.
type Middleware func(http.Handler) http.Handler

// Chain wraps h in each middleware, the first being the outermost.
func Chain(h http.Handler, middleware ...Middleware) http.Handler {
	for _, m := range slices.Backward(middleware) {
		h = m(h)
	}
	return h
}

// ---- request ID and language ----

// Identify gives each request an ID, the client's X-Request-Id when it is a
// sensible one or a new UUID v7, and the language it is answered in, from
// Accept-Language. Both go back in the response's headers.
func Identify(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		id := r.Header.Get("X-Request-Id")
		if !sensibleID(id) {
			id = uuid.NewV7().String()
		}
		lang := Negotiate(r.Header.Get("Accept-Language"))
		w.Header().Set("X-Request-Id", id)
		w.Header().Set("Content-Language", lang)
		ctx := context.WithValue(r.Context(), requestIDKey, id)
		ctx = context.WithValue(ctx, languageKey, lang)
		next.ServeHTTP(w, r.WithContext(ctx))
	})
}

// sensibleID reports whether a client's request ID is safe to log and echo:
// 1 to 64 letters, digits, '-', '_' or '.'.
func sensibleID(id string) bool {
	if id == "" || len(id) > 64 {
		return false
	}
	for _, c := range id {
		ok := c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_' || c == '.'
		if !ok {
			return false
		}
	}
	return true
}

// ---- access log and panics ----

// Log logs every request once it is answered: its method, path, status,
// size, duration and ID; as an error when the status is 500 or more.
func Log(logger *slog.Logger, s Settings) Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			start := time.Now()
			rec := &recorder{ResponseWriter: w, status: http.StatusOK}
			next.ServeHTTP(rec, r)
			level := slog.LevelInfo
			if rec.status >= 500 {
				level = slog.LevelError
			}
			logger.LogAttrs(r.Context(), level, "request",
				slog.String("method", r.Method),
				slog.String("path", r.URL.Path),
				slog.Int("status", rec.status),
				slog.Int64("bytes", rec.bytes),
				slog.Duration("duration", time.Since(start)),
				slog.String("client", ClientOf(r, s.TrustProxy)),
				slog.String("request_id", RequestIDOf(r.Context())),
			)
		})
	}
}

// recorder keeps the status and size of a response.
type recorder struct {
	http.ResponseWriter
	status int
	bytes  int64
	wrote  bool
}

func (r *recorder) WriteHeader(status int) {
	if !r.wrote {
		r.status, r.wrote = status, true
	}
	r.ResponseWriter.WriteHeader(status)
}

func (r *recorder) Write(b []byte) (int, error) {
	r.wrote = true
	n, err := r.ResponseWriter.Write(b)
	r.bytes += int64(n)
	return n, err
}

func (r *recorder) Unwrap() http.ResponseWriter { return r.ResponseWriter }

// Recover answers a panic as ErrInternal and logs it with its stack, so one
// broken request does not take the service down.
func Recover(logger *slog.Logger) Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			defer func() {
				v := recover()
				if v == nil {
					return
				}
				if err, ok := v.(error); ok && errors.Is(err, http.ErrAbortHandler) {
					panic(v)
				}
				logger.ErrorContext(r.Context(), "panic",
					slog.Any("panic", v),
					slog.String("stack", string(debug.Stack())),
					slog.String("request_id", RequestIDOf(r.Context())),
				)
				Write(w, r, ErrInternal)
			}()
			next.ServeHTTP(w, r)
		})
	}
}

// ---- headers ----

// Secure sets the headers an API should send (OWASP): no sniffing, no
// framing, no content loaded from it, no referrer, no caching, and HSTS when
// asked for. A handler may replace them, as the documentation page does.
func Secure(s Settings) Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			h := w.Header()
			h.Set("X-Content-Type-Options", "nosniff")
			h.Set("X-Frame-Options", "DENY")
			h.Set("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'")
			h.Set("Referrer-Policy", "no-referrer")
			h.Set("Cache-Control", "no-store")
			if s.HSTS {
				h.Set("Strict-Transport-Security", "max-age=63072000; includeSubDomains")
			}
			next.ServeHTTP(w, r)
		})
	}
}

// CORS lets browsers on s.CORSOrigins call the API, answering their
// preflight requests. Without origins it does nothing.
func CORS(s Settings) Middleware {
	return func(next http.Handler) http.Handler {
		if len(s.CORSOrigins) == 0 {
			return next
		}
		anyOrigin := slices.Contains(s.CORSOrigins, "*")
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			origin := r.Header.Get("Origin")
			if origin == "" {
				next.ServeHTTP(w, r)
				return
			}
			h := w.Header()
			h.Add("Vary", "Origin")
			allowed := anyOrigin || slices.Contains(s.CORSOrigins, origin)
			if allowed {
				if anyOrigin {
					h.Set("Access-Control-Allow-Origin", "*")
				} else {
					h.Set("Access-Control-Allow-Origin", origin)
				}
				h.Set("Access-Control-Expose-Headers", "X-Request-Id, Content-Language, RateLimit-Limit, RateLimit-Remaining, Retry-After")
			}
			if r.Method == http.MethodOptions && r.Header.Get("Access-Control-Request-Method") != "" {
				if allowed {
					h.Set("Access-Control-Allow-Methods", "GET, POST, PUT, PATCH, DELETE")
					h.Set("Access-Control-Allow-Headers", "Accept, Accept-Language, Authorization, Content-Type, X-Request-Id")
					h.Set("Access-Control-Max-Age", "600")
				}
				w.WriteHeader(http.StatusNoContent)
				return
			}
			next.ServeHTTP(w, r)
		})
	}
}

// ---- rate limit ----

// RateLimit lets each client make s.RateLimit requests a minute, refilled
// evenly, and answers ErrRateLimited with Retry-After past that. It counts
// in memory, so it holds for one instance of the service; 0 turns it off.
func RateLimit(s Settings) Middleware {
	return func(next http.Handler) http.Handler {
		if s.RateLimit <= 0 {
			return next
		}
		l := newLimiter(s.RateLimit, time.Now)
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			ok, remaining, wait := l.take(ClientOf(r, s.TrustProxy))
			w.Header().Set("RateLimit-Limit", strconv.Itoa(s.RateLimit))
			w.Header().Set("RateLimit-Remaining", strconv.Itoa(remaining))
			if !ok {
				w.Header().Set("Retry-After", strconv.Itoa(int(math.Ceil(wait.Seconds()))))
				Write(w, r, ErrRateLimited)
				return
			}
			next.ServeHTTP(w, r)
		})
	}
}

// limiter is a token bucket per client.
type limiter struct {
	mu      sync.Mutex
	size    float64 // tokens of a full bucket: the requests of a minute
	perSec  float64
	now     func() time.Time
	clients map[string]*bucket
	swept   time.Time
}

type bucket struct {
	tokens float64
	at     time.Time
}

func newLimiter(perMinute int, now func() time.Time) *limiter {
	return &limiter{size: float64(perMinute), perSec: float64(perMinute) / 60, now: now, clients: map[string]*bucket{}, swept: now()}
}

// take spends a token of the client, if it has one, and says how many are
// left and, when none, how long until the next.
func (l *limiter) take(client string) (bool, int, time.Duration) {
	l.mu.Lock()
	defer l.mu.Unlock()
	now := l.now()
	if now.Sub(l.swept) > time.Minute {
		// A bucket untouched for a minute is full again: forget it.
		for c, b := range l.clients {
			if now.Sub(b.at) > time.Minute {
				delete(l.clients, c)
			}
		}
		l.swept = now
	}
	b, ok := l.clients[client]
	if !ok {
		b = &bucket{tokens: l.size, at: now}
		l.clients[client] = b
	}
	b.tokens = min(l.size, b.tokens+now.Sub(b.at).Seconds()*l.perSec)
	b.at = now
	if b.tokens < 1 {
		return false, 0, time.Duration((1 - b.tokens) / l.perSec * float64(time.Second))
	}
	b.tokens--
	return true, int(b.tokens), 0
}

// ClientOf is the address of the client of r: the last address of
// X-Forwarded-For, which the proxy in front adds, when trustProxy is set.
func ClientOf(r *http.Request, trustProxy bool) string {
	if trustProxy {
		if fwd := r.Header.Get("X-Forwarded-For"); fwd != "" {
			parts := strings.Split(fwd, ",")
			return strings.TrimSpace(parts[len(parts)-1])
		}
	}
	host, _, err := net.SplitHostPort(r.RemoteAddr)
	if err != nil {
		return r.RemoteAddr
	}
	return host
}

// ---- body and content negotiation ----

// LimitBody refuses a body over s.MaxBody bytes with ErrRequestTooLarge;
// 0 turns it off. Operations see a body cut at the limit fail to decode,
// which the API answers with the same problem.
func LimitBody(s Settings) Middleware {
	return func(next http.Handler) http.Handler {
		if s.MaxBody <= 0 {
			return next
		}
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if r.ContentLength > s.MaxBody {
				Write(w, r, ErrRequestTooLarge)
				return
			}
			r.Body = http.MaxBytesReader(w, r.Body, s.MaxBody)
			next.ServeHTTP(w, r)
		})
	}
}

// JSONOnly refuses, before the operation, an Accept header that leaves out
// JSON (ErrNotAcceptable) and a body that is not JSON
// (ErrUnsupportedMediaType).
func JSONOnly(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if accept := r.Header.Get("Accept"); accept != "" && !acceptsJSON(accept) {
			Write(w, r, ErrNotAcceptable)
			return
		}
		if r.ContentLength != 0 && r.Method != http.MethodGet && r.Method != http.MethodDelete {
			media, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
			if err != nil || media != "application/json" {
				Write(w, r, ErrUnsupportedMediaType)
				return
			}
		}
		next.ServeHTTP(w, r)
	})
}

// acceptsJSON reports whether an Accept header takes JSON or Problem
// Details.
func acceptsJSON(accept string) bool {
	for part := range strings.SplitSeq(accept, ",") {
		media, params, _ := strings.Cut(strings.TrimSpace(part), ";")
		if strings.ReplaceAll(strings.TrimSpace(params), " ", "") == "q=0" {
			continue
		}
		switch strings.ToLower(strings.TrimSpace(media)) {
		case "*/*", "application/*", "application/json", "application/problem+json":
			return true
		}
	}
	return false
}
