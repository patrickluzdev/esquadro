// Package seed puts data in the database from the project's seeds/*.yaml:
// records written out, each with an alias ($id) others point at, and
// records generated by the hundred, the same every time. Each record goes
// through its module's use case, as the API's do; the app's generated code
// (cmd/{{.App.Kebab}}/seed_gen.go) tells it the lists and how to create
// each one's records.
package seed

import (
	"context"
	"crypto/sha1"
	"errors"
	"fmt"
	"io"
	"math/rand/v2"
	"os"
	"path/filepath"
	"slices"
	"strings"
	"time"
	"uuid"

	"{{.App.Module}}/internal/platform/postgres"

	"go.yaml.in/yaml/v3"
)

// Kind is what a field holds, as the seed reads and makes it.
type Kind string

const (
	String   Kind = "string"
	Text     Kind = "text"
	Int      Kind = "int"
	Int64    Kind = "int64"
	Decimal  Kind = "decimal"
	Money    Kind = "money"
	Bool     Kind = "bool"
	Time     Kind = "time"
	Date     Kind = "date"
	UUID     Kind = "uuid"
	JSON     Kind = "json"
	Enum     Kind = "enum"
	Relation Kind = "relation"
	File     Kind = "file"
)

// Field is a field of a list, as the model declares it.
type Field struct {
	// Name is the field's in the API; a relation's is its name (category),
	// and its key's (category_id) is read too.
	Name     string
	Kind     Kind
	Required bool
	// Default is whether the model gives it a value when it is missing.
	Default bool
	Unique  bool
	// Values are an enum's.
	Values []string
	// Target is a relation's list: categories.
	Target string
	// Min and Max bound a number, or a text's length.
	Min, Max *float64
}

// Entity is a list a seed file may fill: its key, its table, its fields,
// and how a record is created from a row, with the id it is given.
type Entity struct {
	List   string
	Table  string
	Fields []Field
	Create func(ctx context.Context, id uuid.UUID, r *Row) error
}

// Options are how the seed is applied.
type Options struct {
	// App names the namespace of the records' ids.
	App string
	// Env is the environment (APP_ENV): production is refused unless
	// AllowProduction.
	Env             string
	AllowProduction bool
	// Currency is the app's, for an amount written without one.
	Currency string
	// Locale picks the words of generated values: pt_br or en.
	Locale string
	// Fresh deletes the lists' records first, and generates again.
	Fresh bool
	// DryRun checks everything and writes nothing.
	DryRun bool
	// Seed changes what is generated; the same seed, the same records.
	Seed uint64
	Out  io.Writer
}

// Files are the seed files of a folder, in the order of their names.
func Files(dir string) ([]string, error) {
	var out []string
	for _, pattern := range []string{"*.yaml", "*.yml"} {
		m, err := filepath.Glob(filepath.Join(dir, pattern))
		if err != nil {
			return nil, err
		}
		out = append(out, m...)
	}
	slices.Sort(out)
	return out, nil
}

var errDryRun = errors.New("dry run")

// Run applies the files, each in a transaction of its own: a mistake in
// one undoes that one.
func Run(ctx context.Context, db postgres.DB, entities []Entity, files []string, o Options) error {
	if o.Out == nil {
		o.Out = os.Stdout
	}
	if o.Env == "production" && !o.AllowProduction {
		return errors.New("seed: this is production (APP_ENV): pass --allow-production to seed it")
	}
	if o.Env == "production" && o.Fresh {
		return errors.New("seed: --fresh deletes records, and never runs in production")
	}
	s := &run{db: db, o: o, byList: map[string]*Entity{}, refs: map[string]map[string]uuid.UUID{}}
	for i := range entities {
		s.byList[entities[i].List] = &entities[i]
	}
	docs := make([]*document, 0, len(files))
	for _, f := range files {
		d, err := s.read(f)
		if err != nil {
			return err
		}
		docs = append(docs, d)
	}
	if o.Fresh {
		if err := s.clear(ctx, entities, docs); err != nil {
			return err
		}
	}
	for _, d := range docs {
		err := postgres.InTx(ctx, db, func(ctx context.Context) error {
			if err := s.apply(ctx, d); err != nil {
				return err
			}
			if o.DryRun {
				return errDryRun
			}
			return nil
		})
		if err != nil && !errors.Is(err, errDryRun) {
			return err
		}
	}
	if o.DryRun {
		fmt.Fprintln(o.Out, "dry run: nothing was written")
	}
	return nil
}

// run is a seed being applied.
type run struct {
	db     postgres.DB
	o      Options
	byList map[string]*Entity
	// refs are the ids of the records with an alias, by list and alias.
	refs map[string]map[string]uuid.UUID
}

// document is a seed file read: its lists in order.
type document struct {
	file  string
	lists []*block
}

// block is a list of a file: its records written out, or a rule to
// generate some.
type block struct {
	entity   *Entity
	line     int
	rows     []*yaml.Node
	generate int
	fields   map[string]*yaml.Node
}

func (s *run) read(file string) (*document, error) {
	src, err := os.ReadFile(file)
	if err != nil {
		return nil, err
	}
	var root yaml.Node
	if err := yaml.Unmarshal(src, &root); err != nil {
		return nil, fmt.Errorf("%s: %w", file, err)
	}
	d := &document{file: file}
	if len(root.Content) == 0 {
		return d, nil
	}
	top := root.Content[0]
	if top.Kind != yaml.MappingNode {
		return nil, fmt.Errorf("%s:%d: a seed file is lists by their names: categories:, products:", file, top.Line)
	}
	for i := 0; i+1 < len(top.Content); i += 2 {
		key, value := top.Content[i], top.Content[i+1]
		e, ok := s.byList[key.Value]
		if !ok {
			return nil, fmt.Errorf("%s:%d: %s is not a list of the model (%s)", file, key.Line, key.Value, strings.Join(s.lists(), ", "))
		}
		b := &block{entity: e, line: key.Line}
		switch value.Kind {
		case yaml.SequenceNode:
			b.rows = value.Content
		case yaml.MappingNode:
			for j := 0; j+1 < len(value.Content); j += 2 {
				k, v := value.Content[j], value.Content[j+1]
				switch k.Value {
				case "generate":
					if err := v.Decode(&b.generate); err != nil || b.generate < 1 {
						return nil, fmt.Errorf("%s:%d: generate is how many records: generate: 100", file, v.Line)
					}
				case "fields":
					if v.Kind != yaml.MappingNode {
						return nil, fmt.Errorf("%s:%d: fields are the rules of the fields: fields: { total: { money: 10..500 } }", file, v.Line)
					}
					b.fields = map[string]*yaml.Node{}
					for f := 0; f+1 < len(v.Content); f += 2 {
						b.fields[v.Content[f].Value] = v.Content[f+1]
					}
				default:
					return nil, fmt.Errorf("%s:%d: %s: a list is its records ([...]) or generate: and fields:", file, k.Line, k.Value)
				}
			}
			if b.generate == 0 {
				return nil, fmt.Errorf("%s:%d: %s: generate: how many records", file, key.Line, key.Value)
			}
		default:
			return nil, fmt.Errorf("%s:%d: %s: its records ([...]) or generate: and fields:", file, key.Line, key.Value)
		}
		d.lists = append(d.lists, b)
	}
	return d, nil
}

func (s *run) lists() []string {
	var out []string
	for name := range s.byList {
		out = append(out, name)
	}
	slices.Sort(out)
	return out
}

// clear deletes the records of the files' lists, the ones that point at
// others first.
func (s *run) clear(ctx context.Context, entities []Entity, docs []*document) error {
	named := map[string]bool{}
	for _, d := range docs {
		for _, b := range d.lists {
			named[b.entity.List] = true
		}
	}
	return postgres.InTx(ctx, s.db, func(ctx context.Context) error {
		for _, e := range slices.Backward(entities) {
			if !named[e.List] {
				continue
			}
			tag, err := postgres.Querier(ctx, s.db).Exec(ctx, "DELETE FROM "+quote(e.Table))
			if err != nil {
				return fmt.Errorf("seed: deleting %s: %w (another list points at it: add it to the seed, or delete those first)", e.List, err)
			}
			fmt.Fprintf(s.o.Out, "%s: %d deleted\n", e.List, tag.RowsAffected())
		}
		return nil
	})
}

func (s *run) apply(ctx context.Context, d *document) error {
	for _, b := range d.lists {
		if b.generate > 0 {
			if err := s.generated(ctx, d.file, b); err != nil {
				return err
			}
			continue
		}
		created, kept := 0, 0
		for i, node := range b.rows {
			ok, err := s.written(ctx, d.file, b.entity, i, node)
			if err != nil {
				return err
			}
			if ok {
				created++
			} else {
				kept++
			}
		}
		fmt.Fprintf(s.o.Out, "%s: %d created, %d already there\n", b.entity.List, created, kept)
	}
	return nil
}

// written creates a record written out, unless it is there already (its
// id comes from its alias, or its place in the file): false then.
func (s *run) written(ctx context.Context, file string, e *Entity, i int, node *yaml.Node) (bool, error) {
	if node.Kind != yaml.MappingNode {
		return false, fmt.Errorf("%s:%d: %s[%d]: a record is its fields: { name: ... }", file, node.Line, e.List, i)
	}
	r := &Row{list: e.List, index: i, file: file, line: node.Line, values: map[string]any{}, lines: map[string]int{}, currency: s.o.Currency}
	alias := ""
	for j := 0; j+1 < len(node.Content); j += 2 {
		k, v := node.Content[j], node.Content[j+1]
		if k.Value == "$id" {
			alias = v.Value
			continue
		}
		var value any
		if err := v.Decode(&value); err != nil {
			return false, fmt.Errorf("%s:%d: %s[%d].%s: %w", file, v.Line, e.List, i, k.Value, err)
		}
		r.values[k.Value] = value
		r.lines[k.Value] = v.Line
	}
	key := fmt.Sprintf("%s/%s#%d", e.List, filepath.Base(file), i)
	if alias != "" {
		key = e.List + "/$" + alias
	}
	id := s.id(key)
	if alias != "" {
		if s.refs[e.List] == nil {
			s.refs[e.List] = map[string]uuid.UUID{}
		}
		s.refs[e.List][alias] = id
	}
	if err := s.resolve(r, e); err != nil {
		return false, err
	}
	if exists, err := s.exists(ctx, e, id); err != nil || exists {
		return false, err
	}
	return true, s.create(ctx, e, id, r)
}

// generated makes a block's records, unless its list has records already
// (and no --fresh).
func (s *run) generated(ctx context.Context, file string, b *block) error {
	e := b.entity
	if !s.o.Fresh {
		var n int
		if err := postgres.Querier(ctx, s.db).QueryRow(ctx, "SELECT count(*) FROM "+quote(e.Table)).Scan(&n); err != nil {
			return err
		}
		if n > 0 {
			fmt.Fprintf(s.o.Out, "%s: %d already there, none generated (--fresh to start over)\n", e.List, n)
			return nil
		}
	}
	g, err := s.generator(ctx, file, b)
	if err != nil {
		return err
	}
	for i := range b.generate {
		r := &Row{list: e.List, index: i, file: file, line: b.line, values: map[string]any{}, lines: map[string]int{}, currency: s.o.Currency}
		if err := g.fill(r, i); err != nil {
			return err
		}
		if err := s.create(ctx, e, s.id(fmt.Sprintf("%s/generated#%d/%d", e.List, i, s.o.Seed)), r); err != nil {
			return err
		}
	}
	fmt.Fprintf(s.o.Out, "%s: %d generated\n", e.List, b.generate)
	return nil
}

// resolve turns a relation's alias ($eletronicos) into its record's id,
// and checks the fields a row names.
func (s *run) resolve(r *Row, e *Entity) error {
	for name, v := range r.values {
		if name == "created_at" || name == "updated_at" {
			continue
		}
		f := e.field(name)
		if f == nil {
			return r.errorf(name, "%s has no field %s (%s)", e.List, name, strings.Join(e.names(), ", "))
		}
		text, isText := v.(string)
		if f.Kind == Relation && isText && strings.HasPrefix(text, "$") {
			id, ok := s.refs[f.Target][text[1:]]
			if !ok {
				return r.errorf(name, "%s is no alias of %s declared before ($id: %s)", text, f.Target, text[1:])
			}
			r.values[name] = id.String()
		}
		if f.Kind == Enum && v != nil && !slices.Contains(f.Values, fmt.Sprint(v)) {
			return r.errorf(name, "%v is not one of %s", v, strings.Join(f.Values, ", "))
		}
	}
	for _, f := range e.Fields {
		if f.Required && !f.Default && f.Kind != File {
			if _, ok := r.value(f.Name); !ok {
				return r.errorf(f.Name, "is required")
			}
		}
	}
	return nil
}

func (s *run) exists(ctx context.Context, e *Entity, id uuid.UUID) (bool, error) {
	var ok bool
	err := postgres.Querier(ctx, s.db).QueryRow(ctx, "SELECT EXISTS (SELECT 1 FROM "+quote(e.Table)+" WHERE id = $1)", id.String()).Scan(&ok)
	return ok, err
}

// create stores a row through its list's use case, and then the dates it
// gives (created_at, updated_at), which the use cases leave to the
// database.
func (s *run) create(ctx context.Context, e *Entity, id uuid.UUID, r *Row) error {
	if err := e.Create(ctx, id, r); err != nil {
		if rerr := r.Err(); rerr != nil {
			return rerr
		}
		return fmt.Errorf("%s:%d: %s[%d]: %w", r.file, r.line, r.list, r.index, err)
	}
	created, hasCreated := r.when("created_at")
	updated, hasUpdated := r.when("updated_at")
	if err := r.Err(); err != nil {
		return err
	}
	if !hasCreated && !hasUpdated {
		return nil
	}
	if !hasUpdated {
		updated = created
	}
	if !hasCreated {
		created = updated
	}
	_, err := postgres.Querier(ctx, s.db).Exec(ctx, "UPDATE "+quote(e.Table)+" SET created_at = $2, updated_at = $3 WHERE id = $1", id.String(), created, updated)
	return err
}

// id is a record's id, the same for the same key in the same app: UUID
// version 5 of the key.
func (s *run) id(key string) uuid.UUID {
	h := sha1.Sum([]byte("esquadro-seed/" + s.o.App + "/" + key))
	var u uuid.UUID
	copy(u[:], h[:16])
	u[6] = u[6]&0x0f | 0x50
	u[8] = u[8]&0x3f | 0x80
	return u
}

// rng is the randomness of a list, the same for the same seed.
func (s *run) rng(list string) *rand.Rand {
	h := sha1.Sum([]byte(list))
	var k uint64
	for _, b := range h[:8] {
		k = k<<8 | uint64(b)
	}
	return rand.New(rand.NewPCG(s.o.Seed, k))
}

func (e *Entity) field(name string) *Field {
	for i := range e.Fields {
		f := &e.Fields[i]
		if f.Name == name || (f.Kind == Relation && f.Name+"_id" == name) {
			return f
		}
	}
	return nil
}

func (e *Entity) names() []string {
	var out []string
	for _, f := range e.Fields {
		out = append(out, f.Name)
	}
	return out
}

func quote(table string) string { return `"` + strings.ReplaceAll(table, `"`, `""`) + `"` }

// Row is a record of a seed file, or generated: its values by field.
type Row struct {
	list     string
	index    int
	file     string
	line     int
	values   map[string]any
	lines    map[string]int
	currency string
	errs     []error
}

func (r *Row) value(name string) (any, bool) {
	if v, ok := r.values[name]; ok && v != nil {
		return v, true
	}
	if v, ok := r.values[name+"_id"]; ok && v != nil {
		return v, true
	}
	return nil, false
}

func (r *Row) errorf(name, format string, args ...any) error {
	line := r.line
	if l, ok := r.lines[name]; ok {
		line = l
	}
	return fmt.Errorf("%s:%d: %s[%d].%s: %s", r.file, line, r.list, r.index, name, fmt.Sprintf(format, args...))
}

// Fail notes that a field's value is not what it should be.
func (r *Row) Fail(name, expected string) {
	r.errs = append(r.errs, r.errorf(name, "expected %s", expected))
}

// Err is what was wrong with the row's values, or nil.
func (r *Row) Err() error { return errors.Join(r.errs...) }

// String is a text field's value.
func (r *Row) String(name string) string {
	v, ok := r.value(name)
	if !ok {
		return ""
	}
	return fmt.Sprint(v)
}

// Int is a whole number's value.
func (r *Row) Int(name string) int { return int(r.Int64(name)) }

// Int64 is a whole number's value.
func (r *Row) Int64(name string) int64 {
	v, ok := r.value(name)
	if !ok {
		return 0
	}
	switch n := v.(type) {
	case int:
		return int64(n)
	case int64:
		return n
	case uint64:
		return int64(n)
	case float64:
		if n == float64(int64(n)) {
			return int64(n)
		}
	}
	r.Fail(name, "a whole number")
	return 0
}

// Number is a decimal's value as text: 19.90.
func (r *Row) Number(name string) string {
	v, ok := r.value(name)
	if !ok {
		return ""
	}
	switch n := v.(type) {
	case string, int, int64, uint64, float64:
		return fmt.Sprint(n)
	}
	r.Fail(name, "a number, as 19.90")
	return ""
}

// Money is an amount and its currency: "199.90" (the app's currency),
// 199.90, or { amount: "199.90", currency: BRL }.
func (r *Row) Money(name string) (amount, code string, ok bool) {
	v, has := r.value(name)
	if !has {
		return "", "", false
	}
	switch m := v.(type) {
	case map[string]any:
		amount, code = fmt.Sprint(m["amount"]), r.currency
		if c, ok := m["currency"]; ok {
			code = fmt.Sprint(c)
		}
		return amount, code, m["amount"] != nil
	case string, int, int64, uint64, float64:
		return fmt.Sprint(m), r.currency, true
	}
	r.Fail(name, `money, as "199.90" or { amount: "199.90", currency: BRL }`)
	return "", "", false
}

// Bool is a yes or no's value.
func (r *Row) Bool(name string) bool {
	v, ok := r.value(name)
	if !ok {
		return false
	}
	b, isBool := v.(bool)
	if !isBool {
		r.Fail(name, "true or false")
	}
	return b
}

// Time is a moment's or a date's value: 2026-10-01, 2026-10-01T10:00:00Z.
func (r *Row) Time(name string) time.Time {
	t, _ := r.when(name)
	return t
}

func (r *Row) when(name string) (time.Time, bool) {
	v, ok := r.values[name]
	if !ok || v == nil {
		return time.Time{}, false
	}
	switch t := v.(type) {
	case time.Time:
		return t, true
	case string:
		for _, layout := range []string{time.RFC3339Nano, "2006-01-02T15:04:05", "2006-01-02 15:04:05", time.DateOnly} {
			if p, err := time.Parse(layout, t); err == nil {
				return p, true
			}
		}
	}
	r.Fail(name, "a date, as 2026-10-01 or 2026-10-01T10:00:00Z")
	return time.Time{}, false
}

// UUID is an id's value: a relation's, once its alias is resolved.
func (r *Row) UUID(name string) uuid.UUID {
	v, ok := r.value(name)
	if !ok {
		return uuid.Nil()
	}
	id, err := uuid.Parse(fmt.Sprint(v))
	if err != nil {
		r.Fail(name, "an id, or an alias declared before ($name)")
	}
	return id
}

// JSON is a JSON field's value, as written.
func (r *Row) JSON(name string) []byte {
	v, ok := r.value(name)
	if !ok {
		return nil
	}
	out, err := yamlToJSON(v)
	if err != nil {
		r.Fail(name, "a value JSON can hold")
	}
	return out
}
