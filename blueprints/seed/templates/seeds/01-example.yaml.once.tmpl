# The data of {{.App.Kebab}}'s database, for development and demos: yours.
# {{.App.Kebab}} seed (task seed) applies seeds/*.yaml in the order of their
# names, each record through the model's use case (its validations, its
# defaults); records already there are kept. --fresh starts over.
#
# A list is its records written out, each with an alias others point at:
#
#   categories:
#     - $id: home
#       name: Home
#   products:
#     - name: Lamp
#       price: "49.90"             # or { amount: "49.90", currency: BRL }
#       category: $home            # a relation, by its alias
#       created_at: 2026-10-01     # a date in the past
#
# or records generated, the same every time (--seed N for others):
#
#   orders:
#     generate: 500
#     fields:
#       number:     { sequence: "#{n:5}" }        # #00001, #00002…
#       status:     { pick: { PAID: 4, PENDING: 1 } }
#       total:      { money: 40..500 }
#       quantity:   { int: 1..3 }
#       customer:   { any: true }                 # one already there
#       created_at: { past: 90d, trend: up }      # more of them lately
#
# Rules: sequence, pick, one_of, int, decimal, money, past, future, between,
# trend, any, name, email, sentence, words, null (a chance of empty). A
# field not named is made by its type and its name.
{{- range $e := seedEntities .Entities}}{{if not (index (annOf "security" $e) "principal")}}

{{$e.Plural.Snake}}:
  generate: 10
{{- end}}{{end}}
