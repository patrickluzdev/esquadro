func seedNumber(n float64) *float64 { return &n }
{{- if $money}}

// seedMoney is a row's amount, in its currency or the app's.
func seedMoney(r *seed.Row, name string) currency.Amount {
	n, code, ok := r.Money(name)
	if !ok {
		return currency.Amount{}
	}
	a, err := currency.NewAmount(n, code)
	if err != nil {
		r.Fail(name, `money, as "199.90" or { amount: "199.90", currency: BRL }`)
	}
	return a
}
{{- end}}
{{- if $decimal}}

// seedDecimal is a row's decimal number.
func seedDecimal(r *seed.Row, name string) decimal.Decimal {
	text := r.Number(name)
	if text == "" {
		return decimal.Zero
	}
	v, err := decimal.NewFromString(text)
	if err != nil {
		r.Fail(name, "a number, as 19.90")
	}
	return v
}
{{- end}}
