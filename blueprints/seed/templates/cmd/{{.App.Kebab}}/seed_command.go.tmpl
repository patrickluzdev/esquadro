package main

import (
	"context"
	"errors"
	"flag"
	"fmt"
	"os"
	"strconv"

	"{{.App.Module}}/internal/platform/seed"
)

const seedUsage = `usage: {{.App.Kebab}} seed [options] [file...]

Puts the data of seeds/*.yaml (or of the files given) in the database,
through the model's use cases. Records written out that are there already
are kept; generated ones are made when their list is empty.

  --fresh             delete the lists' records first, and generate again
  --dry-run           check everything, write nothing
  --seed N            other generated values (the same N, the same records)
  --allow-production  seed the production database`

// seedLocale picks the words of generated texts.
const seedLocale = "{{range $i, $s := instances "spa"}}{{if eq $i 0}}{{$s.Options.locale}}{{end}}{{else}}en{{end}}"

// seedCommand runs {{.App.Kebab}} seed.
func seedCommand(ctx context.Context, args []string) error {
	flags := flag.NewFlagSet("seed", flag.ContinueOnError)
	flags.Usage = func() { fmt.Fprintln(os.Stderr, seedUsage) }
	fresh := flags.Bool("fresh", false, "")
	dryRun := flags.Bool("dry-run", false, "")
	number := flags.String("seed", "1", "")
	allow := flags.Bool("allow-production", false, "")
	if err := flags.Parse(args); err != nil {
		return err
	}
	n, err := strconv.ParseUint(*number, 10, 64)
	if err != nil {
		return errors.New("seed: --seed is a whole number")
	}
	files := flags.Args()
	if len(files) == 0 {
		if files, err = seed.Files("seeds"); err != nil {
			return err
		}
		if len(files) == 0 {
			return errors.New("seed: no seeds/*.yaml; write one, or name the files")
		}
	}
	d, release, err := open(ctx)
	if err != nil {
		return err
	}
	defer release()
	return seed.Run(ctx, d.pool, seedEntities(d), files, seed.Options{
		App:             "{{.App.Kebab}}",
		Env:             d.config.Env,
		AllowProduction: *allow,
		Currency:        "{{or .App.Currency "USD"}}",
		Locale:          seedLocale,
		Fresh:           *fresh,
		DryRun:          *dryRun,
		Seed:            n,
	})
}
