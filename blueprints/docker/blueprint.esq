/// A container image of the app, for any kind of app (an API, a worker, a
/// command): a multi-stage Dockerfile that builds the binary and copies it
/// into a minimal image without a shell or root (distroless). The image runs
/// the app's default command; give another one after the image's name, e.g.
/// docker run <image> migrate. With http, it exposes the port and checks
/// /healthz; with compose, the app becomes a service of compose.yaml in the
/// app profile.
blueprint docker {
  version "0.1.0"
  requires app
  optional http, compose

  /// Steps of the build stage before the binary is built, e.g. RUN lines.
  slot "docker.build"
  /// Lines of the final image before its entrypoint, e.g. COPY of a file.
  slot "docker.runtime"
  /// Variables of the app's service in compose.yaml, as YAML lines indented
  /// by six spaces, e.g. DATABASE_URL: ...
  slot "docker.compose.environment"
  /// Services the app's service waits for in compose.yaml, as YAML lines
  /// indented by six spaces, e.g. postgres: { condition: service_healthy }.
  slot "docker.compose.depends_on"
}
