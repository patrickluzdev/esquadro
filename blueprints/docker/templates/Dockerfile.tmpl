{{- $app := .App.Kebab -}}
{{- $port := 8080}}{{with optionsOf "http"}}{{$port = .port}}{{end -}}
# syntax=docker/dockerfile:1
# Generated by esquadro: the image of {{.App.Label}}. To change it, contribute
# to the docker.build and docker.runtime slots from a blueprint, or write a
# Dockerfile of your own and remove the docker blueprint.

FROM golang:{{goVersion}} AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
{{- with slot "docker.build" .}}
{{.}}
{{- end}}
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/{{$app}} ./cmd/{{$app}}

# No shell, no package manager, no root: only the binary.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/{{$app}} /app/{{$app}}
ENV {{upper .App.Snake}}_ENV=production
{{- if uses "http"}}
ENV PORT={{$port}}
EXPOSE {{$port}}
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 CMD ["/app/{{$app}}", "health"]
{{- end}}
{{- with slot "docker.runtime" .}}
{{.}}
{{- end}}
ENTRYPOINT ["/app/{{$app}}"]
