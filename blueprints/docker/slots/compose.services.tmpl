{{- $name := or (index (optionsOf "compose") "name") .App.Kebab}}
{{- $port := 8080}}{{with optionsOf "http"}}{{$port = .port}}{{end}}
{{- $env := slotParts "docker.compose.environment" .}}{{$deps := slotParts "docker.compose.depends_on" .}}
  # The app itself, built from the Dockerfile; only with the app profile:
  # docker compose --profile app up.
  app:
    container_name: {{$name}}-app
    build: .
    profiles: [app]
{{- if uses "http"}}
    ports:
      - "{{$port}}:{{$port}}"
{{- end}}
{{- if uses "env"}}
    # Run as development, with the secrets of .env.{{index .Environments 0}}; the
    # services' addresses below replace localhost's.
    env_file:
      - path: .env.{{index .Environments 0}}
        required: false
{{- end}}
{{- if or $env (uses "env")}}
    environment:
{{- if uses "env"}}
      APP_ENV: {{index .Environments 0}}
{{- end}}
{{- range $env}}
{{.}}
{{- end}}
{{- end}}
{{- if $deps}}
    depends_on:
{{- range $deps}}
{{.}}
{{- end}}
{{- end}}
