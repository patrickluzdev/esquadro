# Generated by esquadro: the CI of {{.App.Label}}.
name: ci

on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7.0.1
      - uses: actions/setup-go@v7.0.0
        with:
          go-version-file: go.mod
      - run: go vet ./...
      - run: go test ./...
      - run: go build ./...
      - name: The generated code is what the model generates
        run: |
          version=$(jq -r .esquadro esquadro/lock.json)
          case "$version" in v*) ;; *) version=latest ;; esac
          go install github.com/patrickluzdev/esquadro/cmd/esquadro@"$version"
          esquadro gen -check
{{- if uses "docker"}}

  image:
    needs: test
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v7.0.1
      - uses: docker/setup-buildx-action@v4.4.1
      - uses: docker/login-action@v4.7.0
        if: startsWith(github.ref, 'refs/tags/v')
        with:
          registry: ghcr.io
          username: {{"${{"}} github.actor {{"}}"}}
          password: {{"${{"}} secrets.GITHUB_TOKEN {{"}}"}}
      - id: meta
        uses: docker/metadata-action@v6.2.0
        with:
          images: ghcr.io/{{"${{"}} github.repository {{"}}"}}
          tags: |
            type=semver,pattern={{"{{"}}version{{"}}"}}
            type=semver,pattern={{"{{"}}major{{"}}"}}.{{"{{"}}minor{{"}}"}}
            type=raw,value=latest,enable={{"${{"}} startsWith(github.ref, 'refs/tags/v') {{"}}"}}
            type=sha
      # Built on every push; published only for tags v*.
      - uses: docker/build-push-action@v7.4.0
        with:
          context: .
          push: {{"${{"}} startsWith(github.ref, 'refs/tags/v') {{"}}"}}
          tags: {{"${{"}} steps.meta.outputs.tags {{"}}"}}
          labels: {{"${{"}} steps.meta.outputs.labels {{"}}"}}
          build-args: VERSION={{"${{"}} steps.meta.outputs.version {{"}}"}}
{{- end}}
