{{- if or .Entities .Reports -}}
# Generated by esquadro: one entry per module with entities or reports.
version: "2"
sql:
{{- range .Modules}}{{if or .Entities .Reports}}
  - engine: postgresql
    schema: migrations
    queries: [{{if .Entities}}internal/{{.Snake}}/queries.sql{{end}}{{if and .Entities .Reports}}, {{end}}{{if .Reports}}internal/{{.Snake}}/reports{{end}}]
    gen:
      go:
        package: sqlgen
        out: internal/{{.Snake}}/sqlgen
        sql_package: pgx/v5
        emit_exact_table_names: true
        omit_unused_structs: true
        initialisms: [{{join ", " initialisms}}]
{{- end}}{{end}}
{{end -}}
