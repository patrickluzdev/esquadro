package postgres

{{importBlock "errors" "time" "uuid" (and $money "strings") "github.com/jackc/pgx/v5/pgconn" "github.com/jackc/pgx/v5/pgtype" (and $decimal "github.com/shopspring/decimal") (and $money "github.com/bojanz/currency")}}
// In optional columns, the empty value of a Go type stands for NULL: an
// empty string, a zero time. Numbers and booleans are always stored, since
// their zero is a value.

// Text is s, NULL when empty.
func Text(s string) pgtype.Text { return pgtype.Text{String: s, Valid: s != ""} }

// Int4 is n.
func Int4(n int) pgtype.Int4 { return pgtype.Int4{Int32: int32(n), Valid: true} }

// Int8 is n.
func Int8(n int64) pgtype.Int8 { return pgtype.Int8{Int64: n, Valid: true} }

// Bool is b.
func Bool(b bool) pgtype.Bool { return pgtype.Bool{Bool: b, Valid: true} }

// Timestamptz is t, NULL when zero.
func Timestamptz(t time.Time) pgtype.Timestamptz { return pgtype.Timestamptz{Time: t, Valid: !t.IsZero()} }

// Date is the day of t, NULL when zero.
func Date(t time.Time) pgtype.Date { return pgtype.Date{Time: t, Valid: !t.IsZero()} }

// UUID is u, NULL when it is the nil UUID.
func UUID(u uuid.UUID) pgtype.UUID { return pgtype.UUID{Bytes: u, Valid: u != uuid.Nil()} }

// UUIDs is ids as a query takes them.
func UUIDs(ids []uuid.UUID) []pgtype.UUID {
	out := make([]pgtype.UUID, len(ids))
	for i, id := range ids {
		out[i] = UUID(id)
	}
	return out
}

// ID is the UUID u holds, the nil UUID when NULL.
func ID(u pgtype.UUID) uuid.UUID {
	if !u.Valid {
		return uuid.Nil()
	}
	return u.Bytes
}
{{- if $decimal}}

// Numeric is d.
func Numeric(d decimal.Decimal) pgtype.Numeric {
	var n pgtype.Numeric
	if err := n.Scan(d.String()); err != nil {
		return pgtype.Numeric{}
	}
	return n
}

// Decimal is n, zero when NULL.
func Decimal(n pgtype.Numeric) decimal.Decimal {
	v, err := n.Value()
	if err != nil {
		return decimal.Zero
	}
	s, ok := v.(string)
	if !ok {
		return decimal.Zero
	}
	d, err := decimal.NewFromString(s)
	if err != nil {
		return decimal.Zero
	}
	return d
}
{{- end}}

// Violation tells which constraint err broke and how ("unique" or
// "foreign_key"); ok is false for any other error.
func Violation(err error) (constraint, kind string, ok bool) {
	pg, isPg := errors.AsType[*pgconn.PgError](err)
	if !isPg {
		return "", "", false
	}
	switch pg.Code {
	case "23505":
		return pg.ConstraintName, "unique", true
	case "23503":
		return pg.ConstraintName, "foreign_key", true
	}
	return "", "", false
}
{{- if $money}}

// MoneyAmount is the number of a, as its amount column takes it: NULL when
// a has no currency (an empty money field).
func MoneyAmount(a currency.Amount) pgtype.Numeric {
	if a.CurrencyCode() == "" {
		return pgtype.Numeric{}
	}
	var n pgtype.Numeric
	if err := n.Scan(a.Number()); err != nil {
		return pgtype.Numeric{}
	}
	return n
}

// Money is the amount its two columns hold, exactly: the zero Amount (no
// currency) when they are NULL.
func Money(n pgtype.Numeric, code string) currency.Amount {
	v, err := n.Value()
	if err != nil {
		return currency.Amount{}
	}
	s, ok := v.(string)
	if !ok || code == "" {
		return currency.Amount{}
	}
	// numeric(19,4) answers 19.9000: the places it pads are not the amount's.
	if strings.Contains(s, ".") {
		s = strings.TrimRight(strings.TrimRight(s, "0"), ".")
	}
	a, err := currency.NewAmount(s, code)
	if err != nil {
		return currency.Amount{}
	}
	return a
}
{{- end}}
