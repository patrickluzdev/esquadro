func Test{{$e.Pascal}}Writes{{.Pascal}}WithIt(t *testing.T) {
	t.Parallel()
	ctx := context.Background()
	{{$r}} := {{$p}}.New({{$p}}.Deps{Pool: postgrestest.Fresh(t)})

	var linked []uuid.UUID
	for i := range 2 {
		x, err := {{$r}}.Create{{$T.Pascal}}(ctx, given{{$T.Pascal}}(t, {{$r}}, 10+i))
		if err != nil {
			t.Fatal(err)
		}
		linked = append(linked, x.ID)
	}
	count := func(id uuid.UUID) int {
		t.Helper()
		page, err := {{$r}}.List{{$e.Pascal}}{{.Pascal}}(ctx, id, uuid.Nil(), 10)
		if err != nil {
			t.Fatal(err)
		}
		return len(page.{{$T.Plural.Pascal}})
	}
	n := given{{$e.Pascal}}(t, {{$r}}, 1)
	n.{{(.IDs).Pascal}} = linked
	created, err := {{$r}}.Create{{$e.Pascal}}(ctx, n)
	if err != nil {
		t.Fatal(err)
	}
	if got := count(created.ID); got != 2 {
		t.Fatalf("created with %d {{.Snake}}, not 2", got)
	}
	n.{{(.IDs).Pascal}} = linked[1:]
	if _, err := {{$r}}.Update{{$e.Pascal}}(ctx, created.ID, 0, n); err != nil {
		t.Fatal(err)
	}
	if got := count(created.ID); got != 1 {
		t.Fatalf("updated to %d {{.Snake}}, not 1", got)
	}
	// Left out, they stay.
	n.{{(.IDs).Pascal}} = nil
	if _, err := {{$r}}.Update{{$e.Pascal}}(ctx, created.ID, 0, n); err != nil {
		t.Fatal(err)
	}
	if got := count(created.ID); got != 1 {
		t.Fatalf("left out, %d {{.Snake}} stayed, not 1", got)
	}
	// One that is no record: refused, and nothing changed.
	n.{{(.IDs).Pascal}} = []uuid.UUID{uuid.NewV7()}
	if _, err := {{$r}}.Update{{$e.Pascal}}(ctx, created.ID, 0, n); !errors.As(err, new(*{{$p}}.InvalidFields)) {
		t.Fatalf("an id that is no record: %v", err)
	}
	if got := count(created.ID); got != 1 {
		t.Fatalf("a refused change left %d {{.Snake}}, not 1", got)
	}
	n.{{(.IDs).Pascal}} = []uuid.UUID{}
	if _, err := {{$r}}.Update{{$e.Pascal}}(ctx, created.ID, 0, n); err != nil {
		t.Fatal(err)
	}
	if got := count(created.ID); got != 0 {
		t.Fatalf("emptied, %d {{.Snake}} stayed", got)
	}
}
