		t.Fatalf("patch: %+v, %v", patched, err)
	}
	keep := {{$p}}.{{$e.Pascal}}Changes{ {{- $f.Pascal}}: &created.{{$f.Pascal}}}
	if got, want := keep.Apply(patched), keep.Apply(created); !reflect.DeepEqual(got, want) {
