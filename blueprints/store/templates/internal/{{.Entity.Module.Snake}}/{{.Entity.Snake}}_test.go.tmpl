func TestAudit{{$e.Pascal}}(t *testing.T) {
	t.Parallel()
	ctx := audit.AsSystem(context.Background(), "test")
	pool := postgrestest.Fresh(t)
	{{$r}} := {{$p}}.New({{$p}}.Deps{Pool: pool})

	created, err := {{$r}}.Create{{$e.Pascal}}(ctx, given{{$e.Pascal}}(t, {{$r}}, 1))
	if err != nil {
		t.Fatal(err)
	}
	changed := given{{$e.Pascal}}(t, {{$r}}, 2)
	if _, err := {{$r}}.Update{{$e.Pascal}}(ctx, created.ID, 0, changed); err != nil {
		t.Fatal(err)
	}
	// The same values again: nothing changed, nothing kept.
	if _, err := {{$r}}.Update{{$e.Pascal}}(ctx, created.ID, 0, changed); err != nil {
		t.Fatal(err)
	}
	if err := {{$r}}.Delete{{$e.Pascal}}(ctx, created.ID, 0); err != nil {
		t.Fatal(err)
	}
	page, err := audit.List(ctx, pool, audit.Filter{Entity: {{quote $e.Plural.Snake}}, RecordID: created.ID}, 1, 10)
	if err != nil {
		t.Fatal(err)
	}
	var actions []string
	for _, c := range page.Items {
		actions = append(actions, c.Action)
		if c.Actor.Kind != "system" || c.Actor.Name != "test" {
			t.Fatalf("the change of %s by %+v", c.Action, c.Actor)
		}
	}
	if strings.Join(actions, ",") != "delete,update,create" {
		t.Fatalf("kept %v", actions)
	}
	if len(page.Items[1].Changes) == 0 {
		t.Fatal("an update kept no field")
	}
}
