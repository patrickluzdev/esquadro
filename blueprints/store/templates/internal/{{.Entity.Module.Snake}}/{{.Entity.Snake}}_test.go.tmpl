	wg.Wait()
	read, err := {{$r}}.Read{{$e.Pascal}}(ctx, created.ID)
	if errs[0] != nil || errs[1] != nil || err != nil || read.{{$f.Pascal}} != third.{{$f.Pascal}} || read.{{$g.Pascal}} != third.{{$g.Pascal}} {
		t.Fatalf("two at once: %+v, %v", read, errors.Join(append(errs, err)...))
