func TestCreate{{$e.Pascal}}RefusesBrokenRules(t *testing.T) {
	t.Parallel()
	{{$r}} := {{$p}}.New({{$p}}.Deps{Pool: postgrestest.Fresh(t)})

	_, err := {{$r}}.Create{{$e.Pascal}}(context.Background(), {{$p}}.New{{$e.Pascal}}{})
	if _, ok := errors.AsType[*{{$p}}.InvalidFields](err); !ok {
		t.Fatalf("creating an empty {{lower $e.Label}}: %v", err)
	}
}
