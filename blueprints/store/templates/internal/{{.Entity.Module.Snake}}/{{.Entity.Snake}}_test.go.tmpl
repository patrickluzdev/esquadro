		t.Fatalf("patching an old version: %v", err)
	}
	if _, err := {{$r}}.Patch{{$e.Pascal}}(ctx, uuid.NewV7(), 0, keep, nil); !errors.Is(err, {{$p}}.Err{{$e.Pascal}}NotFound) {
