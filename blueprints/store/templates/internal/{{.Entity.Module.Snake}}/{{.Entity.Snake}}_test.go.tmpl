	wg.Go(func() {
		_, errs[0] = {{$r}}.Patch{{$e.Pascal}}(ctx, created.ID, 0, {{$p}}.{{$e.Pascal}}Changes{ {{- $f.Pascal}}: &third.{{$f.Pascal}}}, nil)
	})
	wg.Go(func() {
