// TestRead{{$e.Pascal}} reads the {{lower $e.Label}} before anyone saved it: there is
// one, with its defaults, and always the same one.
func TestRead{{$e.Pascal}}(t *testing.T) {
	t.Parallel()
	ctx := context.Background()
	{{$r}} := {{$p}}.New({{$p}}.Deps{Pool: postgrestest.Fresh(t)})

	first, err := {{$r}}.Read{{$e.Pascal}}(ctx)
	if err != nil {
		t.Fatal(err)
	}
	if first.ID == uuid.Nil() || first.Version != 1 {
		t.Fatalf("read %+v", first)
	}
	again, err := {{$r}}.Read{{$e.Pascal}}(ctx)
	if err != nil || again.ID != first.ID || again.Version != first.Version {
		t.Fatalf("read again %+v, %v; first %+v", again, err, first)
	}
}

