	}
	if err := {{$r}}.Delete{{$e.Pascal}}(ctx, created.ID, created.Version); err != nil {
		t.Fatal(err)
	}
	trash, err := {{$r}}.ListDeleted{{$e.Plural.Pascal}}(ctx, 1, 10{{if ownerColumn .Entities $e}}, uuid.Nil(){{end}})
	if err != nil {
		t.Fatal(err)
	}
	if trash.Total != 1 || len(trash.{{$e.Plural.Pascal}}) != 1 || trash.{{$e.Plural.Pascal}}[0].ID != created.ID || trash.{{$e.Plural.Pascal}}[0].DeletedAt.IsZero() {
		t.Fatalf("the trash: %+v", trash)
	}
	if page, err := {{$r}}.List{{$e.Plural.Pascal}}(ctx, {{$p}}.{{$e.Pascal}}Query{Page: 1}); err != nil || page.Total != 0 {
		t.Fatalf("a list shows what is in the trash: %+v, %v", page, err)
	}
	restored, err := {{$r}}.Restore{{$e.Pascal}}(ctx, created.ID)
	if err != nil {
		t.Fatal(err)
	}
	if restored.Version <= created.Version {
		t.Fatalf("restoring is a change: version %d after %d", restored.Version, created.Version)
	}
	if _, err := {{$r}}.Read{{$e.Pascal}}(ctx, created.ID); err != nil {
		t.Fatalf("reading a restored {{lower $e.Label}}: %v", err)
	}
	if _, err := {{$r}}.Restore{{$e.Pascal}}(ctx, created.ID); !errors.Is(err, {{$p}}.Err{{$e.Pascal}}NotFound) {
		t.Fatalf("restoring one not in the trash: %v", err)
	}
	if err := {{$r}}.Purge{{$e.Pascal}}(ctx, created.ID); !errors.Is(err, {{$p}}.Err{{$e.Pascal}}NotFound) {
		t.Fatalf("purging one not in the trash: %v", err)
	}
	if err := {{$r}}.Delete{{$e.Pascal}}(ctx, created.ID, 0); err != nil {
		t.Fatal(err)
	}
	if err := {{$r}}.Purge{{$e.Pascal}}(ctx, created.ID); err != nil {
		t.Fatal(err)
	}
	if _, err := {{$r}}.Restore{{$e.Pascal}}(ctx, created.ID); !errors.Is(err, {{$p}}.Err{{$e.Pascal}}NotFound) {
		t.Fatalf("restoring one purged: %v", err)
	}
	if n, err := {{$r}}.PurgeDeleted{{$e.Plural.Pascal}}(ctx, time.Time{}); err != nil || n != 0 {
		t.Fatalf("emptying an empty trash: %d, %v", n, err)
	}
}
