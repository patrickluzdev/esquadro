{{- if uses "testcontainers" -}}
{{- $e := .Entity}}{{$m := $e.Module}}{{$p := $m.Snake}}{{$r := lower (slice $m.Camel 0 1)}}{{$ok := canSample $e -}}
package {{$p}}_test
{{- if not $ok}}

import "testing"

func Test{{$e.Pascal}}UseCases(t *testing.T) {
	t.Skip("esquadro cannot write a valid New{{$e.Pascal}}: a required field has a pattern, or a required relation needs such a record. " +
		"Write the tests of {{$e.Plural.Snake}} by hand.")
}
{{- else}}

{{importBlock "context" "errors" "testing" "uuid" (sampleImports $e) (printf "%s/internal/%s" .App.Module $p) (printf "%s/internal/platform/postgres" .App.Module) (printf "%s/internal/platform/postgres/postgrestest" .App.Module)}}
// given{{$e.Pascal}} returns a valid New{{$e.Pascal}}, creating the records it needs
// first; i tells records apart. Change the values freely: esquadro wrote
// them from the rules in the .esq file.
func given{{$e.Pascal}}(t *testing.T, {{if parents $e}}{{$r}}{{else}}_{{end}} *{{$p}}.{{$m.Pascal}}, i int) {{$p}}.New{{$e.Pascal}} {
	t.Helper()
{{- range parents $e}}
	{{.Camel}}, err := {{$r}}.Create{{.Target.Pascal}}(context.Background(), given{{.Target.Pascal}}(t, {{$r}}, i))
	if err != nil {
		t.Fatal(err)
	}
{{- end}}
	return {{$p}}.New{{$e.Pascal}}{
{{- range $e.Fields}}{{if not .Implicit}}{{$f := .}}{{with sample $f $p "i"}}
		{{$f.Pascal}}: {{.}},
{{- end}}{{end}}{{end}}
{{- range $e.Relations}}{{if and .OwnsForeignKey .Required}}
{{- if eq .Target.Module $m}}
		{{.Pascal}}ID: {{.Camel}}.ID,
{{- else}}
		{{.Pascal}}ID: uuid.NewV7(), // in another module: no foreign key
{{- end}}
{{- end}}{{end}}
	}
}

func TestCreateAndRead{{$e.Pascal}}(t *testing.T) {
	t.Parallel()
	ctx := context.Background()
	{{$r}} := {{$p}}.New({{$p}}.Deps{Pool: postgrestest.Fresh(t)})

	created, err := {{$r}}.Create{{$e.Pascal}}(ctx, given{{$e.Pascal}}(t, {{$r}}, 1))
	if err != nil {
		t.Fatal(err)
	}
	read, err := {{$r}}.Read{{$e.Pascal}}(ctx, created.ID)
	if err != nil {
		t.Fatal(err)
	}
	if read.ID != created.ID || read.ID == uuid.Nil() || !read.CreatedAt.Equal(created.CreatedAt) {
		t.Fatalf("read %+v, created %+v", read, created)
	}
}

func TestList{{$e.Plural.Pascal}}(t *testing.T) {
	t.Parallel()
	ctx := context.Background()
	{{$r}} := {{$p}}.New({{$p}}.Deps{Pool: postgrestest.Fresh(t)})

	var created []{{$p}}.{{$e.Pascal}}
	for i := range 3 {
		x, err := {{$r}}.Create{{$e.Pascal}}(ctx, given{{$e.Pascal}}(t, {{$r}}, i))
		if err != nil {
			t.Fatal(err)
		}
		created = append(created, x)
	}
	list := func(q {{$p}}.{{$e.Pascal}}Query) {{$p}}.{{$e.Pascal}}Page {
		t.Helper()
		page, err := {{$r}}.List{{$e.Plural.Pascal}}(ctx, q)
		if err != nil {
			t.Fatal(err)
		}
		return page
	}

	// The newest first, by default.
	if first := list({{$p}}.{{$e.Pascal}}Query{Limit: 1}); len(first.{{$e.Plural.Pascal}}) != 1 || first.{{$e.Plural.Pascal}}[0].ID != created[2].ID {
		t.Fatalf("the default order: %+v", first.{{$e.Plural.Pascal}})
	}

	// Every order, both ways, a page at a time by cursor: each one once.
	for _, sort := range {{$p}}.{{$e.Pascal}}Sorts {
		if sort == "relevance" {
			continue
		}
		seen := map[uuid.UUID]bool{}
		after := ""
		for {
			page := list({{$p}}.{{$e.Pascal}}Query{Sort: sort, Limit: 2, After: after})
			for _, listed := range page.{{$e.Plural.Pascal}} {
				if seen[listed.ID] {
					t.Fatalf("%s: %s listed twice", sort, listed.ID)
				}
				seen[listed.ID] = true
			}
			if page.Next == "" {
				break
			}
			after = page.Next
		}
		if len(seen) != len(created) {
			t.Fatalf("%s: listed %d of %d", sort, len(seen), len(created))
		}
	}

	// By page: numbered, with the total.
	if p1, p2 := list({{$p}}.{{$e.Pascal}}Query{Page: 1, PerPage: 2}), list({{$p}}.{{$e.Pascal}}Query{Page: 2, PerPage: 2}); len(p1.{{$e.Plural.Pascal}}) != 2 || len(p2.{{$e.Plural.Pascal}}) != 1 || p1.Total != 3 || p1.Next != "" {
		t.Fatalf("pages: %d and %d of %d", len(p1.{{$e.Plural.Pascal}}), len(p2.{{$e.Plural.Pascal}}), p1.Total)
	}

	// A cursor of another order is refused.
	ascending := list({{$p}}.{{$e.Pascal}}Query{Sort: "created_at", Limit: 1})
	if _, err := {{$r}}.List{{$e.Plural.Pascal}}(ctx, {{$p}}.{{$e.Pascal}}Query{After: ascending.Next}); !errors.Is(err, postgres.ErrBadCursor) {
		t.Fatalf("a cursor of another order: %v", err)
	}

	// By creation date.
	since := created[1].CreatedAt
	if page := list({{$p}}.{{$e.Pascal}}Query{Filter: {{$p}}.{{$e.Pascal}}Filter{CreatedAtMin: &since}, Limit: 10}); len(page.{{$e.Plural.Pascal}}) != 2 {
		t.Fatalf("created since the second: %d", len(page.{{$e.Plural.Pascal}}))
	}
{{- with ownerField .Entities $e}}

	// The owner's only, for security's owner rule.
	if page := list({{$p}}.{{$e.Pascal}}Query{Owner: created[0].{{.}}, Limit: 10}); len(page.{{$e.Plural.Pascal}}) != 1 || page.{{$e.Plural.Pascal}}[0].ID != created[0].ID {
		t.Fatalf("the owner's: %+v", page.{{$e.Plural.Pascal}})
	}
{{- end}}
{{- with searchField $e}}

	// A search finds the record its text came from.
	found := false
	for _, x := range list({{$p}}.{{$e.Pascal}}Query{Search: created[1].{{.}}, Limit: 10}).{{$e.Plural.Pascal}} {
		found = found || x.ID == created[1].ID
	}
	if created[1].{{.}} != "" && !found {
		t.Fatalf("a search of %q did not find it", created[1].{{.}})
	}
{{- end}}

	// Without pagination, past the limit: Next says there were more.
	if page := list({{$p}}.{{$e.Pascal}}Query{Limit: 2, Unpaged: true}); len(page.{{$e.Plural.Pascal}}) != 2 || page.Next == "" {
		t.Fatalf("unpaged past its limit: %d, next %q", len(page.{{$e.Plural.Pascal}}), page.Next)
	}
}

func TestUpdate{{$e.Pascal}}(t *testing.T) {
	t.Parallel()
	ctx := context.Background()
	{{$r}} := {{$p}}.New({{$p}}.Deps{Pool: postgrestest.Fresh(t)})

	created, err := {{$r}}.Create{{$e.Pascal}}(ctx, given{{$e.Pascal}}(t, {{$r}}, 1))
	if err != nil {
		t.Fatal(err)
	}
	updated, err := {{$r}}.Update{{$e.Pascal}}(ctx, created.ID, created.Version, given{{$e.Pascal}}(t, {{$r}}, 2))
	if err != nil {
		t.Fatal(err)
	}
	if updated.ID != created.ID || updated.UpdatedAt.Before(created.UpdatedAt) || updated.Version != created.Version+1 {
		t.Fatalf("updated %+v, created %+v", updated, created)
	}
	// The version it was read at no longer is its own: the change is refused.
	if _, err := {{$r}}.Update{{$e.Pascal}}(ctx, created.ID, created.Version, given{{$e.Pascal}}(t, {{$r}}, 4)); !errors.Is(err, {{$p}}.Err{{$e.Pascal}}Changed) {
		t.Fatalf("updating an old version: %v", err)
	}
	if err := {{$r}}.Delete{{$e.Pascal}}(ctx, created.ID, created.Version); !errors.Is(err, {{$p}}.Err{{$e.Pascal}}Changed) {
		t.Fatalf("deleting an old version: %v", err)
	}
	if _, err := {{$r}}.Update{{$e.Pascal}}(ctx, uuid.NewV7(), 0, given{{$e.Pascal}}(t, {{$r}}, 3)); !errors.Is(err, {{$p}}.Err{{$e.Pascal}}NotFound) {
		t.Fatalf("updating a missing {{lower $e.Label}}: %v", err)
	}
}

func TestDelete{{$e.Pascal}}(t *testing.T) {
	t.Parallel()
	ctx := context.Background()
	{{$r}} := {{$p}}.New({{$p}}.Deps{Pool: postgrestest.Fresh(t)})

	created, err := {{$r}}.Create{{$e.Pascal}}(ctx, given{{$e.Pascal}}(t, {{$r}}, 1))
	if err != nil {
		t.Fatal(err)
	}
	if err := {{$r}}.Delete{{$e.Pascal}}(ctx, created.ID, 0); err != nil {
		t.Fatal(err)
	}
	if _, err := {{$r}}.Read{{$e.Pascal}}(ctx, created.ID); !errors.Is(err, {{$p}}.Err{{$e.Pascal}}NotFound) {
		t.Fatalf("reading a deleted {{lower $e.Label}}: %v", err)
	}
	if err := {{$r}}.Delete{{$e.Pascal}}(ctx, created.ID, 0); !errors.Is(err, {{$p}}.Err{{$e.Pascal}}NotFound) {
		t.Fatalf("deleting twice: %v", err)
	}
}

func TestRead{{$e.Pascal}}ThatDoesNotExist(t *testing.T) {
	t.Parallel()
	{{$r}} := {{$p}}.New({{$p}}.Deps{Pool: postgrestest.Fresh(t)})

	for _, id := range []uuid.UUID{uuid.Nil(), uuid.NewV7()} {
		if _, err := {{$r}}.Read{{$e.Pascal}}(context.Background(), id); !errors.Is(err, {{$p}}.Err{{$e.Pascal}}NotFound) {
			t.Fatalf("Read{{$e.Pascal}}(%s): %v", id, err)
		}
	}
}
