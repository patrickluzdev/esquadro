package {{$m.Snake}}

{{importBlock "context" "errors" "uuid"}}
// Patch{{$e.Pascal}} changes only what changes sets of the {{lower $e.Label}} with the given
// id, once the whole {{lower $e.Label}} passes the rules declared for {{$e.Plural.Snake}}.
// With a version (not 0), only that version is changed: Err{{$e.Pascal}}Changed
// when someone changed it since. Without one, a change someone makes
// meanwhile is kept: changes apply to it again. guard, when not nil, sees
// each attempt and may adjust n or refuse it.
func ({{$r}} *{{$m.Pascal}}) Patch{{$e.Pascal}}(ctx context.Context, id uuid.UUID, version int, changes {{$e.Pascal}}Changes, guard func(stored {{$e.Pascal}}, n *New{{$e.Pascal}}) error) ({{$e.Pascal}}, error) {
	for attempt := 1; ; attempt++ {
		stored, err := {{$r}}.Read{{$e.Pascal}}(ctx, id)
		if err != nil {
			return {{$e.Pascal}}{}, err
		}
		if version > 0 && stored.Version != version {
			return {{$e.Pascal}}{}, Err{{$e.Pascal}}Changed
		}
		n := changes.Apply(stored)
		if guard != nil {
			if err := guard(stored, &n); err != nil {
				return {{$e.Pascal}}{}, err
			}
		}
		if changes.Empty() {
			return stored, nil
		}
		updated, err := {{$r}}.Update{{$e.Pascal}}(ctx, id, stored.Version, n)
		if errors.Is(err, Err{{$e.Pascal}}Changed) && version == 0 && attempt < 3 {
			continue
		}
		return updated, err
	}
}
