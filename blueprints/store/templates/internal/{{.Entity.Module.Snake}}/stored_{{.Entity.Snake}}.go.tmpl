{{- $e := .Entity}}{{$ws := writable $e}}{{$rs := refusals $e -}}
package {{$e.Module.Snake}}

{{importBlock "context" "errors" (and (needs $e "json") "encoding/json") "uuid" "github.com/jackc/pgx/v5" (printf "%s/internal/%s/sqlgen" .App.Module $e.Module.Snake) (printf "%s/internal/platform/postgres" .App.Module)}}
// {{$e.Camel}}Gone is why a change of the {{lower $e.Label}} id changed nothing: it
// does not exist (Err{{$e.Pascal}}NotFound), or its version is no longer the one
// asked for (Err{{$e.Pascal}}Changed).
func {{$e.Camel}}Gone(ctx context.Context, db sqlgen.DBTX, id uuid.UUID) error {
	_, err := sqlgen.New(db).Get{{$e.Pascal}}(ctx, postgres.UUID(id))
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return Err{{$e.Pascal}}NotFound
	case err != nil:
		return err
	}
	return Err{{$e.Pascal}}Changed
}

// {{$e.Camel}}Of is the {{lower $e.Label}} a stored row holds.
func {{$e.Camel}}Of(row sqlgen.{{sqlcModel $e (optionsOf "postgres")}}) {{$e.Pascal}} {
	return {{$e.Pascal}}{
{{- range $e.Fields}}
		{{.Pascal}}: {{sqlcOut . (printf "row.%s" (sqlcField .))}},
{{- end}}
{{- range $e.Relations}}{{if .OwnsForeignKey}}
		{{.Pascal}}ID: {{keyOut . (printf "row.%s" (keyField .))}},
{{- end}}{{end}}
	}
}
{{- if $ws}}

// create{{$e.Pascal}}Params are id and the values of n as the insert takes them.
func create{{$e.Pascal}}Params(id uuid.UUID, n New{{$e.Pascal}}) sqlgen.Create{{$e.Pascal}}Params {
	return sqlgen.Create{{$e.Pascal}}Params{
		ID: postgres.UUID(id),
{{- range $ws}}
		{{.GoParam}}: {{.In "n"}},
{{- end}}
	}
}
{{- end}}
{{- if $ws}}

// update{{$e.Pascal}}Params are the values of n as the update of id takes them.
func update{{$e.Pascal}}Params(id uuid.UUID, n New{{$e.Pascal}}) sqlgen.Update{{$e.Pascal}}Params {
	return sqlgen.Update{{$e.Pascal}}Params{
{{- range $ws}}
		{{.GoParam}}: {{.In "n"}},
{{- end}}
		ID: postgres.UUID(id),
	}
}
{{- end}}

{{- with fileFields $e}}

// {{$e.Camel}}Files keeps the files of the {{lower $e.Label}} id in step with it, in the
// transaction of ctx: the files it gains (after) are checked and attached,
// those it loses (before) released; a file refused is a field refused.
func ({{lower (slice $e.Module.Camel 0 1)}} *{{$e.Module.Pascal}}) {{$e.Camel}}Files(ctx context.Context, id uuid.UUID, before, after map[string]uuid.UUID) error {
	refused, err := {{lower (slice $e.Module.Camel 0 1)}}.Files.Sync(ctx, {{quote $e.Plural.Snake}}, id, before, after)
	if err != nil {
		return err
	}
	if len(refused) == 0 {
		return nil
	}
	invalid := &InvalidFields{}
	for _, field := range []string{ {{- range $i, $f := .}}{{if $i}}, {{end}}{{quote $f.Snake}}{{end -}} } {
		if code, ok := refused[field]; ok {
			invalid.Fields = append(invalid.Fields, FieldError{Field: field, Code: code})
		}
	}
	return invalid
}

// {{$e.Camel}}FileIDs are the ids of the files of a {{lower $e.Label}}, by field.
func {{$e.Camel}}FileIDs({{range $i, $f := .}}{{if $i}}, {{end}}{{$f.Camel}}{{end}} uuid.UUID) map[string]uuid.UUID {
	return map[string]uuid.UUID{ {{- range $i, $f := .}}{{if $i}}, {{end}}{{quote $f.Snake}}: {{$f.Camel}}{{end -}} }
}
{{- end}}

// {{$e.Camel}}Refusal turns a constraint of {{$e.Plural.Snake}} the database
// enforced into the field it concerns; other errors pass through.
func {{$e.Camel}}Refusal(err error) error {
{{- if $rs}}
	constraint, _, ok := postgres.Violation(err)
	if !ok {
		return err
	}
	switch constraint {
{{- range $rs}}
	case {{quote .Constraint}}:
		return &InvalidFields{Fields: []FieldError{ {Field: {{quote .Field}}, Code: {{quote .Code}}} }}
{{- end}}
	}
{{- end}}
	return err
}
