package {{$m.Snake}}

{{importBlock "context" "uuid" (printf "%s/internal/%s/sqlgen" .App.Module $m.Snake) (printf "%s/internal/platform/postgres" .App.Module)}}
// Delete{{$e.Pascal}} deletes the {{lower $e.Label}} with the given id, unless
// other records still point at it. With a version (not 0), only that
// version: Err{{$e.Pascal}}Changed when someone changed it since.
func ({{$r}} *{{$m.Pascal}}) Delete{{$e.Pascal}}(ctx context.Context, id uuid.UUID, version int) error {
	deleted, err := sqlgen.New(postgres.Querier(ctx, {{$r}}.Pool)).Delete{{$e.Pascal}}(ctx, sqlgen.Delete{{$e.Pascal}}Params{ID: postgres.UUID(id), IfVersion: postgres.Version(version)})
	if _, kind, ok := postgres.Violation(err); ok && kind == "foreign_key" {
		return Err{{$e.Pascal}}InUse
	}
	if err != nil {
		return err
	}
	if deleted == 0 {
		return {{$e.Camel}}Gone(ctx, postgres.Querier(ctx, {{$r}}.Pool), id)
	}
	return nil
}
