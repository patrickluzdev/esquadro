{{- $e := .Entity}}{{$m := $e.Module}}{{$r := lower (slice $m.Camel 0 1)}}{{$files := fileFields $e}}{{$audited := audited $e (optionsOf "audit")}}{{$rule := noticeRule $e}}{{$notice := false}}{{if $rule}}{{$notice = $rule.Has "delete"}}{{end}}{{$tx := true -}}
package {{$m.Snake}}
{{if softDeleted $e}}
{{importBlock "context" "time" "uuid" (printf "%s/internal/platform/postgres" .App.Module)}}
// Delete{{$e.Pascal}} puts the {{lower $e.Label}} with the given id in the trash, and
// with it the records that go with it (their relation cascades); unless
// other records still point at it. Restore{{$e.Pascal}} takes it out. With a
// version (not 0), only that version: Err{{$e.Pascal}}Changed when someone
// changed it since.
func ({{$r}} *{{$m.Pascal}}) Delete{{$e.Pascal}}(ctx context.Context, id uuid.UUID, version int) error {
	return postgres.InTx(ctx, {{$r}}.Pool, func(ctx context.Context) error {
		stored, err := {{$r}}.Read{{$e.Pascal}}(ctx, id)
		if err != nil {
			return err
		}
		rules := {{$e.Pascal}}Rules{}
		if err := rules.BeforeDelete(ctx, {{$r}}, stored); err != nil {
			return err
		}
		if err := trash{{$e.Pascal}}(ctx, postgres.Querier(ctx, {{$r}}.Pool), id, version, time.Now()); err != nil {
			return err
		}
		return rules.AfterDelete(ctx, {{$r}}, stored)
	})
}
{{- else}}

{{importBlock "context" (and $tx "errors") "uuid" (and $tx "github.com/jackc/pgx/v5") (printf "%s/internal/%s/sqlgen" .App.Module $m.Snake) (printf "%s/internal/platform/postgres" .App.Module)}}
// Delete{{$e.Pascal}} deletes the {{lower $e.Label}} with the given id, unless
// other records still point at it or the rules of {{$e.Snake}}_rules.go refuse. With a version (not 0), only that
// version: Err{{$e.Pascal}}Changed when someone changed it since.
func ({{$r}} *{{$m.Pascal}}) Delete{{$e.Pascal}}(ctx context.Context, id uuid.UUID, version int) error {
{{- if $tx}}
	// The record{{if $files}}, and then its files{{end}}{{if $audited}}, with the change kept{{end}}, together.
	return postgres.InTx(ctx, {{$r}}.Pool, func(ctx context.Context) error {
		q := sqlgen.New(postgres.Querier(ctx, {{$r}}.Pool))
		before, err := q.Get{{$e.Pascal}}(ctx, postgres.UUID(id))
		if errors.Is(err, pgx.ErrNoRows) {
			return Err{{$e.Pascal}}NotFound
		}
		if err != nil {
			return err
		}
		stored := {{$e.Camel}}Of(before)
		rules := {{$e.Pascal}}Rules{}
		if err := rules.BeforeDelete(ctx, {{$r}}, stored); err != nil {
			return err
		}
		deleted, err := q.Delete{{$e.Pascal}}(ctx, sqlgen.Delete{{$e.Pascal}}Params{ID: postgres.UUID(id), IfVersion: postgres.Version(version)})
		if _, kind, ok := postgres.Violation(err); ok && kind == "foreign_key" {
			return Err{{$e.Pascal}}InUse
		}
		if err != nil {
			return err
		}
		if deleted == 0 {
			return {{$e.Camel}}Gone(ctx, postgres.Querier(ctx, {{$r}}.Pool), id)
		}
{{- if $audited}}
		if err := {{$e.Camel}}Recorded(ctx, postgres.Querier(ctx, {{$r}}.Pool), "delete", id, &stored, nil); err != nil {
			return err
		}
{{- end}}
{{- if $notice}}
		if err := {{$e.Camel}}Noticed(ctx, postgres.Querier(ctx, {{$r}}.Pool), "delete", &stored, nil); err != nil {
			return err
		}
{{- end}}
{{- if $files}}
		if err := {{$r}}.{{$e.Camel}}Files(ctx, id, {{$e.Camel}}FileIDs({{range $i, $f := $files}}{{if $i}}, {{end}}stored.{{$f.Pascal}}{{end}}), nil); err != nil {
			return err
		}
{{- end}}
		return rules.AfterDelete(ctx, {{$r}}, stored)
	})
}
{{- else}}
	deleted, err := sqlgen.New(postgres.Querier(ctx, {{$r}}.Pool)).Delete{{$e.Pascal}}(ctx, sqlgen.Delete{{$e.Pascal}}Params{ID: postgres.UUID(id), IfVersion: postgres.Version(version)})
	if _, kind, ok := postgres.Violation(err); ok && kind == "foreign_key" {
		return Err{{$e.Pascal}}InUse
	}
	if err != nil {
		return err
	}
	if deleted == 0 {
		return {{$e.Camel}}Gone(ctx, postgres.Querier(ctx, {{$r}}.Pool), id)
	}
	return nil
}
{{- end}}
{{- end}}
