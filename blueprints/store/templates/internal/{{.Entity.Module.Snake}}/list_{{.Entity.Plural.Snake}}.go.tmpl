{{- $e := .Entity}}{{$m := $e.Module}}{{$r := lower (slice $m.Camel 0 1) -}}
package {{$m.Snake}}

{{importBlock "context" "uuid" (printf "%s/internal/%s/sqlgen" .App.Module $m.Snake) (printf "%s/internal/platform/postgres" .App.Module)}}
// Max{{$e.Pascal}}Page is the most {{$e.Plural.Snake}} a page holds.
const Max{{$e.Pascal}}Page = 100

// {{$e.Pascal}}Page is a page of {{$e.Plural.Snake}} in the order they were created
// (their IDs are UUID v7, which sort by time). Next is the cursor of the next
// page, the nil UUID on the last one.
type {{$e.Pascal}}Page struct {
	{{$e.Plural.Pascal}} []{{$e.Pascal}}
	Next uuid.UUID
}

// List{{$e.Plural.Pascal}} returns up to limit {{$e.Plural.Snake}} (at most
// Max{{$e.Pascal}}Page) created after the one whose id is after, or from the
// first when after is the nil UUID.
func ({{$r}} *{{$m.Pascal}}) List{{$e.Plural.Pascal}}(ctx context.Context, after uuid.UUID, limit int) ({{$e.Pascal}}Page, error) {
	limit = min(max(limit, 1), Max{{$e.Pascal}}Page)
	rows, err := sqlgen.New({{$r}}.Pool).List{{$e.Plural.Pascal}}(ctx, sqlgen.List{{$e.Plural.Pascal}}Params{
		After:    postgres.UUID(after),
		PageSize: int32(limit + 1),
	})
	if err != nil {
		return {{$e.Pascal}}Page{}, err
	}
	return {{$e.Camel}}PageOf(rows, limit), nil
}
{{- if ownerColumn .Entities $e}}

// List{{$e.Plural.Pascal}}OwnedBy is List{{$e.Plural.Pascal}} of the {{$e.Plural.Snake}} that belong to
// owner, for security's owner rule.
func ({{$r}} *{{$m.Pascal}}) List{{$e.Plural.Pascal}}OwnedBy(ctx context.Context, owner, after uuid.UUID, limit int) ({{$e.Pascal}}Page, error) {
	limit = min(max(limit, 1), Max{{$e.Pascal}}Page)
	rows, err := sqlgen.New({{$r}}.Pool).List{{$e.Plural.Pascal}}OwnedBy(ctx, sqlgen.List{{$e.Plural.Pascal}}OwnedByParams{
		OwnerID:  postgres.UUID(owner),
		After:    postgres.UUID(after),
		PageSize: int32(limit + 1),
	})
	if err != nil {
		return {{$e.Pascal}}Page{}, err
	}
	return {{$e.Camel}}PageOf(rows, limit), nil
}
{{- end}}

// {{$e.Camel}}PageOf is a page of up to limit rows, with the cursor of the
// next when there is one more.
func {{$e.Camel}}PageOf(rows []sqlgen.{{sqlcModel $e (optionsOf "postgres")}}, limit int) {{$e.Pascal}}Page {
	page := {{$e.Pascal}}Page{ {{$e.Plural.Pascal}}: make([]{{$e.Pascal}}, 0, min(len(rows), limit)) }
	for i, row := range rows {
		if i == limit {
			page.Next = page.{{$e.Plural.Pascal}}[limit-1].ID
			break
		}
		page.{{$e.Plural.Pascal}} = append(page.{{$e.Plural.Pascal}}, {{$e.Camel}}Of(row))
	}
	return page
}
