{{- $e := .Entity}}{{$m := $e.Module}}{{$ws := writable $e}}{{$r := lower (slice $m.Camel 0 1)}}{{$files := fileFields $e}}{{$audited := audited $e (optionsOf "audit")}}{{$rule := noticeRule $e}}{{$notice := false}}{{if $rule}}{{$notice = $rule.Has "update"}}{{end}}{{$links := idLinks $e}}{{$tx := true -}}
package {{$m.Snake}}

{{importBlock "context" "errors" (and (not (single $e)) "uuid") "github.com/jackc/pgx/v5" (printf "%s/internal/%s/sqlgen" .App.Module $m.Snake) (printf "%s/internal/platform/postgres" .App.Module)}}
{{- if single $e}}
// Update{{$e.Pascal}} replaces the {{lower $e.Label}} by n, with its defaults, once it
// passes the rules declared for it and those of {{$e.Snake}}_rules.go, in the
// same transaction. With a version (not 0), only that version is replaced:
// Err{{$e.Pascal}}Changed when someone changed it since.
func ({{$r}} *{{$m.Pascal}}) Update{{$e.Pascal}}(ctx context.Context, version int, n New{{$e.Pascal}}) ({{$e.Pascal}}, error) {
	id := {{$e.Camel}}ID
{{- else}}
// Update{{$e.Pascal}} replaces the {{lower $e.Label}} with the given id by n, with
// its defaults, once it passes the rules declared for {{$e.Plural.Snake}} and those
// of {{$e.Snake}}_rules.go, in the same transaction. With a
// version (not 0), only that version is replaced: Err{{$e.Pascal}}Changed when
// someone changed it since.
func ({{$r}} *{{$m.Pascal}}) Update{{$e.Pascal}}(ctx context.Context, id uuid.UUID, version int, n New{{$e.Pascal}}) ({{$e.Pascal}}, error) {
{{- end}}
	n = n.WithDefaults()
	if err := n.Validate(); err != nil {
		return {{$e.Pascal}}{}, err
	}
{{- if trashedParents $e}}
	if err := {{$e.Camel}}Parents(ctx, postgres.Querier(ctx, {{$r}}.Pool), n); err != nil {
		return {{$e.Pascal}}{}, err
	}
{{- end}}
{{- if $tx}}
	// The record{{if $files}} and its files (the files it had, then the new){{end}}{{if $audited}}, and the change kept{{end}}, together.
	var updated {{$e.Pascal}}
	err := postgres.InTx(ctx, {{$r}}.Pool, func(ctx context.Context) error {
		q := sqlgen.New(postgres.Querier(ctx, {{$r}}.Pool))
{{- if single $e}}
		before, err := ensure{{$e.Pascal}}(ctx, q)
{{- else}}
		before, err := q.Get{{$e.Pascal}}(ctx, postgres.UUID(id))
{{- end}}
		if errors.Is(err, pgx.ErrNoRows) {
			return Err{{$e.Pascal}}NotFound
		}
		if err != nil {
			return err
		}
		stored := {{$e.Camel}}Of(before)
		rules := {{$e.Pascal}}Rules{}
		if err := rules.BeforeUpdate(ctx, {{$r}}, stored, &n); err != nil {
			return err
		}
		// What the rules changed is checked again.
		if err := n.Validate(); err != nil {
			return err
		}
{{- if $ws}}
		params := update{{$e.Pascal}}Params(id, n)
		params.IfVersion = postgres.Version(version)
		row, err := q.Update{{$e.Pascal}}(ctx, params)
{{- else}}
		row, err := q.Update{{$e.Pascal}}(ctx, sqlgen.Update{{$e.Pascal}}Params{ID: postgres.UUID(id), IfVersion: postgres.Version(version)})
{{- end}}
		if errors.Is(err, pgx.ErrNoRows) {
			return {{$e.Camel}}Gone(ctx, postgres.Querier(ctx, {{$r}}.Pool), id)
		}
		if err != nil {
			return {{$e.Camel}}Refusal(err)
		}
		updated = {{$e.Camel}}Of(row)
{{- if countedBy $e}}
		if err := {{$e.Camel}}Counted(ctx, postgres.Querier(ctx, {{$r}}.Pool), &stored, &updated); err != nil {
			return err
		}
{{- end}}
{{- if $links}}
		if err := {{$e.Camel}}Links(ctx, postgres.Querier(ctx, {{$r}}.Pool), id, n); err != nil {
			return err
		}
{{- end}}
{{- if $audited}}
		if err := {{$e.Camel}}Recorded(ctx, postgres.Querier(ctx, {{$r}}.Pool), "update", id, &stored, &updated); err != nil {
			return err
		}
{{- end}}
{{- if $notice}}
		if err := {{$e.Camel}}Noticed(ctx, postgres.Querier(ctx, {{$r}}.Pool), "update", &stored, &updated); err != nil {
			return err
		}
{{- end}}
{{- if $files}}
		if err := {{$r}}.{{$e.Camel}}Files(ctx, id, {{$e.Camel}}FileIDs({{range $i, $f := $files}}{{if $i}}, {{end}}stored.{{$f.Pascal}}{{end}}), {{$e.Camel}}FileIDs({{range $i, $f := $files}}{{if $i}}, {{end}}n.{{$f.Pascal}}{{end}})); err != nil {
			return err
		}
{{- end}}
		return rules.AfterUpdate(ctx, {{$r}}, stored, updated)
	})
	if err != nil {
		return {{$e.Pascal}}{}, err
	}
	return updated, nil
}
{{- else}}
{{- if $ws}}
	params := update{{$e.Pascal}}Params(id, n)
	params.IfVersion = postgres.Version(version)
	row, err := sqlgen.New(postgres.Querier(ctx, {{$r}}.Pool)).Update{{$e.Pascal}}(ctx, params)
{{- else}}
	row, err := sqlgen.New(postgres.Querier(ctx, {{$r}}.Pool)).Update{{$e.Pascal}}(ctx, sqlgen.Update{{$e.Pascal}}Params{ID: postgres.UUID(id), IfVersion: postgres.Version(version)})
{{- end}}
	if errors.Is(err, pgx.ErrNoRows) {
		return {{$e.Pascal}}{}, {{$e.Camel}}Gone(ctx, postgres.Querier(ctx, {{$r}}.Pool), id)
	}
	if err != nil {
		return {{$e.Pascal}}{}, {{$e.Camel}}Refusal(err)
	}
	return {{$e.Camel}}Of(row), nil
}
{{- end}}
