{{- $e := .Entity}}{{$m := $e.Module}}{{$ws := writable $e}}{{$r := lower (slice $m.Camel 0 1)}}{{$files := fileFields $e}}{{$audited := audited $e (optionsOf "audit")}}{{$links := idLinks $e}}{{$tx := or $files $audited $links -}}
package {{$m.Snake}}

{{importBlock "context" "errors" "uuid" "github.com/jackc/pgx/v5" (printf "%s/internal/%s/sqlgen" .App.Module $m.Snake) (printf "%s/internal/platform/postgres" .App.Module)}}
// Update{{$e.Pascal}} replaces the {{lower $e.Label}} with the given id by n, with
// its defaults, once it passes the rules declared for {{$e.Plural.Snake}}. With a
// version (not 0), only that version is replaced: Err{{$e.Pascal}}Changed when
// someone changed it since.
func ({{$r}} *{{$m.Pascal}}) Update{{$e.Pascal}}(ctx context.Context, id uuid.UUID, version int, n New{{$e.Pascal}}) ({{$e.Pascal}}, error) {
	n = n.WithDefaults()
	if err := n.Validate(); err != nil {
		return {{$e.Pascal}}{}, err
	}
{{- if trashedParents $e}}
	if err := {{$e.Camel}}Parents(ctx, postgres.Querier(ctx, {{$r}}.Pool), n); err != nil {
		return {{$e.Pascal}}{}, err
	}
{{- end}}
{{- if $tx}}
	// The record{{if $files}} and its files (the files it had, then the new){{end}}{{if $audited}}, and the change kept{{end}}, together.
	var updated {{$e.Pascal}}
	err := postgres.InTx(ctx, {{$r}}.Pool, func(ctx context.Context) error {
		q := sqlgen.New(postgres.Querier(ctx, {{$r}}.Pool))
		before, err := q.Get{{$e.Pascal}}(ctx, postgres.UUID(id))
		if errors.Is(err, pgx.ErrNoRows) {
			return Err{{$e.Pascal}}NotFound
		}
		if err != nil {
			return err
		}
		stored := {{$e.Camel}}Of(before)
{{- if $ws}}
		params := update{{$e.Pascal}}Params(id, n)
		params.IfVersion = postgres.Version(version)
		row, err := q.Update{{$e.Pascal}}(ctx, params)
{{- else}}
		row, err := q.Update{{$e.Pascal}}(ctx, sqlgen.Update{{$e.Pascal}}Params{ID: postgres.UUID(id), IfVersion: postgres.Version(version)})
{{- end}}
		if errors.Is(err, pgx.ErrNoRows) {
			return {{$e.Camel}}Gone(ctx, postgres.Querier(ctx, {{$r}}.Pool), id)
		}
		if err != nil {
			return {{$e.Camel}}Refusal(err)
		}
		updated = {{$e.Camel}}Of(row)
{{- if $links}}
		if err := {{$e.Camel}}Links(ctx, postgres.Querier(ctx, {{$r}}.Pool), id, n); err != nil {
			return err
		}
{{- end}}
{{- if $audited}}
		if err := {{$e.Camel}}Recorded(ctx, postgres.Querier(ctx, {{$r}}.Pool), "update", id, &stored, &updated); err != nil {
			return err
		}
{{- end}}
{{- if $files}}
		return {{$r}}.{{$e.Camel}}Files(ctx, id, {{$e.Camel}}FileIDs({{range $i, $f := $files}}{{if $i}}, {{end}}stored.{{$f.Pascal}}{{end}}), {{$e.Camel}}FileIDs({{range $i, $f := $files}}{{if $i}}, {{end}}n.{{$f.Pascal}}{{end}}))
{{- else}}
		_ = stored
		return nil
{{- end}}
	})
	if err != nil {
		return {{$e.Pascal}}{}, err
	}
	return updated, nil
}
{{- else}}
{{- if $ws}}
	params := update{{$e.Pascal}}Params(id, n)
	params.IfVersion = postgres.Version(version)
	row, err := sqlgen.New(postgres.Querier(ctx, {{$r}}.Pool)).Update{{$e.Pascal}}(ctx, params)
{{- else}}
	row, err := sqlgen.New(postgres.Querier(ctx, {{$r}}.Pool)).Update{{$e.Pascal}}(ctx, sqlgen.Update{{$e.Pascal}}Params{ID: postgres.UUID(id), IfVersion: postgres.Version(version)})
{{- end}}
	if errors.Is(err, pgx.ErrNoRows) {
		return {{$e.Pascal}}{}, {{$e.Camel}}Gone(ctx, postgres.Querier(ctx, {{$r}}.Pool), id)
	}
	if err != nil {
		return {{$e.Pascal}}{}, {{$e.Camel}}Refusal(err)
	}
	return {{$e.Camel}}Of(row), nil
}
{{- end}}
