// countedIDs are the records before and after point at through parent,
// each once, but none: those whose totals a change moves.
func countedIDs[T any](before, after *T, parent func(*T) uuid.UUID) []uuid.UUID {
	var out []uuid.UUID
	for _, x := range []*T{before, after} {
		if x == nil {
			continue
		}
		if id := parent(x); id != uuid.Nil() && !slices.Contains(out, id) {
			out = append(out, id)
		}
	}
	return out
}
