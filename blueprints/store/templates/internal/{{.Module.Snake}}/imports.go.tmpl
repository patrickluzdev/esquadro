func (e *ImportRefused) Error() string {
	return fmt.Sprintf("{{.Module.Snake}}: import refused: %d rows", len(e.Rows))
}

// rowError is why a row was refused, when it is about the row (its fields,
// a rule it breaks), not about the whole import.
func rowError(row int, err error) (RowError, bool) {
	if invalid, ok := errors.AsType[*InvalidFields](err); ok {
		return RowError{Row: row, Fields: invalid.Fields}, true
	}
	if broken, ok := errors.AsType[*RuleError](err); ok {
		fields := make([]FieldError, 0, len(broken.Fields))
		for _, f := range broken.Fields {
			fields = append(fields, FieldError{Field: f, Code: broken.Code})
		}
		if len(fields) == 0 {
			fields = append(fields, FieldError{Field: "", Code: broken.Code})
		}
		return RowError{Row: row, Fields: fields}, true
	}
	return RowError{}, false
}
