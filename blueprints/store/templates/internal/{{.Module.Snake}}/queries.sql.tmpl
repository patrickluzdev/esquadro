{{- if .Module.Entities -}}
-- Generated by esquadro: the queries of the {{.Module.Snake}} module, for sqlc.
{{- range .Module.Entities}}{{$e := .}}{{$t := pgTable $e (optionsOf "postgres")}}{{$ws := writable $e}}{{$soft := softDeleted $e}}{{$live := ""}}{{if $soft}}{{$live = " AND deleted_at IS NULL"}}{{end}}

-- name: Create{{$e.Pascal}} :one
INSERT INTO {{$t}} (id{{range $ws}}, {{.Column}}{{end}})
VALUES (@id{{range $ws}}, @{{.Param}}{{end}})
RETURNING *;

-- name: Get{{$e.Pascal}} :one
SELECT * FROM {{$t}} WHERE id = @id{{$live}};
{{- if single $e}}

-- name: Ensure{{$e.Pascal}} :exec
INSERT INTO {{$t}} (id) VALUES (@id) ON CONFLICT (id) DO NOTHING;
{{- end}}

-- name: Get{{$e.Plural.Pascal}}ByIDs :many
SELECT * FROM {{$t}} WHERE id = ANY(@ids::uuid[]){{$live}};

{{- $where := listWhere $.Entities $e (optionsOf "postgres") $.Options.search_language}}
{{- range listSorts $e (optionsOf "postgres")}}{{$s := .}}
{{- range $dir := list "Asc" "Desc"}}

-- name: List{{$e.Plural.Pascal}}By{{$s.Pascal}}{{$dir}} :many
SELECT * FROM {{$t}}
{{$where}}
  AND (sqlc.narg(after_id)::uuid IS NULL OR ({{$s.Column}}, id) {{if eq $dir "Asc"}}>{{else}}<{{end}} (sqlc.narg(after_value)::text::{{$s.Cast}}, sqlc.narg(after_id)::uuid))
ORDER BY {{$s.Column}}{{if eq $dir "Desc"}} DESC{{end}}, id{{if eq $dir "Desc"}} DESC{{end}}
LIMIT sqlc.arg(page_size) OFFSET sqlc.arg(skip);
{{- end}}
{{- end}}
{{- if searchFields $e}}

-- name: List{{$e.Plural.Pascal}}ByRelevance :many
SELECT sqlc.embed(x), {{rank $.Options.search_language}} AS rank
FROM {{$t}} x
{{$where}}
  AND (sqlc.narg(after_id)::uuid IS NULL OR ({{rank $.Options.search_language}}, id) < (sqlc.narg(after_value)::text::real, sqlc.narg(after_id)::uuid))
ORDER BY rank DESC, id DESC
LIMIT sqlc.arg(page_size) OFFSET sqlc.arg(skip);
{{- end}}

-- name: Count{{$e.Plural.Pascal}} :one
SELECT count(*) FROM {{$t}}
{{$where}};

-- name: Update{{$e.Pascal}} :one
UPDATE {{$t}}
SET {{range $ws}}{{.Column}} = @{{.Param}}, {{end}}version = version + 1, updated_at = now()
WHERE id = @id{{$live}} AND (sqlc.narg(if_version)::integer IS NULL OR version = sqlc.narg(if_version)::integer)
RETURNING *;

-- name: Touch{{$e.Pascal}} :execrows
UPDATE {{$t}}
SET version = version + 1, updated_at = now()
WHERE id = @id{{$live}} AND (sqlc.narg(if_version)::integer IS NULL OR version = sqlc.narg(if_version)::integer);

{{- if $soft}}{{$own := ownerColumn $.Entities $e}}

-- name: Live{{$e.Pascal}} :one
SELECT EXISTS (SELECT 1 FROM {{$t}} WHERE id = @id AND deleted_at IS NULL);

-- name: Trash{{$e.Pascal}} :execrows
UPDATE {{$t}}
SET deleted_at = @deleted_at::timestamptz, version = version + 1, updated_at = now()
WHERE id = @id AND deleted_at IS NULL AND (sqlc.narg(if_version)::integer IS NULL OR version = sqlc.narg(if_version)::integer);

-- name: Restore{{$e.Pascal}} :one
UPDATE {{$t}}
SET deleted_at = NULL, version = version + 1, updated_at = now()
WHERE id = @id AND deleted_at IS NOT NULL
RETURNING *;

-- name: GetDeleted{{$e.Pascal}} :one
SELECT * FROM {{$t}} WHERE id = @id AND deleted_at IS NOT NULL;

-- name: ListDeleted{{$e.Plural.Pascal}} :many
SELECT * FROM {{$t}}
WHERE deleted_at IS NOT NULL{{if $own}} AND (sqlc.narg(owner_id)::uuid IS NULL OR {{$own}} = sqlc.narg(owner_id)::uuid){{end}}
ORDER BY deleted_at DESC, id DESC
LIMIT sqlc.arg(page_size) OFFSET sqlc.arg(skip);

-- name: CountDeleted{{$e.Plural.Pascal}} :one
SELECT count(*) FROM {{$t}}
WHERE deleted_at IS NOT NULL{{if $own}} AND (sqlc.narg(owner_id)::uuid IS NULL OR {{$own}} = sqlc.narg(owner_id)::uuid){{end}};

-- name: Purge{{$e.Pascal}} :execrows
DELETE FROM {{$t}} WHERE id = @id AND deleted_at IS NOT NULL;

-- name: CountDeletedBefore{{$e.Plural.Pascal}} :one
SELECT count(*) FROM {{$t}} WHERE deleted_at < @before::timestamptz;

-- name: DeletedBefore{{$e.Plural.Pascal}} :many
SELECT id FROM {{$t}} WHERE deleted_at < @before::timestamptz
ORDER BY deleted_at, id
LIMIT sqlc.arg(page_size);
{{- range dependents $e}}{{$ct := pgTable .Relation.Entity (optionsOf "postgres")}}

-- name: Has{{.Name}} :one
SELECT EXISTS (SELECT 1 FROM {{$ct}} WHERE {{.Column}} = @id{{if .Soft}} AND deleted_at IS NULL{{end}});
{{- if .Soft}}

-- name: Live{{.Name}} :many
SELECT id FROM {{$ct}} WHERE {{.Column}} = @id AND deleted_at IS NULL;

-- name: Trashed{{.Name}} :many
SELECT id FROM {{$ct}} WHERE {{.Column}} = @id AND deleted_at = @deleted_at::timestamptz;
{{- end}}
{{- end}}
{{- else}}

-- name: Delete{{$e.Pascal}} :execrows
DELETE FROM {{$t}} WHERE id = @id AND (sqlc.narg(if_version)::integer IS NULL OR version = sqlc.narg(if_version)::integer);
{{- end}}
{{- range links $e}}{{$l := link . (optionsOf "postgres")}}
{{- if $l.Declared}}

-- name: AddTo{{$e.Pascal}}{{.Pascal}} :exec
INSERT INTO {{$l.Table}} ({{$l.Own}}, {{$l.Other}})
VALUES (@own_id, @other_id)
ON CONFLICT DO NOTHING;

-- name: RemoveFrom{{$e.Pascal}}{{.Pascal}} :exec
DELETE FROM {{$l.Table}} WHERE {{$l.Own}} = @own_id AND {{$l.Other}} = @other_id;

-- name: Unlink{{$e.Pascal}}{{.Pascal}}Except :exec
DELETE FROM {{$l.Table}} WHERE {{$l.Own}} = @own_id AND NOT ({{$l.Other}} = ANY(@keep::uuid[]));

-- name: Link{{$e.Pascal}}{{.Pascal}}All :exec
INSERT INTO {{$l.Table}} ({{$l.Own}}, {{$l.Other}})
SELECT @own_id, unnest(@other_ids::uuid[])
ON CONFLICT DO NOTHING;

-- name: List{{$e.Pascal}}{{.Pascal}}Of :many
SELECT own_id, other_id FROM (
  SELECT {{$l.Own}} AS own_id, {{$l.Other}} AS other_id,
    row_number() OVER (PARTITION BY {{$l.Own}} ORDER BY {{$l.Other}}) AS n
  FROM {{$l.Table}}
  WHERE {{$l.Own}} = ANY(@own_ids::uuid[]){{if and (not .CrossesModules) (softDeleted .Target)}}
    AND {{$l.Other}} IN (SELECT id FROM {{pgTable .Target (optionsOf "postgres")}} WHERE deleted_at IS NULL){{end}}
) linked
WHERE n <= sqlc.arg(per_own)::bigint
ORDER BY own_id, other_id;
{{- end}}

-- name: List{{$e.Pascal}}{{.Pascal}} :many
{{- if .CrossesModules}}
SELECT {{$l.Other}} FROM {{$l.Table}}
WHERE {{$l.Own}} = @own_id
  AND (sqlc.narg(after)::uuid IS NULL OR {{$l.Other}} > sqlc.narg(after)::uuid)
ORDER BY {{$l.Other}}
LIMIT sqlc.arg(page_size);
{{- else}}
SELECT sqlc.embed(target) FROM {{pgTable .Target (optionsOf "postgres")}} target
JOIN {{$l.Table}} link ON link.{{$l.Other}} = target.id
WHERE link.{{$l.Own}} = @own_id{{if softDeleted .Target}} AND target.deleted_at IS NULL{{end}}
  AND (sqlc.narg(after)::uuid IS NULL OR target.id > sqlc.narg(after)::uuid)
ORDER BY target.id
LIMIT sqlc.arg(page_size);
{{- end}}
{{- end}}
{{- end}}
{{end -}}
