/// Storage in PostgreSQL: each module's queries, written for sqlc from the
/// model and generated into internal/<module>/sqlgen, and each entity's use
/// cases (create, read, list, update, delete, and adding to and removing
/// from many-to-many relations) as methods of its module. With
/// testcontainers, each use case gets tests against a real Postgres.
blueprint store {
  version "0.1.0"
  requires domain, postgres, migrations
  optional testcontainers, jobs

  hook post-gen "sqlc" writes "internal/*/sqlgen/**"

  /// The language of the search column, as PostgreSQL's text search names
  /// it: simple (words as written), portuguese, english, spanish...; it
  /// decides how words are reduced to their root.
  option search_language name default(simple)

  /// How many days a record stays in the trash before it is deleted for
  /// good (entities with @store(soft_delete)); 0 keeps it there.
  option purge_days int default(30)

  annotation entity {
    /// Deleting a record puts it in the trash (deleted_at), from which it
    /// may be restored or deleted for good; reads and lists leave it out.
    soft_delete bool
    /// One record only, which always exists, with its defaults until
    /// someone changes it: read and changed, never listed, created or
    /// deleted (settings the team tunes without a deploy).
    single bool
    /// Records may be imported in a batch (a CSV in the admin panel): all
    /// or none, each through the rules of a create.
    import bool
    /// Imported by this field, unique and required: a row with the value
    /// of a record updates it, others are created (import_by external_id).
    import_by name
  }
  annotation field {
    /// Lists may filter by it: by value, by range (numbers and dates), or
    /// by a list of values (enums).
    filter bool
    /// Lists may be ordered by it; only a required field, so that pages
    /// keep every record.
    sort bool
    /// Lists may search its text (q).
    search bool
  }
  annotation relation {
    /// Lists may filter by the related record's id.
    filter bool
  }
}
