// failing answers status the first n times, then 200 with {"ok":true}.
func failing(n int32, status int, header ...string) http.HandlerFunc {
	var calls atomic.Int32
	return func(w http.ResponseWriter, _ *http.Request) {
		if calls.Add(1) <= n {
			for i := 0; i+1 < len(header); i += 2 {
				w.Header().Set(header[i], header[i+1])
			}
			w.WriteHeader(status)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write([]byte(`{"ok":true}`))
	}
}

func Test{{pascalOf $n}}TriesAgain(t *testing.T) {
	if {{$n}}.Retries == 0 {
		t.Skip("retries 0: a call is tried once")
	}
	ctx := context.Background()
	var out struct{ OK bool }

	// A GET the API failed for a moment: tried again.
	c, s := {{$n}}test.New(t, failing(1, http.StatusServiceUnavailable))
	if err := c.JSON(ctx, http.MethodGet, "/things", nil, &out); err != nil || !out.OK || len(s.Requests()) != 2 {
		t.Fatalf("a GET after a 503: %v, %d requests", err, len(s.Requests()))
	}
	// A POST the API did not take (429, Retry-After): tried again.
	c, s = {{$n}}test.New(t, failing(1, http.StatusTooManyRequests, "Retry-After", "1"))
	if err := c.JSON(ctx, http.MethodPost, "/things", map[string]int{"n": 1}, nil); err != nil || len(s.Requests()) != 2 || string(s.Requests()[1].Body) != `{"n":1}` {
		t.Fatalf("a POST after a 429: %v, %+v", err, s.Requests())
	}
	// A POST the API may have taken (502): not again, unless it may be.
	c, s = {{$n}}test.New(t, failing(1, http.StatusBadGateway))
	err := c.JSON(ctx, http.MethodPost, "/things", nil, nil)
	if apiErr, ok := errors.AsType[*{{$n}}.Error](err); !ok || apiErr.Status != http.StatusBadGateway || len(s.Requests()) != 1 {
		t.Fatalf("a POST after a 502: %v, %d requests", err, len(s.Requests()))
	}
	c, s = {{$n}}test.New(t, failing(1, http.StatusBadGateway))
	if err := c.JSON(ctx, http.MethodPost, "/things", nil, nil, {{$n}}.Retry); err != nil || len(s.Requests()) != 2 {
		t.Fatalf("a POST that may be repeated, after a 502: %v, %d requests", err, len(s.Requests()))
	}
	// Failing every time: tried Retries more times, then the API's answer.
	c, s = {{$n}}test.New(t, failing(100, http.StatusServiceUnavailable))
	err = c.JSON(ctx, http.MethodGet, "/things", nil, nil)
	if apiErr, ok := errors.AsType[*{{$n}}.Error](err); !ok || apiErr.Status != http.StatusServiceUnavailable || len(s.Requests()) != {{$n}}.Retries+1 {
		t.Fatalf("failing every time: %v, %d requests", err, len(s.Requests()))
	}
}

