{{- $n := .Instance.Name}}{{$o := .Instance.Options}}{{$obs := uses "observability" -}}
// Generated by esquadro: do not edit. {{$n}}.go, yours, says how a request is
// authenticated and has the API's calls.

// Package {{$n}} is the client of the {{$n}} API ({{$o.url}}): retries
// with backoff that respect Retry-After, a rate limit, a timeout, and the
// secrets kept out of errors.
package {{$n}}

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"math/rand/v2"
	"net/http"
	"net/url"
	"strconv"
	"strings"
	"sync"
	"time"
{{- if $obs}}

	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
{{- end}}
)

// Config is how the client reaches the API: its address and secrets, from
// {{integrationEnv $n "URL"}}{{if $o.key}}, {{integrationEnv $n "KEY"}}{{end}}{{if $o.secret}}, {{integrationEnv $n "SECRET"}}{{end}}.
type Config struct {
	URL string
	Secrets
}

// Secrets are what the API knows the app by. They never show in errors.
type Secrets struct {
	Key, Secret string
}

// Retries, Timeout and Rate are as the blueprint's options say; tests may
// change them.
var (
	// Retries is how many more times a call is tried when the API fails
	// for a moment.
	Retries = {{$o.retries}}
	// Timeout is how long a call may take, its tries included.
	Timeout = {{durationOf $o.timeout}}
)

// Client calls the {{$n}} API.
type Client struct {
	base    *url.URL
	secrets Secrets
	http    *http.Client
	limit   *limiter
	// Wait is how a retry waits: a test makes it instant.
	Wait func(ctx context.Context, d time.Duration) error
}

// New returns a client of the API at cfg.URL.
func New(cfg Config) (*Client, error) {
	base, err := url.Parse(strings.TrimSuffix(cfg.URL, "/"))
	if err != nil || (base.Scheme != "http" && base.Scheme != "https") || base.Host == "" {
		return nil, fmt.Errorf("{{$n}}: %s is not an http(s) address", "{{integrationEnv $n "URL"}}")
	}
	transport := http.DefaultTransport
{{- if $obs}}
	// A span for each call, and the client's metrics.
	transport = otelhttp.NewTransport(transport, otelhttp.WithSpanNameFormatter(func(_ string, r *http.Request) string {
		return "{{$n}} " + r.Method + " " + r.URL.Path
	}))
{{- end}}
	return &Client{
		base:    base,
		secrets: cfg.Secrets,
		http:    &http.Client{Transport: transport},
		limit:   newLimiter({{rateOf $o.rate_limit}}),
		Wait:    sleep,
	}, nil
}

// Error is an answer of the API that is not a success: its status and the
// beginning of its body, without the secrets.
type Error struct {
	Status int
	Body   string
}

func (e *Error) Error() string { return fmt.Sprintf("{{$n}}: %d %s: %s", e.Status, http.StatusText(e.Status), e.Body) }

// Option changes one call.
type Option func(*call)

type call struct{ retry bool }

// Retry lets a call that is not GET, HEAD, PUT or DELETE be tried again
// when the API fails: one that reads (a GraphQL query) or that the API
// takes once anyway (with an idempotency key).
func Retry(c *call) { c.retry = true }

// URL is the address of path on the API.
func (c *Client) URL(path string) *url.URL {
	u := *c.base
	u.Path = c.base.Path + "/" + strings.TrimPrefix(path, "/")
	return &u
}

// JSON sends in (when not nil) as JSON to path, and reads the answer into
// out (when not nil).
func (c *Client) JSON(ctx context.Context, method, path string, in, out any, opts ...Option) error {
	var body []byte
	if in != nil {
		var err error
		if body, err = json.Marshal(in); err != nil {
			return err
		}
	}
	req, err := http.NewRequestWithContext(ctx, method, c.URL(path).String(), nil)
	if err != nil {
		return err
	}
	if body != nil {
		req.Header.Set("Content-Type", "application/json")
	}
	req.Header.Set("Accept", "application/json")
	answer, err := c.Do(req, body, opts...)
	if err != nil {
		return err
	}
	if out == nil || len(answer) == 0 {
		return nil
	}
	if err := json.Unmarshal(answer, out); err != nil {
		return fmt.Errorf("{{$n}}: reading the answer of %s %s: %w", method, req.URL.Path, err)
	}
	return nil
}

// Do sends req with body, authenticated (Authenticate, in {{$n}}.go), and
// answers the body of a success; *Error for an answer that is not one. A
// failure for a moment (429, 502, 503, 504, a connection lost) is tried
// again, waiting longer each time or as Retry-After says, when the method
// may be repeated or the API says it did nothing (429, 503).
func (c *Client) Do(req *http.Request, body []byte, opts ...Option) ([]byte, error) {
	var o call
	for _, opt := range opts {
		opt(&o)
	}
	ctx, cancel := context.WithTimeout(req.Context(), Timeout)
	defer cancel()
	repeatable := o.retry || req.Method == http.MethodGet || req.Method == http.MethodHead || req.Method == http.MethodPut || req.Method == http.MethodDelete
	for try := 0; ; try++ {
		if err := c.limit.wait(ctx); err != nil {
			return nil, err
		}
		r := req.Clone(ctx)
		if body != nil {
			r.Body = io.NopCloser(bytes.NewReader(body))
			r.ContentLength = int64(len(body))
		}
		if err := Authenticate(r, c.secrets); err != nil {
			return nil, err
		}
		res, err := c.http.Do(r)
		if err != nil {
			if ctx.Err() == nil && repeatable && try < Retries {
				if err := c.Wait(ctx, backoff(try)); err != nil {
					return nil, c.hide(err)
				}
				continue
			}
			return nil, c.hide(err)
		}
		answer, err := io.ReadAll(io.LimitReader(res.Body, 32<<20))
		res.Body.Close()
		if err != nil {
			return nil, c.hide(err)
		}
		if res.StatusCode < 300 {
			return answer, nil
		}
		notDone := res.StatusCode == http.StatusTooManyRequests || res.StatusCode == http.StatusServiceUnavailable
		transient := notDone || res.StatusCode == http.StatusBadGateway || res.StatusCode == http.StatusGatewayTimeout
		if transient && (repeatable || notDone) && try < Retries {
			if err := c.Wait(ctx, retryAfter(res.Header.Get("Retry-After"), try)); err != nil {
				return nil, c.hide(err)
			}
			continue
		}
		text := string(answer)
		if len(text) > 500 {
			text = text[:500] + "…"
		}
		return nil, c.hide(&Error{Status: res.StatusCode, Body: text})
	}
}

// hide takes the secrets out of an error's text: a URL with a token in it,
// an answer that repeats what was sent.
func (c *Client) hide(err error) error {
	if err == nil {
		return nil
	}
	text := err.Error()
	clean := text
	for _, s := range []string{c.secrets.Key, c.secrets.Secret} {
		if len(s) >= 4 {
			clean = strings.ReplaceAll(clean, s, "[secret]")
		}
	}
	if clean == text {
		return err
	}
	var api *Error
	if errors.As(err, &api) {
		return &Error{Status: api.Status, Body: strings.TrimPrefix(clean, fmt.Sprintf("{{$n}}: %d %s: ", api.Status, http.StatusText(api.Status)))}
	}
	return &hidden{text: clean, err: err}
}

// hidden is an error whose text had a secret: errors.Is still sees what
// it was (a timeout, a connection refused).
type hidden struct {
	text string
	err  error
}

func (h *hidden) Error() string { return h.text }
func (h *hidden) Unwrap() error { return h.err }

// backoff is how long try waits: 200ms, 400ms, 800ms... with a part of it
// at random, so that clients do not all come back at once; 30s at most.
func backoff(try int) time.Duration {
	d := 200 * time.Millisecond << min(try, 7)
	d = min(d, 30*time.Second)
	return d/2 + rand.N(d/2+1)
}

// retryAfter is how long the API asked to wait (seconds or a date), or the
// backoff of try.
func retryAfter(header string, try int) time.Duration {
	if s, err := strconv.Atoi(strings.TrimSpace(header)); err == nil && s >= 0 {
		return min(time.Duration(s)*time.Second, time.Minute)
	}
	if at, err := http.ParseTime(header); err == nil {
		return min(max(time.Until(at), 0), time.Minute)
	}
	return backoff(try)
}

func sleep(ctx context.Context, d time.Duration) error {
	t := time.NewTimer(d)
	defer t.Stop()
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-t.C:
		return nil
	}
}

// limiter lets n calls through per period, in this process; nil lets every
// call through.
type limiter struct {
	mu     sync.Mutex
	every  time.Duration
	next   time.Time
	tokens float64
	burst  float64
}

func newLimiter(n int, per time.Duration) *limiter {
	if n <= 0 {
		return nil
	}
	return &limiter{every: per / time.Duration(n), tokens: float64(n), burst: float64(n)}
}

// wait waits for a call's turn, or for ctx to end.
func (l *limiter) wait(ctx context.Context) error {
	if l == nil {
		return nil
	}
	l.mu.Lock()
	now := time.Now()
	if !l.next.IsZero() {
		l.tokens = min(l.burst, l.tokens+float64(now.Sub(l.next))/float64(l.every))
	}
	l.next = now
	l.tokens--
	var d time.Duration
	if l.tokens < 0 {
		d = time.Duration(-l.tokens * float64(l.every))
	}
	l.mu.Unlock()
	if d == 0 {
		return nil
	}
	return sleep(ctx, d)
}
