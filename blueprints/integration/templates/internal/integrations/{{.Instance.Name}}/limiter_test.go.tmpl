// TestLimiterWaitsItsTurn lets 2 calls a second through: the third waits
// half a second.
func TestLimiterWaitsItsTurn(t *testing.T) {
	l := newLimiter(2, time.Second)
	start := time.Now()
	for range 3 {
		if err := l.wait(context.Background()); err != nil {
			t.Fatal(err)
		}
	}
	if waited := time.Since(start); waited < 400*time.Millisecond || waited > 2*time.Second {
		t.Fatalf("3 calls at 2/s took %v, want about 500ms", waited)
	}
	if newLimiter(0, time.Second) != nil {
		t.Fatal("no rate limit is a limiter")
	}
}
