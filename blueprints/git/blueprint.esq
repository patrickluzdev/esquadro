/// A git repository for the project: created on the first generation, with
/// everything generated in a first commit, made as the user git knows. Later
/// generations commit nothing: review the diff and commit when you want.
blueprint git {
  version "0.1.0"

  /// Commit everything on the first generation.
  option initial_commit bool default(true)
  /// Message of the first commit.
  option message string default("chore: generate project with esquadro")
  /// The branch a new repository starts on, whatever git's own default is;
  /// with branching, its main option decides.
  option branch string default("main")

  hook post-gen "init"
}
