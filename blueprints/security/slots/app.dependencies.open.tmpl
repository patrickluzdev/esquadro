{{- if realms .Entities}}
{{- if .Options.pepper}}
	if d.config.SecurityPepper == "" {
		release()
		return d, nil, errors.New("security: the pepper option needs SECURITY_PEPPER")
	}
{{- end}}
	d.security, err = security.New(d.pool, security.Config{
		App: "{{.App.Snake}}", Secure: d.config.Env != "{{index .Environments 0}}",
		Secret: d.config.SecuritySecret,{{if .Options.pepper}} Pepper: d.config.SecurityPepper,{{end}}
		SessionDays: {{.Options.session_days}}, SessionIdleHours: {{.Options.session_idle_hours}}, SessionMaxDays: {{.Options.session_max_days}},
		KeepIP: {{.Options.session_ip}}, KeepUserAgent: {{.Options.session_user_agent}},
		TokenMinutes: {{.Options.token_minutes}}, Issuer: {{printf "%q" .Options.public_url}},
		Argon2MemoryKiB: {{.Options.argon2_memory_kib}}, Argon2Iterations: {{.Options.argon2_iterations}}, Argon2Parallelism: {{.Options.argon2_parallelism}},
		LockoutAttempts: {{.Options.lockout_attempts}}, LockoutMinutes: {{.Options.lockout_minutes}},
		LimitAttempts: d.config.Env != "{{index .Environments 0}}",
{{- with strs .Options.password_lists}}
		PasswordLists: {{goStrings .}},
{{- end}}
		PublicURL: {{printf "%q" .Options.public_url}},
		Mailer: securityMail{d.mail},
		VerifyEmailHours: {{.Options.verify_email_hours}}, PasswordResetMinutes: {{.Options.password_reset_minutes}}, InviteDays: {{.Options.invite_days}},
		ResendMinutes: {{.Options.resend_minutes}}, ResendPerDay: {{.Options.resend_per_day}},
		RotateKeysDays: {{.Options.rotate_keys_days}},
{{- with strs .Options.redirect_urls}}
		RedirectURLs: {{goStrings .}},
{{- end}}
{{- if or (usesProvider .Entities "google") (usesProvider .Entities "github")}}
		Providers: map[string]security.Provider{
{{- if usesProvider .Entities "google"}}
			"google": security.Google(d.config.SecurityGoogleClientID, d.config.SecurityGoogleClientSecret),
{{- end}}
{{- if usesProvider .Entities "github"}}
			"github": security.GitHub(d.config.SecurityGithubClientID, d.config.SecurityGithubClientSecret),
{{- end}}
		},
{{- end}}
	}, d.logger)
	if err != nil {
		release()
		return d, nil, err
	}
{{- end}}
