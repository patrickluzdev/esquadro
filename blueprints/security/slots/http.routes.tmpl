{{- if realms .Entities}}
	d.security.Routes(mux, {{printf "%q" .Options.path}}, d.realms())
{{- if not (uses "rest")}}
	mux.HandleFunc("GET {{.Options.path}}/openapi.yaml", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/yaml")
		_, _ = w.Write(security.Contract)
	})
{{- end}}
	mux.HandleFunc("GET /.well-known/jwks.json", func(w http.ResponseWriter, r *http.Request) {
		jwks, err := d.security.JWKS(r.Context())
		if err != nil {
			edge.Write(w, r, edge.ErrInternal)
			return
		}
		w.Header().Set("Content-Type", "application/jwk-set+json")
		w.Header().Set("Cache-Control", "public, max-age=300")
		_, _ = w.Write(jwks)
	})
{{- end}}
