{{- if and (realms .Entities) (uses "rest") -}}
package main

// byPolicy are the operations of the API on entities, by ID: the edge lets
// them through to the handlers, which ask the entity's policy
// (internal/<module>/<entity>_policy.go). Any other operation, one of your
// own, needs someone signed in.
var byPolicy = map[string]bool{
{{- range $e := .Entities}}
	"list{{$e.Plural.Pascal}}": true,
	"create{{$e.Pascal}}": true,
	"get{{$e.Pascal}}": true,
	"update{{$e.Pascal}}": true,
	"delete{{$e.Pascal}}": true,
{{- range manyToMany $e}}
	"list{{$e.Pascal}}{{.Pascal}}": true,
{{- if not .Inferred}}
	"addTo{{$e.Pascal}}{{.Pascal}}": true,
	"removeFrom{{$e.Pascal}}{{.Pascal}}": true,
{{- end}}
{{- end}}
{{- end}}
}
{{end -}}
