{{- if realms .Entities -}}
package main

import (
	"bufio"
	"context"
	"encoding/json"
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"slices"
	"strings"
	"text/tabwriter"
{{- if .Options.services}}
	"time"
{{- end}}

	"{{.App.Module}}/internal/platform/edge"
	"{{.App.Module}}/internal/platform/security"
)

const securityUsage = `usage: {{.App.Kebab}} security <command>

  create <realm> <email> [field=value...] [-role r]... [-password-stdin] [-redirect /path]
        an account, and a link to set its password (or the password, from stdin)
  invite <realm> <email> [field=value...] [-role r]... [-redirect /path]
        an account, and an email inviting it to choose its password
  grant <realm> <email> <role>     give a role
  revoke <realm> <email> <role>    take a role away
  sessions <realm> <email>         the open sessions of an account
  delete <realm> <email>           delete an account and its principal
  cleanup                          delete expired sessions, links and keys
  rotate-keys                      a new JWT signing key
{{- if .Options.services}}
  key create <name> -role r [-role r]... [-days n]
                                   a service key, shown once (roles: {{range $i, $r := .Options.services}}{{if $i}}, {{end}}{{$r}}{{end}})
  key list                         the service keys, never the keys themselves
  key revoke <name>                revoke a service key, at once
{{- end}}

realms: {{range $i, $r := realms .Entities}}{{if $i}}, {{end}}{{$r.Name}}{{end}}`

// securityCommand runs {{.App.Kebab}} security <command>.
func securityCommand(ctx context.Context, args []string) error {
	if len(args) == 0 {
		return errors.New(securityUsage)
	}
	d, release, err := open(ctx)
	if err != nil {
		return err
	}
	defer release()
	command, args := args[0], args[1:]
	switch command {
	case "cleanup":
		n, err := d.security.Cleanup(ctx)
		if err != nil {
			return err
		}
		fmt.Printf("deleted %d expired rows\n", n)
		return nil
	case "rotate-keys":
		if err := d.security.RotateKeys(ctx); err != nil {
			return err
		}
		fmt.Println("a new signing key signs the tokens; the old ones check theirs until they expire")
		return nil
	case "create":
		return createAccount(ctx, d, args, os.Stdin, false)
	case "invite":
		return createAccount(ctx, d, args, os.Stdin, true)
{{- if .Options.services}}
	case "key":
		return serviceKeyCommand(ctx, d, args)
{{- end}}
	}
	if len(args) < 2 {
		return errors.New(securityUsage)
	}
	realm, ok := realmNamed(d, args[0])
	if !ok {
		return errors.New(securityUsage)
	}
	id, err := d.security.AccountID(ctx, realm.Name, args[1])
	if err != nil {
		return err
	}
	switch {
	case (command == "grant" || command == "revoke") && len(args) == 3:
		role := args[2]
		if !slices.Contains(realm.Roles, role) {
			return fmt.Errorf("%s is not a role of %s: %s", role, realm.Name, strings.Join(realm.Roles, ", "))
		}
		if command == "grant" {
			return d.security.Grant(ctx, d.pool, id, role)
		}
		return d.security.Revoke(ctx, d.pool, id, role)
	case command == "sessions" && len(args) == 2:
		sessions, err := d.security.Sessions(ctx, id)
		if err != nil {
			return err
		}
		w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
		fmt.Fprintln(w, "SESSION\tSINCE\tLAST SEEN\tADDRESS\tBROWSER")
		for _, s := range sessions {
			fmt.Fprintf(w, "%s\t%s\t%s\t%s\t%s\n", s.ID, s.CreatedAt.Format("2006-01-02 15:04"), s.LastSeenAt.Format("2006-01-02 15:04"), s.IPAddress, s.UserAgent)
		}
		return w.Flush()
	case command == "delete" && len(args) == 2:
		return d.security.DeleteAccount(ctx, realm, id)
	}
	return errors.New(securityUsage)
}

// createAccount runs security create, or security invite.
func createAccount(ctx context.Context, d dependencies, args []string, stdin io.Reader, invite bool) error {
	if len(args) < 2 {
		return errors.New(securityUsage)
	}
	realm, ok := realmNamed(d, args[0])
	if !ok {
		return errors.New(securityUsage)
	}
	email := args[1]
	fs := flag.NewFlagSet("security create", flag.ContinueOnError)
	var roles roleList
	fs.Var(&roles, "role", "a role of the account; repeat it for more")
	fromStdin := fs.Bool("password-stdin", false, "read the password from stdin, instead of answering a link to set it")
	redirect := fs.String("redirect", "/", "the page of the app the link opens, which sets the password")
	// Fields come before the flags: name=Ana -role admin.
	fields := map[string]any{}
	rest := args[2:]
	for len(rest) > 0 && !strings.HasPrefix(rest[0], "-") {
		key, value, ok := strings.Cut(rest[0], "=")
		if !ok {
			return fmt.Errorf("%q is not field=value", rest[0])
		}
		var v any
		if json.Unmarshal([]byte(value), &v) != nil {
			v = value
		}
		fields[key] = v
		rest = rest[1:]
	}
	if err := fs.Parse(rest); err != nil {
		return err
	}
	var password string
	if *fromStdin {
		line, err := bufio.NewReader(stdin).ReadString('\n')
		if err != nil && !errors.Is(err, io.EOF) {
			return err
		}
		password = strings.TrimRight(line, "\r\n")
	}
	body, err := json.Marshal(fields)
	if err != nil {
		return err
	}
	if invite {
		if _, err := d.security.Invite(ctx, realm, email, body, *redirect, "", roles...); err != nil {
			return describe(err)
		}
		fmt.Printf("invited %s %s: an email with a link to choose the password is on its way\n", realm.Name, email)
		return nil
	}
	id, err := d.security.CreateAccount(ctx, realm, email, password, body, roles...)
	if err != nil {
		return describe(err)
	}
	fmt.Printf("created %s %s (%s)\n", realm.Name, email, id)
	if password != "" {
		return nil
	}
	link, expires, err := d.security.ResetLink(ctx, realm.Name, id, *redirect)
	if err != nil {
		return err
	}
	fmt.Printf("its password is set at %s\nuntil %s\n", link, expires.Local().Format("2006-01-02 15:04"))
	return nil
}

// realmNamed is the realm called name.
func realmNamed(d dependencies, name string) (security.Realm, bool) {
	for _, r := range d.realms() {
		if r.Name == name {
			return r, true
		}
	}
	return security.Realm{}, false
}

// describe is an error of the model as a line: its fields refused.
func describe(err error) error {
	if weak, ok := errors.AsType[*security.WeakPassword](err); ok {
		return fmt.Errorf("the password is refused: %s", weak.Reason)
	}
	if p, ok := errors.AsType[*edge.Problem](err); ok {
		parts := make([]string, 0, len(p.Errors))
		for _, f := range p.Errors {
			parts = append(parts, f.Field+": "+f.Code)
		}
		return fmt.Errorf("%s %s", p.Title, strings.Join(parts, ", "))
	}
	return err
}

// roleList is the -role flag, repeated.
type roleList []string

func (r *roleList) String() string     { return strings.Join(*r, ",") }
func (r *roleList) Set(v string) error { *r = append(*r, v); return nil }
{{- if .Options.services}}

// serviceKeyCommand runs {{.App.Kebab}} security key <command>.
func serviceKeyCommand(ctx context.Context, d dependencies, args []string) error {
	if len(args) == 0 {
		return errors.New(securityUsage)
	}
	switch args[0] {
	case "create":
		fs := flag.NewFlagSet("key create", flag.ContinueOnError)
		var roles roleList
		fs.Var(&roles, "role", "a role of the key (repeat for more)")
		days := fs.Int("days", 0, "days the key lasts; 0 is until revoked")
		if len(args) < 2 {
			return errors.New(securityUsage)
		}
		name := args[1]
		if err := fs.Parse(args[2:]); err != nil {
			return err
		}
		var expires time.Time
		if *days > 0 {
			expires = time.Now().AddDate(0, 0, *days)
		}
		key, err := d.security.CreateServiceKey(ctx, name, roles, expires)
		if err != nil {
			return err
		}
		fmt.Fprintf(os.Stderr, "service key %s (%s): copy it now, it is not shown again\n", name, strings.Join(roles, ", "))
		fmt.Println(key)
		return nil
	case "list":
		keys, err := d.security.ServiceKeys(ctx)
		if err != nil {
			return err
		}
		w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
		fmt.Fprintln(w, "NAME\tROLES\tKEY\tCREATED\tEXPIRES\tLAST USED\tSTATUS")
		for _, k := range keys {
			status := "active"
			switch {
			case k.RevokedAt != nil:
				status = "revoked"
			case k.ExpiresAt != nil && k.ExpiresAt.Before(time.Now()):
				status = "expired"
			}
			fmt.Fprintf(w, "%s\t%s\t%s...\t%s\t%s\t%s\t%s\n", k.Name, strings.Join(k.Roles, ","), k.Prefix,
				k.CreatedAt.Format(time.DateOnly), dateOr(k.ExpiresAt, "never"), dateOr(k.LastUsedAt, "never"), status)
		}
		return w.Flush()
	case "revoke":
		if len(args) != 2 {
			return errors.New(securityUsage)
		}
		if err := d.security.RevokeServiceKey(ctx, args[1]); err != nil {
			return err
		}
		fmt.Printf("revoked %s\n", args[1])
		return nil
	}
	return errors.New(securityUsage)
}

func dateOr(t *time.Time, none string) string {
	if t == nil {
		return none
	}
	return t.Format("2006-01-02 15:04")
}
