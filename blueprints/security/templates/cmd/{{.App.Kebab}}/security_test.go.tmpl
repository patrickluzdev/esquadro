// TestAPISignIn lists {{$target}} through the whole service: no one is
// refused with 401{{if $denied}}, a {{$denied}} with 403{{end}}, and {{$allowed}} lets in.
func TestAPISignIn(t *testing.T) {
	t.Parallel()
	srv := newTestServer(t)
	for who, want := range map[string]int{"nobody": http.StatusUnauthorized, {{printf "%q" $allowed}}: http.StatusOK{{if $denied}}, {{printf "%q" $denied}}: http.StatusForbidden{{end}}} {
		res, err := asTestPrincipal(who).Get(srv.URL + "/api/v1/{{$target}}")
		if err != nil {
			t.Fatal(err)
		}
		res.Body.Close()
		if res.StatusCode != want {
			t.Errorf("as %s: %d, want %d", who, res.StatusCode, want)
		}
	}
}
