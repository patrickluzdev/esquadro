{{- if realms .Entities -}}
{{- $e := .Entity}}{{$m := $e.Module}}{{$o := ownerOf .Entities $e}}{{$R := printf "%sRules" $e.Camel}}
{{- $field := ""}}{{with $o}}{{if .Relation}}{{$field = printf "%sID" .Relation.Pascal}}{{else}}{{$field = "ID"}}{{end}}{{end}}
// Code generated by esquadro from the @security rules of {{$e.Raw}}: do not
// edit. Change the rules in the model, or an action in {{$e.Snake}}_policy.go.

package {{$m.Snake}}

{{- $usesKey := and $o (or (rulesOf .Entities $e "read").Owner (rulesOf .Entities $e "update").Owner (rulesOf .Entities $e "delete").Owner (and $o.Relation (rulesOf .Entities $e "create").Owner))}}
import (
	"context"
{{- if $usesKey}}
	"uuid"
{{- end}}

	"{{.App.Module}}/internal/platform/security"
)

// {{$R}} are the rules the model gives {{$e.Plural.Snake}}; {{$e.Pascal}}Policy
// embeds them.
type {{$R}} struct{}

// List is which {{$e.Plural.Snake}} the request of ctx may list.
func ({{$R}}) List(ctx context.Context) security.Scope {
{{- $l := rulesOf .Entities $e "list"}}
{{- if $l.Others}}
	if security.Allows(ctx, {{goList $l.Others}}) {
		return security.All()
	}
{{- end}}
{{- if and $l.Owner $o}}
	if p, ok := security.PrincipalIn(ctx, "{{$o.Realm}}"); ok {
		return security.OwnedBy(p.ID)
	}
{{- end}}
	return security.Nobody()
}
{{range $op := list "Read" "Update" "Delete"}}
// {{$op}} reports whether the request of ctx may {{lower $op}} x.
func (r {{$R}}) {{$op}}(ctx context.Context, x {{$e.Pascal}}) bool {
	return {{allowExpr (rulesOf $.Entities $e (lower $op)) "r.owns(ctx, x)"}}
}
{{end}}
// Create reports whether the request of ctx may create n.
func (r {{$R}}) Create(ctx context.Context, n New{{$e.Pascal}}) bool {
{{- if and $o $o.Relation}}
	return {{allowExpr (rulesOf .Entities $e "create") (printf "r.ownsKey(ctx, n.%s)" $field)}}
{{- else}}
	return {{allowExpr (rulesOf .Entities $e "create") "false"}}
{{- end}}
}
{{- $ro := or (rulesOf .Entities $e "read").Owner (rulesOf .Entities $e "update").Owner (rulesOf .Entities $e "delete").Owner}}
{{- $co := and $o $o.Relation (rulesOf .Entities $e "create").Owner}}
{{- with $o}}
{{- if $ro}}

// owns reports whether the request of ctx comes from the {{.Realm}} x belongs
// to.
func (r {{$R}}) owns(ctx context.Context, x {{$e.Pascal}}) bool {
	return r.ownsKey(ctx, x.{{$field}})
}
{{- end}}
{{- if or $ro $co}}

func ({{$R}}) ownsKey(ctx context.Context, owner uuid.UUID) bool {
	p, ok := security.PrincipalIn(ctx, "{{.Realm}}")
	return ok && p.ID == owner
}
{{- end}}
{{- if .Relation}}

// Claim gives n its owner when the request of ctx is let in only as the
// owner: on create (stored is nil), the {{.Realm}} who makes it; on update,
// the one stored, so that no {{.Realm}} hands one over to another.
func ({{$R}}) Claim(ctx context.Context, n *New{{$e.Pascal}}, stored *{{$e.Pascal}}) {
	p, ok := security.PrincipalIn(ctx, "{{.Realm}}")
	if !ok {
		return
	}
{{- $c := rulesOf $.Entities $e "create"}}{{$u := rulesOf $.Entities $e "update"}}
	switch {
	case stored == nil{{if $c.Others}} && !security.Allows(ctx, {{goList $c.Others}}){{end}}:
		n.{{$field}} = p.ID
	case stored != nil{{if $u.Others}} && !security.Allows(ctx, {{goList $u.Others}}){{end}}:
		n.{{$field}} = stored.{{$field}}
	}
}
{{- end}}
{{- end}}
{{end -}}
