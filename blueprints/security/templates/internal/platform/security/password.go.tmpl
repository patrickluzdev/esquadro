{{- if realms .Entities -}}
package security

import (
	"crypto/hmac"
	"crypto/rand"
	"crypto/sha256"
	"crypto/subtle"
	"encoding/base64"
	"errors"
	"fmt"
	"strings"

	"golang.org/x/crypto/argon2"
	"golang.org/x/text/unicode/norm"
)

// Hasher hashes passwords with Argon2id and keeps them in the PHC string
// format, $argon2id$v=19$m=19456,t=2,p=1$<salt>$<hash>, so that the cost of
// each hash travels with it.
type Hasher struct {
	Memory      uint32 // KiB
	Iterations  uint32
	Parallelism uint8
	// Pepper, when set, is mixed into the password (HMAC-SHA256) before it
	// is hashed; it is kept out of the database.
	Pepper []byte
}

const (
	saltBytes = 16
	keyBytes  = 32
)

// Hash hashes a password with a new salt.
func (h Hasher) Hash(password string) (string, error) {
	salt := make([]byte, saltBytes)
	if _, err := rand.Read(salt); err != nil {
		return "", err
	}
	key := argon2.IDKey(h.input(password), salt, h.Iterations, h.Memory, h.Parallelism, keyBytes)
	return fmt.Sprintf("$argon2id$v=%d$m=%d,t=%d,p=%d$%s$%s", argon2.Version, h.Memory, h.Iterations, h.Parallelism,
		base64.RawStdEncoding.EncodeToString(salt), base64.RawStdEncoding.EncodeToString(key)), nil
}

// Verify reports whether password is the one encoded hashes, comparing in
// constant time, and whether the hash should be made again because its
// cost is below the hasher's.
func (h Hasher) Verify(password, encoded string) (ok, rehash bool, err error) {
	var version int
	var memory, iterations uint32
	var parallelism uint8
	parts := strings.Split(encoded, "$")
	if len(parts) != 6 || parts[1] != "argon2id" {
		return false, false, errors.New("security: not an argon2id hash")
	}
	if _, err := fmt.Sscanf(parts[2], "v=%d", &version); err != nil || version != argon2.Version {
		return false, false, errors.New("security: unknown argon2id version")
	}
	if _, err := fmt.Sscanf(parts[3], "m=%d,t=%d,p=%d", &memory, &iterations, &parallelism); err != nil {
		return false, false, fmt.Errorf("security: argon2id parameters: %w", err)
	}
	salt, err := base64.RawStdEncoding.DecodeString(parts[4])
	if err != nil {
		return false, false, err
	}
	want, err := base64.RawStdEncoding.DecodeString(parts[5])
	if err != nil {
		return false, false, err
	}
	got := argon2.IDKey(h.input(password), salt, iterations, memory, parallelism, uint32(len(want)))
	ok = subtle.ConstantTimeCompare(got, want) == 1
	rehash = memory < h.Memory || iterations < h.Iterations || parallelism < h.Parallelism
	return ok, rehash, nil
}

// Waste spends the time a verification takes, for a sign-in with an email
// that has no password: the answer must not come faster, or it would tell
// which emails have an account.
func (h Hasher) Waste(password string) {
	argon2.IDKey(h.input(password), make([]byte, saltBytes), h.Iterations, h.Memory, h.Parallelism, keyBytes)
}

// input is the password as it is hashed: normalized (NFC), so that the same
// characters typed differently match, and peppered when there is a pepper.
func (h Hasher) input(password string) []byte {
	p := []byte(norm.NFC.String(password))
	if len(h.Pepper) == 0 {
		return p
	}
	mac := hmac.New(sha256.New, h.Pepper)
	mac.Write(p)
	return []byte(base64.RawStdEncoding.EncodeToString(mac.Sum(nil)))
}
