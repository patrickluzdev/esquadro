package security

import (
	"encoding/json"
	"errors"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"time"
)

// TestServiceKeys creates a key, signs a request in with it, and sees an
// expired and a revoked key refused.
func TestServiceKeys(t *testing.T) {
	ctx := t.Context()
	s, _ := testSecurity(t)
	role := ServiceRoles[0]
	// As long as a key may last: until revoked, or the most the app allows.
	lasting := time.Time{}
	if ServiceKeyMaxDays > 0 {
		lasting = time.Now().AddDate(0, 0, ServiceKeyMaxDays-1)
	}
	if _, err := s.CreateServiceKey(ctx, "x", []string{"no-such-role"}, lasting); err == nil {
		t.Fatal("a key with a role the model does not declare")
	}
	key, err := s.CreateServiceKey(ctx, "partner", []string{role}, lasting)
	if err != nil {
		t.Fatal(err)
	}
	if !strings.HasPrefix(key, ServiceKeyPrefix) || len(key) < 40 {
		t.Fatalf("key %q", key)
	}
	if _, err := s.CreateServiceKey(ctx, "partner", []string{role}, lasting); !errors.Is(err, ErrServiceKeyExists) {
		t.Fatalf("the same name twice: %v", err)
	}

	// The key signs a request in, as the service with its roles.
	var who Principal
	h := s.Authenticate([]string{ServiceRealm}, nil)(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		who, _ = PrincipalIn(r.Context(), ServiceRealm)
	}))
	call := func(token string) int {
		req := httptest.NewRequest("GET", "/", nil)
		req.Header.Set("Authorization", "Bearer "+token)
		rec := httptest.NewRecorder()
		who = Principal{}
		h.ServeHTTP(rec, req)
		return rec.Code
	}
	if code := call(key); code != http.StatusOK || who.Realm != ServiceRealm || len(who.Roles) != 1 || who.Roles[0] != role {
		t.Fatalf("%d, signed in as %+v", code, who)
	}
	keys, err := s.ServiceKeys(ctx)
	if err != nil || len(keys) != 1 || keys[0].LastUsedAt == nil || strings.Contains(key, keys[0].Prefix+"x") {
		t.Fatalf("listed %+v (%v)", keys, err)
	}

	// Not a key, an expired one, a revoked one: 401.
	if code := call(ServiceKeyPrefix + "nope"); code != http.StatusUnauthorized {
		t.Fatalf("an unknown key: %d", code)
	}
	old, err := s.CreateServiceKey(ctx, "old", []string{role}, time.Now().Add(-time.Hour))
	if err != nil {
		t.Fatal(err)
	}
	if code := call(old); code != http.StatusUnauthorized {
		t.Fatalf("an expired key: %d", code)
	}
	if err := s.RevokeServiceKey(ctx, "partner"); err != nil {
		t.Fatal(err)
	}
	if code := call(key); code != http.StatusUnauthorized {
		t.Fatalf("a revoked key: %d", code)
	}
}

// TestAdministeringServiceKeys creates, lists and revokes keys through the
// API, as the team's admin, and sees the key shown only once.
func TestAdministeringServiceKeys(t *testing.T) {
	defer func(a []string) { ServiceAdmins = a }(ServiceAdmins)
	ServiceAdmins = []string{"team.admin"}
	f, team := adminFlow(t)
	boss := f.as("boss@example.com")
	role := ServiceRoles[0]
	f.expect(f.call("GET", "/identity/service-keys", nil), 401, "unauthorized")
	if _, err := f.s.CreateAccount(t.Context(), team, "ana@example.com", password, json.RawMessage(`{"name":"Ana"}`), "member"); err != nil {
		t.Fatal(err)
	}
	f.expect(f.call("GET", "/identity/service-keys", nil, f.as("ana@example.com")...), 403, "forbidden")

	f.expect(f.call("POST", "/identity/service-keys", map[string]any{"name": "x", "roles": []string{"no-such-role"}}, boss...), 422, "invalid_fields")
	f.expect(f.call("POST", "/identity/service-keys", map[string]any{"name": " ", "roles": []string{role}}, boss...), 422, "invalid_fields")
	created := f.call("POST", "/identity/service-keys", map[string]any{"name": "studio", "roles": []string{role}, "days": 30}, boss...)
	f.expect(created, 201, "")
	key := created.str("key")
	if !strings.HasPrefix(key, ServiceKeyPrefix) || created.str("status") != "active" || created.str("expires_at") == "" {
		t.Fatalf("created: %v", created.body)
	}
	f.expect(f.call("POST", "/identity/service-keys", map[string]any{"name": "studio", "roles": []string{role}}, boss...), 409, "name_taken")

	list := f.call("GET", "/identity/service-keys", nil, boss...)
	f.expect(list, 200, "")
	if strings.Contains(list.raw, key) || !strings.Contains(list.raw, `"studio"`) {
		t.Fatalf("the list shows the key, or misses it: %s", list.raw)
	}
	roles := f.call("GET", "/identity/service-roles", nil, boss...)
	f.expect(roles, 200, "")
	if !strings.Contains(roles.raw, `"keys":1`) {
		t.Fatalf("roles: %s", roles.raw)
	}

	id := created.str("id")
	f.expect(f.call("DELETE", "/identity/service-keys/"+id, nil, boss...), 204, "")
	f.expect(f.call("DELETE", "/identity/service-keys/"+id, nil, boss...), 409, "already_revoked")
	if !strings.Contains(f.call("GET", "/identity/service-keys", nil, boss...).raw, `"status":"revoked"`) {
		t.Fatal("a revoked key leaves the list")
	}
}
