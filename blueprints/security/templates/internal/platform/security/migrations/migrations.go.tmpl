{{- if realms .Entities -}}
// Package migrations holds the migrations of the security tables, which
// come with esquadro: a new version of the security blueprint may add one.
package migrations

import (
	"context"
	"database/sql"
	"embed"
	"fmt"

	"github.com/pressly/goose/v3"
	"github.com/pressly/goose/v3/database"
)

//go:embed *.sql
var fsys embed.FS

// Apply applies the security migrations the database does not have yet,
// keeping their versions apart from the model's.
func Apply(ctx context.Context, db *sql.DB) error {
	store, err := database.NewStore(database.DialectPostgres, "security_goose_db_version")
	if err != nil {
		return fmt.Errorf("security migrations: %w", err)
	}
	provider, err := goose.NewProvider("", db, fsys, goose.WithStore(store))
	if err != nil {
		return fmt.Errorf("security migrations: %w", err)
	}
	if _, err := provider.Up(ctx); err != nil {
		return fmt.Errorf("security migrations: %w", err)
	}
	return nil
}
{{end -}}
