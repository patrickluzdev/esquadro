{{- if realms .Entities -}}
{{- $pg := optionsOf "postgres" -}}
{{- $sends := securityTable "email_sends" $pg -}}
-- Generated by esquadro: the emails sent again on request (an invitation,
-- the confirmation of an email), counted per account so that no one floods
-- an inbox with them; kept a day.

-- +goose Up
CREATE TABLE {{$sends}} (
  identity_id uuid NOT NULL REFERENCES {{securityTable "identities" $pg}} (id) ON DELETE CASCADE,
  purpose     text NOT NULL,
  sent_at     timestamptz NOT NULL
);
CREATE INDEX ON {{$sends}} (identity_id, purpose, sent_at);
CREATE INDEX ON {{$sends}} (sent_at);

-- +goose Down
DROP TABLE {{$sends}};
{{end -}}
