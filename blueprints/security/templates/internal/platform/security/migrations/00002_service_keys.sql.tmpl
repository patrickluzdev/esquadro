{{- if and (realms .Entities) .Options.services -}}
{{- $keys := securityTable "service_keys" (optionsOf "postgres") -}}
-- Generated by esquadro: the service keys, for what is no person. A key is
-- kept as its SHA-256 only; prefix is its start, to tell keys apart.

-- +goose Up
CREATE TABLE {{$keys}} (
  id           uuid PRIMARY KEY,
  name         text NOT NULL UNIQUE,
  roles        text[] NOT NULL,
  key_hash     bytea NOT NULL UNIQUE,
  prefix       text NOT NULL,
  created_at   timestamptz NOT NULL DEFAULT now(),
  expires_at   timestamptz,
  last_used_at timestamptz,
  revoked_at   timestamptz
);

-- +goose Down
DROP TABLE {{$keys}};
{{end -}}
