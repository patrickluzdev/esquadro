-- Generated by esquadro: the tables of the security blueprint. An identity
-- has the id of its principal (the User or Customer row of its realm).

-- +goose Up
{{- if contains $identities "."}}
CREATE SCHEMA IF NOT EXISTS security;
{{- end}}

CREATE TABLE {{$identities}} (
  id             uuid PRIMARY KEY,
  realm          text NOT NULL,
  email          text NOT NULL,
  email_verified boolean NOT NULL DEFAULT false,
  disabled_at    timestamptz,
  created_at     timestamptz NOT NULL DEFAULT now(),
  updated_at     timestamptz NOT NULL DEFAULT now(),
  UNIQUE (realm, email)
);

-- Each way to sign in: a password (provider password, subject the
-- identity's id) or a social account (the provider's id of the person).
CREATE TABLE {{$credentials}} (
  id                       uuid PRIMARY KEY,
  identity_id              uuid NOT NULL REFERENCES {{$identities}} (id) ON DELETE CASCADE,
  provider                 text NOT NULL,
  subject                  text NOT NULL,
  password_hash            text,
  access_token             text,
  refresh_token            text,
  id_token                 text,
  access_token_expires_at  timestamptz,
  refresh_token_expires_at timestamptz,
  scope                    text,
  created_at               timestamptz NOT NULL DEFAULT now(),
  updated_at               timestamptz NOT NULL DEFAULT now(),
  UNIQUE (provider, subject)
);
CREATE INDEX ON {{$credentials}} (identity_id);

-- Sessions keep a hash of their token, never the token.
CREATE TABLE {{$sessions}} (
  id               uuid PRIMARY KEY,
  identity_id      uuid NOT NULL REFERENCES {{$identities}} (id) ON DELETE CASCADE,
  token_hash       bytea NOT NULL UNIQUE,
  expires_at       timestamptz NOT NULL,
  max_expires_at   timestamptz NOT NULL,
  last_seen_at     timestamptz NOT NULL DEFAULT now(),
  authenticated_at timestamptz NOT NULL DEFAULT now(),
  ip_address       text,
  user_agent       text,
  created_at       timestamptz NOT NULL DEFAULT now(),
  updated_at       timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX ON {{$sessions}} (identity_id);
CREATE INDEX ON {{$sessions}} (expires_at);

-- One-time codes (verify an email, reset a password, change an email),
-- kept as a hash.
CREATE TABLE {{$verifications}} (
  id          uuid PRIMARY KEY,
  realm       text NOT NULL,
  purpose     text NOT NULL,
  identifier  text NOT NULL,
  value_hash  bytea NOT NULL UNIQUE,
  data        text,
  expires_at  timestamptz NOT NULL,
  used_at     timestamptz,
  created_at  timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX ON {{$verifications}} (purpose, identifier);
CREATE INDEX ON {{$verifications}} (expires_at);

CREATE TABLE {{$roles}} (
  identity_id uuid NOT NULL REFERENCES {{$identities}} (id) ON DELETE CASCADE,
  role        text NOT NULL,
  created_at  timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY (identity_id, role)
);

-- The keys that sign JWTs; the private one is encrypted with SECURITY_SECRET.
CREATE TABLE {{$keys}} (
  id          text PRIMARY KEY,
  algorithm   text NOT NULL,
  public_key  bytea NOT NULL,
  private_key bytea NOT NULL,
  created_at  timestamptz NOT NULL DEFAULT now(),
  expires_at  timestamptz
);

-- Failed sign-ins, by account and by address, to slow down guessing.
CREATE TABLE {{$attempts}} (
  key          text PRIMARY KEY,
  count        integer NOT NULL,
  window_start timestamptz NOT NULL,
  locked_until timestamptz
);

-- +goose Down
DROP TABLE {{$attempts}};
DROP TABLE {{$keys}};
DROP TABLE {{$roles}};
DROP TABLE {{$verifications}};
DROP TABLE {{$sessions}};
DROP TABLE {{$credentials}};
DROP TABLE {{$identities}};
