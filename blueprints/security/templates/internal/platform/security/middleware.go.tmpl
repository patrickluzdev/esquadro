{{- if realms .Entities -}}
package security

import (
	"context"
	"errors"
	"net/http"
	"slices"
	"strings"

	"{{.App.Module}}/internal/platform/edge"
)

type principalsKey struct{}

// PrincipalIn is the principal of a realm the request of ctx came with.
func PrincipalIn(ctx context.Context, realm string) (Principal, bool) {
	principals, _ := ctx.Value(principalsKey{}).(map[string]Principal)
	p, ok := principals[realm]
	return p, ok
}

// Authenticate finds who a request comes from: a session cookie of each
// realm, or an Authorization: Bearer header with a JWT or a session token.
// With a session cookie, a request that changes something must come from
// the app (Origin, Sec-Fetch-Site) and carry the session's CSRF token in
// X-CSRF-Token. A request to a realm's identity routes (signing up, in,
// out) is that realm's alone: the sessions of the others are not read, so
// that a person signed in to another frontend of the app still signs up or
// in to this one. A request that comes from no one goes on, for the routes
// open to anyone.
func (s *Security) Authenticate(realms []string, origins []string) edge.Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
{{- if uses "storage"}}
			// The storage's signed links carry their own authority (the
			// file, the method, the type and an expiry, signed): no session
			// is read, nor a CSRF token asked for.
			if r.URL.Path == "/storage/blob" {
				next.ServeHTTP(w, r)
				return
			}
{{- end}}
			ctx := r.Context()
			principals := map[string]Principal{}
			unsafe := r.Method != http.MethodGet && r.Method != http.MethodHead && r.Method != http.MethodOptions
			// An embedded screen's pages send no CSRF token: what they change
			// must come from the API's own address (see EmbeddedUI).
			embedded := s.embeddedUI(r.URL.Path)
			if unsafe && (!SameOrigin(r, origins) || embedded && !OwnOrigin(r)) {
				edge.Write(w, r, ErrCSRF)
				return
			}
			if bearer, ok := strings.CutPrefix(r.Header.Get("Authorization"), "Bearer "); ok {
				p, err := s.bearer(ctx, strings.TrimSpace(bearer), realms)
				if err != nil {
					edge.Write(w, r, ErrUnauthorized)
					return
				}
				principals[p.Realm] = p
			}
			only := ""
			if rest, ok := strings.CutPrefix(r.URL.Path, s.prefix+"/"); ok {
				if realm, _, _ := strings.Cut(rest, "/"); slices.Contains(realms, realm) {
					only = realm
				}
			}
			for _, realm := range realms {
				if only != "" && realm != only {
					continue
				}
				c, err := r.Cookie(s.SessionCookieName(realm))
				if err != nil || c.Value == "" {
					continue
				}
				p, err := s.principal(ctx, c.Value)
				if errors.Is(err, ErrNoSession) {
					http.SetCookie(w, s.SessionCookie(realm, "", s.now()))
					continue
				}
				if err != nil {
					edge.Write(w, r, edge.ErrInternal)
					return
				}
				if unsafe && !embedded && !s.CheckCSRF(*p.SessionID, r.Header.Get("X-CSRF-Token")) {
					edge.Write(w, r, ErrCSRF)
					return
				}
				principals[realm] = p
			}
			for _, realm := range realms {
				if p, ok := principals[realm]; ok {
					ctx = WithPrincipal(ctx, p)
				}
			}
			next.ServeHTTP(w, r.WithContext(ctx))
		})
	}
}

// bearer is the principal of a bearer token: a JWT of one of the realms, a
// session token{{if .Options.services}}, or a service key{{end}}.
func (s *Security) bearer(ctx context.Context, token string, realms []string) (Principal, error) {
{{- if .Options.services}}
	if strings.HasPrefix(token, ServiceKeyPrefix) {
		if !slices.Contains(realms, ServiceRealm) {
			return Principal{}, ErrBadToken
		}
		return s.service(ctx, token)
	}
{{- end}}
	if strings.Count(token, ".") == 2 {
		for _, realm := range realms {
			if p, err := s.VerifyToken(ctx, token, realm); err == nil {
				return p, nil
			}
		}
		return Principal{}, ErrBadToken
	}
	p, err := s.principal(ctx, token)
	if err != nil {
		return Principal{}, err
	}
	if !slices.Contains(realms, p.Realm) {
		return Principal{}, ErrNoSession
	}
	return p, nil
}

// principal is the principal of a session token, with its roles.
func (s *Security) principal(ctx context.Context, token string) (Principal, error) {
	ses, err := s.SessionByToken(ctx, token)
	if err != nil {
		return Principal{}, err
	}
	roles, err := s.Roles(ctx, s.db, ses.IdentityID)
	if err != nil {
		return Principal{}, err
	}
	return Principal{ID: ses.IdentityID, Realm: ses.Realm, Roles: roles, SessionID: &ses.ID, AuthenticatedAt: ses.AuthenticatedAt}, nil
}
{{end -}}
