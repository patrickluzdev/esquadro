package security

import (
	"context"
	"encoding/json"
	"errors"
	"net/http"
	"net/url"
	"strings"
	"time"
	"uuid"

	"github.com/jackc/pgx/v5"
	"golang.org/x/oauth2"

	"{{.App.Module}}/internal/platform/edge"
)

// The problems of signing in with a provider.
var (
	ErrBadRedirect     = &edge.Problem{Status: http.StatusBadRequest, Code: "invalid_redirect", Title: "The app may not send people there."}
	ErrNoProvider      = &edge.Problem{Status: http.StatusServiceUnavailable, Code: "provider_not_configured", Title: "Signing in this way is not set up."}
	ErrLastCredential  = &edge.Problem{Status: http.StatusConflict, Code: "last_credential", Title: "This is the only way left to sign in."}
	ErrProviderUnknown = &edge.Problem{Status: http.StatusNotFound, Code: "not_found", Title: "The account is not linked to it."}
)

// oauthFlow is what a sign-in with a provider keeps between leaving for the
// provider and coming back: the PKCE verifier, where to send the person
// after, and, to link the provider, the identity.
type oauthFlow struct {
	Verifier string     `json:"verifier"`
	Redirect string     `json:"redirect"`
	Link     *uuid.UUID `json:"link,omitempty"`
}

// oauthStart sends the browser to the provider; ?redirect= is where it
// comes back to after, one of the app's paths or of redirect_urls.
func (s *Security) oauthStart(realm Realm, name string) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		target, err := s.authURL(w, r, realm, name, r.URL.Query().Get("redirect"), nil)
		if err != nil {
			s.fail(w, r, err)
			return
		}
		http.Redirect(w, r, target, http.StatusFound)
	}
}

// linkStart answers the address that links a provider to the signed-in
// account, for the app to send the browser to.
func (s *Security) linkStart(realm Realm, name string) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		p, ok := s.freshPrincipal(w, r, realm)
		if !ok {
			return
		}
		var in struct {
			Redirect string `json:"redirect"`
		}
		_ = decode(w, r, &in)
		target, err := s.authURL(w, r, realm, name, in.Redirect, &p.ID)
		if err != nil {
			s.fail(w, r, err)
			return
		}
		writeJSON(w, map[string]string{"url": target})
	}
}

// authURL starts a sign-in with a provider: it keeps the flow, keyed by the
// hash of its state, sets the state in a cookie of this browser, so that
// only it can finish the flow, and answers the provider's address.
func (s *Security) authURL(w http.ResponseWriter, r *http.Request, realm Realm, name, redirect string, link *uuid.UUID) (string, error) {
	conf, err := s.oauthConfig(realm, name)
	if err != nil {
		return "", err
	}
	if redirect == "" {
		redirect = "/"
	}
	if !s.allowedRedirect(redirect) {
		return "", ErrBadRedirect
	}
	state, hash := newToken()
	flow := oauthFlow{Verifier: oauth2.GenerateVerifier(), Redirect: redirect, Link: link}
	data, err := json.Marshal(flow)
	if err != nil {
		return "", err
	}
	if _, err := s.db.Exec(r.Context(), `INSERT INTO {{$verifications}} (id, realm, purpose, identifier, value_hash, data, expires_at) VALUES ($1, $2, 'oauth', $3, $4, $5, $6)`,
		uuid.NewV7(), realm.Name, name, hash, string(data), s.now().Add(10*time.Minute)); err != nil {
		return "", err
	}
	http.SetCookie(w, s.oauthCookie(realm.Name, state, 600))
	return conf.AuthCodeURL(state, oauth2.S256ChallengeOption(flow.Verifier)), nil
}

// oauthCookie keeps the state of a sign-in with a provider in the browser
// that started it.
func (s *Security) oauthCookie(realm, state string, maxAge int) *http.Cookie {
	c := s.SessionCookie(realm, state, s.now())
	c.Name = strings.TrimSuffix(c.Name, "_session") + "_oauth"
	c.MaxAge, c.Expires = maxAge, time.Time{}
	if state == "" {
		c.MaxAge = -1
	}
	return c
}

// oauthCallback is where the provider sends the browser back: it checks the
// state, exchanges the code (with the PKCE verifier), reads the profile,
// finds or makes the identity, opens a session and sends the browser where
// the flow said; a failure goes there too, with ?error=<code>.
func (s *Security) oauthCallback(realm Realm, name string) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		ctx := r.Context()
		q := r.URL.Query()
		state := q.Get("state")
		cookie, err := r.Cookie(s.oauthCookie(realm.Name, "", 0).Name)
		http.SetCookie(w, s.oauthCookie(realm.Name, "", 0))
		if err != nil || state == "" || cookie.Value != state {
			edge.Write(w, r, ErrCSRF)
			return
		}
		flow, err := s.takeFlow(ctx, realm.Name, name, state)
		if err != nil {
			s.fail(w, r, err)
			return
		}
		back := func(code string) {
			http.Redirect(w, r, withQuery(s.local(flow.Redirect), "error", code), http.StatusFound)
		}
		if q.Get("error") != "" {
			back("provider_refused")
			return
		}
		conf, err := s.oauthConfig(realm, name)
		if err != nil {
			s.fail(w, r, err)
			return
		}
		ctx = context.WithValue(ctx, oauth2.HTTPClient, &http.Client{Timeout: 10 * time.Second})
		tok, err := conf.Exchange(ctx, q.Get("code"), oauth2.VerifierOption(flow.Verifier))
		if err != nil {
			s.event(ctx, "oauth_failed", realm.Name, name, false)
			back("provider_failed")
			return
		}
		profile, err := s.cfg.Providers[name].Profile(ctx, conf.Client(ctx, tok))
		if err != nil || profile.Subject == "" {
			s.event(ctx, "oauth_failed", realm.Name, name, false)
			back("provider_failed")
			return
		}
		id, code, err := s.identityOf(ctx, realm, name, profile, flow.Link)
		if err != nil {
			s.logError(ctx, err)
			back("internal")
			return
		}
		if code != "" {
			s.event(ctx, "oauth_refused", realm.Name, code, false)
			back(code)
			return
		}
		if flow.Link == nil {
			if _, err := s.openSession(w, r, realm.Name, id, true); err != nil {
				s.logError(ctx, err)
				back("internal")
				return
			}
		}
		http.Redirect(w, r, s.local(flow.Redirect), http.StatusFound)
	}
}

// takeFlow is the flow of a state, used once.
func (s *Security) takeFlow(ctx context.Context, realm, name, state string) (oauthFlow, error) {
	var data string
	err := s.db.QueryRow(ctx, `DELETE FROM {{$verifications}} WHERE value_hash = $1 AND purpose = 'oauth' AND realm = $2 AND identifier = $3 AND expires_at > $4 RETURNING data`,
		hashToken(state), realm, name, s.now()).Scan(&data)
	if errors.Is(err, pgx.ErrNoRows) {
		return oauthFlow{}, ErrCSRF
	}
	if err != nil {
		return oauthFlow{}, err
	}
	var flow oauthFlow
	return flow, json.Unmarshal([]byte(data), &flow)
}

// identityOf is the identity a provider's profile signs in as, made or
// linked as needed; or, when it cannot sign in, a code that says why:
//   - linked_elsewhere: the provider's account belongs to another identity;
//   - account_exists: an account has the email, and the two cannot be
//     linked safely, as one of the emails is not verified; the person signs
//     in another way and links the provider;
//   - email_missing: the provider gave no email;
//   - signup_closed: the realm does not take sign-ups;
//   - signup_incomplete: the entity needs more than the provider gives.
func (s *Security) identityOf(ctx context.Context, realm Realm, name string, p Profile, link *uuid.UUID) (uuid.UUID, string, error) {
	var owner uuid.UUID
	err := s.db.QueryRow(ctx, `SELECT c.identity_id FROM {{$credentials}} c JOIN {{$identities}} i ON i.id = c.identity_id
		WHERE c.realm = $3 AND c.provider = $1 AND c.subject = $2 AND i.disabled_at IS NULL`, name, p.Subject, realm.Name).Scan(&owner)
	switch {
	case err == nil && link != nil && owner != *link:
		return uuid.Nil(), "linked_elsewhere", nil
	case err == nil:
		return owner, "", nil
	case !errors.Is(err, pgx.ErrNoRows):
		return uuid.Nil(), "", err
	}
	if link != nil {
		return *link, "", s.addCredential(ctx, realm.Name, *link, name, p.Subject)
	}
	email := normalEmail(p.Email)
	if email == "" {
		return uuid.Nil(), "email_missing", nil
	}
	var verified bool
	err = s.db.QueryRow(ctx, `SELECT id, email_verified FROM {{$identities}} WHERE realm = $1 AND email = $2 AND disabled_at IS NULL`, realm.Name, email).Scan(&owner, &verified)
	switch {
	case err == nil && verified && p.EmailVerified:
		// Both sides proved the email: it is the same person.
		return owner, "", s.addCredential(ctx, realm.Name, owner, name, p.Subject)
	case err == nil:
		return uuid.Nil(), "account_exists", nil
	case !errors.Is(err, pgx.ErrNoRows):
		return uuid.Nil(), "", err
	}
	if realm.Signup != "open" {
		return uuid.Nil(), "signup_closed", nil
	}
	fields, _ := json.Marshal(map[string]string{"name": p.Name})
	if realm.Validate != nil && realm.Validate(fields) != nil {
		return uuid.Nil(), "signup_incomplete", nil
	}
	id := uuid.NewV7()
	tx, err := s.db.Begin(ctx)
	if err != nil {
		return uuid.Nil(), "", err
	}
	defer tx.Rollback(ctx)
	if _, err := tx.Exec(ctx, `INSERT INTO {{$identities}} (id, realm, email, email_verified) VALUES ($1, $2, $3, $4)`, id, realm.Name, email, p.EmailVerified); err != nil {
		return uuid.Nil(), "", err
	}
	if _, err := tx.Exec(ctx, `INSERT INTO {{$credentials}} (id, identity_id, realm, provider, subject) VALUES ($1, $2, $3, $4, $5)`, uuid.NewV7(), id, realm.Name, name, p.Subject); err != nil {
		return uuid.Nil(), "", err
	}
	if err := realm.Create(ctx, id, fields); err != nil {
		if _, ok := errors.AsType[*edge.Problem](err); ok {
			return uuid.Nil(), "signup_incomplete", nil
		}
		return uuid.Nil(), "", err
	}
	if err := tx.Commit(ctx); err != nil {
		_ = realm.Delete(context.WithoutCancel(ctx), id)
		return uuid.Nil(), "", err
	}
	s.event(ctx, "sign_up", realm.Name, id.String(), true)
	return id, "", nil
}

// addCredential links a provider's account to an identity.
func (s *Security) addCredential(ctx context.Context, realm string, identity uuid.UUID, name, subject string) error {
	_, err := s.db.Exec(ctx, `INSERT INTO {{$credentials}} (id, identity_id, realm, provider, subject) VALUES ($1, $2, $3, $4, $5)`, uuid.NewV7(), identity, realm, name, subject)
	if err == nil {
		s.event(ctx, "provider_linked", realm, identity.String(), true)
	}
	return err
}

// providers answers the ways the account signs in.
func (s *Security) providers(realm Realm) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		p, ok := s.sessionPrincipal(w, r, realm)
		if !ok {
			return
		}
		rows, err := s.db.Query(r.Context(), `SELECT provider, created_at FROM {{$credentials}} WHERE identity_id = $1 ORDER BY created_at`, p.ID)
		if err != nil {
			s.fail(w, r, err)
			return
		}
		type linked struct {
			Provider  string    `json:"provider"`
			CreatedAt time.Time `json:"created_at"`
		}
		list, err := pgx.CollectRows(rows, func(row pgx.CollectableRow) (linked, error) {
			var l linked
			return l, row.Scan(&l.Provider, &l.CreatedAt)
		})
		if err != nil {
			s.fail(w, r, err)
			return
		}
		writeJSON(w, list)
	}
}

// unlink removes a provider from the account, unless it is the only way
// left to sign in; it needs a recent sign-in.
func (s *Security) unlink(realm Realm, name string) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		p, ok := s.freshPrincipal(w, r, realm)
		if !ok {
			return
		}
		tag, err := s.db.Exec(r.Context(), `DELETE FROM {{$credentials}} WHERE identity_id = $1 AND provider = $2
			AND (SELECT count(*) FROM {{$credentials}} WHERE identity_id = $1) > 1`, p.ID, name)
		if err != nil {
			s.fail(w, r, err)
			return
		}
		if tag.RowsAffected() == 0 {
			var has bool
			_ = s.db.QueryRow(r.Context(), `SELECT EXISTS (SELECT 1 FROM {{$credentials}} WHERE identity_id = $1 AND provider = $2)`, p.ID, name).Scan(&has)
			if has {
				edge.Write(w, r, ErrLastCredential)
			} else {
				edge.Write(w, r, ErrProviderUnknown)
			}
			return
		}
		s.event(r.Context(), "provider_unlinked", realm.Name, p.ID.String(), true)
		w.WriteHeader(http.StatusNoContent)
	}
}

// oauthConfig is the OAuth 2.0 client of a provider, for a realm.
func (s *Security) oauthConfig(realm Realm, name string) (*oauth2.Config, error) {
	p, ok := s.cfg.Providers[name]
	if !ok || p.ClientID == "" {
		return nil, ErrNoProvider
	}
	return &oauth2.Config{
		ClientID: p.ClientID, ClientSecret: p.ClientSecret, Scopes: p.Scopes,
		Endpoint:    oauth2.Endpoint{AuthURL: p.AuthURL, TokenURL: p.TokenURL},
		RedirectURL: strings.TrimSuffix(s.cfg.PublicURL, "/") + s.prefix + "/" + realm.Name + "/oauth/" + name + "/callback",
	}, nil
}

// allowedRedirect reports whether the app may send a browser to target:
// one of its own paths, an address of RedirectURLs, or in development one
// on this machine, where the frontends run.
func (s *Security) allowedRedirect(target string) bool {
	// Browsers drop tabs and newlines from addresses and read \ as /:
	// "/\t/evil.example" would be "//evil.example", another site.
	if strings.ContainsFunc(target, func(r rune) bool { return r < 0x20 || r == 0x7f || r == '\\' }) {
		return false
	}
	if strings.HasPrefix(target, "/") && !strings.HasPrefix(target, "//") {
		return true
	}
	u, err := url.Parse(target)
	if err != nil || u.User != nil || (u.Scheme != "https" && u.Scheme != "http") {
		return false
	}
	if s.cfg.Development && (u.Hostname() == "localhost" || u.Hostname() == "127.0.0.1") {
		return true
	}
	for _, allowed := range s.cfg.RedirectURLs {
		a, err := url.Parse(allowed)
		if err != nil || a.Scheme != u.Scheme || a.Host != u.Host {
			continue
		}
		// The path of redirect_urls, or below it: /signed-in lets in
		// /signed-in and /signed-in/home, not /signed-in-elsewhere.
		base := strings.TrimSuffix(a.Path, "/")
		if u.Path == base || strings.HasPrefix(u.Path, base+"/") || (base == "" && u.Path == "") {
			return true
		}
	}
	return false
}

// withQuery is target with one more query parameter.
func withQuery(target, key, value string) string {
	u, err := url.Parse(target)
	if err != nil {
		return target
	}
	q := u.Query()
	q.Set(key, value)
	u.RawQuery = q.Encode()
	return u.String()
}
