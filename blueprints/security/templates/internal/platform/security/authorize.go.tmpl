{{- if realms .Entities -}}
package security

import (
	"context"
	"net/http"
	"slices"
	"strings"
	"uuid"

	"{{.App.Module}}/internal/platform/edge"
)

// grants are the permissions of each role of each realm, as the model
// declares them.
var grants = map[string]map[string][]string{
{{- range realms .Entities}}{{if .Grants}}
	"{{.Name}}": {
{{- range $role, $perms := .Grants}}
		"{{$role}}": {{goElems $perms}},
{{- end}}
	},
{{- end}}{{end}}
}

// Allows reports whether the request of ctx comes from one rules let in:
// "public" (anyone), a realm ("user": any of its principals) or a realm's
// role ("user.admin").
func Allows(ctx context.Context, rules ...string) bool {
	for _, rule := range rules {
		if rule == "public" {
			return true
		}
		realm, role, hasRole := strings.Cut(rule, ".")
		p, ok := PrincipalIn(ctx, realm)
		if ok && (!hasRole || slices.Contains(p.Roles, role)) {
			return true
		}
	}
	return false
}

// Can reports whether p has permission, by one of its roles.
func Can(p Principal, permission string) bool {
	for _, role := range p.Roles {
		if slices.Contains(grants[p.Realm][role], permission) {
			return true
		}
	}
	return false
}

// PermissionsOf are the permissions p has, by its roles.
func PermissionsOf(p Principal) []string {
	out := []string{}
	for _, role := range p.Roles {
		for _, perm := range grants[p.Realm][role] {
			if !slices.Contains(out, perm) {
				out = append(out, perm)
			}
		}
	}
	return out
}

// Require answers nil when the request of ctx comes from a principal with
// permission, such as orders.refund; else the problem to answer:
// unauthorized (401) without one, forbidden (403) when it may not.
func Require(ctx context.Context, permission string) error {
	principals, _ := ctx.Value(principalsKey{}).(map[string]Principal)
	if len(principals) == 0 {
		return ErrUnauthorized
	}
	for _, p := range principals {
		if Can(p, permission) {
			return nil
		}
	}
	return ErrForbidden
}

// Who is whom the request of ctx comes from, as "realm:id", or "" for no
// one: what the API's idempotency keys belong to.
func Who(ctx context.Context) string {
	p, ok := PrincipalOf(ctx)
	if !ok {
		return ""
	}
	return p.Realm + ":" + p.ID.String()
}

// Anonymous reports whether no one signed in to the request of ctx.
func Anonymous(ctx context.Context) bool {
	principals, _ := ctx.Value(principalsKey{}).(map[string]Principal)
	return len(principals) == 0
}

// Refusal is the problem for a request a policy refuses: unauthorized
// (401) when no one signed in, forbidden (403) otherwise.
func Refusal(ctx context.Context) error {
	if Anonymous(ctx) {
		return ErrUnauthorized
	}
	return ErrForbidden
}

// Owns reports whether the request of ctx comes from owner, a principal of
// realm: the owner rule of the policies.
func Owns(ctx context.Context, realm string, owner uuid.UUID) bool {
	p, ok := PrincipalIn(ctx, realm)
	return ok && (p.ID == owner || p.OwnsAll)
}

// OwnerScope is the scope of the records the request of ctx owns, when it
// comes from a principal of realm.
func OwnerScope(ctx context.Context, realm string) (Scope, bool) {
	p, ok := PrincipalIn(ctx, realm)
	switch {
	case !ok:
		return Scope{}, false
	case p.OwnsAll:
		return All(), true
	}
	return OwnedBy(p.ID), true
}

// Authorize lets the requests of the API in: an operation in byPolicy is
// left to its entity's policy, which the API asks; any other, one of your
// own, needs a principal of any realm (check more with Allows or Require in
// its code). find is the operation of a request.
func (s *Security) Authorize(find func(method, path string) (string, bool), byPolicy map[string]bool) edge.Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			op, found := find(r.Method, r.URL.Path)
			if !found || byPolicy[op] {
				// Not an operation (ogen answers not_found or
				// method_not_allowed), or the policy's to decide.
				next.ServeHTTP(w, r)
				return
			}
			if Anonymous(r.Context()) {
				w.Header().Set("WWW-Authenticate", `Bearer realm="{{.App.Snake}}"`)
				edge.Write(w, r, ErrUnauthorized)
				return
			}
			w.Header().Set("Cache-Control", "no-store")
			next.ServeHTTP(w, r)
		})
	}
}
{{end -}}
