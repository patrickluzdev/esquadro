// Generated by esquadro: do not edit.

package security

import "slices"

// accessRules are who may do what with each resource of the API, as the
// model's @security says: its operations, and the fields only some may read.
var accessRules = []struct {
	name   string
	ops    [][2]any
	fields [][2]any
}{
{{- range accessTable .Entities .Reports}}
	{name: "{{.Name}}", ops: [][2]any{
{{- range .Ops}}
		{"{{.Name}}", []string{ {{- goList .Who -}} }},
{{- end}}
	}{{if .Fields}}, fields: [][2]any{
{{- range .Fields}}
		{"{{.Name}}", []string{ {{- goList .Who -}} }},
{{- end}}
	}{{end}}},
{{- end}}
}

// Access is what p may do with a resource of the API, for a frontend to
// show only what the API would not refuse. The API still decides, by the
// same rules and by the policies written in the project.
type Access struct {
	// Can are the operations p may: list, read, create, update, delete,
	// import, restore, purge, and the steps of flows ("status:PUBLISHED").
	Can []string `json:"can"`
	// Own are the operations p may only on records that are p's own.
	Own []string `json:"own,omitempty"`
	// Hidden are the fields p does not read: the API leaves them out.
	Hidden []string `json:"hidden,omitempty"`
}

// AccessOf is what p may do, resource by resource, as the model says.
func AccessOf(p Principal) map[string]Access {
	out := make(map[string]Access, len(accessRules))
	for _, r := range accessRules {
		a := Access{Can: []string{}}
		for _, op := range r.ops {
			name, who := op[0].(string), op[1].([]string)
			switch {
			case lets(p, who):
				a.Can = append(a.Can, name)
			case slices.Contains(who, "owner"):
				a.Own = append(a.Own, name)
			}
		}
		for _, f := range r.fields {
			if name, who := f[0].(string), f[1].([]string); !lets(p, who) {
				a.Hidden = append(a.Hidden, name)
			}
		}
		out[r.name] = a
	}
	return out
}

// lets reports whether one of rules lets p in, as Allows does for a
// request: "public", p's realm, or p's realm with one of its roles. owner
// depends on the record, and is left to Own.
func lets(p Principal, rules []string) bool {
	for _, rule := range rules {
		if rule == "public" || rule == p.Realm || (len(rule) > len(p.Realm)+1 && rule[:len(p.Realm)+1] == p.Realm+"." && slices.Contains(p.Roles, rule[len(p.Realm)+1:])) {
			return true
		}
	}
	return false
}
