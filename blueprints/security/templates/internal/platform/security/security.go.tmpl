// Package security is who signs in to {{.App.Label}} and what each one may do:
// passwords, sessions, tokens, CSRF and the limits on guessing. Identities
// live in the security_ tables, apart from the entities that sign in, and
// share their id.
package security

import (
	"context"
	"crypto/hkdf"
	"crypto/sha256"
	"errors"
	"fmt"
	"log/slog"
	"time"
	"uuid"

	"github.com/jackc/pgx/v5/pgxpool"
)

// Config is how security works: its secrets, from the environment, and the
// blueprint's options.
type Config struct {
	// App names the cookies.
	App string
	// Secure sends cookies over HTTPS only, with the __Host- prefix: every
	// environment but development.
	Secure bool
	// Secret signs CSRF tokens and encrypts the signing keys; Pepper, when
	// set, is mixed into every password hash.
	Secret, Pepper string

	SessionDays, SessionIdleHours, SessionMaxDays int
	KeepIP, KeepUserAgent                         bool
	TokenMinutes                                  int
	Issuer                                        string

	Argon2MemoryKiB, Argon2Iterations, Argon2Parallelism int
	LockoutAttempts, LockoutMinutes                      int
	// LimitAttempts counts failed sign-ins and locks; off in development,
	// where trying again should never be in the way.
	LimitAttempts bool
	// PasswordLists are files of passwords to refuse.
	PasswordLists []string
	// PublicURL is the address of the app, for the providers' callbacks.
	PublicURL string
	// DevServers are where the app's frontends are in development, by their
	// path on the app's domain (/admin: http://localhost:5173, where task
	// dev serves a panel) or their own domain (admin.shop.com:
	// http://localhost:5173; shop.com: http://site.localhost:8080, a site's
	// alias): in Development, a link to a page of one opens there.
	DevServers map[string]string
	// Development is the app's first environment, where DevServers count.
	Development bool
	// RedirectURLs are where, besides the app's own paths, people may be sent
	// back to after signing in with a provider, or by an email's link: an
	// origin, or an origin and the start of a path. The frontends' own
	// domains are among them.
	RedirectURLs []string
	// Providers sign in with other accounts, by name: google, github.
	Providers map[string]Provider
	// Mailer sends the emails: verification, password reset, email change.
	Mailer Mailer
	// How long the links of the emails work.
	VerifyEmailHours, PasswordResetMinutes int
	// InviteDays is how long an invitation's link works.
	InviteDays int
	// An invitation or an email's confirmation is sent again no sooner than
	// ResendMinutes after the last one, and no more than ResendPerDay times
	// a day, to an account; 0 is no limit.
	ResendMinutes, ResendPerDay int
	// RotateKeysDays makes a new JWT signing key that often; 0 never does.
	RotateKeysDays int
}

// Security holds what the security of the app works with.
type Security struct {
	db      *pgxpool.Pool
	cfg     Config
	hasher  Hasher
	csrfKey []byte
	keyKey  []byte
	keys    keyCache
	lists   map[string]bool
	prefix  string
	realms  []Realm
	mailer  Mailer
	logger  *slog.Logger
	now     func() time.Time
}

// New returns the security of the app on db.
func New(db *pgxpool.Pool, cfg Config, logger *slog.Logger) (*Security, error) {
	if len(cfg.Secret) < 32 {
		return nil, errors.New("security: SECURITY_SECRET must be at least 32 characters")
	}
	csrfKey, err := derive(cfg.Secret, "csrf")
	if err != nil {
		return nil, err
	}
	keyKey, err := derive(cfg.Secret, "signing-keys")
	if err != nil {
		return nil, err
	}
	lists, err := ReadPasswordLists(cfg.PasswordLists...)
	if err != nil {
		return nil, err
	}
	return &Security{
		db: db, cfg: cfg, csrfKey: csrfKey, keyKey: keyKey, lists: lists, mailer: cfg.Mailer, logger: logger, now: time.Now,
		hasher: Hasher{
			Memory: uint32(cfg.Argon2MemoryKiB), Iterations: uint32(cfg.Argon2Iterations),
			Parallelism: uint8(cfg.Argon2Parallelism), Pepper: []byte(cfg.Pepper),
		},
	}, nil
}

// derive is a key for one use, from the secret: a leak of one does not
// reveal the others.
func derive(secret, use string) ([]byte, error) {
	key, err := hkdf.Key(sha256.New, []byte(secret), nil, "{{.App.Kebab}} security "+use, 32)
	if err != nil {
		return nil, fmt.Errorf("security: %w", err)
	}
	return key, nil
}

// Principal is who a request comes from: an identity of a realm, with its
// roles. Its ID is also the id of the entity that signed in.
type Principal struct {
	ID    uuid.UUID
	Realm string
	Roles []string
	// SessionID is the session the request came with; nil with a token.
	SessionID *uuid.UUID
	// AuthenticatedAt is when the identity last proved who it is.
	AuthenticatedAt time.Time
	// OwnsAll makes the principal the owner of every record of its realm's
	// owner rule: for the tests of what the API does, never set by a
	// sign-in.
	OwnsAll bool
}

type principalKey struct{}

// WithPrincipal is ctx signed in as p, besides the principals of the other
// realms ctx has; PrincipalOf answers the first one. Code that acts on its
// own, such as a job, signs in this way.
func WithPrincipal(ctx context.Context, p Principal) context.Context {
	principals, _ := ctx.Value(principalsKey{}).(map[string]Principal)
	all := map[string]Principal{p.Realm: p}
	for realm, other := range principals {
		if realm != p.Realm {
			all[realm] = other
		}
	}
	ctx = context.WithValue(ctx, principalsKey{}, all)
	if _, ok := ctx.Value(principalKey{}).(Principal); ok {
		return ctx
	}
	return context.WithValue(ctx, principalKey{}, p)
}

// PrincipalOf is the principal of ctx, and whether there is one.
func PrincipalOf(ctx context.Context) (Principal, bool) {
	p, ok := ctx.Value(principalKey{}).(Principal)
	return p, ok
}
