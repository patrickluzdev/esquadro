// adminFlow is the routes of a realm whose admins administer its
// accounts, kept in a table of their own (team), with Boss its admin.
func adminFlow(t *testing.T) (*flow, Realm) {
	t.Helper()
	f := newFlow(t)
	ctx := context.Background()
	f.s.cfg.RedirectURLs = []string{"https://app.example/reset"}
	if _, err := f.s.db.Exec(ctx, `CREATE TABLE team (id uuid PRIMARY KEY, name text NOT NULL)`); err != nil {
		t.Fatal(err)
	}
	team := Realm{
		Name: "team", Roles: []string{"admin", "member"}, Providers: []string{"password"}, Signup: "closed", VerifyEmail: "optional", PasswordReset: true,
		Policy: PasswordPolicy{Min: 12, Max: 128, Blocklist: "lists"},
		Validate: func(fields json.RawMessage) error {
			var in struct{ Name string }
			if json.Unmarshal(fields, &in) != nil || in.Name == "" {
				return &edge.Problem{Status: 422, Code: "invalid_fields"}
			}
			return nil
		},
		Create: func(ctx context.Context, id uuid.UUID, fields json.RawMessage) error {
			var in struct{ Name string }
			_ = json.Unmarshal(fields, &in)
			_, err := f.s.db.Exec(ctx, `INSERT INTO team (id, name) VALUES ($1, $2)`, id, in.Name)
			return err
		},
		Delete: func(ctx context.Context, id uuid.UUID) error {
			_, err := f.s.db.Exec(ctx, `DELETE FROM team WHERE id = $1`, id)
			return err
		},
		Table: "team", Display: "name", Admins: []string{"team.admin"},
	}
	mux := http.NewServeMux()
	f.s.Routes(mux, "/identity", []Realm{team})
	f.handler = f.s.Authenticate([]string{"team"}, nil)(mux)
	if _, err := f.s.CreateAccount(ctx, team, "boss@example.com", password, json.RawMessage(`{"name":"Boss"}`), "admin"); err != nil {
		t.Fatal(err)
	}
	return f, team
}

// as signs someone of team in: the headers to send back.
func (f *flow) as(email string) []string {
	f.t.Helper()
	a := f.call("POST", "/identity/team/sign-in", map[string]string{"email": email, "password": password})
	f.expect(a, 200, "")
	cookie, _, _ := strings.Cut(a.header.Get("Set-Cookie"), ";")
	return []string{"Cookie: " + cookie, "X-CSRF-Token: " + a.str("csrf_token")}
}

func TestAnAdminInvitesAndTheInvitedComesIn(t *testing.T) {
	f, _ := adminFlow(t)
	boss := f.as("boss@example.com")
	f.expect(f.call("GET", "/identity/team/accounts", nil), 401, "unauthorized")

	invite := map[string]any{"email": "Ana@Example.com", "roles": []string{"member"}, "fields": map[string]string{"name": "Ana"}, "redirect": "https://app.example/reset"}
	a := f.call("POST", "/identity/team/accounts", invite, boss...)
	f.expect(a, 201, "")
	if a.str("status") != "invited" || a.str("name") != "Ana" || a.str("email") != "ana@example.com" {
		t.Fatalf("invited: %v", a.body)
	}
	msg, token := f.mail.last(t, "invitation")
	if msg.From != "boss@example.com" || msg.To != "ana@example.com" || token == "" {
		t.Fatalf("invitation: %+v", msg)
	}
	f.expect(f.call("POST", "/identity/team/accounts", invite, boss...), 409, "email_taken")
	invite["email"], invite["roles"] = "bia@example.com", []string{"owner"}
	f.expect(f.call("POST", "/identity/team/accounts", invite, boss...), 422, "invalid_fields")

	// The invited chooses a password with the link, and comes in.
	f.expect(f.call("POST", "/identity/team/password/reset", map[string]string{"token": token, "new_password": password}), 204, "")
	ana := f.as("ana@example.com")
	f.expect(f.call("GET", "/identity/team/accounts", nil, ana...), 403, "forbidden")

	list := f.call("GET", "/identity/team/accounts?q=ana", nil, boss...)
	f.expect(list, 200, "")
	items, _ := list.body["items"].([]any)
	if len(items) != 1 || items[0].(map[string]any)["status"] != "active" {
		t.Fatalf("list: %v", list.body)
	}
	if n := len(f.call("GET", "/identity/team/accounts?role=admin", nil, boss...).body["items"].([]any)); n != 1 {
		t.Fatalf("admins: %d", n)
	}
	roles := f.call("GET", "/identity/team/roles", nil, boss...)
	if !strings.Contains(roles.raw, `"name":"admin","permissions":[],"accounts":1,"administers":true`) {
		t.Fatalf("roles: %s", roles.raw)
	}
}

func TestAnAdminChangesRolesAndDisablesButNeverTheirOwnWay(t *testing.T) {
	f, team := adminFlow(t)
	ctx := context.Background()
	boss := f.as("boss@example.com")
	bossID, _ := f.s.AccountID(ctx, "team", "boss@example.com")
	anaID, err := f.s.CreateAccount(ctx, team, "ana@example.com", password, json.RawMessage(`{"name":"Ana"}`), "member")
	if err != nil {
		t.Fatal(err)
	}
	ana := f.as("ana@example.com")

	f.expect(f.call("PUT", "/identity/team/accounts/"+bossID.String()+"/roles", map[string]any{"roles": []string{"member"}}, boss...), 409, "own_account")
	f.expect(f.call("POST", "/identity/team/accounts/"+bossID.String()+"/disable", nil, boss...), 409, "own_account")
	f.expect(f.call("DELETE", "/identity/team/accounts/"+bossID.String(), nil, boss...), 409, "own_account")
	if err := f.s.keepsAdmins(ctx, team, bossID, nil); !errors.Is(err, ErrLastAdmin) {
		t.Fatalf("the last admin: %v", err)
	}

	a := f.call("PUT", "/identity/team/accounts/"+anaID.String()+"/roles", map[string]any{"roles": []string{"admin", "member"}}, boss...)
	f.expect(a, 200, "")
	if !strings.Contains(a.raw, `"roles":["admin","member"]`) {
		t.Fatalf("roles: %s", a.raw)
	}
	// Disabled, her sessions end and she cannot sign in.
	f.expect(f.call("POST", "/identity/team/accounts/"+anaID.String()+"/disable", nil, boss...), 200, "")
	f.expect(f.call("GET", "/identity/team/session", nil, ana...), 401, "")
	f.expect(f.call("POST", "/identity/team/sign-in", map[string]string{"email": "ana@example.com", "password": password}), 401, "invalid_credentials")
	f.expect(f.call("POST", "/identity/team/accounts/"+anaID.String()+"/enable", nil, boss...), 200, "")
	f.as("ana@example.com")

	// Ana, an admin now, may take Boss's role; then Boss is no admin.
	ana = f.as("ana@example.com")
	f.expect(f.call("PUT", "/identity/team/accounts/"+bossID.String()+"/roles", map[string]any{"roles": []string{"member"}}, ana...), 200, "")
	f.expect(f.call("GET", "/identity/team/accounts", nil, boss...), 403, "forbidden")

	f.expect(f.call("DELETE", "/identity/team/accounts/"+bossID.String(), nil, ana...), 204, "")
	f.expect(f.call("DELETE", "/identity/team/accounts/"+bossID.String(), nil, ana...), 404, "not_found")
	var left int
	_ = f.s.db.QueryRow(ctx, `SELECT count(*) FROM team WHERE id = $1`, bossID).Scan(&left)
	if left != 0 {
		t.Fatal("the record of a deleted account was left")
	}
}

// resendAtOf is the resend_at of the account of email in the list.
func (f *flow) resendAtOf(email string, headers ...string) string {
	f.t.Helper()
	list := f.call("GET", "/identity/team/accounts?q="+email, nil, headers...)
	f.expect(list, 200, "")
	items, _ := list.body["items"].([]any)
	if len(items) != 1 {
		f.t.Fatalf("list: %v", list.body)
	}
	at, _ := items[0].(map[string]any)["resend_at"].(string)
	return at
}

func TestAnAdminSendsTheConfirmationAgainNotTooOften(t *testing.T) {
	f, team := adminFlow(t)
	ctx := context.Background()
	f.s.cfg.ResendMinutes, f.s.cfg.ResendPerDay = 5, 3
	anaID, err := f.s.CreateAccount(ctx, team, "ana@example.com", password, json.RawMessage(`{"name":"Ana"}`), "member")
	if err != nil {
		t.Fatal(err)
	}
	resend := "/identity/team/accounts/" + anaID.String() + "/verify-email"
	again := map[string]string{"redirect": "https://app.example/reset"}

	// Only those who administer the realm.
	f.expect(f.call("POST", resend, again), 401, "unauthorized")
	f.expect(f.call("POST", resend, again, f.as("ana@example.com")...), 403, "forbidden")
	boss := f.as("boss@example.com")
	f.expect(f.call("POST", "/identity/team/accounts/"+uuid.NewV7().String()+"/verify-email", again, boss...), 404, "not_found")
	f.expect(f.call("POST", resend, map[string]string{"redirect": "https://evil.example"}, boss...), 400, "invalid_redirect")
	if at := f.resendAtOf("ana", boss...); at != "" {
		t.Fatalf("resend_at before any: %s", at)
	}

	// Sent, then not again within 5 minutes: 429, and when it may.
	f.expect(f.call("POST", resend, again, boss...), 202, "")
	msg, _ := f.mail.last(t, "verify_email")
	if msg.To != "ana@example.com" || !strings.HasPrefix(msg.Link, "https://app.example/reset?token=") {
		t.Fatalf("email: %+v", msg)
	}
	first := *f.now
	soon := f.call("POST", resend, again, boss...)
	f.expect(soon, 429, "too_soon")
	if soon.header.Get("Retry-After") != "301" || f.mail.count() != 1 {
		t.Fatalf("too soon: Retry-After %q, %d emails", soon.header.Get("Retry-After"), f.mail.count())
	}
	if at := f.resendAtOf("ana", boss...); at != first.Add(5*time.Minute).UTC().Format(time.RFC3339) {
		t.Fatalf("resend_at: %s", at)
	}

	// Again after 5 minutes, up to 3 a day.
	for range 2 {
		*f.now = f.now.Add(5 * time.Minute)
		f.expect(f.call("POST", resend, again, boss...), 202, "")
	}
	*f.now = f.now.Add(5 * time.Minute)
	f.expect(f.call("POST", resend, again, boss...), 429, "too_soon")
	if at := f.resendAtOf("ana", boss...); at != first.Add(24*time.Hour).UTC().Format(time.RFC3339) {
		t.Fatalf("resend_at after 3: %s", at)
	}
	if f.mail.count() != 3 {
		t.Fatalf("%d emails", f.mail.count())
	}

	// A day after the first, it may again; its link confirms the email.
	*f.now = first.Add(24*time.Hour + time.Second)
	boss = f.as("boss@example.com")
	f.expect(f.call("POST", resend, again, boss...), 202, "")
	_, token := f.mail.last(t, "verify_email")
	f.expect(f.call("POST", "/identity/team/verify-email", map[string]string{"token": token}), 204, "")
	f.expect(f.call("POST", resend, again, boss...), 409, "already_verified")

	// Counted a day only.
	*f.now = f.now.Add(25 * time.Hour)
	if _, err := f.s.Cleanup(ctx); err != nil {
		t.Fatal(err)
	}
	var kept int
	_ = f.s.db.QueryRow(ctx, `SELECT count(*) FROM {{securityTable "email_sends" (optionsOf "postgres")}}`).Scan(&kept)
	if kept != 0 {
		t.Fatalf("%d emails still counted", kept)
	}
}

func TestAnInvitationIsSentAgainNotTooOften(t *testing.T) {
	f, _ := adminFlow(t)
	f.s.cfg.ResendMinutes, f.s.cfg.ResendPerDay = 5, 5
	boss := f.as("boss@example.com")
	invite := map[string]any{"email": "bia@example.com", "roles": []string{"member"}, "fields": map[string]string{"name": "Bia"}, "redirect": "https://app.example/reset"}
	a := f.call("POST", "/identity/team/accounts", invite, boss...)
	f.expect(a, 201, "")
	if a.str("resend_at") != f.now.Add(5*time.Minute).UTC().Format(time.RFC3339) {
		t.Fatalf("invited: %s", a.raw)
	}
	reinvite := "/identity/team/accounts/" + a.str("id") + "/invite"
	again := map[string]string{"redirect": "https://app.example/reset"}
	// The invitation itself counts: not again within 5 minutes.
	f.expect(f.call("POST", reinvite, again, boss...), 429, "too_soon")
	// The confirmation is no invitation's: Bia has no password to confirm.
	f.expect(f.call("POST", "/identity/team/accounts/"+a.str("id")+"/verify-email", again, boss...), 409, "already_verified")
	*f.now = f.now.Add(5*time.Minute + time.Second)
	f.expect(f.call("POST", reinvite, again, boss...), 202, "")
	if f.mail.count() != 2 {
		t.Fatalf("%d emails", f.mail.count())
	}
}

func TestNoLimitWithoutOne(t *testing.T) {
	f, team := adminFlow(t)
	ctx := context.Background()
	anaID, err := f.s.CreateAccount(ctx, team, "ana@example.com", password, json.RawMessage(`{"name":"Ana"}`))
	if err != nil {
		t.Fatal(err)
	}
	boss := f.as("boss@example.com")
	for range 3 {
		f.expect(f.call("POST", "/identity/team/accounts/"+anaID.String()+"/verify-email", nil, boss...), 202, "")
	}
	if at := f.resendAtOf("ana", boss...); at != "" {
		t.Fatalf("resend_at: %s", at)
	}
}
