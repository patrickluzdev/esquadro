{{- /* The identity routes in the contract: the document of their own
without the rest blueprint, part of api/openapi.yaml with it. */ -}}
{{- define "identity-tags"}}
{{- range realms .Entities}}
  - name: {{.Name}}
{{- end}}
{{- if .Options.services}}
  - name: service-keys
{{- end}}
{{- end}}
{{- define "identity-paths"}}{{$p := .Options.path}}
{{- range $r := realms .Entities}}
{{- if has $r.Providers "password"}}
  {{$p}}/{{$r.Name}}/sign-up:
    post:
      tags: [{{$r.Name}}]
      summary: {{if eq $r.Signup "open"}}Sign up{{else}}"Sign up (closed: answers signup_closed)"{{end}}
      description: |
        Answers 202 whether the email had an account or not, so that sign-up
        does not tell who has one.{{if ne $r.VerifyEmail "off"}} Sends the verification link to the email.{{end}}
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: "#/components/schemas/IdentityCredentials"
                - type: object
                  properties:
                    password:
                      type: string
                      minLength: {{or $r.PasswordMin $.Options.password_min}}
                      maxLength: {{or $r.PasswordMax $.Options.password_max}}
{{- if uses "rest"}}
                - $ref: "#/components/schemas/New{{$r.Entity.Pascal}}"
{{- else}}
                - type: object
                  description: The fields of the {{$r.Name}}, as the API creates one.
                  additionalProperties: true
{{- end}}
      responses:
        "202": {description: Signed up, or the email had an account.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/sign-in:
    post:
      tags: [{{$r.Name}}]
      summary: Sign in with an email and a password
      requestBody:
        required: true
        content:
          application/json:
            schema: {$ref: "#/components/schemas/IdentityCredentials"}
      responses:
        "200":
          description: Signed in; with a cookie, unless cookie is false.
          content:
            application/json:
              schema: {$ref: "#/components/schemas/IdentitySession"}
        "401": {$ref: "#/components/responses/Problem"}
        "429": {$ref: "#/components/responses/Problem"}
        default: {$ref: "#/components/responses/Problem"}
{{- end}}
  {{$p}}/{{$r.Name}}/sign-out:
    post:
      tags: [{{$r.Name}}]
      summary: End this session
      responses:
        "204": {description: Signed out.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/session:
    get:
      tags: [{{$r.Name}}]
      summary: Who signed in
      responses:
        "200":
          description: The principal, its roles and permissions, and the CSRF token.
          content:
            application/json:
              schema: {$ref: "#/components/schemas/IdentitySession"}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/token:
    post:
      tags: [{{$r.Name}}]
      summary: A short JWT, for other services
      description: Checked with /.well-known/jwks.json; its audience is the realm.
      responses:
        "200":
          description: The token.
          content:
            application/json:
              schema:
                type: object
                properties:
                  token: {type: string}
                  expires_at: {type: string, format: date-time}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/sessions:
    get:
      tags: [{{$r.Name}}]
      summary: The account's sessions, its devices
      responses:
        "200":
          description: The sessions.
          content:
            application/json:
              schema:
                type: array
                items: {$ref: "#/components/schemas/IdentityDevice"}
        default: {$ref: "#/components/responses/Problem"}
    delete:
      tags: [{{$r.Name}}]
      summary: End every other session (needs a recent sign-in)
      responses:
        "204": {description: Ended.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/sessions/{id}:
    delete:
      tags: [{{$r.Name}}]
      summary: End one session
      parameters:
        - {name: id, in: path, required: true, schema: {type: string, format: uuid}}
      responses:
        "204": {description: Ended.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/password:
    post:
      tags: [{{$r.Name}}]
      summary: Change the password; ends the other sessions
      description: Without a password yet (signed in with a provider), current_password is left out and a recent sign-in is needed.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [new_password]
              properties:
                current_password: {type: string}
                new_password: {type: string}
      responses:
        "204": {description: Changed.}
        default: {$ref: "#/components/responses/Problem"}
{{- if ne $r.VerifyEmail "off"}}
  {{$p}}/{{$r.Name}}/verify-email/send:
    post:
      tags: [{{$r.Name}}]
      summary: Send the verification link again
      requestBody:
        content:
          application/json:
            schema: {$ref: "#/components/schemas/IdentityEmailRequest"}
      responses:
        "202": {description: Sent, if the email has an account to verify.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/verify-email:
    post:
      tags: [{{$r.Name}}]
      summary: Verify the email with the token of its link
      requestBody:
        required: true
        content:
          application/json:
            schema: {$ref: "#/components/schemas/IdentityToken"}
      responses:
        "204": {description: Verified.}
        default: {$ref: "#/components/responses/Problem"}
{{- end}}
{{- if $r.PasswordReset}}
  {{$p}}/{{$r.Name}}/password/forgot:
    post:
      tags: [{{$r.Name}}]
      summary: Send a link that sets a new password
      requestBody:
        required: true
        content:
          application/json:
            schema: {$ref: "#/components/schemas/IdentityEmailRequest"}
      responses:
        "202": {description: Sent, if the email has an account.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/password/reset:
    post:
      tags: [{{$r.Name}}]
      summary: Set a new password with the token of its link; ends every session
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [token, new_password]
              properties:
                token: {type: string}
                new_password: {type: string}
      responses:
        "204": {description: Set.}
        default: {$ref: "#/components/responses/Problem"}
{{- end}}
  {{$p}}/{{$r.Name}}/email:
    post:
      tags: [{{$r.Name}}]
      summary: Change the email; a link to the new one confirms it (needs a recent sign-in)
      requestBody:
        required: true
        content:
          application/json:
            schema: {$ref: "#/components/schemas/IdentityEmailRequest"}
      responses:
        "202": {description: Sent, if no other account has the email.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/email/confirm:
    post:
      tags: [{{$r.Name}}]
      summary: Confirm the new email with the token of its link
      requestBody:
        required: true
        content:
          application/json:
            schema: {$ref: "#/components/schemas/IdentityToken"}
      responses:
        "204": {description: Changed.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/providers:
    get:
      tags: [{{$r.Name}}]
      summary: The ways the account signs in
      responses:
        "200":
          description: The linked providers.
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    provider: {type: string}
                    created_at: {type: string, format: date-time}
        default: {$ref: "#/components/responses/Problem"}
{{- range $r.Providers}}{{if ne . "password"}}
  {{$p}}/{{$r.Name}}/oauth/{{.}}:
    get:
      tags: [{{$r.Name}}]
      summary: Sign in with {{.}}
      description: Sends the browser to {{.}}, and back to redirect, signed in, or with ?error=<code>.
      parameters:
        - {name: redirect, in: query, schema: {type: string}, description: "A path of the app, or an address of redirect_urls."}
      responses:
        "302": {description: To the provider.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/providers/{{.}}:
    post:
      tags: [{{$r.Name}}]
      summary: Link {{.}} to the account (needs a recent sign-in)
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                redirect: {type: string}
      responses:
        "200":
          description: The address to send the browser to.
          content:
            application/json:
              schema:
                type: object
                properties:
                  url: {type: string}
        default: {$ref: "#/components/responses/Problem"}
    delete:
      tags: [{{$r.Name}}]
      summary: Unlink {{.}}, unless it is the only way left to sign in
      responses:
        "204": {description: Unlinked.}
        default: {$ref: "#/components/responses/Problem"}
{{- end}}{{end}}
  {{$p}}/{{$r.Name}}:
    delete:
      tags: [{{$r.Name}}]
      summary: Delete the account (needs a recent sign-in)
      responses:
        "204": {description: Deleted.}
        default: {$ref: "#/components/responses/Problem"}
{{- with realmAdmins $.Entities $r.Entity}}
  {{$p}}/{{$r.Name}}/accounts:
    get:
      tags: [{{$r.Name}}]
      summary: The accounts, for those who administer them ({{join ", " .}})
      parameters:
        - {name: q, in: query, schema: {type: string}, description: Words of the email or the name.}
        - {name: role, in: query, schema: {type: string}}
        - {name: status, in: query, schema: {type: string, enum: [active, invited, unverified, disabled]}}
        - {name: page, in: query, schema: {type: integer, minimum: 1}}
        - {name: per_page, in: query, schema: {type: integer, minimum: 1, maximum: 100}}
      responses:
        "200":
          description: A page of accounts.
          content:
            application/json:
              schema: {$ref: "#/components/schemas/IdentityAccountPage"}
        default: {$ref: "#/components/responses/Problem"}
    post:
      tags: [{{$r.Name}}]
      summary: Invite an account; an email with a link to choose its password goes to it
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [email]
              properties:
                email: {type: string, format: email}
                roles: {type: array, items: {type: string}}
                fields: {type: object, description: The account's fields, as its sign-up takes them.}
                redirect: {type: string, description: The page of the app the link opens.}
      responses:
        "201":
          description: Invited.
          content:
            application/json:
              schema: {$ref: "#/components/schemas/IdentityAccount"}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/accounts/{id}:
    delete:
      tags: [{{$r.Name}}]
      summary: Delete an account and its record (never one's own, nor the last admin)
      parameters:
        - {name: id, in: path, required: true, schema: {type: string, format: uuid}}
      responses:
        "204": {description: Deleted.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/accounts/{id}/invite:
    post:
      tags: [{{$r.Name}}]
      summary: Send the invitation again, to an account without a password yet
      parameters:
        - {name: id, in: path, required: true, schema: {type: string, format: uuid}}
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                redirect: {type: string}
      responses:
        "202": {description: Sent.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/accounts/{id}/roles:
    put:
      tags: [{{$r.Name}}]
      summary: Set an account's roles
      parameters:
        - {name: id, in: path, required: true, schema: {type: string, format: uuid}}
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [roles]
              properties:
                roles: {type: array, items: {type: string}}
      responses:
        "200":
          description: The account.
          content:
            application/json:
              schema: {$ref: "#/components/schemas/IdentityAccount"}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/accounts/{id}/disable:
    post:
      tags: [{{$r.Name}}]
      summary: Disable an account; its sessions end
      parameters:
        - {name: id, in: path, required: true, schema: {type: string, format: uuid}}
      responses:
        "200":
          description: The account.
          content:
            application/json:
              schema: {$ref: "#/components/schemas/IdentityAccount"}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/accounts/{id}/enable:
    post:
      tags: [{{$r.Name}}]
      summary: Enable a disabled account
      parameters:
        - {name: id, in: path, required: true, schema: {type: string, format: uuid}}
      responses:
        "200":
          description: The account.
          content:
            application/json:
              schema: {$ref: "#/components/schemas/IdentityAccount"}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/accounts/{id}/sessions:
    delete:
      tags: [{{$r.Name}}]
      summary: Sign an account out everywhere
      parameters:
        - {name: id, in: path, required: true, schema: {type: string, format: uuid}}
      responses:
        "204": {description: Ended.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/{{$r.Name}}/roles:
    get:
      tags: [{{$r.Name}}]
      summary: The realm's roles, their permissions and how many accounts have each
      responses:
        "200":
          description: The roles.
          content:
            application/json:
              schema:
                type: array
                items: {$ref: "#/components/schemas/IdentityRole"}
        default: {$ref: "#/components/responses/Problem"}
{{- end}}
{{- end}}
{{- if .Options.services}}
  {{$p}}/service-keys:
    get:
      tags: [service-keys]
      summary: The service keys, newest first; never the keys themselves
      responses:
        "200":
          description: The keys.
          content:
            application/json:
              schema:
                type: object
                properties:
                  items: {type: array, items: {$ref: "#/components/schemas/ServiceKey"}}
        default: {$ref: "#/components/responses/Problem"}
    post:
      tags: [service-keys]
      summary: Create a service key
      description: |
        Answers the key itself, the only time it is shown: only its hash is
        kept. `days` defaults to {{.Options.service_key_days}}; 0 is until revoked.
        Codes: `name_taken` (409); `invalid_fields` (422): `name`, `roles`, `days` (`too_long`).
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [name, roles]
              properties:
                name: {type: string}
                roles: {type: array, items: {type: string, enum: [{{join ", " (strs .Options.services)}}]}}
                days: {type: integer, minimum: 0}
      responses:
        "201":
          description: The key, with `key` this once.
          content:
            application/json:
              schema:
                allOf:
                  - {$ref: "#/components/schemas/ServiceKey"}
                  - {type: object, properties: {key: {type: string}}}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/service-keys/{id}:
    delete:
      tags: [service-keys]
      summary: Revoke a service key, at once
      description: "Codes: `not_found` (404); `already_revoked` (409)."
      parameters:
        - {name: id, in: path, required: true, schema: {type: string, format: uuid}}
      responses:
        "204": {description: Revoked.}
        default: {$ref: "#/components/responses/Problem"}
  {{$p}}/service-roles:
    get:
      tags: [service-keys]
      summary: The service roles, what each may do, how many active keys have each, and the lifetimes offered
      responses:
        "200":
          description: The roles.
          content:
            application/json:
              schema:
                type: object
                properties:
                  items:
                    type: array
                    items:
                      type: object
                      properties:
                        name: {type: string}
                        permissions: {type: array, items: {type: string}}
                        keys: {type: integer}
                  days: {type: integer, description: The lifetime of a new key by default; 0 is until revoked.}
                  max_days: {type: integer, description: The most a key may last; 0 is no limit.}
                  choices: {type: array, items: {type: integer}}
        default: {$ref: "#/components/responses/Problem"}
{{- end}}
{{- end}}
{{- define "identity-schemas"}}
{{- if .Options.services}}
    ServiceKey:
      type: object
      properties:
        id: {type: string, format: uuid}
        name: {type: string}
        roles: {type: array, items: {type: string}}
        prefix: {type: string, description: "The key's first characters, to tell it apart: sk_abc123."}
        status: {type: string, enum: [active, expired, revoked]}
        created_at: {type: string, format: date-time}
        expires_at: {type: string, format: date-time, nullable: true}
        last_used_at: {type: string, format: date-time, nullable: true}
        revoked_at: {type: string, format: date-time, nullable: true}
{{- end}}
    IdentityAccount:
      type: object
      properties:
        id: {type: string, format: uuid}
        email: {type: string}
        name: {type: string}
        fields: {type: object}
        roles: {type: array, items: {type: string}}
        status: {type: string, enum: [active, invited, unverified, disabled]}
        last_seen_at: {type: string, format: date-time, nullable: true}
        created_at: {type: string, format: date-time}
    IdentityAccountPage:
      type: object
      properties:
        items: {type: array, items: {$ref: "#/components/schemas/IdentityAccount"}}
        page: {type: integer}
        per_page: {type: integer}
        total: {type: integer}
        total_pages: {type: integer}
    IdentityRole:
      type: object
      properties:
        name: {type: string}
        permissions: {type: array, items: {type: string}}
        accounts: {type: integer}
        administers: {type: boolean}
    IdentityCredentials:
      type: object
      required: [email, password]
      properties:
        email: {type: string, format: email}
        password: {type: string}
        redirect: {type: string, description: The page of the app the verification link opens.}
        cookie: {type: boolean, description: "false answers session_token instead of a cookie."}
    IdentitySession:
      type: object
      properties:
        id: {type: string, format: uuid}
        realm: {type: string}
        roles: {type: array, items: {type: string}}
        permissions: {type: array, items: {type: string}}
        expires_at: {type: string, format: date-time}
        csrf_token: {type: string}
        session_token: {type: string}
    IdentityDevice:
      type: object
      properties:
        id: {type: string, format: uuid}
        current: {type: boolean}
        created_at: {type: string, format: date-time}
        last_seen_at: {type: string, format: date-time}
        ip_address: {type: string}
        user_agent: {type: string}
    IdentityEmailRequest:
      type: object
      properties:
        email: {type: string, format: email}
        redirect: {type: string, description: The page of the app the link opens.}
    IdentityToken:
      type: object
      required: [token]
      properties:
        token: {type: string}
{{- end}}
