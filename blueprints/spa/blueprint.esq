/// A single-page application of the app's (an admin panel, a customer
/// portal), in React, used by name: blueprint spa admin. It lives in
/// web/<name>, in the workspace, with the API's TypeScript client, sign-in
/// by the session cookie of a realm (with the page asked for kept for after
/// it), a responsive layout, a light and dark theme, and resources: each
/// entity marked @<name>(resource) gets its list (the API's filters, sorting,
/// search and pages, in the URL), its form (by field type, with the API's
/// errors on their fields) and its page. What is generated is regenerated;
/// what is yours (src/resources, src/pages, src/components, src/menu.ts,
/// src/messages.ts, src/theme.css) is written once and left alone. With
/// serve app, the app's binary serves it, on its domain (or under its path).
blueprint spa {
  version "0.1.0"
  instances
  requires app, http, rest, client_ts, workspace, security

  /// The domain it answers on (admin.shop.com); without one, the app's
  /// domain, under path.
  option domain string default("")
  /// Its path on the app's domain, when it has no domain of its own;
  /// /<name> by default.
  option path string default("")
  /// The realm that signs in to it; the first realm by default.
  option auth string default("")
  /// The roles of the realm let in; any role when empty.
  option roles list default([])
  /// en or pt_br: the language of its own words (src/messages.ts) and of
  /// dates, numbers and money.
  option locale name default(en)
  /// app: the app's binary serves it, built in. (image, a container of its
  /// own, is planned.)
  option serve name default(app)
  /// The sidebar, from shadcn/ui's blocks: icon (sidebar-07, it collapses
  /// to its icons), inset (sidebar-08, the page in an inset card) or
  /// dashboard (dashboard-01, it slides away, wider).
  option sidebar name default(icon)
  /// Where a list's filters are, unless its resource says (filterLayout):
  /// drawer (a panel at the right, applied at once), dialog, or bar (beside
  /// the search, applied as chosen).
  option filters name default(drawer)
  /// The primary color (buttons, links, what is chosen), as #rrggbb; the
  /// text on it is white or black, whichever reads.
  option primary string default("#2a85ff")
  /// The primary color of the dark theme; by default the primary, or a
  /// light gray when the primary is too dark to stand out there.
  option primary_dark string default("")
  /// How round the corners are, as CSS: 0.75rem, 0.5rem, 0.
  option radius string default("0.75rem")
  /// Minutes without use after which the frontend signs out (a warning
  /// comes a minute before); 0, never.
  option idle_minutes int default(0)

  annotation entity {
    /// The entity is a resource of the frontend: its list, form and page.
    resource bool
    /// What people call it, in the frontend's language: Offers.
    label string
    /// What one of it is called, in titles: "Product".
    singular string
    /// Its entry in the menu; the label by default.
    menu string
    /// The section of the menu it is in, with the other resources of the
    /// same group: "Catalog".
    group string
    /// The icon of its menu entry, a Lucide name: tag, users, shopping_cart.
    icon name
  }
  annotation field {
    /// What people call the field, in the frontend's language: Price.
    label string
    /// How a report's column is shown: percent (0.42 as 42%, with a bar in
    /// a table) or duration (seconds as 03:45).
    format name
  }
  annotation relation {
    /// What people call the relation, in the frontend's language: Category.
    label string
  }
  annotation report {
    /// The report on a dashboard of the frontend: stat (a number, the y
    /// column summed), area, line, bar, combo (bars and a line), donut,
    /// progress (bars of shares), goal (a ring of y over target), top (a
    /// ranking), table, radar or timeline.
    widget name
    /// The column of the names, along the chart: category, day. On a
    /// number, the column it is drawn over in the overview: day. On a
    /// timeline, the column of when.
    x name
    /// The column of the numbers, or several, a series each:
    /// [ongoing, finished]. On a timeline, the column of what happened.
    y list
    /// A column whose values split the rows into series, a line or bars
    /// each: channel (the rows, a day, a channel and a total).
    series name
    /// What the dashboard calls it; the report's name by default.
    label string
    /// The time parameter the dashboard's period fills (its start): since.
    since name
    /// The time parameter of the period's end: with since, a number shows
    /// how it changed from the period before.
    until name
    /// How a number is reckoned from its rows: sum (by default), last (a
    /// running total, a balance: the last row's), average or max.
    total name
    /// The column of the goal (goal), or of what is 100% (progress).
    target name
    /// On a ranking: the column of each one's picture, of a second line
    /// under its name, and of its change (a percentage).
    image name
    subtitle name
    delta name
    /// How wide its card is: third, half, two_thirds or full. By default,
    /// two_thirds for area, line, bar, combo; full for table and number;
    /// third for the rest.
    width name
    /// How many rows a ranking, a list, a timeline or a table shows: by
    /// default 6 (8 for a table).
    rows int
    /// The dashboard it is on: Sales. Without one, the first page's.
    dashboard string
    /// A number's icon, a Lucide name: shopping_cart.
    icon name
  }
  annotation value {
    /// What people call a value of an enum, in the frontend's language:
    /// Active.
    label string
    /// The color of its dot: green, amber, red, blue, violet, sky, orange
    /// or gray. Without one, a guess from its name: ACTIVE, PAID and DONE
    /// are green, PENDING and DRAFT amber, CANCELED and FAILED red; others
    /// gray.
    color name
  }
}
