// The start of the {{.Instance.Name}} frontend: yours to change.
import { QueryClient, QueryClientProvider } from "@tanstack/react-query"
import { createRouter, RouterProvider } from "@tanstack/react-router"
import { ThemeProvider } from "next-themes"
import { StrictMode } from "react"
import { createRoot } from "react-dom/client"
import { isApiError } from "@api"
import { base } from "./esquadro/config.ts"
import { sessionQuery } from "./esquadro/kit/auth.tsx"
import { PageLoader } from "./esquadro/kit/states.tsx"
import { retryDelay, retryQuery } from "./esquadro/kit/errors.ts"
import { routeTree } from "./esquadro/routeTree.gen.ts"
import "./theme.css"

const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      // Too many requests (a dashboard asks for many at once) are tried
      // again after a pause; a refusal (400, 403, 404) is not.
      retry: retryQuery,
      retryDelay,
      staleTime: 10_000,
    },
  },
})

const router = createRouter({
  routeTree,
  basepath: base,
  context: { queryClient },
  defaultPreload: "intent",
  scrollRestoration: true,
  // A page on its way (its code, what it loads first): the ring, after a
  // moment, and for long enough not to flicker.
  defaultPendingComponent: PageLoader,
  defaultPendingMs: 150,
  defaultPendingMinMs: 300,
})

// A session that ends while the frontend is open: back to the sign-in page,
// keeping the page the person was on.
queryClient.getQueryCache().subscribe((event) => {
  const e = event.query.state.error
  if (event.type === "updated" && isApiError(e) && e.status === 401 && event.query.queryKey[0] !== "session") {
    queryClient.setQueryData(sessionQuery.queryKey, null)
    router.navigate({ to: "/login", search: { redirect: router.state.location.href } })
  }
})

declare module "@tanstack/react-router" {
  interface Register {
    router: typeof router
  }
}

createRoot(document.getElementById("root")!).render(
  <StrictMode>
    {/* The theme: light, dark or the system's, kept in this browser. */}
    <ThemeProvider attribute="class" defaultTheme="system" enableSystem disableTransitionOnChange>
      <QueryClientProvider client={queryClient}>
        <RouterProvider router={router} />
      </QueryClientProvider>
    </ThemeProvider>
  </StrictMode>,
)
