import { Link } from "@tanstack/react-router"
import { CircleCheck, Info, ShieldAlert, TriangleAlert } from "lucide-react"
import type { ReactNode } from "react"
import { cn } from "@/lib/utils"
import { t } from "../esquadro/kit/i18n.ts"

/** How a page before signing in ended: its icon, in a circle of its color. */
export type AuthTone = "success" | "error" | "info" | "forbidden"

const TONES: Record<AuthTone, { icon: typeof Info; className: string }> = {
  success: { icon: CircleCheck, className: "bg-emerald-100 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-100" },
  error: { icon: TriangleAlert, className: "bg-red-100 text-red-600 dark:bg-red-500/20 dark:text-red-100" },
  info: { icon: Info, className: "bg-blue-100 text-blue-600 dark:bg-blue-500/20 dark:text-blue-100" },
  forbidden: { icon: ShieldAlert, className: "bg-amber-100 text-amber-600 dark:bg-amber-500/20 dark:text-amber-100" },
}

/**
 * The frame of the pages before signing in: the brand (or how it ended, in
 * a tone), a title, a hint, what the page holds and a way back under it.
 */
export function AuthFrame({
  title,
  hint,
  tone,
  footer,
  children,
}: {
  title: string
  hint?: string
  tone?: AuthTone
  footer?: ReactNode
  children?: ReactNode
}) {
  const shown = tone ? TONES[tone] : undefined
  return (
    <div className="flex min-h-svh items-center justify-center bg-card p-6">
      <div className="flex w-full max-w-[360px] flex-col gap-8">
        <div className="flex flex-col gap-6">
          {shown ? (
            <div className={cn("flex size-12 items-center justify-center rounded-full", shown.className)}>
              <shown.icon className="size-6" />
            </div>
          ) : (
            <div className="flex size-12 items-center justify-center rounded-2xl bg-foreground text-xl font-bold text-background">{{slice .App.Label 0 1}}</div>
          )}
          <div className="flex flex-col gap-1">
            <h1 className="text-3xl font-bold tracking-tight text-foreground">{title}</h1>
            {hint && <p className="font-semibold text-foreground">{hint}</p>}
          </div>
        </div>
        {children}
        {footer}
      </div>
    </div>
  )
}

/** Under a page before signing in: back to signing in. */
export function BackToSignIn() {
  return (
    <p className="text-center text-sm text-muted-foreground">
      <Link to="/login" search={ { redirect: undefined } } className="font-semibold text-primary underline-offset-4 hover:underline">
        {t("backToSignIn")}
      </Link>
    </p>
  )
}
