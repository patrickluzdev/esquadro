// The account, at the right of the header: its avatar opens who is signed
// in, the account's page, the theme and signing out. Yours to change: a
// profile page, settings.
import { useQueryClient } from "@tanstack/react-query"
import { Link, useNavigate } from "@tanstack/react-router"
import { KeyRound, LogOut, Mail, Monitor, MonitorSmartphone, Moon, Palette, Sun } from "lucide-react"
import type { LucideIcon } from "lucide-react"
import { useTheme } from "next-themes"
import { Avatar, AvatarFallback } from "@/components/ui/avatar"
import { Button } from "@/components/ui/button"
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuGroup,
  DropdownMenuItem,
  DropdownMenuLabel,
  DropdownMenuRadioGroup,
  DropdownMenuRadioItem,
  DropdownMenuSeparator,
  DropdownMenuSub,
  DropdownMenuSubContent,
  DropdownMenuSubTrigger,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu"
import { panel } from "../esquadro/config.ts"
import { signOut, useSession } from "../esquadro/kit/auth.tsx"
import { t } from "../esquadro/kit/i18n.ts"

/**
 * The menu's links: each section of the account page, by its key
 * (?section=). Add yours (a profile, notifications) here and to the page.
 */
const links: { label: string; icon: LucideIcon; section: string }[] = [
  { label: t("password"), icon: KeyRound, section: "password" },
  { label: t("devices"), icon: MonitorSmartphone, section: "devices" },
  { label: t("email"), icon: Mail, section: "email" },
]

export function UserMenu() {
  const session = useSession()
  const { theme, setTheme } = useTheme()
  const queryClient = useQueryClient()
  const navigate = useNavigate()
  const name = t("account")
  const roles = session?.roles.join(", ") ?? ""
  const initials = (roles || name).slice(0, 2).toUpperCase()
  return (
    <DropdownMenu>
      <DropdownMenuTrigger asChild>
        <Button variant="ghost" size="icon" className="size-10 rounded-full p-0" aria-label={name}>
          <Avatar className="size-9">
            <AvatarFallback className="bg-primary/10 text-xs font-bold text-primary">{initials}</AvatarFallback>
          </Avatar>
        </Button>
      </DropdownMenuTrigger>
      <DropdownMenuContent align="end" sideOffset={8} className="w-64 rounded-xl p-2">
        <DropdownMenuLabel className="flex items-center gap-3 px-2 py-2.5 font-normal">
          <Avatar className="size-10">
            <AvatarFallback className="bg-primary/10 text-sm font-bold text-primary">{initials}</AvatarFallback>
          </Avatar>
          <div className="grid min-w-0 flex-1 leading-tight">
            <span className="truncate text-sm font-bold text-foreground">{name}</span>
            <span className="truncate text-xs text-muted-foreground">{[roles, t("panel", { name: panel })].filter(Boolean).join(" · ")}</span>
          </div>
        </DropdownMenuLabel>
        <DropdownMenuSeparator />
        <DropdownMenuGroup>
          {links.map((l) => (
            <DropdownMenuItem key={l.section} asChild className="h-10 gap-3 rounded-lg px-2 font-semibold text-sidebar-foreground">
              <Link to="/account" search={ { section: l.section } as never }>
                <l.icon />
                {l.label}
              </Link>
            </DropdownMenuItem>
          ))}
          <DropdownMenuSub>
            <DropdownMenuSubTrigger className="h-10 gap-3 rounded-lg px-2 font-semibold text-sidebar-foreground">
              <Palette className="size-4 text-muted-foreground" />
              {t("theme")}
            </DropdownMenuSubTrigger>
            <DropdownMenuSubContent className="rounded-xl p-1.5">
              <DropdownMenuRadioGroup value={theme} onValueChange={setTheme}>
                <DropdownMenuRadioItem value="light" className="gap-3 font-semibold">
                  <Sun /> {t("light")}
                </DropdownMenuRadioItem>
                <DropdownMenuRadioItem value="dark" className="gap-3 font-semibold">
                  <Moon /> {t("dark")}
                </DropdownMenuRadioItem>
                <DropdownMenuRadioItem value="system" className="gap-3 font-semibold">
                  <Monitor /> {t("system")}
                </DropdownMenuRadioItem>
              </DropdownMenuRadioGroup>
            </DropdownMenuSubContent>
          </DropdownMenuSub>
        </DropdownMenuGroup>
        <DropdownMenuSeparator />
        <DropdownMenuItem
          className="h-10 gap-3 rounded-lg px-2 font-semibold text-sidebar-foreground"
          onClick={async () => {
            await signOut(queryClient)
            navigate({ to: "/login", search: { redirect: undefined } })
          }}
        >
          <LogOut />
          {t("signOut")}
        </DropdownMenuItem>
      </DropdownMenuContent>
    </DropdownMenu>
  )
}
