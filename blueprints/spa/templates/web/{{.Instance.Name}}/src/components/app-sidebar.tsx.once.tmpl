{{- $mode := or .Options.sidebar "icon" -}}
// The sidebar of the {{.Instance.Name}} frontend, from shadcn/ui's block
// {{if eq $mode "icon"}}sidebar-07 (it collapses to its icons){{else if eq $mode "inset"}}sidebar-08 (the page in an inset card){{else}}dashboard-01 (it slides away){{end}}. Yours to change: see
// ui.shadcn.com/blocks for others.
import { Link } from "@tanstack/react-router"
import type { ComponentProps } from "react"
import { NavMain } from "@/components/nav-main"
import { NavSecondary } from "@/components/nav-secondary"
import {
  Sidebar,
  SidebarContent,
  SidebarHeader,
{{- if eq $mode "icon"}}
  SidebarRail,
{{- end}}
} from "@/components/ui/sidebar"
import { menu } from "@/menu.ts"
import { t } from "../esquadro/kit/i18n.ts"

export function AppSidebar(props: ComponentProps<typeof Sidebar>) {
  return (
    <Sidebar {{if eq $mode "icon"}}collapsible="icon"{{else if eq $mode "inset"}}variant="inset"{{else}}collapsible="offcanvas"{{end}} {...props}>
      {/* The brand, as tall as the header: its mark and name; closed, its mark alone. */}
      <SidebarHeader className="h-16 shrink-0 justify-center p-0">
        <Link
          to="/"
          className="flex items-center gap-3 px-6 outline-none focus-visible:ring-2 focus-visible:ring-sidebar-ring group-data-[collapsible=icon]:justify-center group-data-[collapsible=icon]:px-0"
          aria-label="{{.App.Label}}"
        >
          <div className="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary text-lg font-bold text-primary-foreground">
            {{slice .App.Label 0 1}}
          </div>
          <span className="truncate text-2xl font-bold tracking-tight text-foreground group-data-[collapsible=icon]:hidden">{{.App.Label}}</span>
        </Link>
      </SidebarHeader>
      <SidebarContent>
        <NavMain items={menu.main} label={t("menu")} />
        <NavSecondary items={menu.secondary} className="mt-auto" />
      </SidebarContent>
{{- if eq $mode "icon"}}
      <SidebarRail />
{{- end}}
    </Sidebar>
  )
}
