import { createFileRoute } from "@tanstack/react-router"
import { t } from "../../esquadro/kit/i18n.ts"
import { SettingsPage } from "../../esquadro/kit/pages/settings.tsx"

// The settings of whoever signed in, all in one place: each section is in
// the menu at the left. The page comes from the kit, and esquadro keeps it
// up to date; add your own sections (a profile, preferences) with
// <SettingsPage sections={(own) => [...own, { key, label, icon, content }]} />.
export const Route = createFileRoute("/_app/settings")({ staticData: { title: t("settings") }, component: () => <SettingsPage /> })
