import { createFileRoute } from "@tanstack/react-router"
import { KeyRound, Mail, MonitorSmartphone, Palette } from "lucide-react"
import { DevicesCard, EmailCard, PasswordCard, ThemeCard } from "../../esquadro/kit/account.tsx"
import { t } from "../../esquadro/kit/i18n.ts"
import { PageHeader } from "../../esquadro/kit/page.tsx"
import { Settings } from "../../esquadro/kit/settings.tsx"

// The settings of whoever signed in, all in one place: each section is in
// the menu at the left; add your own (a profile, notifications) to the list.
export const Route = createFileRoute("/_app/settings")({ staticData: { title: t("settings") }, component: SettingsPage })

function SettingsPage() {
  return (
    <div className="flex flex-col gap-4">
      <PageHeader title={t("settings")} description={t("settingsHint")} />
      <Settings
        sections={[
          { key: "password", label: t("password"), icon: KeyRound, content: <PasswordCard /> },
          { key: "devices", label: t("devices"), icon: MonitorSmartphone, content: <DevicesCard /> },
          { key: "email", label: t("email"), icon: Mail, content: <EmailCard /> },
          { key: "theme", label: t("theme"), icon: Palette, content: <ThemeCard /> },
        ]}
      />
    </div>
  )
}
