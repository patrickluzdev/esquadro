import { createFileRoute } from "@tanstack/react-router"
import { useSession } from "../../esquadro/kit/auth.tsx"
import { Dashboard } from "../../esquadro/kit/dashboard.tsx"
import { t } from "../../esquadro/kit/i18n.ts"

// The first page after signing in: yours. The dashboard shows the reports
// marked @{{.Instance.Name}}(widget ...), under this title, with the period
// at its right; add charts of your own (BarsChart, LineChart, ReportTable)
// as you like.
export const Route = createFileRoute("/_app/")({ component: Home })

function Home() {
  const session = useSession()
  return (
    <Dashboard title={t("welcome")} description={session?.roles.join(", ")} />
  )
}
