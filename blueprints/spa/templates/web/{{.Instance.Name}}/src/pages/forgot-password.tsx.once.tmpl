import { createFileRoute, Link } from "@tanstack/react-router"
import { MailCheck } from "lucide-react"
import { useState } from "react"
import { Button } from "@/components/ui/button"
import { Field, FieldGroup, FieldLabel } from "@/components/ui/field"
import { Input } from "@/components/ui/input"
import { Spinner } from "@/components/ui/spinner"
import { api } from "../esquadro/api.ts"
import { base, realmKey } from "../esquadro/config.ts"
import { t } from "../esquadro/kit/i18n.ts"
import { AuthFrame } from "@/components/auth-frame"

export const Route = createFileRoute("/forgot-password")({ component: Forgot })

function Forgot() {
  const [sent, setSent] = useState(false)
  const [busy, setBusy] = useState(false)
  return (
    <AuthFrame title={t("forgotPassword")} hint={sent ? t("linkSent") : t("forgotHint")}>
          <div>
            {sent ? (
              <div className="flex justify-center text-muted-foreground">
                <MailCheck className="size-10" />
              </div>
            ) : (
              <form
                onSubmit={async (e) => {
                  e.preventDefault()
                  const email = String(new FormData(e.currentTarget).get("email"))
                  const identity = api.identity[realmKey] as { forgotPassword?: (r: { email: string; redirect?: string }) => Promise<void> }
                  setBusy(true)
                  try {
                    await identity.forgotPassword?.({ email, redirect: `${base}reset-password` })
                  } finally {
                    setBusy(false)
                    setSent(true)
                  }
                }}
              >
                <FieldGroup>
                  <Field>
                    <FieldLabel htmlFor="email">{t("email")}</FieldLabel>
                    <Input id="email" name="email" type="email" autoComplete="email" required />
                  </Field>
                  <Button type="submit" className="w-full" disabled={busy}>
                    {busy && <Spinner />}
                    {t("sendLink")}
                  </Button>
                </FieldGroup>
              </form>
            )}
          </div>
        <Link to="/login" search={ { redirect: undefined } } className="text-center text-sm text-muted-foreground underline-offset-4 hover:underline">
          {t("back")}
        </Link>
    </AuthFrame>
  )
}
