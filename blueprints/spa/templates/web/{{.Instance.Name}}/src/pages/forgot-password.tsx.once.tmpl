import { createFileRoute } from "@tanstack/react-router"
import { useState } from "react"
import { Button } from "@/components/ui/button.tsx"
import { Card } from "@/components/ui/card.tsx"
import { Input } from "@/components/ui/input.tsx"
import { api } from "../esquadro/api.ts"
import { base, realmKey } from "../esquadro/config.ts"
import { t } from "../esquadro/kit/i18n.ts"

export const Route = createFileRoute("/forgot-password")({ component: Forgot })

function Forgot() {
  const [sent, setSent] = useState(false)
  return (
    <div className="flex min-h-screen items-center justify-center bg-background p-4 text-foreground">
      <Card className="w-full max-w-sm">
        {sent ? (
          <p>{t("linkSent")}</p>
        ) : (
          <form
            className="flex flex-col gap-3"
            onSubmit={async (e) => {
              e.preventDefault()
              const email = String(new FormData(e.currentTarget).get("email"))
              const identity = api.identity[realmKey] as { forgotPassword?: (r: { email: string; redirect?: string }) => Promise<void> }
              await identity.forgotPassword?.({ email, redirect: `${base}reset-password` })
              setSent(true)
            }}
          >
            <h1 className="text-xl font-semibold">{t("forgotPassword")}</h1>
            <Input name="email" type="email" placeholder={t("email")} required />
            <Button type="submit">{t("sendLink")}</Button>
          </form>
        )}
      </Card>
    </div>
  )
}
