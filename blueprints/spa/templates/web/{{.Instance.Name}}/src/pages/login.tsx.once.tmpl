import { createFileRoute } from "@tanstack/react-router"
import { LoginPage, loginSearch } from "../esquadro/kit/pages/login.tsx"

// Signing in: back to the page asked for (?redirect) afterwards.
// The page comes from the kit, and esquadro keeps it up to date; to make
// it yours, put your own component here.
export const Route = createFileRoute("/login")({ validateSearch: loginSearch, component: LoginPage })
