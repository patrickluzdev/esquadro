import { createFileRoute } from "@tanstack/react-router"
import { ResetPasswordPage, resetPasswordSearch } from "../esquadro/kit/pages/reset-password.tsx"

// The page the password reset email links to, with its ?token; an
// invitation's too (?invite=1), which greets the person first.
// The page comes from the kit, and esquadro keeps it up to date; to make
// it yours, put your own component here.
export const Route = createFileRoute("/reset-password")({ validateSearch: resetPasswordSearch, component: ResetPasswordPage })
