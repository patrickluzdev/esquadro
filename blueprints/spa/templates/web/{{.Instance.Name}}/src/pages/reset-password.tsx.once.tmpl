import { createFileRoute, Link } from "@tanstack/react-router"
import { useState } from "react"
import { Button } from "@/components/ui/button"
import { Field, FieldError, FieldGroup, FieldLabel } from "@/components/ui/field"
import { Input } from "@/components/ui/input"
import { Spinner } from "@/components/ui/spinner"
import { api } from "../esquadro/api.ts"
import { realmKey } from "../esquadro/config.ts"
import { describe } from "../esquadro/kit/errors.ts"
import { t } from "../esquadro/kit/i18n.ts"
import { AuthFrame } from "@/components/auth-frame"

// The page the password reset email links to, with its ?token.
export const Route = createFileRoute("/reset-password")({
  validateSearch: (s: Record<string, unknown>) => ({ token: typeof s.token === "string" ? s.token : "" }),
  component: Reset,
})

function Reset() {
  const { token } = Route.useSearch()
  const [done, setDone] = useState(false)
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState("")
  return (
    <AuthFrame title={t("setPassword")} hint={done ? t("passwordSet") : t("resetHint")}>
          <div>
            {done ? (
              <Button asChild className="w-full">
                <Link to="/login" search={ { redirect: undefined } }>
                  {t("signIn")}
                </Link>
              </Button>
            ) : (
              <form
                onSubmit={async (e) => {
                  e.preventDefault()
                  const password = String(new FormData(e.currentTarget).get("password"))
                  const identity = api.identity[realmKey] as { resetPassword?: (r: { token: string; password: string }) => Promise<void> }
                  setBusy(true)
                  try {
                    await identity.resetPassword?.({ token, password })
                    setDone(true)
                  } catch (err) {
                    setError(describe(err))
                  } finally {
                    setBusy(false)
                  }
                }}
              >
                <FieldGroup>
                  <Field data-invalid={error !== "" || undefined}>
                    <FieldLabel htmlFor="password">{t("newPassword")}</FieldLabel>
                    <Input id="password" name="password" type="password" autoComplete="new-password" required aria-invalid={error !== "" || undefined} />
                    {error && <FieldError>{error}</FieldError>}
                  </Field>
                  <Button type="submit" className="w-full" disabled={busy}>
                    {busy && <Spinner />}
                    {t("setPassword")}
                  </Button>
                </FieldGroup>
              </form>
            )}
          </div>
    </AuthFrame>
  )
}
