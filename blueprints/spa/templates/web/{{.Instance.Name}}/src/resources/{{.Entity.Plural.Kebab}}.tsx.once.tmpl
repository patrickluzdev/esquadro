{{- $a := ann .Entity}}{{if index $a "resource" -}}
// The {{.Entity.Plural.Kebab}} resource: what its list, form and page show. Yours to
// change: columns, form fields, filters, actions. A field the model gains
// is in resources.{{.Entity.Plural.Camel}}.fields; add it here when you want it.
//
// A column changed in the list itself:  column(f.status, { editable: true })
// An action on a record (in its menu and on its page), and on the records
// selected (bulk):
//   actions: [{ label: "Approve", icon: Check, bulk: true,
//               run: (r) => api.request("POST", `/api/v1/{{.Entity.Plural.Kebab}}/${r.id}/approve`) }],
import { {{- $rel := false}}{{range $r := .Entity.Relations}}{{if and (hasMany $r) (ne $r.Target.Raw $.Entity.Raw) (index (ann $r.Target) "resource") (filterable $r.Target (inverseKey $r))}}{{$rel = true}}{{end}}{{end}}{{if $rel}} relation,{{end}} resource } from "../esquadro/kit/resource.ts"
import { resources } from "../esquadro/resources.gen.ts"
{{- range $r := .Entity.Relations}}{{if and (hasMany $r) (ne $r.Target.Raw $.Entity.Raw) (index (ann $r.Target) "resource") (filterable $r.Target (inverseKey $r))}}
import {{$r.Target.Plural.Camel}} from "./{{$r.Target.Plural.Kebab}}.tsx"
{{- end}}{{end}}

const meta = resources.{{.Entity.Plural.Camel}}
const f = meta.fields

export default resource(meta, {
  table: {
    columns: [{{$n := 0}}{{range $f := inRequest .Entity}}{{if and (lt $n 4) (ne (spaKind $f) "image")}}{{if $n}}, {{end}}f.{{$f.Snake}}{{$n = add1 $n}}{{end}}{{end}}],
    // The filters the API has (a field marked @store(filter)).
    filters: [{{$m := 0}}{{range $f := inRequest .Entity}}{{if or (and (or (eq (spaKind $f) "enum") (eq (spaKind $f) "bool")) (filterable $.Entity $f.Snake)) (and (eq (spaKind $f) "money") (rangeFilterable $.Entity $f.Snake))}}{{if $m}}, {{end}}f.{{$f.Snake}}{{$m = add1 $m}}{{end}}{{end}}{{range $r := keys .Entity}}{{if filterable $.Entity (keyName $r)}}{{if $m}}, {{end}}f.{{keyName $r}}{{$m = add1 $m}}{{end}}{{end}}{{if $m}}, {{end}}f.created_at],
    // Where the filters are: a drawer (by default), a dialog or a bar.
    // filterLayout: "bar",
{{- $t := "" }}{{range $f := inRequest .Entity}}{{if and (not $t) (eq (spaKind $f) "enum") (filterable $.Entity $f.Snake)}}{{$t = $f.Snake}}{{end}}{{end}}
{{- if $t}}
    // Tabs above the list, each value with how many records it keeps.
    // tabs: f.{{$t}},
{{- end}}
    // A funnel in the header of each column the list filters by.
    // columnFilters: true,
  },
  form: [{{range $i, $f := inRequest .Entity}}{{if $i}}, {{end}}f.{{$f.Snake}}{{end}}{{range $r := keys .Entity}}, f.{{keyName $r}}{{end}}{{range $r := idLinks .Entity}}, f.{{($r.IDs).Snake}}{{end}}],
  show: [{{$s := 0}}{{range $f := inRequest .Entity}}{{if ne (spaKind $f) "image"}}{{if $s}}, {{end}}f.{{$f.Snake}}{{$s = add1 $s}}{{end}}{{end}}{{range $r := keys .Entity}}, f.{{keyName $r}}{{end}}, f.created_at, f.updated_at],
{{- with inRequest .Entity}}
  title: f.{{(index . 0).Snake}},
{{- end}}
{{- with keys .Entity}}
  // A second line under each name in the list: change it, or remove it.
  subtitle: f.{{keyName (index . 0)}},
{{- end}}
{{- $rel := false}}{{range $r := .Entity.Relations}}{{if and (hasMany $r) (ne $r.Target.Raw $.Entity.Raw) (index (ann $r.Target) "resource") (filterable $r.Target (inverseKey $r))}}{{$rel = true}}{{end}}{{end}}
{{- if $rel}}
  // The related records on a record's page.
  relations: () => [
{{- range $r := .Entity.Relations}}{{if and (hasMany $r) (ne $r.Target.Raw $.Entity.Raw) (index (ann $r.Target) "resource") (filterable $r.Target (inverseKey $r))}}
    relation({{$r.Target.Plural.Camel}}, "{{inverseKey $r}}"),
{{- end}}{{end}}
  ],
{{- end}}
})
{{end -}}
