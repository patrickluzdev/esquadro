/* Generated by esquadro: do not edit. The theme's tokens from the
   frontend's options (primary, primary_dark, radius in the .esq), the same
   every frontend of the app writes. src/theme.css, yours, imports this
   first: a token set there wins. */
{{- $t := uiTheme .Options }}
:root {
  --radius: {{$t.Radius}};
  --primary: {{$t.Primary}};
  --primary-foreground: {{$t.OnPrimary}};
  --ring: {{$t.Primary}};
  --chart-1: {{$t.Primary}};
  --sidebar-primary: {{$t.Primary}};
  --sidebar-primary-foreground: {{$t.OnPrimary}};
  --sidebar-ring: {{$t.Primary}};
}

.dark {
  --primary: {{$t.Dark}};
  --primary-foreground: {{$t.OnDark}};
  --ring: {{$t.Dark}};
  --chart-1: {{$t.Dark}};
  --sidebar-primary: {{$t.Dark}};
  --sidebar-primary-foreground: {{$t.OnDark}};
  --sidebar-ring: {{$t.Dark}};
}
