/* Generated by esquadro: do not edit. The theme's tokens from the spa's
   options (primary, primary_dark, radius in the .esq). src/theme.css,
   yours, imports this first: a token set there wins. */
{{- $p := .Options.primary }}{{ $d := darkPrimary .Options.primary .Options.primary_dark }}
:root {
  --radius: {{.Options.radius}};
  --primary: {{$p}};
  --primary-foreground: {{onColor $p}};
  --ring: {{$p}};
  --chart-1: {{$p}};
  --sidebar-primary: {{$p}};
  --sidebar-primary-foreground: {{onColor $p}};
  --sidebar-ring: {{$p}};
}

.dark {
  --primary: {{$d}};
  --primary-foreground: {{onColor $d}};
  --ring: {{$d}};
  --chart-1: {{$d}};
  --sidebar-primary: {{$d}};
  --sidebar-primary-foreground: {{onColor $d}};
  --sidebar-ring: {{$d}};
}
