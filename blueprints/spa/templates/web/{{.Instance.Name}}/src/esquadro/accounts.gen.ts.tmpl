{{- $realms := realms .Entities -}}
{{- $realm := .Options.auth -}}
{{- if and (not $realm) $realms}}{{$realm = (index $realms 0).Name}}{{end -}}
// Generated by esquadro from the model: do not edit. The realms whose
// accounts this frontend administers: those whose entity lets someone of
// its own realm write it (@security(write user.admin)).
import type { FieldMeta } from "./kit/meta.ts"

/** A realm the frontend administers: its accounts' page, roles and fields. */
export interface AccountRealm {
  /** Its name in the API (/identity/<name>), and its key in the client. */
  name: string
  key: string
  /** Its address in the frontend: /accounts/<slug>. */
  slug: string
  label: string
  singular: string
  roles: string[]
  /** Who administers it: realm.role rules. */
  admins: string[]
  /** The fields an invitation asks for. */
  fields: FieldMeta[]
}

export const accountRealms: AccountRealm[] = [
{{- range $r := $realms}}{{$e := $r.Entity}}{{$admins := realmAdmins $.Entities $e}}{{$ours := false}}{{range $admins}}{{if or (eq . $realm) (hasPrefix . (printf "%s." $realm))}}{{$ours = true}}{{end}}{{end}}{{if $ours}}{{$a := ann $e}}
  {
    name: "{{$r.Name}}",
    key: "{{$e.Camel}}",
    slug: "{{$e.Plural.Kebab}}",
    label: {{printf "%q" (or (index $a "label") (humanize $e.Plural.Snake))}},
    singular: {{printf "%q" (or (index $a "singular") (humanize $e.Snake))}},
    roles: [{{range $i, $role := $r.Roles}}{{if $i}}, {{end}}"{{$role}}"{{end}}],
    admins: [{{range $i, $w := $admins}}{{if $i}}, {{end}}"{{$w}}"{{end}}],
    fields: [{{$n := 0}}{{range $f := $e.Fields}}{{if not $f.Implicit}}{{if $n}}, {{end}}{{$n = add1 $n}}{ name: "{{$f.Snake}}", label: {{printf "%q" (or (index (ann $f) "label") (humanize $f.Snake))}}, kind: "{{spaKind $f}}", required: {{and $f.Required (not $f.Default)}}{{if $f.Enum}}, values: [{{range $j, $v := $f.Enum.Values}}{{if $j}}, {{end}}"{{$v.Raw}}"{{end}}], labels: { {{- range $j, $v := $f.Enum.Values}}{{if $j}},{{end}} {{$v.Raw}}: {{printf "%q" (or (index (ann $v) "label") $v.Raw)}}{{end}} }{{end}} }{{end}}{{end}}],
  },
{{- end}}{{end}}
]
