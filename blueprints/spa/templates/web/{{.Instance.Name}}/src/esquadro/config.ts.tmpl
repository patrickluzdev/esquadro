{{- $realms := realms .Entities -}}
{{- $realm := .Options.auth -}}
{{- if and (not $realm) $realms}}{{$realm = (index $realms 0).Name}}{{end -}}
{{- $key := ""}}{{range $realms}}{{if eq .Name $realm}}{{$key = .Entity.Camel}}{{end}}{{end -}}
{{- $path := .Options.path}}{{if not $path}}{{$path = printf "/%s" .Instance.Name}}{{end -}}
// Generated by esquadro from the model: do not edit. How the {{.Instance.Name}}
// frontend is set up, from its blueprint's options.

/** Where the frontend lives: / on its own domain, else its path. */
export const base = {{if .Options.domain}}"/"{{else}}"{{$path}}/"{{end}}

/** The realm that signs in, and its key in the API client's identity. */
export const realm = "{{$realm}}"
export const realmKey = "{{$key}}" as const

/** The roles let in; any role of the realm when empty. */
export const roles: readonly string[] = [{{range $i, $r := .Options.roles}}{{if $i}}, {{end}}"{{$r}}"{{end}}]

/** Minutes without use after which it signs out; 0, never. */
export const idleMinutes: number = {{or .Options.idle_minutes 0}}

/** The language of the frontend's own words, dates, numbers and money. */
export const locale: string = "{{if eq .Options.locale "pt_br"}}pt-BR{{else}}en{{end}}"

/** The app's currency (ISO 4217): money's when an amount has none. */
export const currency: string = "{{.App.Currency}}"
