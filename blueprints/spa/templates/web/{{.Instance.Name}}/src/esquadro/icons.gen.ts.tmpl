{{- range $r := .Reports}}{{$a := ann $r}}{{if index $a "widget"}}{{with index $a "icon"}}{{$model = withIcon $model .}}{{end}}{{end}}{{end}}
{{- $set := iconSet $model -}}
// Generated by esquadro from the model: do not edit. The icons of the
// {{.Instance.Name}} frontend, by name: those the kit draws and those the model names
// (@ui(icon ...), a number's icon), Lucide's (lucide-react) unless
// src/icons.tsx, which is yours, gives its own. The kit draws them from
// here, and so can your files: import { Trash2 } from "@/esquadro/icons.gen.ts".
import type { ComponentType } from "react"
import * as lucide from "lucide-react"
import type { LucideIcon, LucideProps } from "lucide-react"
import { icons as yours } from "../icons.tsx"

/** Lucide's icon of each name: what is drawn unless src/icons.tsx says. */
export const lucideIcons = {
{{- range $set}}
  {{.}}: lucide.{{.}},
{{- end}}
}

/** The name of an icon of the set: its Lucide name, in PascalCase (Trash2). */
export type IconName = keyof typeof lucideIcons

/** An icon: draws an SVG, sized by its className (size-4) or size. */
export type IconComponent = LucideIcon

/**
 * The icons of src/icons.tsx, by the set's names: a Lucide icon, one made
 * with createLucideIcon, or any component that takes Lucide's props.
 */
export type IconOverrides = { [K in IconName]?: ComponentType<LucideProps> } & {
  [name: string]: ComponentType<LucideProps> | undefined
}

/** Every icon of the set: Lucide's, with yours in their place. */
export const icons = { ...lucideIcons, ...yours } as unknown as Record<IconName, IconComponent> &
  Record<string, IconComponent | undefined>

/**
 * The icon of a name as the model writes it (shopping_cart, shopping-cart
 * or ShoppingCart), or fallback's when the set has none of that name.
 */
export function iconOf(name: string | undefined, fallback: IconName = "Circle"): IconComponent {
  const key = (name ?? "")
    .split(/[-_ ]/)
    .filter(Boolean)
    .map((p) => p[0].toUpperCase() + p.slice(1))
    .join("")
  return icons[key] ?? icons[fallback]
}
{{range $set}}
export const {{.}} = icons.{{.}}
{{- end}}
