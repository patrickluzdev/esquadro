// Fields of your own: how a field is shown and edited, by its name
// ("price") or its kind ("decimal"), in place of the kit's. Yours to change.
import type { ReactNode } from "react"
import type { Rec } from "./esquadro/kit/meta.ts"

export interface FieldRenderer {
  show?: (value: unknown, record: Rec) => ReactNode
  input?: (value: unknown, onChange: (v: unknown) => void) => ReactNode
}

// For example, an amount in bold (money is already shown with its currency):
//   import { formatMoney } from "./esquadro/kit/money.tsx"
//   price: { show: (v) => <b>{formatMoney(v)}</b> },
export const fields: Record<string, FieldRenderer> = {}
