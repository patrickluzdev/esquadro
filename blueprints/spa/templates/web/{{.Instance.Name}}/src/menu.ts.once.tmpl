// The menu of the {{.Instance.Name}} frontend: yours to change. Add your own
// pages, reorder, group (a group opens and closes), or leave resources out.
import * as icons from "lucide-react"
import type { LucideIcon } from "lucide-react"
import { t } from "./esquadro/kit/i18n.ts"
import { dashboards } from "./esquadro/dashboard.gen.ts"
import { resources } from "./esquadro/resources.gen.ts"

export interface MenuItem {
  to: string
  label: string
  icon?: LucideIcon
}

export interface MenuGroup {
  label: string
  icon?: LucideIcon
  items: MenuItem[]
}

export interface Menu {
  /** The main entries: pages, and groups of them. */
  main: (MenuItem | MenuGroup)[]
  /** Smaller entries at the bottom of the sidebar: help, settings. */
  secondary: MenuItem[]
}

// The first page, and the dashboards the reports name (a group of them,
// once there are some): new ones show up as the model names them.
const home: MenuItem | MenuGroup = dashboards.length
  ? {
      label: t("dashboards"),
      icon: icons.LayoutDashboard,
      items: [{ to: "/", label: t("home") }, ...dashboards.map((d) => ({ to: `/dashboards/${d.slug}`, label: d.name }))],
    }
  : { to: "/", label: t("home"), icon: icons.House }

export const menu: Menu = {
  main: [
    home,
{{- range $i, $e := .Entities}}{{$a := ann $e}}{{if index $a "resource"}}
{{- $g := printf "%v" (index $a "group")}}
{{- if eq $g "<nil>"}}
    { to: "/{{$e.Plural.Kebab}}", label: resources.{{$e.Plural.Camel}}.menu, icon: icons.{{index $a "icon" | lucide}} },
{{- else}}
{{- $first := true}}{{range $j, $o := $.Entities}}{{if lt $j $i}}{{$oa := ann $o}}{{if and (index $oa "resource") (eq (printf "%v" (index $oa "group")) $g)}}{{$first = false}}{{end}}{{end}}{{end}}
{{- if $first}}
    {
      label: {{printf "%q" $g}},
      icon: icons.{{index $a "icon" | lucide}},
      items: [
{{- range $o := $.Entities}}{{$oa := ann $o}}{{if and (index $oa "resource") (eq (printf "%v" (index $oa "group")) $g)}}
        { to: "/{{$o.Plural.Kebab}}", label: resources.{{$o.Plural.Camel}}.menu, icon: icons.{{index $oa "icon" | lucide}} },
{{- end}}{{end}}
      ],
    },
{{- end}}
{{- end}}
{{- end}}{{end}}
  ],
  secondary: [],
}

export function isGroup(entry: MenuItem | MenuGroup): entry is MenuGroup {
  return "items" in entry
}
