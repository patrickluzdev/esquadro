<!doctype html>
<html lang="{{if eq .Options.locale "pt_br"}}pt-BR{{else}}en{{end}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{.App.Label}} {{humanize .Instance.Name}}</title>
    <script src="/theme.js"></script>
    <style>
      /* What shows until the frontend's code is in: a ring turning, in the middle. */
      .boot { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: #f5f5f5; }
      .dark .boot { background: #0a0a0a; }
      .boot svg { width: 40px; height: 40px; color: #2a85ff; animation: boot-spin 0.8s linear infinite; }
      @keyframes boot-spin { to { transform: rotate(360deg); } }
    </style>
  </head>
  <body>
    <div id="root">
      <div class="boot" role="status" aria-label="…">
        <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" fill="none" stroke="currentColor" stroke-width="4" opacity="0.15" /><circle cx="20" cy="20" r="17" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-dasharray="30 200" /></svg>
      </div>
    </div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
