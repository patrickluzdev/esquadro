package main

import (
	"fmt"
	"runtime/debug"
)

// version is the app's version, set when it is built:
// go build -ldflags "-X main.version=v1.2.3". Without it, the version comes
// from the build: the module's version, or the commit it was built from.
var version = ""

// printVersion prints the app's version.
func printVersion() error {
	fmt.Println("{{.App.Kebab}}", appVersion())
	return nil
}

func appVersion() string {
	if version != "" {
		return version
	}
	info, ok := debug.ReadBuildInfo()
	if !ok {
		return "dev"
	}
	if v := info.Main.Version; v != "" && v != "(devel)" {
		return v
	}
	for _, s := range info.Settings {
		if s.Key == "vcs.revision" && len(s.Value) >= 12 {
			return "dev-" + s.Value[:12]
		}
	}
	return "dev"
}
