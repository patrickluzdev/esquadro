{{- if uses "testcontainers" -}}
{{- $pg := optionsOf "postgres" -}}
{{- $realm := "" -}}{{- $role := "" -}}
{{- range realms .Entities}}{{if not $realm}}{{$realm = .Name}}{{if .Roles}}{{$role = index .Roles 0}}{{end}}{{end}}{{end -}}
package notifications

import (
	"context"
	"testing"
	"time"
	"uuid"

	"{{.App.Module}}/internal/platform/postgres/postgrestest"
	"{{.App.Module}}/internal/platform/security"
)

func TestNotices(t *testing.T) {
	ctx := context.Background()
	pool := postgrestest.Fresh(t)
	newPerson := func(email, role string, disabled bool) uuid.UUID {
		t.Helper()
		id := uuid.NewV7()
		var at any
		if disabled {
			at = time.Now()
		}
		if _, err := pool.Exec(ctx, `INSERT INTO {{identitiesTable $pg}} (id, realm, email, disabled_at) VALUES ($1, $2, $3, $4)`, id, {{quote $realm}}, email, at); err != nil {
			t.Fatal(err)
		}
		if role != "" {
			if _, err := pool.Exec(ctx, `INSERT INTO {{rolesTable $pg}} (identity_id, role) VALUES ($1, $2)`, id, role); err != nil {
				t.Fatal(err)
			}
		}
		return id
	}
	ana := newPerson("ana@example.com", {{quote $role}}, false)
	bia := newPerson("bia@example.com", {{quote $role}}, false)
	gone := newPerson("gone@example.com", {{quote $role}}, true)
	other := newPerson("other@example.com", "", false)

	// Ana makes a change: those of the role are told, not her, nor the disabled.
	asAna := security.WithPrincipal(ctx, security.Principal{ID: ana, Realm: {{quote $realm}}})
	to := {{quote $realm}}{{if $role}} + "." + {{quote $role}}{{end}}
	if err := Send(asAna, pool, to, Notice{Title: "New order", Link: "/orders/1"}); err != nil {
		t.Fatal(err)
	}
	unread := func(id uuid.UUID) int64 {
		t.Helper()
		n, err := Unread(ctx, pool, {{quote $realm}}, id)
		if err != nil {
			t.Fatal(err)
		}
		return n
	}
	if unread(bia) != 1 || unread(ana) != 0 || unread(gone) != 0 {
		t.Fatalf("bia %d, ana %d, gone %d", unread(bia), unread(ana), unread(gone))
	}
{{- if $role}}
	if unread(other) != 0 {
		t.Fatal("someone without the role was told")
	}
{{- end}}
	if err := ToPerson(ctx, pool, {{quote $realm}}, other, Notice{Title: "Just you"}); err != nil {
		t.Fatal(err)
	}
	if unread(other) != 1 {
		t.Fatal("a notice to one person did not come")
	}
	// Nobody tells themselves.
	if err := ToPerson(asAna, pool, {{quote $realm}}, ana, Notice{Title: "Me"}); err != nil || unread(ana) != 0 {
		t.Fatalf("ana told herself: %v", err)
	}

	page, err := List(ctx, pool, {{quote $realm}}, bia, false, 1, 10)
	if err != nil || len(page.Items) != 1 || page.Items[0].Title != "New order" || page.Unread != 1 {
		t.Fatalf("bia's page: %+v, %v", page, err)
	}
	if _, err := pool.Exec(ctx, `UPDATE notifications SET read_at = now() - interval '2 days' WHERE recipient = $1`, bia); err != nil {
		t.Fatal(err)
	}
	if unread(bia) != 0 {
		t.Fatal("a read notice still counts")
	}
	if n, err := Purge(ctx, pool, time.Now().Add(-24*time.Hour)); err != nil || n != 1 {
		t.Fatalf("purged %d, %v", n, err)
	}
	if unread(other) != 1 {
		t.Fatal("the purge took an unread notice")
	}
}
{{end -}}
