const (
	// PollSeconds is how often a frontend checks for new notices; 0, only
	// when a page opens or comes back to the front.
	PollSeconds = {{.Options.poll_seconds}}
	// PageSize is how many notices a frontend's bell shows.
	PageSize = {{.Options.page_size}}
	// RetentionDays is how long a notice read is kept; 0 keeps it.
	RetentionDays = {{.Options.retention_days}}
)

// Locale is the language a notice writes a record's values in.
const Locale = "{{$loc}}"
{{- if $money}}

var moneyFormat = currency.NewFormatter(currency.NewLocale(Locale))

// Money is an amount as people of Locale write it: R$ 199,90.
func Money(a currency.Amount) string {
	if a.CurrencyCode() == "" {
		return ""
	}
	return moneyFormat.Format(a)
}
{{- end}}

// Date is a day as people of Locale write it: 18/11/2026, Nov 18, 2026.
func Date(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	if strings.HasPrefix(Locale, "pt") {
		return t.Format("02/01/2006")
	}
	return t.Format("Jan 2, 2006")
}

// DateTime is a moment as people of Locale write it, in its time zone.
func DateTime(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	if strings.HasPrefix(Locale, "pt") {
		return t.Local().Format("02/01/2006 15:04")
	}
	return t.Local().Format("Jan 2, 2006 3:04 PM")
}

// Label is an enum's value by the name people know it by, or as it is.
func Label(value string, labels map[string]string) string {
	if l, ok := labels[value]; ok {
		return l
	}
	return value
}

// Notice is what a person is told: a title, a text, and where it leads (a
// path of the frontend: /orders/<id>), with the record it is about.
type Notice struct {
	Title    string
	Text     string
	Link     string
	Entity   string
	RecordID uuid.UUID
}

// Execer runs SQL: the transaction of the change that sends the notice.
type Execer interface {
	Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error)
}

// actor is who makes the change of ctx, never told of it; none for the
// system.
func actor(ctx context.Context) any {
	if p, ok := security.PrincipalOf(ctx); ok {
		return p.ID
	}
	return nil
}

func nullUUID(id uuid.UUID) any {
	if id == uuid.Nil() {
		return nil
	}
	return id
}

// ToPerson sends n to one person of realm, but to who makes the change.
func ToPerson(ctx context.Context, db Execer, realm string, id uuid.UUID, n Notice) error {
	if id == uuid.Nil() {
		return nil
	}
	if a, ok := actor(ctx).(uuid.UUID); ok && a == id {
		return nil
	}
	_, err := db.Exec(ctx, `INSERT INTO notifications (id, realm, recipient, title, text, link, entity, record_id)
		VALUES ($1, $2, $3, $4, $5, $6, $7, $8)`, uuid.NewV7(), realm, id, n.Title, n.Text, n.Link, n.Entity, nullUUID(n.RecordID))
	if err != nil {
		return fmt.Errorf("notifications: send: %w", err)
	}
	return nil
}

// Send sends n to everyone to names (a realm: user, or a realm's role:
// user.admin) who is enabled, but who makes the change.
func Send(ctx context.Context, db Execer, to string, n Notice) error {
	realm, role, _ := strings.Cut(to, ".")
	_, err := db.Exec(ctx, `INSERT INTO notifications (id, realm, recipient, title, text, link, entity, record_id)
		SELECT gen_random_uuid(), i.realm, i.id, $3, $4, $5, $6, $7
		FROM {{identitiesTable $pg}} i
		WHERE i.realm = $1 AND i.disabled_at IS NULL
		  AND ($2 = '' OR EXISTS (SELECT 1 FROM {{rolesTable $pg}} r WHERE r.identity_id = i.id AND r.role = $2))
		  AND ($8::uuid IS NULL OR i.id <> $8::uuid)`,
		realm, role, n.Title, n.Text, n.Link, n.Entity, nullUUID(n.RecordID), actor(ctx))
	if err != nil {
		return fmt.Errorf("notifications: send: %w", err)
	}
	return nil
}

// Fill puts a record's values in a text: {name} becomes its name.
func Fill(text string, values map[string]string) string {
	pairs := make([]string, 0, 2*len(values))
	for k, v := range values {
		pairs = append(pairs, "{"+k+"}", v)
	}
	return strings.NewReplacer(pairs...).Replace(text)
}

// Entry is a notice as it is listed.
type Entry struct {
	ID        uuid.UUID  `json:"id"`
	Title     string     `json:"title"`
	Text      string     `json:"text"`
	Link      string     `json:"link"`
	Entity    string     `json:"entity"`
	RecordID  *uuid.UUID `json:"record_id"`
	CreatedAt time.Time  `json:"created_at"`
	ReadAt    *time.Time `json:"read_at"`
}

// Page is a page of a person's notices, the newest first, with how many
// are unread in all.
type Page struct {
	Items      []Entry `json:"items"`
	Page       int     `json:"page"`
	PerPage    int     `json:"per_page"`
	Total      int64   `json:"total"`
	TotalPages int     `json:"total_pages"`
	Unread     int64   `json:"unread"`
}

// List reads a page (from 1) of the notices of a person, only the unread
// ones with unread.
func List(ctx context.Context, db postgres.DB, realm string, id uuid.UUID, unread bool, page, perPage int) (Page, error) {
	if perPage <= 0 || perPage > 100 {
		perPage = PageSize
	}
	page = max(page, 1)
	out := Page{Items: []Entry{}, Page: page, PerPage: perPage}
	err := db.QueryRow(ctx, `SELECT count(*) FILTER (WHERE NOT $3 OR read_at IS NULL), count(*) FILTER (WHERE read_at IS NULL)
		FROM notifications WHERE realm = $1 AND recipient = $2`, realm, id, unread).Scan(&out.Total, &out.Unread)
	if err != nil {
		return Page{}, fmt.Errorf("notifications: list: %w", err)
	}
	rows, err := db.Query(ctx, `SELECT id, title, text, link, entity, record_id, created_at, read_at FROM notifications
		WHERE realm = $1 AND recipient = $2 AND (NOT $3 OR read_at IS NULL)
		ORDER BY created_at DESC, id DESC LIMIT $4 OFFSET $5`, realm, id, unread, perPage, (page-1)*perPage)
	if err != nil {
		return Page{}, fmt.Errorf("notifications: list: %w", err)
	}
	defer rows.Close()
	for rows.Next() {
		var e Entry
		if err := rows.Scan(&e.ID, &e.Title, &e.Text, &e.Link, &e.Entity, &e.RecordID, &e.CreatedAt, &e.ReadAt); err != nil {
			return Page{}, fmt.Errorf("notifications: list: %w", err)
		}
		out.Items = append(out.Items, e)
	}
	out.TotalPages = int((out.Total + int64(perPage) - 1) / int64(perPage))
	return out, rows.Err()
}

// Unread is how many notices of a person are unread.
func Unread(ctx context.Context, db postgres.DB, realm string, id uuid.UUID) (int64, error) {
	var n int64
	err := db.QueryRow(ctx, `SELECT count(*) FROM notifications WHERE realm = $1 AND recipient = $2 AND read_at IS NULL`, realm, id).Scan(&n)
	if err != nil {
		return 0, fmt.Errorf("notifications: unread: %w", err)
	}
	return n, nil
}

// Purge deletes the notices read before before, how many.
func Purge(ctx context.Context, db Execer, before time.Time) (int64, error) {
	tag, err := db.Exec(ctx, `DELETE FROM notifications WHERE read_at < $1`, before)
	if err != nil {
		return 0, fmt.Errorf("notifications: purge: %w", err)
	}
	return tag.RowsAffected(), nil
}

// ErrNoSuchNotice is the error for a notice that is not the person's.
var ErrNoSuchNotice = &edge.Problem{Status: http.StatusNotFound, Code: "not_found", Title: "There is no such notice."}

// Routes serves the notices of who signs in: GET /notifications
// (?unread=true, page, per_page), GET /notifications/count, POST
// /notifications/{id}/read, POST /notifications/read (all), DELETE
// /notifications/{id}.
func Routes(mux *http.ServeMux, db postgres.DB) {
	who := func(w http.ResponseWriter, r *http.Request) (security.Principal, bool) {
		p, ok := security.PrincipalOf(r.Context())
		if !ok {
			edge.Write(w, r, security.ErrUnauthorized)
		}
		return p, ok
	}
	mux.HandleFunc("GET /notifications", func(w http.ResponseWriter, r *http.Request) {
		p, ok := who(w, r)
		if !ok {
			return
		}
		q := r.URL.Query()
		page, _ := strconv.Atoi(q.Get("page"))
		perPage, _ := strconv.Atoi(q.Get("per_page"))
		out, err := List(r.Context(), db, p.Realm, p.ID, q.Get("unread") == "true" || q.Get("unread") == "1", page, perPage)
		if err != nil {
			fail(w, r, err)
			return
		}
		answer(w, out)
	})
	mux.HandleFunc("GET /notifications/count", func(w http.ResponseWriter, r *http.Request) {
		p, ok := who(w, r)
		if !ok {
			return
		}
		n, err := Unread(r.Context(), db, p.Realm, p.ID)
		if err != nil {
			fail(w, r, err)
			return
		}
		answer(w, map[string]any{"unread": n, "poll_seconds": PollSeconds})
	})
	mux.HandleFunc("POST /notifications/read", func(w http.ResponseWriter, r *http.Request) {
		p, ok := who(w, r)
		if !ok {
			return
		}
		if _, err := db.Exec(r.Context(), `UPDATE notifications SET read_at = now() WHERE realm = $1 AND recipient = $2 AND read_at IS NULL`, p.Realm, p.ID); err != nil {
			fail(w, r, err)
			return
		}
		w.WriteHeader(http.StatusNoContent)
	})
	one := func(method, sql string) {
		mux.HandleFunc(method+" /notifications/{id}"+map[string]string{"POST": "/read", "DELETE": ""}[method], func(w http.ResponseWriter, r *http.Request) {
			p, ok := who(w, r)
			if !ok {
				return
			}
			id, err := uuid.Parse(r.PathValue("id"))
			if err != nil {
				edge.Write(w, r, ErrNoSuchNotice)
				return
			}
			tag, err := db.Exec(r.Context(), sql, id, p.Realm, p.ID)
			if err != nil {
				fail(w, r, err)
				return
			}
			if tag.RowsAffected() == 0 {
				edge.Write(w, r, ErrNoSuchNotice)
				return
			}
			w.WriteHeader(http.StatusNoContent)
		})
	}
	one("POST", `UPDATE notifications SET read_at = coalesce(read_at, now()) WHERE id = $1 AND realm = $2 AND recipient = $3`)
	one("DELETE", `DELETE FROM notifications WHERE id = $1 AND realm = $2 AND recipient = $3`)
}

func answer(w http.ResponseWriter, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.Header().Set("Cache-Control", "no-store")
	_ = json.NewEncoder(w).Encode(v)
}

// fail answers err: a problem as it is, anything else as an internal error,
// logged.
func fail(w http.ResponseWriter, r *http.Request, err error) {
	if p, ok := errors.AsType[*edge.Problem](err); ok {
		edge.Write(w, r, p)
		return
	}
	slog.ErrorContext(r.Context(), "notifications", "error", err.Error())
	edge.Write(w, r, edge.ErrInternal)
}
