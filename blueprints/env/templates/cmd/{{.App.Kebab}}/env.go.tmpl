package main

import (
	"fmt"
	"net/url"
	"os"
	"text/tabwriter"

	"{{.App.Module}}/internal/platform/config"
)

// printEnv shows the configuration of the environment APP_ENV names: each
// variable's value and where it came from, secrets hidden. Its problems
// come after, so that the env command helps when the app does not start.
func printEnv() error {
	cfg, err := config.Load()
	fmt.Printf("environment: %s\n\n", cfg.Env)
	w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
	for _, v := range cfg.Vars() {
		value, source := v.Value, v.Source
		switch {
		case value == "":
			value, source = "-", "not set"
		case v.Secret:
			value = hide(value)
		}
		fmt.Fprintf(w, "%s\t%s\t(%s)\n", v.Name, value, source)
	}
	if err := w.Flush(); err != nil {
		return err
	}
	return err
}

// hide hides a secret: a URL with a password shows all but the password,
// anything else shows nothing.
func hide(secret string) string {
	if u, err := url.Parse(secret); err == nil && u.Host != "" {
		if _, ok := u.User.Password(); ok {
			return u.Redacted()
		}
	}
	return "xxxxx"
}
