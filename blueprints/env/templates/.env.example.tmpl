{{- $envs := .Environments -}}
# Generated by esquadro: every environment variable of {{.App.Label}}, from the
# model. Do not put values here: each environment has its file,
# .env.<environment> ({{join ", " $envs}}), out of git, or
# its platform's variables and secrets. APP_ENV picks the environment;
# {{index $envs 0}} is the default.
{{- $owner := "-"}}
{{- range .Env}}
{{- $v := .}}
{{- if ne .Blueprint $owner}}{{$owner = .Blueprint}}

# --- {{if .Blueprint}}{{.Blueprint}}{{else}}the app{{end}}
{{- end}}
{{range .Doc}}
# {{.}}
{{- end}}
# {{.Type}}{{if .Secret}}, secret{{end}}{{with .Required}}; required in {{join ", " .}}{{end}}
{{- if and (not .Secret) (envText .Default)}}; default: {{envText .Default}}{{end}}
{{- range $envs}}
{{- $e := .}}
{{- $set := index $v.Values $e}}{{if not $set}}{{$set = index $v.ByEnv $e}}{{end}}
{{- if $set}}
#   in {{$e}}: {{if $v.Secret}}a value for development, in the code{{else}}{{envText $set}}{{end}}
{{- end}}
{{- end}}
{{.Full}}=
{{- end}}
