/// Background work: the run command (the one run without arguments, unless
/// the app has http, which takes it) runs the app's processes side by side
/// until the app is asked to stop, then lets each finish. A process is a
/// function that runs until its context ends; worker.Every runs one at an
/// interval. Your processes go in cmd/<app>/processes.go, which starts with
/// an example; other blueprints add theirs to the worker.processes slot.
blueprint worker {
  version "0.1.0"
  requires app
  optional http

  /// Imports of cmd/<app>/worker.go.
  slot "worker.imports"
  /// Processes other blueprints run, as worker.Process values followed by a
  /// comma, e.g. {Name: "queue", Run: d.queue.Run},; d is the dependencies.
  slot "worker.processes"
}
