// Package worker runs processes side by side until they are asked to stop.
package worker

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"sync"
	"time"
)

// A Process is work that runs until its context ends: a loop, a consumer of
// a queue. Run returns nil when it stopped because ctx ended.
type Process struct {
	Name string
	Run  func(ctx context.Context) error
}

// Run runs every process until ctx ends, or until one of them fails: then
// the others are asked to stop, and its error is returned. It waits for
// every process to return.
func Run(ctx context.Context, logger *slog.Logger, processes ...Process) error {
	if len(processes) == 0 {
		return errors.New("worker: no processes to run")
	}
	ctx, cancel := context.WithCancelCause(ctx)
	defer cancel(nil)
	var wg sync.WaitGroup
	for _, p := range processes {
		wg.Go(func() {
			logger.Info("process started", "process", p.Name)
			err := p.Run(ctx)
			if err != nil && ctx.Err() == nil {
				logger.Error("process failed", "process", p.Name, "error", err)
				cancel(fmt.Errorf("%s: %w", p.Name, err))
				return
			}
			logger.Info("process stopped", "process", p.Name)
		})
	}
	wg.Wait()
	if err := context.Cause(ctx); err != nil && !errors.Is(err, context.Canceled) {
		return err
	}
	return nil
}

// Every is a process function that calls do at each interval, the first
// time right away, until ctx ends. An error of do is logged and does not
// stop the process; do gets ctx, to stop early.
func Every(interval time.Duration, logger *slog.Logger, do func(ctx context.Context) error) func(ctx context.Context) error {
	return func(ctx context.Context) error {
		t := time.NewTicker(interval)
		defer t.Stop()
		for {
			if err := do(ctx); err != nil && ctx.Err() == nil {
				logger.Error("periodic work failed", "error", err)
			}
			select {
			case <-ctx.Done():
				return nil
			case <-t.C:
			}
		}
	}
}
